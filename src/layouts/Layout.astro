---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  prevURL?: string;
  nextURL?: string;
  type?: "website" | "article";
  keywords?: string;
  noIndex?: boolean | "noindex, follow" | "noindex, nofollow";
  /** Pass a short plain-text summary for speakable / voice assistant extraction */
  speakableSummary?: string;
  /** JSON-LD breadcrumb items for BreadcrumbList schema in <head> */
  breadcrumbItems?: Array<{ label: string; href?: string }>;
}

const {
  title = "TSA Carry-On Checker: Is It Allowed on a Plane?",
  description = "Type any item to instantly see if it goes in your carry-on or checked bag. Free TSA tool — razors, liquids, power banks, food & more. Try it now.",
  image = "/og-image.png",
  imageAlt = "BringOnPlane — TSA Baggage Rules & Smart Packing Assistant",
  canonicalURL,
  prevURL,
  nextURL,
  type = "website",
  keywords = "can i bring food through tsa, can i bring food on a plane, can i bring a vape on a plane, what can i bring on a plane, tsa carry on rules, tsa baggage rules, airport security, what can i bring in carry on, packing list generator, travel checklist, can i bring snacks on a plane, can i bring a portable charger on a plane, can i bring toothpaste on a plane, can i bring scissors on a plane, can i bring a razor on a plane",
  noIndex = false,
  speakableSummary,
  breadcrumbItems,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : "https://bringonplane.com";

function normalizeCanonical(rawUrl?: string): string {
  const base = `${siteUrl}/`;
  const parsed = rawUrl ? new URL(rawUrl, base) : new URL(Astro.url.pathname, base);
  if (!parsed.pathname.endsWith('/') && !/\.[a-zA-Z0-9]+$/.test(parsed.pathname)) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  return parsed.href;
}

const finalCanonicalURL = normalizeCanonical(canonicalURL);
const resolvedImage = new URL(image, `${siteUrl}/`).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden max-w-full">
  <head>
    <ClientRouter />
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8894580285912422" crossorigin="anonymous"></script>
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme') || 'light';
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          const rtlLangs = ['ar', 'he', 'ur', 'fa', 'ps', 'yi', 'sd'];
          const userLang = localStorage.getItem('user_lang');
          if (userLang && rtlLangs.includes(userLang)) {
            document.documentElement.setAttribute('dir', 'rtl');
          }
        } catch(e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <!-- Application identity for PWA / AI assistants -->
    <meta name="application-name" content="BringOnPlane" />
    <meta name="rating" content="General" />
    <meta name="category" content="Travel, Tools" />
    <!-- DNS prefetch for performance (Core Web Vitals signal) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <!-- International: signals this is the canonical English version -->
    <link rel="alternate" hreflang="en" href={finalCanonicalURL} />
    <link rel="alternate" hreflang="x-default" href={finalCanonicalURL} />
    {prevURL && <link rel="prev" href={prevURL} />}
    {nextURL && <link rel="next" href={nextURL} />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="BringOnPlane" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Sitemaps — auto-discovered by Googlebot, Bingbot, and other crawlers -->
    <link rel="sitemap" type="application/xml" title="Sitemap Index" href="/sitemap-index.xml" />
    
    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- ═══════════════════════════════════════════════════════
         PRIMARY META TAGS
    ═══════════════════════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonicalURL} />
    <meta name="robots" content={typeof noIndex === 'string' ? noIndex : (noIndex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1")} />
    <meta name="author" content="BringOnPlane" />
    <meta name="copyright" content="BringOnPlane" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="subject" content="TSA carry-on and checked baggage rules for travel items" />
    <meta name="classification" content="Travel, Aviation Security, Tools" />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- ═══════════════════════════════════════════════════════
         OPEN GRAPH (Facebook, LinkedIn, Slack, Discord)
    ═══════════════════════════════════════════════════════ -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="BringOnPlane" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={finalCanonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- ═══════════════════════════════════════════════════════
         TWITTER / X CARD
    ═══════════════════════════════════════════════════════ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bringonplane" />
    <meta name="twitter:creator" content="@bringonplane" />
    <meta name="twitter:url" content={finalCanonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- ═══════════════════════════════════════════════════════
         ADDITIONAL SOCIAL / AI SEARCH SIGNALS
    ═══════════════════════════════════════════════════════ -->
    <!-- WhatsApp / iMessage link preview -->
    <meta property="og:rich_attachment" content="true" />
    <!-- Pinterest -->
    <meta name="pinterest-rich-pin" content="true" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <!-- Google Search Console verification placeholder -->
    <meta name="google-site-verification" content="GSC_VERIFICATION_PLACEHOLDER" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PYTY68WGKQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PYTY68WGKQ');
    </script>

    <!-- Organization schema with social profiles -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "BringOnPlane",
      "alternateName": ["Bring On Plane", "BringOnPlane.com"],
      "url": "https://bringonplane.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://bringonplane.com/logo.png",
        "width": 200,
        "height": 60
      },
      "sameAs": [
        "https://www.instagram.com/bringonplane/"
      ],
      "foundingDate": "2024",
      "description": "Free TSA carry-on checker and airport security rules directory for travellers.",
      "areaServed": "Worldwide",
      "knowsAbout": ["TSA security rules", "Airport carry-on regulations", "Airline baggage policies", "FAA regulations", "IATA standards"]
    })} />

    <!-- SoftwareApplication schema: signals to Google this is an interactive tool -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "BringOnPlane TSA Checker",
      "alternateName": "Can I Bring This On A Plane? Checker",
      "description": "Instantly check TSA carry-on and checked bag rules for any item. Search 196+ items with instant color-coded verdicts. Free airport security tool.",
      "url": "https://bringonplane.com",
      "applicationCategory": "TravelApplication",
      "applicationSubCategory": "Airport Security Tool",
      "operatingSystem": "Web, iOS, Android",
      "browserRequirements": "Requires JavaScript",
      "inLanguage": "en",
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "featureList": [
        "Instant TSA carry-on checker",
        "Checked bag rules lookup",
        "196+ items database",
        "Color-coded YES/NO/RESTRICTED verdicts",
        "Free packing checklist builder",
        "Side-by-side item comparison tool",
        "Airline-specific rule variations",
        "International customs guidance"
      ],
      "screenshot": {
        "@type": "ImageObject",
        "url": "https://bringonplane.com/og-image.png",
        "caption": "BringOnPlane TSA Checker — search any item for instant carry-on verdict"
      },
      "provider": {
        "@type": "Organization",
        "name": "BringOnPlane",
        "url": "https://bringonplane.com"
      }
    })} />

    <!-- SiteLinksSearchBox: enables Google to show a search box directly in SERPs -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BringOnPlane",
      "url": "https://bringonplane.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://bringonplane.com/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Speakable: marks content for Google Assistant / voice search extraction -->
    {speakableSummary && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": title,
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".speakable-hero", ".speakable-answer", "h1"]
        },
        "url": finalCanonicalURL
      })}  />
    )}

    <!-- BreadcrumbList in <head> for crawlers that don't parse body JSON-LD -->
    {breadcrumbItems && breadcrumbItems.length > 1 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems.map((crumb, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": crumb.label,
          ...(crumb.href ? { "item": `https://bringonplane.com${crumb.href}` } : {})
        }))
      })} />
    )}

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-canvas-soft text-ink font-sans selection:bg-primary selection:text-on-primary overflow-x-hidden max-w-full relative">
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-link">
      Skip to content
    </a>
    
    <slot name="header" />
    
    <main id="main-content" class="flex-1 flex flex-col">
      <slot />
    </main>
    
    <slot name="footer" />
    <SearchModal />

    <!-- Google Translate Mount Element (must NOT have notranslate class) -->
    <div id="google_translate_element" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; z-index: -9999;" aria-hidden="true"></div>

    <!-- Google Translate Script Loader with Automatic Language & RTL Sync -->
    <script is:inline>
      window.googleTranslateElementInit = function() {
        if (typeof google !== 'undefined' && google.translate) {
          new google.translate.TranslateElement({
            pageLanguage: 'en',
            autoDisplay: false,
            layout: google.translate.TranslateElement.InlineLayout.HORIZONTAL
          }, 'google_translate_element');
        }
      };
    </script>
    <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>
  </body>
</html>
