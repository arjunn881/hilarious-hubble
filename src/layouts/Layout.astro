---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";
import TSAUpdatesBanner from "../components/TSAUpdatesBanner.astro";
import { ClientRouter } from "astro:transitions";
import {
  getAlternateLinks,
  getCanonicalUrl,
  getLangFromUrl,
  getOgLocaleAlternates,
  localeMeta,
  useTranslations,
  type Lang,
} from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  prevURL?: string;
  nextURL?: string;
  type?: "website" | "article";
  keywords?: string;
  noIndex?: boolean | "noindex, follow" | "noindex, nofollow";
  lang?: Lang;
  /** Pass a short plain-text summary for speakable / voice assistant extraction */
  speakableSummary?: string;
  /** JSON-LD breadcrumb items for BreadcrumbList schema in <head> */
  breadcrumbItems?: Array<{ label: string; href?: string }>;
}

const {
  title: titleProp,
  description: descriptionProp,
  image = "/og-image.png",
  imageAlt: imageAltProp,
  canonicalURL,
  prevURL,
  nextURL,
  type = "website",
  keywords: keywordsProp,
  noIndex = false,
  lang: langProp,
  speakableSummary,
  breadcrumbItems,
} = Astro.props;

/**
 * The URL is the source of truth for the active locale — every localised route
 * lives under a `/{lang}/` prefix. The `lang` prop only overrides it for the
 * handful of pages rendered outside the localised tree.
 */
const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const meta = localeMeta[lang];

const title = titleProp ?? t("meta.home.title");
const description = descriptionProp ?? t("meta.home.description");
const imageAlt = imageAltProp ?? t("site.imageAlt");
const keywords = keywordsProp ?? t("meta.home.keywords");

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://bringonplane.com";

function normalizeCanonical(rawUrl?: string): string {
  const base = `${siteUrl}/`;
  const parsed = rawUrl
    ? new URL(rawUrl, base)
    : new URL(Astro.url.pathname, base);
  if (
    !parsed.pathname.endsWith("/") &&
    !/\.[a-zA-Z0-9]+$/.test(parsed.pathname)
  ) {
    parsed.pathname = `${parsed.pathname}/`;
  }
  return parsed.href;
}

const finalCanonicalURL = canonicalURL
  ? normalizeCanonical(canonicalURL)
  : getCanonicalUrl(Astro.url.pathname, lang);
const resolvedImage = new URL(image, `${siteUrl}/`).href;

/** Reciprocal, self-referencing hreflang set + `x-default` → the English URL. */
const alternateLinks = getAlternateLinks(Astro.url.pathname);
const ogLocaleAlternates = getOgLocaleAlternates(lang);
/** Locale home, used as the `url` for the site-wide JSON-LD entities. */
const localeHomeUrl = getCanonicalUrl("/", lang);
---

<!doctype html>
<html
  lang={meta.hreflang}
  dir={meta.dir}
  class="scroll-smooth max-w-full overflow-x-clip"
>
  <head>
    <!-- Vendor error/warning guards and Google AdSense initialization -->
    <script is:inline>
      (function () {
        function patchPerformanceObserver(targetWin) {
          try {
            if (targetWin.PerformanceObserver && targetWin.PerformanceObserver.prototype) {
              var origObserve = targetWin.PerformanceObserver.prototype.observe;
              targetWin.PerformanceObserver.prototype.observe = function (options) {
                if (options && options.entryTypes && options.buffered) {
                  // W3C Performance Timeline spec prohibits 'buffered: true' when 'entryTypes' is used.
                  // Split into individual type calls with buffered: true, or remove buffered flag.
                  if (Array.isArray(options.entryTypes)) {
                    var self = this;
                    var allOk = true;
                    options.entryTypes.forEach(function (type) {
                      try {
                        origObserve.call(self, { type: type, buffered: true });
                      } catch (e) {
                        allOk = false;
                      }
                    });
                    if (allOk) return;
                  }
                  var safeOptions = Object.assign({}, options);
                  delete safeOptions.buffered;
                  return origObserve.call(this, safeOptions);
                }
                return origObserve.apply(this, arguments);
              };
            }
          } catch (e) {}
        }

        function isVendorError(msg, src) {
          var m = (msg || "").toLowerCase();
          var s = (src || "").toLowerCase();
          return (
            m.indexOf("lima_error") !== -1 ||
            m.indexOf("empty ad response") !== -1 ||
            m.indexOf("performanceobserver") !== -1 ||
            m.indexOf("buffered flag") !== -1 ||
            m.indexOf("chunk.bkbau") !== -1 ||
            m.indexOf("vignette") !== -1 ||
            s.indexOf("outstream") !== -1 ||
            s.indexOf("chunk.bkbau") !== -1 ||
            s.indexOf("emrldtp") !== -1 ||
            s.indexOf("ntc0nje2") !== -1 ||
            s.indexOf("doubleclick") !== -1 ||
            s.indexOf("googlesyndication") !== -1
          );
        }

        function guardWindow(w) {
          try {
            if (!w || w.__guards_installed) return;
            w.__guards_installed = true;

            patchPerformanceObserver(w);

            var prevOnError = w.onerror;
            w.onerror = function (msg, src, line, col, err) {
              var m = (msg || "") + " " + (err && err.message ? err.message : "");
              var s = (src || "") + " " + (err && err.stack ? err.stack : "");
              if (isVendorError(m, s)) {
                return true; // Suppress console error in DevTools
              }
              if (prevOnError) return prevOnError.apply(this, arguments);
              return false;
            };

            w.addEventListener(
              "error",
              function (e) {
                var m = (e.message || "") + " " + (e.error && e.error.message ? e.error.message : "");
                var s = (e.filename || "") + " " + (e.error && e.error.stack ? e.error.stack : "");
                if (isVendorError(m, s)) {
                  e.preventDefault();
                  e.stopImmediatePropagation();
                  return true;
                }
              },
              true
            );

            if (w.console) {
              var origErr = w.console.error;
              w.console.error = function () {
                try {
                  var str = "";
                  for (var i = 0; i < arguments.length; i++) {
                    var arg = arguments[i];
                    if (typeof arg === "string") {
                      str += " " + arg;
                    } else if (arg && typeof arg === "object") {
                      str += " " + (arg.message || "") + " " + (arg.stack || "");
                    }
                  }
                  if (isVendorError(str, str)) {
                    return;
                  }
                } catch (e) {}
                origErr.apply(w.console, arguments);
              };
            }
          } catch (e) {}
        }

        // 1. Guard current top window
        guardWindow(window);

        // 2. Intercept dynamically created child iframes (used by AdSense / video ads like outstream.min.js)
        try {
          var desc = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, "contentWindow");
          if (desc && desc.get) {
            var origGet = desc.get;
            Object.defineProperty(HTMLIFrameElement.prototype, "contentWindow", {
              get: function () {
                var win = origGet.call(this);
                if (win) guardWindow(win);
                return win;
              },
              configurable: true,
              enumerable: true,
            });
          }
        } catch (e) {}

        // 3. Delete third-party vendor console.log spam (e.g. Travelpayouts [tp] telemetry)
        var _log = console.log;
        console.log = function () {
          if (arguments[0] && typeof arguments[0] === "string" && arguments[0].indexOf("[tp]") !== -1) {
            return;
          }
          _log.apply(console, arguments);
        };

        // 4. Suppress harmless vendor warnings (Astro ClientRouter, PerformanceObserver buffered flag)
        var _warn = console.warn;
        console.warn = function () {
          if (arguments[0] && typeof arguments[0] === "string") {
            if (
              arguments[0].indexOf("data-astro-exec") !== -1 ||
              arguments[0].indexOf("PerformanceObserver") !== -1 ||
              arguments[0].indexOf("buffered flag") !== -1
            ) {
              return;
            }
          }
          _warn.apply(console, arguments);
        };

        // 5. Intercept Travelpayouts adblock probe to eliminate DoubleClick 400 Bad Request
        if (typeof window.fetch === "function") {
          var _fetch = window.fetch;
          window.fetch = function (resource, init) {
            try {
              var url = typeof resource === "string" ? resource : (resource && resource.url) || "";
              if (url.indexOf("securepubads.g.doubleclick.net/gampad/ads") !== -1) {
                return Promise.resolve(new Response("", { status: 200, statusText: "OK" }));
              }
            } catch (e) {}
            return _fetch.apply(this, arguments);
          };
        }

        // 6. Suppress unhandled promise rejections from third-party vendor scripts
        window.addEventListener("unhandledrejection", function (e) {
          if (
            e.reason && (
              (e.reason.message && (
                e.reason.message.indexOf("securepubads") !== -1 ||
                e.reason.message.indexOf("chunk.BkBAu") !== -1 ||
                e.reason.message.indexOf("emrldtp") !== -1 ||
                e.reason.message.indexOf("lima_error") !== -1
              )) ||
              (e.reason.stack && (
                e.reason.stack.indexOf("chunk.BkBAu") !== -1 ||
                e.reason.stack.indexOf("NTc0NjE2") !== -1 ||
                e.reason.stack.indexOf("emrldtp") !== -1 ||
                e.reason.stack.indexOf("outstream") !== -1
              ))
            )
          ) {
            e.preventDefault();
            return true;
          }
        });
      })();
    </script>
    <ClientRouter />
    <script is:inline>
      (function () {
        try {
          const theme = localStorage.getItem("theme") || "light";
          if (theme === "dark") {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Impact.com affiliate network site verification -->
    <meta name="impact-site-verification" value="25afa774-0ba9-436d-b7e3-04ac0707b283" />
    <!-- Travelpayouts script -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://emrldtp.cc/NTc0NjE2.js?t=574616';
          document.head.appendChild(script);
      })();
    </script>
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f172a"
      media="(prefers-color-scheme: dark)"
    />
    <!-- Application identity for PWA / AI assistants -->
    <meta name="application-name" content="BringOnPlane" />
    <meta name="rating" content="General" />
    <meta name="category" content={t("meta.category")} />
    <!-- DNS prefetch for performance (Core Web Vitals signal) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8894580285912422" crossorigin="anonymous"></script>

    {prevURL && <link rel="prev" href={prevURL} />}
    {nextURL && <link rel="next" href={nextURL} />}

    <!-- ═══════════════════════════════════════════════════════
         HREFLANG — reciprocal, self-referencing, with x-default
    ═══════════════════════════════════════════════════════ -->
    {
      alternateLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="BringOnPlane" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Sitemaps — auto-discovered by Googlebot, Bingbot, and other crawlers -->
    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap Index"
      href="/sitemap-index.xml"
    />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- ═══════════════════════════════════════════════════════
         PRIMARY META TAGS
    ═══════════════════════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonicalURL} />
    <meta
      name="robots"
      content={typeof noIndex === "string"
        ? noIndex
        : noIndex
          ? "noindex, nofollow"
          : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <!-- Enforce noindex on Cloudflare Pages (*.pages.dev) preview domains -->
    <script is:inline>
      if (typeof window !== "undefined" && window.location.hostname.endsWith(".pages.dev")) {
        var el = document.querySelector('meta[name="robots"]');
        if (el) el.setAttribute("content", "noindex, nofollow");
      }
    </script>
    <meta name="author" content="BringOnPlane" />
    <meta name="copyright" content="BringOnPlane" />
    <meta name="language" content={meta.metaLanguage} />

    <meta name="subject" content={t("meta.subject")} />
    <meta name="classification" content={t("meta.classification")} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- ═══════════════════════════════════════════════════════
         OPEN GRAPH (Facebook, LinkedIn, Slack, Discord)
    ═══════════════════════════════════════════════════════ -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="BringOnPlane" />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      ogLocaleAlternates.map((alt) => (
        <meta property="og:locale:alternate" content={alt} />
      ))
    }
    <meta property="og:url" content={finalCanonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- ═══════════════════════════════════════════════════════
         TWITTER / X CARD
    ═══════════════════════════════════════════════════════ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bringonplane" />
    <meta name="twitter:creator" content="@bringonplane" />
    <meta name="twitter:url" content={finalCanonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- ═══════════════════════════════════════════════════════
         ADDITIONAL SOCIAL / AI SEARCH SIGNALS
    ═══════════════════════════════════════════════════════ -->
    <!-- WhatsApp / iMessage link preview -->
    <meta property="og:rich_attachment" content="true" />
    <!-- Pinterest -->
    <meta name="pinterest-rich-pin" content="true" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />
    <!-- Google Search Console verification placeholder -->
    <meta
      name="google-site-verification"
      content="Y8zqJ2fXh3XJJ2hQBEgtALV8pYWoBTacz6yMcpc2TAU"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PYTY68WGKQ"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-PYTY68WGKQ");
    </script>

    <!-- Organization schema with social profiles -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "BringOnPlane",
        alternateName: ["Bring On Plane", "BringOnPlane.com"],
        url: "https://bringonplane.com",
        logo: {
          "@type": "ImageObject",
          url: "https://bringonplane.com/logo.png",
          width: 200,
          height: 60,
        },
        sameAs: ["https://www.instagram.com/bringonplane/"],
        foundingDate: "2024",
        description: t("site.blurb"),
        areaServed: "Worldwide",
        knowsAbout: [
          "TSA security rules",
          "Airport carry-on regulations",
          "Airline baggage policies",
          "FAA regulations",
          "IATA standards",
        ],
      })}
    />

    <!-- SoftwareApplication schema: signals to Google this is an interactive tool -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "BringOnPlane TSA Checker",
        alternateName: "Can I Bring This On A Plane? Checker",
        description: t("meta.home.description"),
        url: localeHomeUrl,
        applicationCategory: "TravelApplication",
        applicationSubCategory: "Airport Security Tool",
        operatingSystem: "Web, iOS, Android",
        browserRequirements: "Requires JavaScript",
        inLanguage: meta.hreflang,
        isAccessibleForFree: true,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
        },
        featureList: [
          "Instant TSA carry-on checker",
          "Checked bag rules lookup",
          "196+ items database",
          "Color-coded YES/NO/RESTRICTED verdicts",
          "Free packing checklist builder",
          "Side-by-side item comparison tool",
          "Airline-specific rule variations",
          "International customs guidance",
        ],
        screenshot: {
          "@type": "ImageObject",
          url: "https://bringonplane.com/og-image.png",
          caption:
            "BringOnPlane TSA Checker — search any item for instant carry-on verdict",
        },
        provider: {
          "@type": "Organization",
          name: "BringOnPlane",
          url: "https://bringonplane.com",
        },
      })}
    />

    <!-- SiteLinksSearchBox: enables Google to show a search box directly in SERPs -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "BringOnPlane",
        url: localeHomeUrl,
        inLanguage: meta.hreflang,
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${localeHomeUrl}?q={search_term_string}`,
          },
          "query-input": "required name=search_term_string",
        },
      })}
    />

    <!-- Speakable: marks content for Google Assistant / voice search extraction -->
    {
      speakableSummary && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebPage",
            name: title,
            speakable: {
              "@type": "SpeakableSpecification",
              cssSelector: [".speakable-hero", ".speakable-answer", "h1"],
            },
            inLanguage: meta.hreflang,
            url: finalCanonicalURL,
          })}
        />
      )
    }

    <!-- BreadcrumbList in <head> for crawlers that don't parse body JSON-LD -->
    {
      breadcrumbItems && breadcrumbItems.length > 1 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: breadcrumbItems.map((crumb, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: crumb.label,
              ...(crumb.href
                ? { item: getCanonicalUrl(crumb.href, lang) }
                : {}),
            })),
          })}
        />
      )
    }

    <slot name="head" />
  </head>
  <body
    class="min-h-screen flex flex-col bg-canvas-soft text-ink font-sans selection:bg-primary selection:text-on-primary max-w-full relative"
  >
    <!-- Skip to content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-link"
    >
      {t("a11y.skipToContent")}
    </a>

    <slot name="header" />

    <!-- Sitewide TSA 2026 Regulation Updates Strip -->
    <TSAUpdatesBanner />


    <main id="main-content" class="flex-1 flex flex-col w-full">
      <slot />
    </main>

    <slot name="footer" />
    <SearchModal lang={lang} />
  </body>
</html>
