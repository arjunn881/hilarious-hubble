---
/**
 * AmazonAffiliateBox.astro
 *
 * Renders a "What You'll Need" / recommended-products card on item and guide pages.
 * • All outbound links carry rel="nofollow sponsored noopener noreferrer" (Google + FTC compliant).
 * • The FTC disclosure sentence is always visible when the box renders.
 * • Pass an empty or undefined array to suppress the block entirely.
 *
 * Supports three link modes:
 * 1. `search`: Amazon search query (Guaranteed 0% error rate — never 404s, always live items).
 * 2. `url`: Direct Amazon Associates affiliate link (e.g. from SiteStripe, https://amzn.to/...).
 * 3. `asin`: Direct product ASIN (e.g. B08N2QK4XR).
 */

import { getItemAffiliateLinks, type AffiliateContext } from '../lib/affiliateEngine';

export interface AffiliateLink {
  /** Short product title shown on the card */
  title: string;
  /** Amazon search query — recommended! Links to live search results matching the query */
  search?: string;
  /** Direct affiliate URL (e.g. amzn.to shortlink or full product link) */
  url?: string;
  /** Direct product ASIN if linking to a specific item */
  asin?: string;
  /** Amazon store domain — default is "amazon.in" (or "amazon.com") */
  domain?: string;
  /** Amazon Associates tracking tag — default is the site's tag */
  tag?: string;
  /** One-sentence reason this product is relevant to the item/guide page */
  why: string;
  /** Optional short badge label, e.g. "Best Seller", "Travel Pick", "Editor's Choice" */
  badge?: string | null;
}

interface Props {
  links?: AffiliateLink[];
  heading?: string;
  item?: AffiliateContext;
  title?: string;
  category?: string;
}

const DEFAULT_TAG = "arjunanayak-21";
const DEFAULT_DOMAIN = "amazon.in";

const { links, heading = "What You'll Need for This Trip", item, title, category } = Astro.props;

// Use explicit links if provided; otherwise auto-generate from the item/guide context
const activeLinks = (links && links.length > 0)
  ? links
  : getItemAffiliateLinks(item || (title ? { name: title, category } : undefined));

function buildUrl(link: AffiliateLink): string {
  const domain = link.domain || DEFAULT_DOMAIN;
  const tag = link.tag || DEFAULT_TAG;

  // 1. Direct affiliate URL provided (e.g., https://amzn.to/... or custom URL)
  if (link.url && link.url.trim().length > 0) {
    try {
      const parsed = new URL(link.url);
      if (parsed.hostname.includes("amazon.") && !parsed.searchParams.has("tag")) {
        parsed.searchParams.set("tag", tag);
        return parsed.toString();
      }
      return link.url;
    } catch {
      return link.url;
    }
  }

  // 2. Search query provided (most reliable: never 404s, shows live available stock)
  if (link.search && link.search.trim().length > 0) {
    const params = new URLSearchParams({ k: link.search.trim(), tag });
    return `https://www.${domain}/s?${params.toString()}`;
  }

  // 3. ASIN provided
  if (link.asin && link.asin.trim().length > 0) {
    return `https://www.${domain}/dp/${link.asin.trim()}?tag=${tag}`;
  }

  // 4. Fallback to product title search so link never breaks
  const fallbackQuery = link.title ? link.title.replace(/[\(\)—–]/g, " ").trim() : "travel accessories";
  const params = new URLSearchParams({ k: fallbackQuery, tag });
  return `https://www.${domain}/s?${params.toString()}`;
}
---

{activeLinks && activeLinks.length > 0 && (
  <section class="amazon-affiliate-box mb-10 no-print" aria-label="Recommended products for this trip">
    <!-- Section Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="flex-shrink-0 w-7 h-7 rounded-sm bg-[#FF9900]/10 border border-[#FF9900]/30 flex items-center justify-center">
        <!-- Amazon-style shopping bag icon -->
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c47800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>
      <h3 class="text-base font-semibold tracking-[-0.4px] text-ink">
        {heading}
      </h3>
    </div>

    <!-- Product Cards Grid -->
    <div class={`grid gap-3 ${activeLinks.length === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
      {activeLinks.map((link) => {
        const href = buildUrl(link);
        return (
          <a
            href={href}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="affiliate-product-card group flex items-start gap-3.5 p-4 rounded-md bg-canvas border border-hairline hover:border-[#FF9900]/50 hover:shadow-md transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF9900] focus-visible:ring-offset-2"
            aria-label={`View ${link.title} on Amazon`}
          >
            <!-- Amazon logo mark -->
            <div class="flex-shrink-0 w-9 h-9 rounded-sm bg-[#FF9900]/8 border border-[#FF9900]/20 flex items-center justify-center group-hover:bg-[#FF9900]/15 transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <!-- Simplified Amazon 'a' with smile arrow -->
                <text x="4" y="17" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#c47800">a</text>
                <path d="M5 19.5 Q12 22.5 19 19.5" stroke="#c47800" stroke-width="1.8" stroke-linecap="round" fill="none"/>
                <path d="M17.5 18 L19 19.5 L17.5 21" stroke="#c47800" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>

            <!-- Product info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2 mb-1">
                <span class="text-sm font-medium text-ink leading-snug group-hover:text-[#c47800] transition-colors line-clamp-2">
                  {link.title}
                </span>
                {link.badge && (
                  <span class="flex-shrink-0 inline-block text-[10px] font-mono font-semibold px-1.5 py-0.5 rounded-xs bg-[#FF9900]/12 border border-[#FF9900]/30 text-[#a06400] uppercase tracking-wide whitespace-nowrap">
                    {link.badge}
                  </span>
                )}
              </div>
              <p class="text-xs text-body leading-[1.5] line-clamp-2 mb-2">
                {link.why}
              </p>
              <span class="inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-[#c47800] group-hover:underline">
                View on Amazon
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- FTC / Amazon Associates Disclosure (required by Amazon Terms of Service) -->
    <p class="mt-3 text-[11px] text-mute leading-relaxed font-mono">
      <svg class="inline w-3 h-3 mr-0.5 -mt-0.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      </svg>
      As an Amazon Associate, BringOnPlane earns from qualifying purchases. Prices and availability may vary.
    </p>
  </section>
)}
