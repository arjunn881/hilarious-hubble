---
import { Plane } from "@lucide/astro";
import InstagramIcon from "./InstagramIcon.astro";
import { CATEGORIES, POPULAR_AIRLINES, GUIDES } from "../lib/relatedEngine";

const topCategories = CATEGORIES.slice(0, 5);
const topAirlines = POPULAR_AIRLINES.slice(0, 5);
const topGuides = GUIDES.slice(0, 5);
---

<footer class="w-full bg-slate-100/90 dark:bg-[#070b12] border-t border-slate-200 dark:border-slate-800/80 text-slate-600 dark:text-slate-400 py-16 px-4 sm:px-6 mt-auto transition-colors">
  <div class="max-w-[1200px] mx-auto">

    <!-- Main grid -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">

      <!-- Col 1: Brand -->
      <div id="about" class="col-span-2 md:col-span-1 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
          <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-blue-600 text-white shadow-xs">
            <Plane class="w-4 h-4 rotate-45" aria-hidden="true" />
          </div>
          <span class="font-sans font-bold tracking-tight text-base text-slate-900 dark:text-white">BringOnPlane</span>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-[220px] leading-[1.7]">
          TSA baggage rules checker &amp; flight safety directory for worldwide travelers.
        </p>
        <div class="flex items-center gap-2 pt-1">
          <a
            href="https://www.instagram.com/bringonplane/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-300 hover:text-pink-600 dark:hover:text-pink-300 transition-all text-xs group shadow-xs"
            aria-label="Follow BringOnPlane on Instagram"
          >
            <InstagramIcon class="w-3.5 h-3.5 text-pink-500 group-hover:scale-110 transition-transform" />
            <span class="font-mono text-[11px]">@bringonplane</span>
          </a>
        </div>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 font-mono">
          &copy; {new Date().getFullYear()} BringOnPlane
        </p>
      </div>

      <!-- Col 2: Tools -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">Tools</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">TSA Item Search</a></li>
          <li><a href="/checklist/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Packing Assistant</a></li>
          <li><a href="/faq/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">FAQ Guide</a></li>
          <li><a href="/guides/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Travel Guides</a></li>
          <li><a href="/items/page/1/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">All Items A–Z</a></li>
        </ul>
      </div>

      <!-- Col 3: Official Sources -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">Official Sources</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href="https://www.tsa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              TSA.gov ↗
            </a>
          </li>
          <li>
            <a href="https://www.tsa.gov/travel/security-screening/whatcanibring/all" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              What Can I Bring? ↗
            </a>
          </li>
          <li>
            <a href="https://www.faa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              FAA.gov ↗
            </a>
          </li>
          <li>
            <a href="https://www.cbp.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              CBP.gov ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Company -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">Company</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/about/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">About Us</a></li>
          <li><a href="/contact/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Contact Us</a></li>
          <li><a href="/airlines/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Airline Rules</a></li>
          <li><a href="/countries/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Country Customs</a></li>
          <li>
            <a
              href="https://www.instagram.com/bringonplane/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-pink-600 dark:hover:text-pink-400 transition-colors focus-visible:underline inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400"
            >
              <InstagramIcon class="w-3.5 h-3.5 text-pink-500" />
              Instagram ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 5: Legal -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">Legal</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/disclaimer/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Disclaimer</a></li>
          <li><a href="/privacy-policy/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">Terms &amp; Conditions</a></li>
          <li>
            <a href="mailto:legal@bringonplane.com" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">
              legal@bringonplane.com
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- SEO Internal Linking Hubs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 py-8 border-t border-slate-200 dark:border-slate-800/80 mb-8">
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">Top Categories</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topCategories.map(c => (
            <li><a href={`/category/${c.slug}/`} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">Top Airlines</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topAirlines.map(a => (
            <li><a href="/airlines/" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{a.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">Popular Guides</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topGuides.map(g => (
            <li><a href={`/guide/${g.slug}/`} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline line-clamp-1">{g.title}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/90 px-5 py-4 mb-8 shadow-xs">
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-[1.7] max-w-[900px]">
        <strong class="text-slate-900 dark:text-slate-200">Disclaimer:</strong> BringOnPlane is an independent informational tool, not affiliated with the TSA, FAA, or any airline. Information is sourced from official publications and updated regularly, but rules change frequently. TSA officers have final authority at all checkpoints. Always verify with <a href="https://www.tsa.gov" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">TSA.gov</a> and your airline before travel. <a href="/disclaimer/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Read our full disclaimer &rarr;</a>
      </p>
    </div>

    <!-- Bottom strip -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
      <div class="flex items-center gap-3 flex-wrap justify-center md:justify-start">
        <a href="/about/" class="hover:text-slate-900 dark:hover:text-white transition-colors">About Us</a>
        <span>&bull;</span>
        <a href="/contact/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact Us</a>
        <span>&bull;</span>
        <a href="/faq/" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ Guide</a>
        <span>&bull;</span>
        <a href="/privacy-policy/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy Policy</a>
        <span>&bull;</span>
        <a href="/terms/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms &amp; Conditions</a>
        <span>&bull;</span>
        <a href="/disclaimer/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Disclaimer</a>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span>TSA feeds operational</span>
        </div>
        <span>&bull;</span>
        <span>English (US)</span>
      </div>
    </div>
  </div>
</footer>
