---
import { Plane } from "@lucide/astro";
import InstagramIcon from "./InstagramIcon.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { CATEGORIES, POPULAR_AIRLINES, GUIDES } from "../lib/relatedEngine";
import { getLangFromUrl, isEnglishOnlyPath, useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import { localizeCategories } from "../i18n/categories";

interface Props {
  lang?: Lang;
}

const { lang: langProp } = Astro.props;

const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const englishOnly = isEnglishOnlyPath(Astro.url.pathname);

/** Category slugs are part of the canonical URL — only the label is localized. */
const topCategories = localizeCategories(CATEGORIES.slice(0, 5), lang);
const topAirlines = POPULAR_AIRLINES.slice(0, 5);
const topGuides = GUIDES.slice(0, 5);
---

<footer class="w-full bg-slate-100/90 dark:bg-[#070b12] border-t border-slate-200 dark:border-slate-800/80 text-slate-600 dark:text-slate-400 py-16 px-4 sm:px-6 mt-auto transition-colors">
  <div class="max-w-[1200px] mx-auto">

    <!-- Main grid -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">

      <!-- Col 1: Brand -->
      <div id="about" class="col-span-2 md:col-span-1 flex flex-col gap-4">
        <a href={translatePath("/")} class="flex items-center gap-2 hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm">
          <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-blue-600 text-white shadow-xs">
            <Plane class="w-4 h-4 rotate-45" aria-hidden="true" />
          </div>
          <span class="font-sans font-bold tracking-tight text-base text-slate-900 dark:text-white notranslate">BringOnPlane</span>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-[220px] leading-[1.7]">
          {t("site.blurb")}
        </p>
        <div class="flex items-center gap-2 pt-1">
          <a
            href="https://www.instagram.com/bringonplane/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-300 hover:text-pink-600 dark:hover:text-pink-300 transition-all text-xs group shadow-xs"
            aria-label={t("footer.followInstagram")}
          >
            <InstagramIcon class="w-3.5 h-3.5 text-pink-500 group-hover:scale-110 transition-transform" />
            <span class="font-mono text-[11px]">@bringonplane</span>
          </a>
        </div>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 font-mono">
          &copy; {new Date().getFullYear()} BringOnPlane
        </p>
      </div>

      <!-- Col 2: Tools -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">{t("footer.tools")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href={translatePath("/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.tsaItemSearch")}</a></li>
          <li><a href={translatePath("/checklist/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.packingAssistant")}</a></li>
          <li><a href={translatePath("/faq/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.faqGuide")}</a></li>
          <li><a href={translatePath("/guides/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.travelGuides")}</a></li>
          <li><a href={translatePath("/items/page/1/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.allItemsAZ")}</a></li>
        </ul>
      </div>

      <!-- Col 3: Official Sources -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">{t("footer.officialSources")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li>
            <a href="https://www.tsa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              TSA.gov ↗
            </a>
          </li>
          <li>
            <a href="https://www.tsa.gov/travel/security-screening/whatcanibring/all" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              {t("footer.whatCanIBring")} ↗
            </a>
          </li>
          <li>
            <a href="https://www.faa.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              FAA.gov ↗
            </a>
          </li>
          <li>
            <a href="https://www.cbp.gov" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline inline-flex items-center gap-1">
              CBP.gov ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Company -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">{t("footer.company")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href={translatePath("/about/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.aboutUs")}</a></li>
          <li><a href={translatePath("/contact/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.contactUs")}</a></li>
          <li><a href={translatePath("/airlines/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.airlineRules")}</a></li>
          <li><a href={translatePath("/countries/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.countryCustoms")}</a></li>
          <li>
            <a
              href="https://www.instagram.com/bringonplane/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-pink-600 dark:hover:text-pink-400 transition-colors focus-visible:underline inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400"
            >
              <InstagramIcon class="w-3.5 h-3.5 text-pink-500" />
              Instagram ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 5: Legal -->
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">{t("footer.legal")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><a href={translatePath("/disclaimer/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.disclaimer")}</a></li>
          <li><a href={translatePath("/privacy-policy/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.privacy")}</a></li>
          <li><a href={translatePath("/terms/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{t("footer.terms")}</a></li>
          <li>
            <a href="mailto:legal@bringonplane.com" class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline notranslate">
              legal@bringonplane.com
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- SEO Internal Linking Hubs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 py-8 border-t border-slate-200 dark:border-slate-800/80 mb-8">
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">{t("footer.topCategories")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topCategories.map(c => (
            <li><a href={translatePath(`/category/${c.slug}/`)} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline">{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">{t("footer.topAirlines")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topAirlines.map(a => (
            <li><a href={translatePath("/airlines/")} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline notranslate">{a.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 block">{t("footer.popularGuides")}</span>
        <ul class="flex flex-col gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {topGuides.map(g => (
            <li><a href={translatePath(`/guide/${g.slug}/`)} class="hover:text-blue-600 dark:hover:text-white transition-colors focus-visible:underline line-clamp-1">{g.title}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/90 px-5 py-4 mb-8 shadow-xs">
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-[1.7] max-w-[900px]">
        <strong class="text-slate-900 dark:text-slate-200">{t("footer.disclaimerLabel")}</strong> {t("footer.disclaimerBody")} <a href="https://www.tsa.gov" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline font-medium notranslate">TSA.gov</a> {t("footer.disclaimerBodyEnd")} <a href={translatePath("/disclaimer/")} class="text-blue-600 dark:text-blue-400 hover:underline font-medium">{t("footer.readFullDisclaimer")}</a>
      </p>
    </div>

    <!-- Bottom strip -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
      <div class="flex items-center gap-3 flex-wrap justify-center md:justify-start">
        <a href={translatePath("/about/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.aboutUs")}</a>
        <span>&bull;</span>
        <a href={translatePath("/contact/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.contactUs")}</a>
        <span>&bull;</span>
        <a href={translatePath("/faq/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.faqGuide")}</a>
        <span>&bull;</span>
        <a href={translatePath("/privacy-policy/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.privacy")}</a>
        <span>&bull;</span>
        <a href={translatePath("/terms/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.terms")}</a>
        <span>&bull;</span>
        <a href={translatePath("/disclaimer/")} class="hover:text-slate-900 dark:hover:text-white transition-colors">{t("footer.disclaimer")}</a>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          <span>{t("footer.feedsOperational")}</span>
        </div>
        {!englishOnly && (
          <>
            <span>&bull;</span>
            <LanguagePicker lang={lang} variant="compact" />
          </>
        )}
      </div>
    </div>
  </div>
</footer>
