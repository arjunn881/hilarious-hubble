---
import { Plane, Sun, Moon, Menu, X, Search, ChevronRight } from "@lucide/astro";
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import { getCategoryName } from "../i18n/categories";
import metadata from "../data/metadata-summary.json";

interface Props {
  transparent?: boolean;
  lang?: Lang;
}

const { transparent = false, lang: langProp } = Astro.props;

const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

/** Rounded down to the nearest ten so the copy survives new item additions. */
const itemCount = Math.floor((metadata as unknown[]).length / 10) * 10;

const navLinks = [
  { label: t("nav.home"), href: translatePath("/") },
  { label: t("nav.searchItems"), href: translatePath("/items/page/1/") },
  { label: t("nav.packingAssistant"), href: translatePath("/checklist/") },
  { label: t("nav.travelGuides"), href: translatePath("/guides/") },
  { label: t("nav.faq"), href: translatePath("/faq/") },
  { label: t("nav.about"), href: translatePath("/about/") },
  { label: t("nav.contact"), href: translatePath("/contact/") },
];

/** Category slugs stay English — they are part of the canonical URL. */
const barCategories = [
  "electronics",
  "liquids",
  "medicine",
  "tools",
  "food",
  "personal-care",
  "sports",
  "jewelry",
].map((slug) => ({
  name: getCategoryName(slug, lang),
  href: translatePath(`/category/${slug}/`),
}));

const mobileCategories = [
  "liquids",
  "electronics",
  "food",
  "medicine",
  "tools",
  "personal-care",
].map((slug) => ({
  name: getCategoryName(slug, lang),
  href: translatePath(`/category/${slug}/`),
}));

const policyLinks = [
  { label: t("footer.aboutUs"), href: translatePath("/about/") },
  { label: t("footer.contactUs"), href: translatePath("/contact/") },
  { label: t("footer.faqGuide"), href: translatePath("/faq/") },
  { label: t("footer.privacy"), href: translatePath("/privacy-policy/") },
  { label: t("footer.terms"), href: translatePath("/terms/") },
  { label: t("footer.disclaimer"), href: translatePath("/disclaimer/") },
];
---

<header
  class={`sticky top-0 z-50 w-full transition-all max-w-full ${transparent ? 'bg-gradient-to-b from-slate-950/80 via-sky-950/50 to-slate-900/30 dark:from-[#060a14]/90 dark:via-[#090e1a]/70 dark:to-transparent backdrop-blur-xl border-b border-white/15 dark:border-white/10 text-white shadow-sm' : 'bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white shadow-xs dark:shadow-md'}`}
>
  <!-- Top Bar -->
  <div
    class="max-w-[1200px] h-16 mx-auto px-3 sm:px-6 flex items-center justify-between gap-2 sm:gap-4 relative"
  >
    <!-- Brand Logo -->
    <a
      href={translatePath("/")}
      class="flex items-center gap-2.5 hover:opacity-95 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xl flex-shrink-0 min-w-0 group"
      aria-label={t("a11y.homeLink")}
    >
      <div
        class="flex items-center justify-center w-9 h-9 rounded-xl bg-blue-600 group-hover:bg-blue-500 text-white shadow-sm shadow-blue-500/20 flex-shrink-0 transition-transform group-hover:scale-105"
      >
        <Plane
          class="w-5 h-5 rotate-45 transition-transform group-hover:rotate-90 duration-300"
          aria-hidden="true"
        />
      </div>
      <div class="flex flex-col min-w-0">
        <span
          class={`font-sans font-extrabold tracking-tight text-sm sm:text-base leading-tight truncate notranslate ${transparent ? 'text-white drop-shadow-xs' : 'text-slate-900 dark:text-white'}`}
        >
          BringOnPlane
        </span>
        <span
          class={`font-mono text-[9px] uppercase tracking-wider font-semibold hidden sm:block ${transparent ? 'text-sky-300 font-bold drop-shadow-xs' : 'text-blue-600 dark:text-blue-400'}`}
        >
          {t("site.tagline")}
        </span>
      </div>
    </a>

    <!-- Nav Links (desktop only) -->
    <nav
      class="hidden xl:flex items-center gap-1 flex-1 justify-center"
      aria-label={t("a11y.mainNav")}
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all focus-visible:outline-none focus-visible:ring-2 whitespace-nowrap ${transparent ? 'text-white/90 hover:text-white hover:bg-white/15 font-bold drop-shadow-xs focus-visible:ring-blue-400' : 'text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/80 focus-visible:ring-blue-500'}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side actions -->
    <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
      <!-- Search CTA -->
      <button
        type="button"
        data-open-search
        class="inline-flex items-center justify-center gap-1.5 px-3 h-9 text-xs font-mono font-semibold text-white bg-blue-600 hover:bg-blue-500 active:bg-blue-700 rounded-xl transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 cursor-pointer shadow-xs"
        aria-label={t("a11y.searchItems")}
      >
        <Search class="w-3.5 h-3.5" aria-hidden="true" />
        <span class="hidden sm:inline">{t("search.cta")}</span>
        <kbd
          class="hidden md:inline-block px-1.5 py-0.2 text-[9px] bg-blue-800/80 rounded border border-blue-400/40 text-blue-200 font-mono"
          >Ctrl K</kbd
        >
      </button>

      <!-- Language switcher (desktop) -->
      <LanguagePicker lang={lang} transparent={transparent} class="hidden md:block" />

      <!-- Dark mode toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class={`inline-flex items-center justify-center w-9 h-9 rounded-xl transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 select-none flex-shrink-0 ${transparent ? 'text-white hover:bg-white/20 border border-white/20 dark:border-white/15' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/90 dark:border-slate-800'}`}
        aria-label={t("a11y.toggleDarkMode")}
      >
        <Sun class="w-4 h-4 hidden dark:block text-amber-400" />
        <Moon class={`w-4 h-4 block dark:hidden ${transparent ? 'text-white' : 'text-slate-600'}`} />
      </button>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class={`xl:hidden inline-flex items-center justify-center w-9 h-9 rounded-xl transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 flex-shrink-0 ${transparent ? 'text-white hover:text-white bg-white/15 hover:bg-white/25 border border-white/20' : 'text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white bg-slate-100/90 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700'}`}
        aria-label={t("a11y.openMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="w-5 h-5 block" id="hamburger-icon" />
        <X class="w-5 h-5 hidden" id="close-icon" />
      </button>
    </div>
  </div>

  <!-- Secondary Category Navigation Bar (Desktop/Tablet) -->
  <div
    class={`hidden md:block py-1.5 px-4 text-xs font-mono max-w-full overflow-hidden ${transparent ? 'bg-gradient-to-r from-slate-950/60 via-sky-950/40 to-slate-950/60 border-t border-white/10 backdrop-blur-md' : 'bg-slate-50/95 dark:bg-slate-950/90 border-t border-slate-200 dark:border-slate-800/80'}`}
  >
    <div
      class="max-w-[1200px] mx-auto flex items-center justify-between gap-4 overflow-x-auto no-scrollbar"
    >
      <span
        class={`text-[10px] uppercase tracking-wider font-semibold whitespace-nowrap flex-shrink-0 ${transparent ? 'text-sky-200 font-bold drop-shadow-xs' : 'text-slate-500 dark:text-slate-400'}`}
      >
        {t("nav.categories")}:
      </span>
      <div class="flex items-center gap-3 overflow-x-auto whitespace-nowrap">
        {
          barCategories.map((cat) => (
            <a
              href={cat.href}
              class={`transition-colors text-[11px] ${transparent ? 'text-white/85 hover:text-white font-medium drop-shadow-xs' : 'text-slate-600 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400'}`}
            >
              {cat.name}
            </a>
          ))
        }
      </div>
      <a
        href={translatePath("/items/page/1/")}
        class={`text-[10px] uppercase font-bold flex-shrink-0 ${transparent ? 'text-sky-300 hover:text-white drop-shadow-xs' : 'text-blue-600 dark:text-blue-400 hover:underline'}`}
      >
        {t("nav.viewAllItems", { count: itemCount })} &rarr;
      </a>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay Scrim -->
  <div
    id="mobile-menu-backdrop"
    class="xl:hidden hidden fixed inset-0 top-16 bg-slate-950/60 backdrop-blur-xs z-40 transition-opacity duration-200"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu Drawer (Fixed overlay with full viewport height & scroll) -->
  <div
    id="mobile-menu"
    class="xl:hidden hidden fixed inset-x-0 top-16 h-[calc(100dvh-4rem)] bg-white/98 dark:bg-slate-950/98 backdrop-blur-xl border-t border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white shadow-2xl z-50 overflow-y-auto transition-all"
    role="dialog"
    aria-label={t("a11y.mobileNav")}
  >
    <div class="max-w-[600px] mx-auto px-4 py-6 flex flex-col gap-5">
      <!-- Quick Search Bar Trigger inside Mobile Menu -->
      <button
        type="button"
        data-open-search
        class="w-full flex items-center gap-3 px-4 h-12 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-600 dark:text-slate-300 text-sm font-medium hover:border-blue-500 transition-all text-left shadow-xs cursor-pointer"
      >
        <Search
          class="w-4 h-4 text-blue-600 dark:text-blue-400 flex-shrink-0"
        />
        <span class="flex-1 truncate">{t("search.mobilePlaceholder")}</span>
        <span
          class="text-xs font-mono bg-blue-600 text-white px-2.5 py-1 rounded-md font-semibold"
          >{t("search.short")}</span
        >
      </button>

      <!-- Language switcher (mobile drawer) -->
      <div class="flex items-center justify-between gap-3 md:hidden">
        <span
          class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold"
        >
          {t("nav.language")}
        </span>
        <LanguagePicker lang={lang} variant="compact" />
      </div>


      <!-- Main Mobile Navigation Links -->
      <nav
        class="flex flex-col gap-1 border-t border-b border-slate-200 dark:border-slate-800/80 py-4"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link flex items-center justify-between px-3.5 py-3 text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-900 rounded-xl transition-all"
            >
              <span>{link.label}</span>
              <ChevronRight class="w-4 h-4 text-slate-400 dark:text-slate-500" />
            </a>
          ))
        }
      </nav>

      <!-- Category Quick Links in Mobile Menu -->
      <div>
        <p
          class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3 px-1 font-semibold"
        >
          {t("nav.topCategories")}
        </p>
        <div class="grid grid-cols-2 gap-2">
          {
            mobileCategories.map((cat) => (
              <a
                href={cat.href}
                class="mobile-nav-link p-2.5 bg-slate-100/80 dark:bg-slate-900/60 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all text-center truncate"
              >
                {cat.name}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Essential Policy & AdSense Required Links in Mobile Menu -->
      <div>
        <p
          class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-3 px-1 font-semibold"
        >
          {t("nav.essentialPolicies")}
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {
            policyLinks.map((link) => (
              <a
                href={link.href}
                class="mobile-nav-link p-2 bg-slate-100 dark:bg-slate-900/80 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 border border-slate-200 dark:border-slate-800 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 transition-all text-center"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Footer Info in Mobile Menu -->
      <div
        class="pt-4 text-center border-t border-slate-200 dark:border-slate-800"
      >
        <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">
          {t("nav.rulesDirectory")}
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    // ── Dark mode toggle ──────────────────────────────────────
    const themeBtn = document.getElementById("theme-toggle-btn");
    if (themeBtn && !themeBtn.dataset.initialized) {
      themeBtn.dataset.initialized = "true";
      themeBtn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", !isDark);
        localStorage.setItem("theme", isDark ? "light" : "dark");
      });
    }

    // ── Mobile menu toggle ────────────────────────────────────
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileBackdrop = document.getElementById("mobile-menu-backdrop");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (menuBtn && !menuBtn.dataset.initialized) {
      menuBtn.dataset.initialized = "true";

      function toggleMenu(open: boolean) {
        if (open) {
          mobileMenu?.classList.remove("hidden");
          mobileBackdrop?.classList.remove("hidden");
          menuBtn?.setAttribute("aria-expanded", "true");
          hamburgerIcon?.classList.add("hidden");
          hamburgerIcon?.classList.remove("block");
          closeIcon?.classList.remove("hidden");
          closeIcon?.classList.add("block");
          document.body.style.overflow = "hidden";
        } else {
          mobileMenu?.classList.add("hidden");
          mobileBackdrop?.classList.add("hidden");
          menuBtn?.setAttribute("aria-expanded", "false");
          hamburgerIcon?.classList.remove("hidden");
          hamburgerIcon?.classList.add("block");
          closeIcon?.classList.add("hidden");
          closeIcon?.classList.remove("block");
          document.body.style.overflow = "";
        }
      }

      menuBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
        toggleMenu(!isOpen);
      });

      mobileBackdrop?.addEventListener("click", () => {
        toggleMenu(false);
      });

      // Close mobile menu when any nav link inside is clicked
      document.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

      // Close mobile menu on Escape key
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          menuBtn.getAttribute("aria-expanded") === "true"
        ) {
          toggleMenu(false);
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener("astro:after-swap", setupHeader);
</script>
