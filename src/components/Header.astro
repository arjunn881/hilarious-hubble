---
import { Plane, Sun, Moon, Menu, X } from "@lucide/astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Search Items", href: "/items", isSearch: false },
  { label: "Packing Assistant", href: "/checklist" },
  { label: "Categories", href: "/#categories" },
  { label: "Travel Guides", href: "/guides" },
  { label: "FAQ", href: "/faq" },
  { label: "About", href: "/about" },
];
---

<header class="sticky top-0 z-40 w-full bg-[#0f172a] border-b border-slate-800 text-white shadow-md">
  <!-- Top Bar -->
  <div class="max-w-[1200px] h-16 mx-auto px-4 md:px-6 flex items-center justify-between gap-4">

    <!-- Brand Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm flex-shrink-0"
      aria-label="Bring On Plane Home"
    >
      <div class="flex items-center justify-center w-8 h-8 rounded-sm bg-blue-600 text-white shadow-sm">
        <Plane class="w-4.5 h-4.5 rotate-45" aria-hidden="true" />
      </div>
      <div class="flex flex-col">
        <span class="font-sans font-bold tracking-tight text-base text-white leading-tight">
          BringOnPlane
        </span>
        <span class="font-mono text-[9px] uppercase tracking-wider text-blue-400 font-medium">
          TSA Baggage Directory
        </span>
      </div>
    </a>

    <!-- Nav Links (desktop only) -->
    <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center" aria-label="Main Navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/80 rounded-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side actions -->
    <div class="flex items-center gap-2.5 flex-shrink-0">
      <!-- Search CTA -->
      <button
        type="button"
        data-open-search
        class="inline-flex items-center justify-center gap-1.5 px-3 h-8 text-xs font-mono font-medium text-white bg-blue-600 hover:bg-blue-700 border border-blue-500/50 rounded-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 cursor-pointer shadow-sm"
        aria-label="Search TSA items"
      >
        <span class="hidden sm:inline">Search Items</span>
        <span class="sm:hidden">Search</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.2 text-[9px] bg-blue-800/80 rounded border border-blue-400/40 text-blue-200">Ctrl K</kbd>
      </button>

      <!-- Dark mode toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="inline-flex items-center justify-center w-8 h-8 rounded-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 select-none"
        aria-label="Toggle dark mode"
      >
        <Sun class="w-4 h-4 hidden dark:block text-amber-400" />
        <Moon class="w-4 h-4 block dark:hidden text-slate-300" />
      </button>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden inline-flex items-center justify-center w-8 h-8 rounded-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="w-4 h-4 block" id="hamburger-icon" />
        <X class="w-4 h-4 hidden" id="close-icon" />
      </button>
    </div>
  </div>

  <!-- Secondary Category Navigation Bar -->
  <div class="hidden md:block bg-[#090d16] border-t border-slate-800/80 py-1.5 px-4 text-xs font-mono">
    <div class="max-w-[1200px] mx-auto flex items-center justify-between gap-4 overflow-x-auto no-scrollbar">
      <span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold whitespace-nowrap flex-shrink-0">
        CATEGORIES:
      </span>
      <div class="flex items-center gap-3 overflow-x-auto whitespace-nowrap">
        {[
          { name: "Electronics", href: "/category/electronics" },
          { name: "Liquids", href: "/category/liquids" },
          { name: "Medicine", href: "/category/medicine" },
          { name: "Tools", href: "/category/tools" },
          { name: "Food", href: "/category/food" },
          { name: "Personal Care", href: "/category/personal-care" },
          { name: "Sports", href: "/category/sports" },
          { name: "Jewelry", href: "/category/jewelry" },
        ].map(cat => (
          <a href={cat.href} class="text-slate-400 hover:text-blue-400 transition-colors text-[11px]">
            {cat.name}
          </a>
        ))}
      </div>
      <a href="/items" class="text-blue-400 hover:underline text-[10px] uppercase font-bold flex-shrink-0">
        View All 170+ Items &rarr;
      </a>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute top-16 left-0 right-0 bg-canvas border-b border-hairline shadow-lg z-50"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <nav class="max-w-[1200px] mx-auto px-4 py-4 flex flex-col gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="mobile-nav-link flex items-center px-3 py-2.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft rounded-md transition-all"
        >
          {link.label}
        </a>
      ))}
      <div class="border-t border-hairline my-2 pt-2 flex flex-col gap-1">
        <a href="/contact" class="flex items-center px-3 py-2.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft rounded-md transition-all">Contact</a>
        <a href="/about" class="flex items-center px-3 py-2.5 text-sm font-medium text-body hover:text-ink hover:bg-canvas-soft rounded-md transition-all">About Us</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    // ── Dark mode toggle ──────────────────────────────────────
    const themeBtn = document.getElementById("theme-toggle-btn");
    if (themeBtn) {
      themeBtn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", !isDark);
        localStorage.setItem("theme", isDark ? "light" : "dark");
      });
    }

    // ── Mobile menu toggle ────────────────────────────────────
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    function toggleMenu(open: boolean) {
      mobileMenu?.classList.toggle("hidden", !open);
      menuBtn?.setAttribute("aria-expanded", String(open));
      hamburgerIcon?.classList.toggle("hidden", open);
      hamburgerIcon?.classList.toggle("block", !open);
      closeIcon?.classList.toggle("hidden", !open);
      closeIcon?.classList.toggle("block", open);
    }

    menuBtn?.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      toggleMenu(!isOpen);
    });

    // Close mobile menu when a link is clicked
    document.querySelectorAll(".mobile-nav-link").forEach(link => {
      link.addEventListener("click", () => toggleMenu(false));
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (
        mobileMenu &&
        !mobileMenu.contains(e.target as Node) &&
        !menuBtn?.contains(e.target as Node) &&
        !mobileMenu.classList.contains("hidden")
      ) {
        toggleMenu(false);
      }
    });
  }

  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
