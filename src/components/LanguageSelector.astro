---

<div class={`relative language-selector-wrapper notranslate ${isMobileDrawer ? 'w-full' : ''}`}>
  <!-- Trigger Button -->
  <button
    type="button"
    class="lang-dropdown-trigger inline-flex items-center justify-between gap-1.5 px-2.5 h-8 text-xs font-mono font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 cursor-pointer select-none shadow-sm"
    aria-label="Select Language"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <div class="flex items-center gap-1.5 pointer-events-none">
      <Globe class="w-3.5 h-3.5 text-blue-400" aria-hidden="true" />
      <span class="current-lang-code uppercase font-semibold text-white">EN</span>
    </div>
    <ChevronDown class="w-3 h-3 text-slate-400 transition-transform duration-200 pointer-events-none lang-chevron-icon" />
  </button>

  <!-- Dropdown Modal & Panel -->
  <div
    class="lang-dropdown-panel hidden absolute right-0 top-full mt-2 w-80 sm:w-96 max-h-[460px] bg-slate-900/98 backdrop-blur-xl border border-slate-700 rounded-xl shadow-2xl z-[9999] flex-col overflow-hidden text-slate-200"
    role="dialog"
    aria-modal="true"
  >
    <!-- Header with Search -->
    <div class="p-3 border-b border-slate-800 bg-slate-950/80">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold flex items-center gap-1.5">
          <Globe class="w-3.5 h-3.5 text-blue-400" />
          Choose Language
        </span>
        <button
          type="button"
          class="lang-close-btn text-slate-400 hover:text-white p-1 rounded-md hover:bg-slate-800 transition-colors cursor-pointer"
          aria-label="Close language selector"
        >
          <X class="w-4 h-4" />
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative">
        <Search class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          placeholder="Search language (e.g. Spanish, 日本語)..."
          class="lang-search-input w-full pl-8 pr-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-xs text-white placeholder-slate-400 focus:outline-none focus:border-blue-500 transition-all"
        />
      </div>
    </div>

    <!-- Quick Popular Languages Pills -->
    <div class="p-2.5 border-b border-slate-800/80 bg-slate-900/50">
      <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-2 font-medium">Popular</p>
      <div class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto no-scrollbar">
        {popularLanguages.map(lang => (
          <button
            type="button"
            data-lang-code={lang.code}
            data-is-rtl={lang.rtl ? 'true' : 'false'}
            class="lang-select-action inline-flex items-center gap-1 px-2.5 py-1 text-xs bg-slate-800 hover:bg-blue-600 hover:text-white border border-slate-700 hover:border-blue-500 rounded-md transition-all cursor-pointer font-sans"
          >
            <span>{lang.flag}</span>
            <span class="font-medium text-[11px]">{lang.native}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Full Categorized Language List -->
    <div class="flex-1 overflow-y-auto p-2 divide-y divide-slate-800/40 lang-list-container max-h-[240px] custom-scrollbar">
      {allLanguages.map(lang => (
        <button
          type="button"
          data-lang-code={lang.code}
          data-lang-name={lang.name.toLowerCase()}
          data-lang-native={lang.native.toLowerCase()}
          data-is-rtl={lang.rtl ? 'true' : 'false'}
          class="lang-select-action lang-option-item w-full flex items-center justify-between px-3 py-2 text-left hover:bg-slate-800 rounded-lg transition-colors cursor-pointer group"
        >
          <div class="flex items-center gap-2.5 pointer-events-none">
            <span class="text-base leading-none">{lang.flag}</span>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white group-hover:text-blue-400 transition-colors">
                {lang.native}
              </span>
              <span class="text-[10px] text-slate-400 font-mono">
                {lang.name}
              </span>
            </div>
          </div>
          <span class="lang-check-icon hidden text-blue-400 pointer-events-none">
            <Check class="w-4 h-4" />
          </span>
        </button>
      ))}
    </div>

    <!-- Footer Notice -->
    <div class="p-2 border-t border-slate-800 bg-slate-950/90 text-center">
      <span class="text-[10px] text-slate-400 font-mono">
        Instant real-time translation powered for all travelers
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const rtlLanguages = ['ar', 'he', 'ur', 'fa', 'ps', 'yi', 'sd'];

    function getDomainVariations() {
      const host = window.location.hostname;
      if (!host || host === 'localhost' || host === '127.0.0.1') {
        return [''];
      }
      const parts = host.split('.');
      const domains = ['', host];
      if (parts.length >= 2) {
        const rootDomain = parts.slice(-2).join('.');
        domains.push('.' + rootDomain);
        domains.push(rootDomain);
      }
      return Array.from(new Set(domains));
    }

    function setCookie(name, value, days) {
      let expires = "";
      if (days > 0) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toUTCString();
      } else if (days < 0) {
        expires = "; expires=Thu, 01 Jan 1970 00:00:00 UTC";
      }

      const domains = getDomainVariations();
      domains.forEach(domain => {
        const domainAttr = domain ? "; domain=" + domain : "";
        document.cookie = name + "=" + (value || "") + expires + "; path=/" + domainAttr + ";";
      });
    }

    function clearGoogleTransCookie() {
      const domains = getDomainVariations();
      domains.forEach(domain => {
        const domainAttr = domain ? "; domain=" + domain : "";
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/" + domainAttr + ";";
      });
    }

    function getCookie(name) {
      const nameEQ = name + "=";
      const ca = document.cookie.split(';');
      for (let i = 0; i < ca.length; i++) {
        let c = ca[i];
        while (c.charAt(0) === ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) === 0) return decodeURIComponent(c.substring(nameEQ.length, c.length));
      }
      return null;
    }

    function getCurrentLanguage() {
      const saved = localStorage.getItem('user_lang');
      if (saved) return saved;
      const cookie = getCookie('googtrans');
      if (cookie) {
        const parts = cookie.split('/');
        if (parts.length >= 3 && parts[parts.length - 1]) return parts[parts.length - 1];
      }
      return 'en';
    }

    function applyRTL(langCode) {
      const isRTL = rtlLanguages.includes(langCode);
      if (isRTL) {
        document.documentElement.setAttribute('dir', 'rtl');
      } else {
        document.documentElement.removeAttribute('dir');
      }
    }

    function updateUI(langCode) {
      const displayCode = (langCode === 'zh-CN' ? 'ZH' : langCode === 'zh-TW' ? 'TW' : langCode || 'en').toUpperCase();
      document.querySelectorAll('.current-lang-code').forEach(el => {
        el.textContent = displayCode;
      });

      document.querySelectorAll('.lang-option-item').forEach(item => {
        const code = item.getAttribute('data-lang-code');
        const check = item.querySelector('.lang-check-icon');
        if (code === langCode) {
          check?.classList.remove('hidden');
          item.classList.add('bg-slate-800/80');
        } else {
          check?.classList.add('hidden');
          item.classList.remove('bg-slate-800/80');
        }
      });

      applyRTL(langCode);
    }

    function triggerGoogleTranslateCombo(langCode) {
      const select = document.querySelector('.goog-te-combo');
      if (!select) return false;

      // Handle language code variations in Google Translate widget
      let targetCode = langCode === 'en' ? '' : langCode;
      if (langCode === 'he') {
        const hasIw = select.querySelector('option[value="iw"]');
        if (hasIw) targetCode = 'iw';
      }

      if (langCode === 'en') {
        select.value = '';
      } else {
        const opt = select.querySelector(`option[value="${targetCode}"]`);
        if (opt) {
          select.value = targetCode;
        } else {
          select.value = langCode;
        }
      }

      if (typeof select.onchange === 'function') {
        select.onchange();
      }
      select.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }

    function setLanguage(langCode) {
      if (langCode === 'en') {
        localStorage.removeItem('user_lang');
        clearGoogleTransCookie();
        updateUI('en');

        const triggered = triggerGoogleTranslateCombo('en');
        // If combo exists, reloading gives cleanest return to pristine original English HTML
        setTimeout(() => {
          window.location.reload();
        }, 150);
      } else {
        localStorage.setItem('user_lang', langCode);
        setCookie('googtrans', '/en/' + langCode, 30);
        updateUI(langCode);

        const triggered = triggerGoogleTranslateCombo(langCode);
        if (!triggered) {
          // Poll for combo element
          let attempts = 0;
          const interval = setInterval(() => {
            attempts++;
            if (triggerGoogleTranslateCombo(langCode) || attempts > 15) {
              clearInterval(interval);
              if (attempts > 15) {
                window.location.reload();
              }
            }
          }, 120);
        }
      }
    }

    function initLanguageSelector() {
      const currentLang = getCurrentLanguage();
      updateUI(currentLang);

      // Sync cookie if user_lang exists in localStorage but cookie was cleared
      if (currentLang && currentLang !== 'en') {
        setCookie('googtrans', '/en/' + currentLang, 30);
        // Attempt to trigger translation once Google Translate script is ready
        let attempts = 0;
        const syncInterval = setInterval(() => {
          attempts++;
          if (triggerGoogleTranslateCombo(currentLang) || attempts > 20) {
            clearInterval(syncInterval);
          }
        }, 150);
      }

      document.querySelectorAll('.language-selector-wrapper').forEach(wrapper => {
        if (wrapper.dataset.initialized === 'true') return;
        wrapper.dataset.initialized = 'true';

        const trigger = wrapper.querySelector('.lang-dropdown-trigger');
        const panel = wrapper.querySelector('.lang-dropdown-panel');
        const chevron = wrapper.querySelector('.lang-chevron-icon');
        const closeBtn = wrapper.querySelector('.lang-close-btn');
        const searchInput = wrapper.querySelector('.lang-search-input');
        const listItems = wrapper.querySelectorAll('.lang-option-item');

        function toggleDropdown(show) {
          const isHidden = panel.classList.contains('hidden');
          const shouldShow = show !== undefined ? show : isHidden;

          if (shouldShow) {
            // Close other open dropdowns first
            document.querySelectorAll('.lang-dropdown-panel').forEach(p => {
              if (p !== panel) {
                p.classList.add('hidden');
                p.classList.remove('flex');
              }
            });
            document.querySelectorAll('.lang-chevron-icon').forEach(c => {
              if (c !== chevron) c.classList.remove('rotate-180');
            });

            panel.classList.remove('hidden');
            panel.classList.add('flex');
            trigger.setAttribute('aria-expanded', 'true');
            chevron?.classList.add('rotate-180');
            setTimeout(() => searchInput?.focus(), 50);
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('flex');
            trigger.setAttribute('aria-expanded', 'false');
            chevron?.classList.remove('rotate-180');
          }
        }

        trigger?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleDropdown();
        });

        closeBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleDropdown(false);
        });

        // Search filtering
        searchInput?.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          listItems.forEach(item => {
            const name = item.getAttribute('data-lang-name') || '';
            const native = item.getAttribute('data-lang-native') || '';
            const code = item.getAttribute('data-lang-code') || '';
            if (name.includes(query) || native.includes(query) || code.includes(query)) {
              item.classList.remove('hidden');
            } else {
              item.classList.add('hidden');
            }
          });
        });

        // Language selection buttons
        wrapper.querySelectorAll('.lang-select-action').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const code = btn.getAttribute('data-lang-code');
            if (code) {
              setLanguage(code);
              toggleDropdown(false);
            }
          });
        });
      });

      // Global click outside listener
      if (!window.__langClickOutsideBound) {
        window.__langClickOutsideBound = true;
        document.addEventListener('click', (e) => {
          document.querySelectorAll('.lang-dropdown-panel').forEach(panel => {
            const trigger = panel.previousElementSibling;
            if (!panel.contains(e.target) && (!trigger || !trigger.contains(e.target))) {
              panel.classList.add('hidden');
              panel.classList.remove('flex');
              const chevron = trigger?.querySelector('.lang-chevron-icon');
              chevron?.classList.remove('rotate-180');
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            document.querySelectorAll('.lang-dropdown-panel').forEach(panel => {
              panel.classList.add('hidden');
              panel.classList.remove('flex');
            });
            document.querySelectorAll('.lang-chevron-icon').forEach(chevron => {
              chevron.classList.remove('rotate-180');
            });
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLanguageSelector);
    } else {
      initLanguageSelector();
    }
    document.addEventListener('astro:after-swap', initLanguageSelector);
  })();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.6);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(51, 65, 85, 0.8);
    border-radius: 4px;
  }
</style>
