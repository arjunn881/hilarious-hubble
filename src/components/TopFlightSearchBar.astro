---
/**
 * TopFlightSearchBar.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Sitewide Kiwi.com Flight Search Form (Mounted on every page via Layout.astro).
 *
 * 1. Primary: Official Travelpayouts Kiwi Flights Search Form:
 *    (promo_id=3414, marker: 778331.BringonPlane, border_radius: 7, button: #0041a9).
 * 2. Pixel-Perfect Native Fallback: Matches the official Travelpayouts Flights
 *    Search Form UI 1:1 (2-row grid, #f2f4f7 inputs, #0041a9 search button,
 *    IATA airport code badge, passenger selector, and hotel checkbox) so that
 *    visitors with client adblockers (which block tpwdg.com) experience the EXACT
 *    same visual design and autocomplete recommendations seamlessly.
 * ─────────────────────────────────────────────────────────────────────────────
 */

import { useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import { POPULAR_AIRPORTS } from "../data/popularAirports";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Localized currency & locale mapping
const currencyMap: Record<string, string> = {
  en: "usd",
  es: "eur",
  fr: "eur",
  de: "eur",
  it: "eur",
  pt: "brl",
  ja: "jpy",
  ko: "krw",
};

const currency = currencyMap[lang] || "usd";
const supportedLocales = ["en", "es", "fr", "de", "it", "pt"];
const locale = supportedLocales.includes(lang) ? lang : "en";

// Official Travelpayouts Kiwi Flights Search Form URL
const widgetSrc = `https://tpwdg.com/content?currency=${currency}&trs=574616&shmarker=778331.BringonPlane&locale=${locale}&stops=any&show_hotels=true&powered_by=true&border_radius=7&plain=true&color_button=%230041a9&color_button_text=%23ffffff&promo_id=3414&campaign_id=111`;
---

<section
  class="no-print w-full bg-slate-100/70 dark:bg-slate-900/40 border-b border-hairline py-3 px-3 sm:px-6 relative z-30 select-none"
  aria-label="Flight Search"
>
  <div class="max-w-[1200px] mx-auto">
    
    {/* ── Official Travelpayouts Kiwi Widget Container ── */}
    <div id="sitewide-tp-widget" class="w-full relative min-h-[90px] overflow-visible">
      <script
        is:inline
        async
        src={widgetSrc}
        charset="utf-8"
        id="sitewide-tpwdg-script"
      ></script>
    </div>

    {/* ── Pixel-Perfect Native Fallback Form (Matches Travelpayouts promo_id 3414 UI 1:1) ── */}
    <div
      id="sitewide-native-fallback-card"
      class="hidden w-full bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-[7px] p-3 sm:p-4 shadow-xs"
    >
      <form id="sitewide-native-flight-form" novalidate>
        
        {/* ── Row 1: Origin & Destination Inputs ── */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
          {/* Origin */}
          <div class="relative flex items-center h-11 bg-slate-100 dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <input
              id="sitewide-origin"
              type="text"
              placeholder="Enter origin city"
              autocomplete="off"
              class="w-full bg-transparent text-sm font-medium text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none pr-10"
            />
            <span
              id="sitewide-origin-iata"
              class="absolute right-3 font-mono text-xs font-bold text-slate-400 dark:text-slate-500 tracking-wider pointer-events-none uppercase"
            ></span>
            {/* Custom Floating Autocomplete Dropdown */}
            <div
              id="sitewide-origin-dropdown"
              class="hidden absolute left-0 right-0 top-[110%] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md shadow-xl max-h-56 overflow-y-auto z-50 divide-y divide-slate-100 dark:divide-slate-800/60"
            ></div>
          </div>

          {/* Destination */}
          <div class="relative flex items-center h-11 bg-slate-100 dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <input
              id="sitewide-dest"
              type="text"
              placeholder="To"
              autocomplete="off"
              class="w-full bg-transparent text-sm font-medium text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none pr-10"
            />
            <span
              id="sitewide-dest-iata"
              class="absolute right-3 font-mono text-xs font-bold text-slate-400 dark:text-slate-500 tracking-wider pointer-events-none uppercase"
            ></span>
            {/* Custom Floating Autocomplete Dropdown */}
            <div
              id="sitewide-dest-dropdown"
              class="hidden absolute left-0 right-0 top-[110%] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md shadow-xl max-h-56 overflow-y-auto z-50 divide-y divide-slate-100 dark:divide-slate-800/60"
            ></div>
          </div>
        </div>

        {/* ── Row 2: Dates, Passengers & Submit Button ── */}
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-center">
          {/* Departure Date */}
          <div class="relative flex items-center h-11 bg-slate-100 dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <input
              id="sitewide-depart-date"
              type="date"
              aria-label="Departure date"
              class="w-full bg-transparent text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer"
            />
            <span class="absolute right-3 text-emerald-600 dark:text-emerald-400 pointer-events-none">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" x2="16" y1="2" y2="6"/>
                <line x1="8" x2="8" y1="2" y2="6"/>
                <line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
            </span>
          </div>

          {/* Return Date */}
          <div class="relative flex items-center h-11 bg-slate-100 dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <input
              id="sitewide-return-date"
              type="date"
              aria-label="Return date"
              class="w-full bg-transparent text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer"
            />
            <span class="absolute right-3 text-emerald-600 dark:text-emerald-400 pointer-events-none">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" x2="16" y1="2" y2="6"/>
                <line x1="8" x2="8" y1="2" y2="6"/>
                <line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
            </span>
          </div>

          {/* Passengers */}
          <div class="relative flex items-center justify-between h-11 bg-slate-100 dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <select
              id="sitewide-passengers"
              aria-label="Number of passengers"
              class="w-full bg-transparent text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer appearance-none pr-6"
            >
              <option value="1">1 passenger</option>
              <option value="2">2 passengers</option>
              <option value="3">3 passengers</option>
              <option value="4">4 passengers</option>
            </select>
            <span class="absolute right-3 text-slate-400 pointer-events-none">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </span>
          </div>

          {/* Search Button (Exact #0041a9 Travelpayouts Color) */}
          <button
            type="submit"
            class="h-11 w-full rounded-[6px] bg-[#0041a9] hover:bg-[#003487] active:bg-[#002766] font-semibold text-white text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-xs"
          >
            <span>Search</span>
          </button>
        </div>

        {/* ── Sub-row: Hotels Checkbox & Attribution ── */}
        <div class="mt-2.5 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <label class="flex items-center gap-1.5 cursor-pointer select-none">
            <input
              id="sitewide-show-hotels"
              type="checkbox"
              checked
              class="w-3.5 h-3.5 text-blue-600 rounded border-slate-300 focus:ring-blue-500"
            />
            <span>Show hotels</span>
          </label>

          <span class="text-[10px] text-slate-400 dark:text-slate-500">
            Powered by <strong class="font-semibold text-slate-600 dark:text-slate-300">travelpayouts</strong>
          </span>
        </div>

      </form>
    </div>

    {/* Shared Datalist for instant autocomplete recommendations */}
    <datalist id="sitewide-airports-list">
      {POPULAR_AIRPORTS.map((apt) => (
        <option value={`${apt.city} (${apt.code})`}>
          {apt.city}, {apt.country} — {apt.name} ({apt.code})
        </option>
      ))}
    </datalist>

    {/* Airport database serialized for instant client-side autocomplete matching Travelpayouts UI 1:1 */}
    <script id="sitewide-airports-json" type="application/json" set:html={JSON.stringify(POPULAR_AIRPORTS)} />

  </div>
</section>

<style is:global>
  tp-cascoon {
    display: block !important;
    width: 100% !important;
    min-height: 80px !important;
  }
</style>

<script is:inline>
  (function () {
    var nativeCard = document.getElementById("sitewide-native-fallback-card");
    var nativeForm = document.getElementById("sitewide-native-flight-form");
    var tpContainer = document.getElementById("sitewide-tp-widget");
    var tpScript = document.getElementById("sitewide-tpwdg-script");

    var widgetLoaded = false;

    function markWidgetLoaded() {
      widgetLoaded = true;
      if (nativeCard) {
        nativeCard.classList.add("hidden");
        nativeCard.style.display = "none";
      }
    }

    function checkTpLoaded() {
      var cascoon = document.querySelector("tp-cascoon");
      var iframe = tpContainer ? tpContainer.querySelector("iframe") : null;
      if (
        (cascoon && cascoon.shadowRoot && cascoon.shadowRoot.children.length > 0) ||
        (cascoon && cascoon.children.length > 0) ||
        iframe
      ) {
        markWidgetLoaded();
      }
    }

    // Set today's date as default depart date
    var departInput = document.getElementById("sitewide-depart-date");
    if (departInput && !departInput.value) {
      try {
        var today = new Date().toISOString().split("T")[0];
        departInput.min = today;
        departInput.value = today;
      } catch (e) {}
    }

    // ── Interactive Autocomplete matching Travelpayouts Dropdown 1:1 ─────────
    var airports = [];
    try {
      var dataScript = document.getElementById("sitewide-airports-json");
      if (dataScript) airports = JSON.parse(dataScript.textContent || "[]");
    } catch (e) {}

    function setupAutocomplete(inputId, dropdownId, badgeId) {
      var input = document.getElementById(inputId);
      var dropdown = document.getElementById(dropdownId);
      var badge = document.getElementById(badgeId);
      if (!input || !dropdown) return;

      function renderItems(list) {
        if (!list || list.length === 0) {
          dropdown.classList.add("hidden");
          return;
        }
        var html = list.slice(0, 6).map(function (apt) {
          return (
            '<div class="px-3.5 py-2 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800/80 flex items-center justify-between text-left transition-colors" data-city="' +
            apt.city +
            '" data-code="' +
            apt.code +
            '">' +
            '<div>' +
            '<div class="text-xs font-semibold text-slate-800 dark:text-slate-100">' +
            apt.city +
            '</div>' +
            '<div class="text-[11px] text-slate-400 dark:text-slate-500">' +
            apt.name +
            ', ' +
            apt.country +
            '</div>' +
            '</div>' +
            '<span class="font-mono text-xs font-bold text-slate-400 dark:text-slate-500 tracking-wider uppercase">' +
            apt.code +
            '</span>' +
            '</div>'
          );
        }).join("");

        dropdown.innerHTML = html;
        dropdown.classList.remove("hidden");
      }

      function filterAirports(query) {
        var q = (query || "").trim().toLowerCase();
        if (!q) {
          // Top popular airport defaults
          return airports.filter(function (a) {
            return ["BOM", "DEL", "BBI", "LHR", "JFK", "DXB"].indexOf(a.code) !== -1;
          });
        }
        return airports.filter(function (a) {
          return (
            a.city.toLowerCase().indexOf(q) !== -1 ||
            a.code.toLowerCase().indexOf(q) !== -1 ||
            a.name.toLowerCase().indexOf(q) !== -1 ||
            a.country.toLowerCase().indexOf(q) !== -1
          );
        });
      }

      input.addEventListener("input", function () {
        var val = input.value || "";
        var match = val.match(/\(([A-Z]{3})\)/);
        if (match && badge) {
          badge.textContent = match[1];
        } else if (val.trim().length === 3 && /^[A-Za-z]{3}$/.test(val.trim()) && badge) {
          badge.textContent = val.trim().toUpperCase();
        }

        renderItems(filterAirports(val));
      });

      input.addEventListener("focus", function () {
        renderItems(filterAirports(input.value));
      });

      dropdown.addEventListener("click", function (e) {
        var target = e.target.closest("[data-city]");
        if (target) {
          var city = target.getAttribute("data-city");
          var code = target.getAttribute("data-code");
          input.value = city;
          input.dataset.iata = code;
          if (badge) badge.textContent = code;
          dropdown.classList.add("hidden");
        }
      });

      document.addEventListener("click", function (e) {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.classList.add("hidden");
        }
      });
    }

    setupAutocomplete("sitewide-origin", "sitewide-origin-dropdown", "sitewide-origin-iata");
    setupAutocomplete("sitewide-dest", "sitewide-dest-dropdown", "sitewide-dest-iata");

    // AdBlock error listener
    if (tpScript) {
      tpScript.addEventListener("error", function () {
        if (!widgetLoaded && nativeCard) {
          nativeCard.classList.remove("hidden");
          nativeCard.style.display = "block";
        }
      });
      tpScript.addEventListener("load", function () {
        setTimeout(checkTpLoaded, 300);
        setTimeout(checkTpLoaded, 1000);
      });
    }

    // Fallback timeout for client-side adblockers
    setTimeout(function () {
      checkTpLoaded();
      if (!widgetLoaded && nativeCard) {
        nativeCard.classList.remove("hidden");
        nativeCard.style.display = "block";
      }
    }, 2500);

    var observer = new MutationObserver(function () {
      checkTpLoaded();
    });
    if (tpContainer) {
      observer.observe(tpContainer, { childList: true, subtree: true });
    }

    // Form submission (routes to verified Kiwi Travelpayouts affiliate URLs)
    if (nativeForm) {
      nativeForm.addEventListener("submit", function (e) {
        e.preventDefault();

        var originInput = document.getElementById("sitewide-origin");
        var originVal = originInput ? originInput.value.trim() : "";
        var destInput = document.getElementById("sitewide-dest");
        var destVal = destInput ? destInput.value.trim() : "";

        var kiwiGeoMap = {
          "us": "https://kiwi.tpk.lu/PRoNbR8A",
          "gb": "https://kiwi.tpk.lu/zdAwHpk4",
          "uk": "https://kiwi.tpk.lu/zdAwHpk4",
          "in": "https://kiwi.tpk.lu/suZfzffW",
          "cz": "https://kiwi.tpk.lu/4JJAeyYQ",
          "fi": "https://kiwi.tpk.lu/j9t7bFL8",
          "it": "https://kiwi.tpk.lu/3cbh2gXF",
          "dk": "https://kiwi.tpk.lu/k5RXUFYd",
          "da": "https://kiwi.tpk.lu/k5RXUFYd",
          "de": "https://kiwi.tpk.lu/FNBUJmy6",
          "nl": "https://kiwi.tpk.lu/U42dntOs",
          "pl": "https://kiwi.tpk.lu/bIz4CwgC",
          "br": "https://kiwi.tpk.lu/xF6eey3B",
          "es": "https://kiwi.tpk.lu/tBWe6mTP",
          "fr": "https://kiwi.tpk.lu/47KJwXAa"
        };

        var rawLang = (navigator.language || "en").toLowerCase();
        var parts = rawLang.split("-");
        var lang = parts[0];
        var country = parts[1] || "";

        var asiaLangs = ["ko", "ja", "zh", "th", "vi", "ms", "id", "tl"];
        var isEastAsia = asiaLangs.indexOf(lang) !== -1 && country !== "in";

        var region = (country === "us" || country === "ca")
          ? "NA"
          : (country === "in" || isEastAsia)
          ? "ASIA"
          : "EU";

        var subId = region + "_sitewide_search";
        var url;

        if (isEastAsia) {
          url = "https://tp.media/r?marker=778331.BringonPlane&trs=574616&p=5543" +
                "&u=https%3A%2F%2Fwww.trip.com%2Fflight%2F" +
                "&sub_id=" + encodeURIComponent(subId);
        } else {
          var kiwiBase = kiwiGeoMap[country] || kiwiGeoMap[lang];
          if (!kiwiBase) {
            kiwiBase = (destVal || originVal) ? "https://kiwi.tpk.lu/7m9bs2Ap" : "https://kiwi.tpk.lu/PRoNbR8A";
          }
          url = kiwiBase + "?sub_id=" + encodeURIComponent(subId);
          if (originVal && destVal) {
            url += "&search=" + encodeURIComponent(originVal + " to " + destVal);
          } else if (destVal) {
            url += "&search=" + encodeURIComponent(destVal);
          } else if (originVal) {
            url += "&search=" + encodeURIComponent(originVal);
          }
        }

        window.open(url, "_blank", "noopener,noreferrer");
      });
    }
  })();
</script>
