---
/**
 * TopFlightSearchBar.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Sitewide Kiwi.com Flight Search Form (Mounted on every page via Layout.astro).
 *
 * 1. Primary: Official Travelpayouts Kiwi Flights Search Form
 *    (promo_id=3414, marker: 778331.BringonPlane, border_radius: 7, button: #0041a9).
 * 2. Pixel-Perfect Native Fallback: Single-row layout matching the official
 *    Travelpayouts Flights Search Form UI 1:1 — From | To | Departure | Return |
 *    Passengers | Search with IATA badge, full airport autocomplete dropdown,
 *    "Show hotels" checkbox, and "Powered by travelpayouts" attribution.
 *    Activates only when tpwdg.com is blocked by an adblocker.
 * ─────────────────────────────────────────────────────────────────────────────
 */

import { useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import { POPULAR_AIRPORTS } from "../data/popularAirports";

interface Props {
  lang?: Lang;
  embedded?: boolean;
}

const { lang = "en", embedded = false } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Localized currency & locale mapping
const currencyMap: Record<string, string> = {
  en: "usd",
  es: "eur",
  fr: "eur",
  de: "eur",
  it: "eur",
  pt: "brl",
  ja: "jpy",
  ko: "krw",
};

const currency = currencyMap[lang] || "usd";
const supportedLocales = ["en", "es", "fr", "de", "it", "pt"];
const locale = supportedLocales.includes(lang) ? lang : "en";

// Official Travelpayouts Kiwi Flights Search Form URL
const widgetSrc = `https://tpwdg.com/content?currency=${currency}&trs=574616&shmarker=778331.BringonPlane&locale=${locale}&stops=any&show_hotels=true&powered_by=true&border_radius=7&plain=true&color_button=%230041a9&color_button_text=%23ffffff&promo_id=3414&campaign_id=111`;
---

<section
  class={embedded
    ? "no-print w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-3 sm:p-5 shadow-sm relative z-20 mb-8"
    : "no-print w-full bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 py-2.5 px-3 sm:px-6 relative z-30"}
  aria-label="Flight Search"
>
  <div class={embedded ? "w-full" : "max-w-[1200px] mx-auto"}>

    {/* ── Official Travelpayouts Kiwi Widget Container ── */}
    <div id="sitewide-tp-widget" class="w-full relative min-h-[80px] overflow-visible">
      <script
        is:inline
        async
        src={widgetSrc}
        charset="utf-8"
        id="sitewide-tpwdg-script"
      ></script>
    </div>

    {/* ── Pixel-Perfect Native Fallback — matches Travelpayouts promo_id=3414 single-row layout ── */}
    <div
      id="sitewide-native-fallback-card"
      class="hidden w-full"
    >
      {/* Header label — matches "✈ Search Flights (Kiwi.com)" heading on flights page */}
      <div class="flex items-center gap-1.5 mb-1.5 text-[11px] font-semibold text-slate-500 dark:text-slate-400 tracking-wide uppercase select-none">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 2c-2-2-4-2-5.5-.5L10 5 1.8 6.2a1 1 0 0 0-.5 1.7l2.8 2.8-1.9 5.5a1 1 0 0 0 1.4 1.2L8 15.5l2.8 2.8a1 1 0 0 0 1.7-.5z"/></svg>
        Search Flights
        <span class="font-normal normal-case text-slate-400">(Kiwi.com)</span>
      </div>

      <form id="sitewide-native-flight-form" novalidate>

        {/* ── Single row: From | To | Departure | Return | Passengers | Search ── */}
        <div class="flex flex-wrap lg:flex-nowrap items-stretch gap-1.5">

          {/* FROM — City or airport with IATA badge */}
          <div class="relative flex-1 min-w-[140px] flex items-center h-11 bg-[#f2f4f7] dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <div class="flex flex-col flex-1 overflow-hidden">
              <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wide leading-none mb-0.5">Departure</span>
              <input
                id="sitewide-origin"
                type="text"
                placeholder="Departure City or Airport"
                autocomplete="off"
                class="w-full bg-transparent text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none pr-8 truncate"
              />
            </div>
            <span
              id="sitewide-origin-iata"
              class="absolute right-2.5 font-mono text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider pointer-events-none uppercase"
            ></span>
            {/* Autocomplete Dropdown */}
            <div
              id="sitewide-origin-dropdown"
              class="hidden absolute left-0 right-0 top-[calc(100%+4px)] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg shadow-xl max-h-56 overflow-y-auto z-50"
            ></div>
          </div>

          {/* TO — Destination with IATA badge */}
          <div class="relative flex-1 min-w-[140px] flex items-center h-11 bg-[#f2f4f7] dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all">
            <div class="flex flex-col flex-1 overflow-hidden">
              <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wide leading-none mb-0.5">Destination</span>
              <input
                id="sitewide-dest"
                type="text"
                placeholder="Destination City or Airport"
                autocomplete="off"
                class="w-full bg-transparent text-[13px] font-medium text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none pr-8 truncate"
              />
            </div>
            <span
              id="sitewide-dest-iata"
              class="absolute right-2.5 font-mono text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider pointer-events-none uppercase"
            ></span>
            {/* Autocomplete Dropdown */}
            <div
              id="sitewide-dest-dropdown"
              class="hidden absolute left-0 right-0 top-[calc(100%+4px)] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg shadow-xl max-h-56 overflow-y-auto z-50"
            ></div>
          </div>

          {/* DEPARTURE DATE */}
          <div class="relative flex items-center h-11 bg-[#f2f4f7] dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all min-w-[120px]">
            <div class="flex flex-col flex-1">
              <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wide leading-none mb-0.5">Departure</span>
              <input
                id="sitewide-depart-date"
                type="date"
                aria-label="Departure date"
                class="w-full bg-transparent text-[13px] font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer"
              />
            </div>
          </div>

          {/* RETURN DATE */}
          <div class="relative flex items-center h-11 bg-[#f2f4f7] dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all min-w-[110px]">
            <div class="flex flex-col flex-1">
              <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wide leading-none mb-0.5">Return</span>
              <input
                id="sitewide-return-date"
                type="date"
                aria-label="Return date"
                placeholder="No return"
                class="w-full bg-transparent text-[13px] font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer"
              />
            </div>
          </div>

          {/* PASSENGERS */}
          <div class="relative flex items-center h-11 bg-[#f2f4f7] dark:bg-slate-800/90 border border-transparent focus-within:border-blue-600 focus-within:bg-white dark:focus-within:bg-slate-900 rounded-[6px] px-3 transition-all min-w-[110px]">
            <div class="flex flex-col flex-1">
              <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wide leading-none mb-0.5">Passengers</span>
              <select
                id="sitewide-passengers"
                aria-label="Number of passengers"
                class="w-full bg-transparent text-[13px] font-medium text-slate-700 dark:text-slate-200 focus:outline-none cursor-pointer appearance-none pr-4"
              >
                <option value="1">1 passenger</option>
                <option value="2">2 passengers</option>
                <option value="3">3 passengers</option>
                <option value="4">4 passengers</option>
              </select>
            </div>
            <span class="absolute right-2 text-slate-400 pointer-events-none">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </span>
          </div>

          {/* SEARCH BUTTON */}
          <button
            type="submit"
            class="h-11 px-5 rounded-[6px] bg-[#0041a9] hover:bg-[#003487] active:bg-[#002766] font-semibold text-white text-sm flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap shrink-0"
          >
            Search
          </button>

        </div>

        {/* Sub-row: Show hotels checkbox + Powered by */}
        <div class="mt-2 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <label class="flex items-center gap-1.5 cursor-pointer select-none">
            <input
              id="sitewide-show-hotels"
              type="checkbox"
              checked
              class="w-3.5 h-3.5 accent-blue-700 rounded border-slate-300"
            />
            <span>Show hotels</span>
          </label>
          <span class="text-[10px] text-slate-400 dark:text-slate-500">
            Powered by <strong class="font-semibold text-slate-600 dark:text-slate-300">travelpayouts</strong>
          </span>
        </div>

      </form>
    </div>

    {/* Airport database serialized for instant client-side autocomplete */}
    <script id="sitewide-airports-json" type="application/json" set:html={JSON.stringify(POPULAR_AIRPORTS)} />

  </div>
</section>

<style is:global>
  /* Ensure tp-cascoon widget fills the container */
  tp-cascoon,
  tp-widget {
    display: block !important;
    width: 100% !important;
    min-height: 70px !important;
  }
  /* Autocomplete dropdown row */
  #sitewide-origin-dropdown > div,
  #sitewide-dest-dropdown > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    cursor: pointer;
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.1s;
  }
  #sitewide-origin-dropdown > div:last-child,
  #sitewide-dest-dropdown > div:last-child {
    border-bottom: none;
  }
  #sitewide-origin-dropdown > div:hover,
  #sitewide-dest-dropdown > div:hover {
    background: #f8fafc;
  }
</style>

<script is:inline>
  (function () {
    var nativeCard = document.getElementById("sitewide-native-fallback-card");
    var nativeForm = document.getElementById("sitewide-native-flight-form");
    var tpContainer = document.getElementById("sitewide-tp-widget");
    var tpScript = document.getElementById("sitewide-tpwdg-script");

    var widgetLoaded = false;
    var fallbackShown = false;

    function showFallback() {
      if (fallbackShown || widgetLoaded) return;
      fallbackShown = true;
      if (nativeCard) {
        nativeCard.classList.remove("hidden");
        nativeCard.style.display = "block";
      }
      // Shrink the TP container so it doesn't leave a blank gap
      if (tpContainer) {
        tpContainer.style.minHeight = "0";
        tpContainer.style.display = "none";
      }
    }

    function markWidgetLoaded() {
      if (widgetLoaded) return;
      widgetLoaded = true;
      if (nativeCard) {
        nativeCard.classList.add("hidden");
        nativeCard.style.display = "none";
      }
      // Disconnect the observer once loaded
      if (observer) observer.disconnect();
    }

    // Robust check: looks for tp-cascoon, tp-widget, or any child appended by tpwdg
    function checkTpLoaded() {
      if (widgetLoaded) return;
      var cascoon = document.querySelector("tp-cascoon");
      var tpWidget = document.querySelector("tp-widget");
      var anyChild = tpContainer && tpContainer.children.length > 0;
      var anyIframe = tpContainer && tpContainer.querySelector("iframe, canvas, div[class*='tp']");

      if (
        (cascoon && (cascoon.children.length > 0 || (cascoon.shadowRoot && cascoon.shadowRoot.children.length > 0))) ||
        tpWidget ||
        anyIframe ||
        anyChild
      ) {
        markWidgetLoaded();
      }
    }

    // Set today's date as default departure
    var departInput = document.getElementById("sitewide-depart-date");
    if (departInput && !departInput.value) {
      try {
        var today = new Date().toISOString().split("T")[0];
        departInput.min = today;
        departInput.value = today;
      } catch (e) {}
    }

    // ── Airport Autocomplete ─────────────────────────────────────────────────
    var airports = [];
    try {
      var dataScript = document.getElementById("sitewide-airports-json");
      if (dataScript) airports = JSON.parse(dataScript.textContent || "[]");
    } catch (e) {}

    function setupAutocomplete(inputId, dropdownId, badgeId) {
      var input = document.getElementById(inputId);
      var dropdown = document.getElementById(dropdownId);
      var badge = document.getElementById(badgeId);
      if (!input || !dropdown) return;

      function renderItems(list) {
        if (!list || list.length === 0) {
          dropdown.classList.add("hidden");
          return;
        }
        dropdown.innerHTML = list.slice(0, 7).map(function (apt) {
          return (
            '<div data-city="' + apt.city + '" data-code="' + apt.code + '">' +
            '<div>' +
            '<div style="font-size:13px;font-weight:600;color:#1e293b">' + apt.city + '</div>' +
            '<div style="font-size:11px;color:#94a3b8">' + apt.name + ', ' + apt.country + '</div>' +
            '</div>' +
            '<span style="font-family:monospace;font-size:11px;font-weight:700;color:#94a3b8;letter-spacing:0.08em">' + apt.code + '</span>' +
            '</div>'
          );
        }).join("");
        dropdown.classList.remove("hidden");
      }

      function filterAirports(query) {
        var q = (query || "").trim().toLowerCase();
        if (!q) {
          return airports.filter(function (a) {
            return ["BOM", "DEL", "BBI", "DXB", "LHR", "JFK", "SIN", "BKK"].indexOf(a.code) !== -1;
          });
        }
        return airports.filter(function (a) {
          return (
            a.city.toLowerCase().indexOf(q) !== -1 ||
            a.code.toLowerCase().indexOf(q) !== -1 ||
            a.name.toLowerCase().indexOf(q) !== -1 ||
            a.country.toLowerCase().indexOf(q) !== -1
          );
        });
      }

      input.addEventListener("input", function () {
        var val = input.value || "";
        var match = val.match(/\(([A-Z]{3})\)/);
        if (match && badge) {
          badge.textContent = match[1];
        } else if (val.trim().length === 3 && /^[A-Za-z]{3}$/.test(val.trim()) && badge) {
          badge.textContent = val.trim().toUpperCase();
        } else if (badge && val.trim().length === 0) {
          badge.textContent = "";
        }
        renderItems(filterAirports(val));
      });

      input.addEventListener("focus", function () {
        renderItems(filterAirports(input.value));
      });

      dropdown.addEventListener("mousedown", function (e) {
        // mousedown fires before blur — select item without closing dropdown first
        var target = e.target.closest("[data-city]");
        if (target) {
          e.preventDefault();
          var city = target.getAttribute("data-city");
          var code = target.getAttribute("data-code");
          input.value = city;
          input.dataset.iata = code;
          if (badge) badge.textContent = code;
          dropdown.classList.add("hidden");
          // Move focus to next field
          var nextField = inputId === "sitewide-origin"
            ? document.getElementById("sitewide-dest")
            : document.getElementById("sitewide-depart-date");
          if (nextField) nextField.focus();
        }
      });

      input.addEventListener("blur", function () {
        // Small delay so mousedown on a dropdown item fires first
        setTimeout(function () { dropdown.classList.add("hidden"); }, 150);
      });

      input.addEventListener("keydown", function (e) {
        if (e.key === "Escape") dropdown.classList.add("hidden");
      });
    }

    setupAutocomplete("sitewide-origin", "sitewide-origin-dropdown", "sitewide-origin-iata");
    setupAutocomplete("sitewide-dest", "sitewide-dest-dropdown", "sitewide-dest-iata");

    // ── Widget Detection ─────────────────────────────────────────────────────
    // Listen for script error (immediate adblocker block)
    if (tpScript) {
      tpScript.addEventListener("error", function () {
        showFallback();
      });
      tpScript.addEventListener("load", function () {
        // Widget script loaded — give it 1.5s to render
        setTimeout(checkTpLoaded, 400);
        setTimeout(checkTpLoaded, 1200);
        setTimeout(function () {
          if (!widgetLoaded) showFallback();
        }, 2000);
      });
    }

    // MutationObserver watches for tp-cascoon or any child injection
    var observer = new MutationObserver(function () {
      checkTpLoaded();
    });
    if (tpContainer) {
      observer.observe(tpContainer, { childList: true, subtree: true, attributes: true });
    }
    // Also watch document body for tp-cascoon injected at document level
    observer.observe(document.body, { childList: true, subtree: false });

    // Hard timeout: if widget still hasn't appeared after 3s, show fallback
    setTimeout(function () {
      checkTpLoaded();
      if (!widgetLoaded) showFallback();
    }, 3000);

    // ── Form Submission ──────────────────────────────────────────────────────
    if (nativeForm) {
      nativeForm.addEventListener("submit", function (e) {
        e.preventDefault();

        var originInput = document.getElementById("sitewide-origin");
        var originVal = originInput ? originInput.value.trim() : "";
        var destInput = document.getElementById("sitewide-dest");
        var destVal = destInput ? destInput.value.trim() : "";

        // Geo-targeted Kiwi affiliate shortlinks
        var kiwiGeoMap = {
          "us": "https://kiwi.tpk.lu/PRoNbR8A",
          "ca": "https://kiwi.tpk.lu/PRoNbR8A",
          "gb": "https://kiwi.tpk.lu/zdAwHpk4",
          "uk": "https://kiwi.tpk.lu/zdAwHpk4",
          "in": "https://kiwi.tpk.lu/suZfzffW",
          "cz": "https://kiwi.tpk.lu/4JJAeyYQ",
          "fi": "https://kiwi.tpk.lu/j9t7bFL8",
          "it": "https://kiwi.tpk.lu/3cbh2gXF",
          "dk": "https://kiwi.tpk.lu/k5RXUFYd",
          "de": "https://kiwi.tpk.lu/FNBUJmy6",
          "nl": "https://kiwi.tpk.lu/U42dntOs",
          "pl": "https://kiwi.tpk.lu/bIz4CwgC",
          "br": "https://kiwi.tpk.lu/xF6eey3B",
          "es": "https://kiwi.tpk.lu/tBWe6mTP",
          "fr": "https://kiwi.tpk.lu/47KJwXAa"
        };

        var rawLang = (navigator.language || "en").toLowerCase();
        var parts = rawLang.split("-");
        var langCode = parts[0];
        var country = parts[1] || "";

        var asiaLangs = ["ko", "ja", "zh", "th", "vi", "ms", "id", "tl"];
        var isEastAsia = asiaLangs.indexOf(langCode) !== -1 && country !== "in";

        var subId = "sitewide_fallback";
        var url;

        if (isEastAsia) {
          url = "https://tp.media/r?marker=778331.BringonPlane&trs=574616&p=5543" +
                "&u=https%3A%2F%2Fwww.trip.com%2Fflight%2F" +
                "&sub_id=" + encodeURIComponent(subId);
        } else {
          var kiwiBase = kiwiGeoMap[country] || kiwiGeoMap[langCode] || "https://kiwi.tpk.lu/PRoNbR8A";
          url = kiwiBase + "?sub_id=" + encodeURIComponent(subId);
          if (originVal && destVal) {
            url += "&search=" + encodeURIComponent(originVal + " to " + destVal);
          } else if (destVal) {
            url += "&search=" + encodeURIComponent(destVal);
          } else if (originVal) {
            url += "&search=" + encodeURIComponent(originVal);
          }
        }

        window.open(url, "_blank", "noopener,noreferrer");
      });
    }

  })();
</script>
