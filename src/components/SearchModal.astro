---
import { Search, X, CornerDownLeft } from "@lucide/astro";
import { defaultLang, useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import { getItemName } from "../i18n/items";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang as Lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

/**
 * The modal's behaviour lives in an inline script block, which cannot read
 * Astro.props. Everything locale-dependent is therefore serialised onto the
 * root element as a single JSON payload the script reads once on boot: the
 * index URL, the item-link prefix, and the strings it injects into result HTML.
 */
const popularSlugs = [
  { slug: "power-bank", name: "Power Bank" },
  { slug: "sunscreen", name: "Sunscreen Lotion" },
  { slug: "laptop", name: "Laptop Computer" },
  { slug: "baby-formula", name: "Baby Formula" },
  { slug: "multi-tool", name: "Multi-tool" },
];

const searchConfig = {
  lang,
  indexUrl: lang === defaultLang ? "/search-index.json" : `/search-index-${lang}.json`,
  itemBase: translatePath("/items"),
  popular: popularSlugs.map((item) => ({
    slug: item.slug,
    name: getItemName(item.slug, item.name, lang),
  })),
  strings: {
    loadFailed: t("search.loadFailed"),
    recent: t("search.recent"),
    clearAll: t("search.clearAll"),
    recentBadge: t("search.recentBadge"),
    popular: t("search.popular"),
    popularBadge: t("search.popularBadge"),
    noMatches: t("search.noMatches"),
    itemsFound: t("search.itemsFound"),
    carryAbbr: t("search.carryAbbr"),
    holdAbbr: t("search.holdAbbr"),
    statusAllowed: t("status.allowed"),
    statusProhibited: t("status.prohibited"),
    statusRestricted: t("status.restricted"),
    statusUnknown: t("status.unknown"),
  },
};
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm transition-all duration-150 flex items-start justify-center pt-[10vh] px-4"
  role="dialog"
  aria-modal="true"
  aria-label={t("a11y.spotlightSearch")}
  data-search-config={JSON.stringify(searchConfig)}
>
  <!-- Modal Content Box -->
  <div 
    id="search-modal-content"
    class="w-full max-w-[620px] bg-white dark:bg-slate-900 border-2 border-slate-300/80 dark:border-slate-700 rounded-2xl shadow-2xl flex flex-col overflow-hidden max-h-[80vh] transform scale-98 opacity-0 transition-all duration-200"
  >
    <!-- Input Header -->
    <div class="h-14 border-b border-slate-200 dark:border-slate-800 flex items-center px-4 gap-3 relative flex-shrink-0 bg-white dark:bg-slate-900 text-slate-900 dark:text-white">
      <Search class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" aria-hidden="true" />
      <input
        type="text"
        id="search-modal-input"
        placeholder={t("search.modalPlaceholder")}
        autocomplete="off"
        spellcheck="false"
        class="w-full h-full text-base font-sans text-slate-900 dark:text-white bg-transparent border-none outline-none placeholder:text-slate-400 dark:placeholder:text-slate-500 font-medium"
      />
      <div class="flex items-center gap-1.5 flex-shrink-0">
        <kbd class="hidden sm:inline-flex items-center justify-center h-5 px-1.5 text-[9px] font-mono font-medium border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded shadow-xs">
          ESC
        </kbd>
        <button
          type="button"
          id="search-modal-close"
          aria-label={t("a11y.closeSearch")}
          class="p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 cursor-pointer"
        >
          <X class="w-4 h-4" aria-hidden="true" />
        </button>
      </div>
    </div>

    <!-- Scrollable Results Panel -->
    <div id="search-modal-results" class="flex-1 overflow-y-auto min-h-[200px] max-h-[50vh] p-2 scroll-smooth bg-white dark:bg-slate-900">
      <!-- Content populated dynamically by JavaScript -->
      <div class="p-6 text-center text-sm text-slate-500 dark:text-slate-400">
        {t("search.loadingIndex")}
      </div>
    </div>

    <!-- Keyboard Navigation Footer -->
    <div class="h-10 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 px-4 flex items-center justify-between text-[11px] text-slate-600 dark:text-slate-400 font-mono flex-shrink-0 select-none">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1">
          <kbd class="border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-1 rounded">↓↑</kbd> {t("search.navigate")}
        </span>
        <span class="flex items-center gap-1">
          <kbd class="border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-1 rounded flex items-center justify-center h-4 w-6"><CornerDownLeft class="w-2.5 h-2.5" /></kbd> {t("search.select")}
        </span>
      </div>
      <div>
        <span class="flex items-center gap-1">
          <kbd class="border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-1 rounded">ESC</kbd> {t("search.close")}
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    slug: string;
    name: string;
    category: string;
    aliases: string[];
    keywords: string[];
    carryOn: string;
    checked: string;
    /** Present on translated indexes; falls back to slugifying `category`. */
    categorySlug?: string;
  }

  interface SearchConfig {
    lang: string;
    indexUrl: string;
    itemBase: string;
    popular: { slug: string; name: string }[];
    strings: Record<string, string>;
  }

  const FALLBACK_CONFIG: SearchConfig = {
    lang: "en",
    indexUrl: "/search-index.json",
    itemBase: "/items",
    popular: [],
    strings: {},
  };

  let config: SearchConfig = FALLBACK_CONFIG;
  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let activeIndex = -1;
  let currentResults: SearchItem[] = [];

  /**
   * Re-reads the locale payload off the modal root. Called on boot and after
   * every `astro:after-swap`, because a view transition can carry the reader
   * into a different locale and the cached index would then be stale.
   */
  function readConfig() {
    const raw = document.getElementById("search-modal")?.getAttribute("data-search-config");
    if (!raw) return;
    try {
      const next = JSON.parse(raw) as SearchConfig;
      if (next.lang !== config.lang) {
        searchIndex = [];
        isIndexLoaded = false;
      }
      config = next;
    } catch {
      /* keep the previous config */
    }
  }

  function itemUrl(slug: string): string {
    return `${config.itemBase}/${slug}/`;
  }

  /** Localised label for a raw `carryOn` / `checked` status value. */
  function statusLabel(status: string): string {
    const s = config.strings;
    switch (status) {
      case "allowed":
        return s.statusAllowed || "Allowed";
      case "prohibited":
      case "not_allowed":
        return s.statusProhibited || "Prohibited";
      case "restricted":
        return s.statusRestricted || "Restricted";
      default:
        return s.statusUnknown || status.replace("_", " ");
    }
  }

  // SVG Icons for categories with explicit width and height
  const icons: Record<string, string> = {
    electronics: `<svg width="16" height="16" class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`,
    liquids: `<svg width="16" height="16" class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-11-7-11S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>`,
    food: `<svg width="16" height="16" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v12"/><path d="M6 12h12"/></svg>`,
    medicine: `<svg width="16" height="16" class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m2 22 20-20"/><path d="M8.3 8.3c-2.3 2.3-2.3 6 0 8.3s6 2.3 8.3 0"/><path d="M12.5 12.5a1 1 0 1 0-2 0 1 1 0 0 0 2 0Z"/></svg>`,
    baby: `<svg width="16" height="16" class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>`,
    tools: `<svg width="16" height="16" class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    sports: `<svg width="16" height="16" class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45 1-1 1H4v2h16v-2h-5c-.55 0-1-.45-1-1v-2.34"/><path d="M12 2a4 4 0 0 0-4 4v3a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4Z"/></svg>`,
    personalcare: `<svg width="16" height="16" class="w-4 h-4 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m12 3-1.912 5.886H3.886L8.7 12.518 6.788 18.4 12 14.782 17.212 18.4l-1.912-5.882 4.814-3.632h-6.202L12 3z"/></svg>`,
    jewelry: `<svg width="16" height="16" class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>`,
    documents: `<svg width="16" height="16" class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>`,
    camping: `<svg width="16" height="16" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>`,
    beauty: `<svg width="16" height="16" class="w-4 h-4 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m12 3-1.912 5.886H3.886L8.7 12.518 6.788 18.4 12 14.782 17.212 18.4l-1.912-5.882 4.814-3.632h-6.202L12 3z"/></svg>`,
    health: `<svg width="16" height="16" class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
    default: `<svg width="16" height="16" class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="16"/><line x1="8" x2="16" y1="12" y2="12"/></svg>`
  };

  const statusColors: Record<string, string> = {
    allowed: "bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700",
    prohibited: "bg-rose-100 dark:bg-rose-950/80 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-700",
    not_allowed: "bg-rose-100 dark:bg-rose-950/80 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-700",
    restricted: "bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-700",
    unknown: "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-700"
  };

  function getModalElements() {
    return {
      modal: document.getElementById("search-modal"),
      content: document.getElementById("search-modal-content"),
      input: document.getElementById("search-modal-input") as HTMLInputElement | null,
      closeBtn: document.getElementById("search-modal-close"),
      resultsContainer: document.getElementById("search-modal-results"),
    };
  }

  // Open Modal
  async function openSearch() {
    const { modal, content, input, resultsContainer } = getModalElements();
    if (!modal || !content || !input) return;

    readConfig();
    modal.classList.remove("hidden");
    void modal.offsetWidth;
    content.classList.remove("scale-98", "opacity-0");
    input.value = "";
    input.focus();
    activeIndex = -1;
    document.body.style.overflow = "hidden"; // Prevent scrolling behind modal

    // Lazy load the search index for the active locale
    if (!isIndexLoaded) {
      try {
        const res = await fetch(config.indexUrl);
        if (!res.ok) throw new Error("Failed to load search index");
        searchIndex = await res.json();
        isIndexLoaded = true;
      } catch (err) {
        console.error(err);
        if (resultsContainer) {
          resultsContainer.innerHTML = `<div class="p-6 text-center text-sm text-rose-600 dark:text-rose-400">${config.strings.loadFailed || "Failed to load search database."}</div>`;
        }
        return;
      }
    }
    renderResults();
  }

  // Close Modal
  function closeSearch() {
    const { modal, content } = getModalElements();
    if (!modal || !content) return;
    content.classList.add("scale-98", "opacity-0");
    setTimeout(() => {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }, 150);
  }

  // Fetch recent searches
  function recentKey(): string {
    // Scoped per locale — a name stored in Japanese is meaningless in French.
    return config.lang === "en" ? "recent_searches" : `recent_searches_${config.lang}`;
  }

  function getRecentSearches(): { slug: string; name: string }[] {
    try {
      return JSON.parse(localStorage.getItem(recentKey()) || "[]");
    } catch {
      return [];
    }
  }

  // Store recent search
  function saveRecentSearch(slug: string, name: string) {
    let recent = getRecentSearches();
    recent = recent.filter(item => item.slug !== slug);
    recent.unshift({ slug, name });
    recent = recent.slice(0, 5); // Limit to 5
    localStorage.setItem(recentKey(), JSON.stringify(recent));
  }

  // Clear recent searches
  function clearRecentSearches() {
    localStorage.removeItem(recentKey());
    renderResults();
  }

  // Subsequence match helper for fuzzy typo tolerance
  function isSubsequence(needle: string, haystack: string): boolean {
    let nIdx = 0;
    let hIdx = 0;
    while (nIdx < needle.length && hIdx < haystack.length) {
      if (needle[nIdx] === haystack[hIdx]) {
        nIdx++;
      }
      hIdx++;
    }
    return nIdx === needle.length;
  }

  // Spotlight Ranking Function
  function getQueryResults(query: string): SearchItem[] {
    const q = query.toLowerCase().trim();
    if (!q) return [];

    const scored = searchIndex.map(item => {
      let score = 0;
      const nameLower = item.name.toLowerCase();
      const catLower = item.category.toLowerCase();

      // 1. Exact Match on Name
      if (nameLower === q) {
        score = 100;
      }
      // 2. Starts With Name
      else if (nameLower.startsWith(q)) {
        score = 80;
      }
      // 3. Contains Name
      else if (nameLower.includes(q)) {
        score = 60;
      }
      // 4. Matches category
      else if (catLower === q || catLower.startsWith(q)) {
        score = 50;
      }
      // 5. Matches Alias
      else if (item.aliases.some(alias => alias.toLowerCase() === q || alias.toLowerCase().startsWith(q))) {
        score = 40;
      }
      // 6. Matches Keyword
      else if (item.keywords.some(keyword => keyword.toLowerCase() === q || keyword.toLowerCase().includes(q))) {
        score = 25;
      }
      // 7. Subsequence/Fuzzy typo match
      else if (isSubsequence(q, nameLower)) {
        score = 10;
      }

      return { item, score };
    });

    // Filter out items with 0 score, and sort by score descending, then alphabetically by name
    return scored
      .filter(x => x.score > 0)
      .sort((a, b) => b.score - a.score || a.item.name.localeCompare(b.item.name))
      .map(x => x.item);
  }

  // Render HTML based on input state
  function renderResults() {
    const { input, resultsContainer } = getModalElements();
    if (!resultsContainer || !input) return;

    const query = input.value;
    
    // Empty query state: show Recent & Popular
    if (!query) {
      activeIndex = -1;
      const recent = getRecentSearches();
      
      let html = "";
      
      // Recent Searches
      if (recent.length > 0) {
        html += `
          <div class="mb-4">
            <div class="flex items-center justify-between px-3 py-1.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              <span>${config.strings.recent || "Recent searches"}</span>
              <button type="button" id="clear-recents-btn" class="hover:text-slate-900 dark:hover:text-white cursor-pointer transition-colors">${config.strings.clearAll || "Clear all"}</button>
            </div>
            <div class="flex flex-col gap-1">
              ${recent.map((item, idx) => `
                <a
                  href="${itemUrl(item.slug)}"
                  class="search-result-item flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-sm text-slate-900 dark:text-slate-100 transition-colors"
                  data-slug="${item.slug}"
                  data-name="${item.name}"
                  data-index="${idx}"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span class="truncate font-medium">${item.name}</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase font-semibold">${config.strings.recentBadge || "Recent"}</span>
                </a>
              `).join("")}
            </div>
          </div>
        `;
      }

      // Popular Searches
      const popularIdxOffset = recent.length;
      html += `
        <div>
          <div class="px-3 py-1.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            ${config.strings.popular || "Popular searches"}
          </div>
          <div class="flex flex-col gap-1">
            ${config.popular.map((item, idx) => `
              <a
                href="${itemUrl(item.slug)}"
                class="search-result-item flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-sm text-slate-900 dark:text-slate-100 transition-colors"
                data-slug="${item.slug}"
                data-name="${item.name}"
                data-index="${popularIdxOffset + idx}"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  <span class="truncate font-bold">${item.name}</span>
                </div>
                <span class="text-[10px] font-mono text-blue-600 dark:text-blue-400 uppercase font-semibold">${config.strings.popularBadge || "Popular"}</span>
              </a>
            `).join("")}
          </div>
        </div>
      `;

      resultsContainer.innerHTML = html;
      currentResults = [];
      
      const clearBtn = document.getElementById("clear-recents-btn");
      if (clearBtn) {
        clearBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          clearRecentSearches();
        });
      }
      
      bindResultItemEvents();
      return;
    }

    // Query state
    currentResults = getQueryResults(query);
    activeIndex = -1;

    if (currentResults.length === 0) {
      resultsContainer.innerHTML = `
        <div class="p-8 text-center text-sm text-slate-500 dark:text-slate-400">
          ${config.strings.noMatches || "No matches found for"} "<span class="font-bold text-slate-900 dark:text-white">${query}</span>"…
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = `
      <div class="px-3 py-1.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        ${config.strings.itemsFound || "Items found"} (${currentResults.length})
      </div>
      <div class="flex flex-col gap-1">
        ${currentResults.map((item, idx) => {
          const iconKey = (item.categorySlug || item.category).toLowerCase().replace(/[\s-]+/g, "");
          const svgIcon = icons[iconKey] || icons.default;
          const coStatus = (item.carryOn || '').toLowerCase();
          const ckStatus = (item.checked || '').toLowerCase();

          return `
            <a
              href="${itemUrl(item.slug)}"
              class="search-result-item flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 border-l-4 border-transparent transition-all"
              data-slug="${item.slug}"
              data-name="${item.name}"
              data-index="${idx}"
            >
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <div class="flex-shrink-0">
                  ${svgIcon}
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-bold text-slate-900 dark:text-white truncate">${item.name}</p>
                  <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase tracking-wide font-semibold">${item.category}</p>
                </div>
              </div>
              <div class="flex items-center gap-1.5 flex-shrink-0 ml-4">
                <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider ${statusColors[coStatus] || statusColors.unknown}">
                  ${config.strings.carryAbbr || "Carry"}: ${statusLabel(coStatus)}
                </span>
                <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider ${statusColors[ckStatus] || statusColors.unknown}">
                  ${config.strings.holdAbbr || "Hold"}: ${statusLabel(ckStatus)}
                </span>
              </div>
            </a>
          `;
        }).join("")}
      </div>
    `;

    bindResultItemEvents();
  }

  // Highlight helper for keyboard/mouse movement
  function updateHighlight() {
    const { resultsContainer } = getModalElements();
    const items = resultsContainer?.querySelectorAll(".search-result-item");
    if (!items) return;

    items.forEach((item, idx) => {
      if (idx === activeIndex) {
        item.classList.add("bg-blue-50", "dark:bg-slate-800", "border-blue-600", "dark:border-blue-400");
        item.scrollIntoView({ block: "nearest" });
      } else {
        item.classList.remove("bg-blue-50", "dark:bg-slate-800", "border-blue-600", "dark:border-blue-400");
      }
    });
  }

  // Bind mouseover/click callbacks dynamically
  function bindResultItemEvents() {
    const { resultsContainer, input } = getModalElements();
    const items = resultsContainer?.querySelectorAll(".search-result-item");
    if (!items) return;

    items.forEach(item => {
      const idx = parseInt(item.getAttribute("data-index") || "-1");
      const slug = item.getAttribute("data-slug") || "";
      const name = item.getAttribute("data-name") || "";

      item.addEventListener("mouseenter", () => {
        activeIndex = idx;
        updateHighlight();
      });

      item.addEventListener("click", () => {
        saveRecentSearch(slug, name);
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'search_select', {
            search_query: input?.value || '',
            item_slug: slug,
            item_name: name
          });
        }
      });
    });
  }

  // Global hotkey triggers (⌘ K, Control K, /)
  window.addEventListener("keydown", (e) => {
    // ⌘ K or Ctrl K
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      const { modal } = getModalElements();
      if (modal && !modal.classList.contains("hidden")) {
        closeSearch();
      } else {
        openSearch();
      }
    }
    // Forward slash (/) trigger when not in an input
    else if (e.key === "/" && document.activeElement?.tagName !== "INPUT" && document.activeElement?.tagName !== "TEXTAREA") {
      e.preventDefault();
      openSearch();
    }
  });

  // Modal input keyboard listeners
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (target?.id !== "search-modal-input") return;

    const { resultsContainer, input } = getModalElements();
    const items = resultsContainer?.querySelectorAll(".search-result-item") || [];
    
    if (e.key === "Escape") {
      e.preventDefault();
      closeSearch();
    }
    else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex + 1) % items.length;
        updateHighlight();
      }
    }
    else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateHighlight();
      }
    }
    else if (e.key === "Enter") {
      e.preventDefault();
      
      if (activeIndex >= 0 && activeIndex < items.length) {
        const activeElem = items[activeIndex] as HTMLAnchorElement;
        const slug = activeElem.getAttribute("data-slug") || "";
        const name = activeElem.getAttribute("data-name") || "";
        if (slug) {
          saveRecentSearch(slug, name);
          window.location.href = itemUrl(slug);
        }
      }
      else if (currentResults.length > 0) {
        const item = currentResults[0];
        saveRecentSearch(item.slug, item.name);
        window.location.href = itemUrl(item.slug);
      }
    }
  });

  // Real-time input search
  document.addEventListener("input", (e) => {
    const target = e.target as HTMLElement;
    if (target?.id === "search-modal-input") {
      renderResults();
    }
  });

  // Delegated click handler for open triggers, close button, and backdrop
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // Open Search Trigger
    const trigger = target.closest("[data-open-search]");
    if (trigger) {
      e.preventDefault();
      e.stopPropagation();

      // Close mobile menu if open
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileBackdrop = document.getElementById("mobile-menu-backdrop");
      if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("hidden");
        mobileBackdrop?.classList.add("hidden");
        const menuBtn = document.getElementById("mobile-menu-btn");
        menuBtn?.setAttribute("aria-expanded", "false");
        document.getElementById("hamburger-icon")?.classList.remove("hidden");
        document.getElementById("close-icon")?.classList.add("hidden");
      }

      openSearch();
      return;
    }

    // Close button
    const closeBtn = target.closest("#search-modal-close");
    if (closeBtn) {
      e.preventDefault();
      closeSearch();
      return;
    }

    // Backdrop click
    const modal = document.getElementById("search-modal");
    if (modal && target === modal) {
      closeSearch();
    }
  });

  readConfig();
  document.addEventListener("astro:after-swap", readConfig);
</script>
