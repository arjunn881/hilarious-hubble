---
import { ChevronRight, Home } from "@lucide/astro";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const siteUrl = "https://bringonplane.com";
const rawPathname = Astro.url.pathname || "/";
const formattedPathname = rawPathname.endsWith("/") ? rawPathname : `${rawPathname}/`;
const currentFullUrl = `${siteUrl}${formattedPathname}`;

function formatPath(pathOrUrl: string): string {
  const trimmed = pathOrUrl.trim();
  if (trimmed.includes('#') || trimmed.includes('?')) return trimmed;
  if (!trimmed.endsWith('/') && !/\.[a-zA-Z0-9]+$/.test(trimmed)) {
    return `${trimmed}/`;
  }
  return trimmed;
}

function getItemUrl(item: BreadcrumbItem): string {
  if (item.href) {
    const rawHref = item.href.trim().replace(/\s+/g, "-");
    if (rawHref.startsWith("http://") || rawHref.startsWith("https://")) {
      return formatPath(rawHref);
    }
    const path = rawHref.startsWith("/") ? rawHref : `/${rawHref}`;
    return `${siteUrl}${formatPath(path)}`;
  }
  return currentFullUrl;
}

// Generate JSON-LD schema with required "item" property on every ListItem
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": getItemUrl(item)
  }))
};
---

<nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-[11px] sm:text-xs font-mono text-mute mb-8 select-none overflow-x-auto whitespace-nowrap pb-2 scrollbar-none">
  <ol class="flex items-center gap-1.5 m-0 p-0 list-none" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      const itemUrl = getItemUrl(item);
      const cleanHref = item.href ? formatPath(item.href.trim().replace(/\s+/g, "-")) : undefined;
      
      return (
        <li 
          itemprop="itemListElement" 
          itemscope 
          itemtype="https://schema.org/ListItem"
          class="flex items-center gap-1.5"
        >
          {cleanHref ? (
            <a 
              href={cleanHref} 
              class="hover:text-ink transition-colors focus-visible:underline flex items-center gap-1"
              itemprop="item"
            >
              {index === 0 && <Home class="w-3.5 h-3.5" />}
              <span itemprop="name">{item.label}</span>
            </a>
          ) : (
            <span class="text-ink font-medium capitalize flex items-center gap-1" aria-current={isLast ? "page" : undefined}>
              {index === 0 && <Home class="w-3.5 h-3.5" />}
              <span itemprop="name">{item.label}</span>
              <link itemprop="item" href={itemUrl} />
            </span>
          )}
          
          <meta itemprop="position" content={(index + 1).toString()} />
          
          {!isLast && (
            <ChevronRight class="w-3 h-3 text-hairline-strong flex-shrink-0" aria-hidden="true" />
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
