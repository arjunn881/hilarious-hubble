---
interface Props {
  slotId?: string;
  clientId?: string;
}

const {
  slotId = "5153849161",
  clientId = "ca-pub-8894580285912422",
} = Astro.props;
---

<!-- ── Left Side Rail Ad (Sticky on Desktop/Laptop >= 1000px) ──────── -->
<aside class="ad-rail-unit ad-rail-left" aria-label="Advertisement">
  <div
    class="ad-rail-inner"
    id="ad-rail-left-container"
    data-client-id={clientId}
    data-slot-id={slotId}
  ></div>
</aside>

<!-- ── Right Side Rail Ad (Sticky on Desktop/Laptop >= 1000px) ─────── -->
<aside class="ad-rail-unit ad-rail-right" aria-label="Advertisement">
  <div
    class="ad-rail-inner"
    id="ad-rail-right-container"
    data-client-id={clientId}
    data-slot-id={slotId}
  ></div>
</aside>

<script is:inline>
  function mountRailAds() {
    if (typeof window === "undefined") return;

    var leftContainer = document.getElementById("ad-rail-left-container");
    var rightContainer = document.getElementById("ad-rail-right-container");

    // On viewports < 1000px, ensure containers are empty so no hidden ins exists
    if (window.innerWidth < 1000) {
      if (leftContainer && leftContainer.querySelector("ins.adsbygoogle")) {
        leftContainer.innerHTML = "";
      }
      if (rightContainer && rightContainer.querySelector("ins.adsbygoogle")) {
        rightContainer.innerHTML = "";
      }
      return;
    }

    // On viewports >= 1000px, mount and initialize side rails
    [
      { container: leftContainer, id: "ad-rail-ins-left" },
      { container: rightContainer, id: "ad-rail-ins-right" },
    ].forEach(function (item) {
      if (!item.container || item.container.querySelector("ins.adsbygoogle")) return;

      var clientId = item.container.getAttribute("data-client-id") || "ca-pub-8894580285912422";
      var slotId = item.container.getAttribute("data-slot-id") || "5153849161";

      var ins = document.createElement("ins");
      ins.className = "adsbygoogle";
      ins.id = item.id;
      ins.style.cssText = "display:inline-block;width:120px;height:600px;";
      ins.setAttribute("data-ad-client", clientId);
      ins.setAttribute("data-ad-slot", slotId);
      ins.setAttribute("data-ad-format", "auto");
      ins.setAttribute("data-full-width-responsive", "true");

      item.container.appendChild(ins);

      try {
        (adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountRailAds);
  } else {
    mountRailAds();
  }

  document.addEventListener("astro:page-load", mountRailAds);
  window.addEventListener("resize", mountRailAds, { passive: true });
</script>
