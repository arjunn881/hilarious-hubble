---
/**
 * FlightSearchWidget.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Travelpayouts interactive Flights Search Form widget.
 * Powered by Travelpayouts (shmarker: 778331, trs: 574616, promo_id: 3414).
 *
 * Automatically localizes currency, locale, sub_id, and destination.
 * Includes graceful noscript fallback and contextual last-minute deals link.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface Props {
  defaultDestination?: string;
  airlineName?: string;
  slug?: string; // page slug for sub_id tracking
  lang?: string;
}

const { defaultDestination = "", airlineName = "", slug = "page", lang = "en" } = Astro.props;

// Localized currency mapping
const currencyMap: Record<string, string> = {
  en: "usd",
  es: "eur",
  fr: "eur",
  de: "eur",
  it: "eur",
  pt: "brl",
  ja: "jpy",
  ko: "krw",
};

const currency = currencyMap[lang] || "usd";
const supportedLocales = ["en", "es", "fr", "de", "it", "pt"];
const locale = supportedLocales.includes(lang) ? lang : "en";

const subId = encodeURIComponent(`WIDGET_${slug}`.slice(0, 64));

let widgetSrc = `https://tpwdg.com/content?currency=${currency}&trs=574616&shmarker=778331.BringonPlane&locale=${locale}&stops=any&show_hotels=true&powered_by=true&border_radius=0&plain=true&color_button=%230041a9&color_button_text=%23ffffff&promo_id=3414&campaign_id=111&sub_id=${subId}`;

if (defaultDestination) {
  widgetSrc += `&destination=${encodeURIComponent(defaultDestination)}`;
}
---

<aside
  class="no-print my-6 rounded-lg border border-hairline bg-canvas p-4 shadow-sm"
  aria-label="Search flights"
>
  {/* ── Header row ── */}
  <div class="mb-3 flex items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-ink leading-tight flex items-center gap-1.5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-link" aria-hidden="true">
        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
      </svg>
      Search Flights{airlineName ? ` on ${airlineName}` : ""}
    </h2>
    <span class="font-mono text-[11px] text-mute">Sponsored</span>
  </div>

  {/* ── Travelpayouts Interactive Search Form Widget ── */}
  <div class="tp-flight-search-container w-full min-h-[90px] overflow-hidden">
    <script
      is:inline
      async
      src={widgetSrc}
      charset="utf-8"
    ></script>
  </div>

  <noscript>
    <div class="p-3 bg-canvas-soft rounded border border-hairline text-center text-sm">
      <a
        href={`https://kiwi.tpk.lu/PRoNbR8A?sub_id=GLOBAL_${slug}_noscript`}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="text-link font-semibold hover:underline"
      >
        Search and compare cheap flights &rarr;
      </a>
    </div>
  </noscript>

  {/* ── Contextual Deals Footer ── */}
  <div class="mt-3 pt-2.5 border-t border-hairline/60 flex flex-wrap items-center justify-between gap-2 text-xs text-mute">
    <a
      href={`https://kiwi.tpk.lu/JFMOmSVL?sub_id=GLOBAL_${slug}_last_minute`}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="text-link hover:underline font-medium inline-flex items-center gap-1"
    >
      <span>⚡ Flying within 72 hours? Check Kiwi Last-Minute Deals &rarr;</span>
    </a>
    <span class="text-[11px] text-mute">Compare live fares across 800+ airlines</span>
  </div>
</aside>
