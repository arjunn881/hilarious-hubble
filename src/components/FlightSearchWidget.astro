---
/**
 * FlightSearchWidget.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Hybrid Intent-Driven Flight Search Utility:
 * 1. Loads Travelpayouts official interactive widget (marker: 778331.BringonPlane, color: #0041a9).
 * 2. Includes native fallback form so visitors with adblockers (which block tpwdg.com)
 *    never see an empty box and can seamlessly search flights via localized Kiwi / Trip links.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface Props {
  defaultDestination?: string;
  airlineName?: string;
  slug?: string;
  lang?: string;
}

const { defaultDestination = "", airlineName = "", slug = "page", lang = "en" } = Astro.props;

// Localized currency mapping
const currencyMap: Record<string, string> = {
  en: "usd",
  es: "eur",
  fr: "eur",
  de: "eur",
  it: "eur",
  pt: "brl",
  ja: "jpy",
  ko: "krw",
};

const currency = currencyMap[lang] || "usd";
const supportedLocales = ["en", "es", "fr", "de", "it", "pt"];
const locale = supportedLocales.includes(lang) ? lang : "en";

const subId = encodeURIComponent(`WIDGET_${slug}`.slice(0, 64));

let widgetSrc = `https://tpwdg.com/content?currency=${currency}&trs=574616&shmarker=778331.BringonPlane&powered_by=true&locale=${locale}&stops=-1&show_header=true&limit=3&primary_color=1431c2&results_background_color=FFFFFF&form_background_color=FFFFFF&campaign_id=111&promo_id=4478&sub_id=${subId}`;

if (defaultDestination) {
  widgetSrc += `&destination=${encodeURIComponent(defaultDestination)}`;
}
---

<aside
  class="no-print my-6 rounded-lg border border-hairline bg-canvas p-4 shadow-sm"
  aria-label="Search flights"
>
  {/* ── Header row ── */}
  <div class="mb-3 flex items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-ink leading-tight flex items-center gap-1.5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-link" aria-hidden="true">
        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
      </svg>
      Search Flights{airlineName ? ` on ${airlineName}` : ""}
    </h2>
  </div>

  {/* ── Travelpayouts Widget Container ── */}
  <div id="tp-widget-container" class="w-full overflow-hidden">
    <script
      is:inline
      async
      src={widgetSrc}
      charset="utf-8"
      id="tpwdg-script"
    ></script>
  </div>

  {/* ── Native Search Form (Active fallback if tpwdg.com is blocked by client adblockers) ── */}
  <form id="native-flight-search-form" class="mt-1" novalidate>
    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
      <div>
        <label for="flight-origin" class="block text-[11px] font-medium text-mute mb-1">Departure</label>
        <input
          id="flight-origin"
          type="text"
          placeholder="Origin city or airport code"
          autocomplete="off"
          class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
        />
      </div>

      <div>
        <label for="flight-dest" class="block text-[11px] font-medium text-mute mb-1">Destination</label>
        <input
          id="flight-dest"
          type="text"
          placeholder="Destination city or airport"
          autocomplete="off"
          value={defaultDestination}
          class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
        />
      </div>

      <div>
        <label for="flight-date" class="block text-[11px] font-medium text-mute mb-1">Departure Date</label>
        <input
          id="flight-date"
          type="date"
          class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
        />
      </div>
    </div>

    <div class="mt-3.5 flex flex-wrap items-center justify-between gap-3">
      <button
        type="submit"
        class="rounded-md bg-link px-4 py-2 text-sm font-semibold text-white hover:bg-link-deep focus:outline-none focus:ring-2 focus:ring-link focus:ring-offset-2 active:opacity-90 transition-colors cursor-pointer"
      >
        Search Flights &rarr;
      </button>

      <a
        href={`https://kiwi.tpk.lu/JFMOmSVL?sub_id=GLOBAL_${slug}_last_minute`}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="text-xs text-link hover:underline font-medium inline-flex items-center gap-1"
      >
        <span>⚡ Need flights in 72h? Kiwi Last-Minute Deals &rarr;</span>
      </a>
    </div>
  </form>
</aside>

<style is:global>
  tp-cascoon,
  #tp-widget-container iframe {
    display: block !important;
    width: 100% !important;
    min-height: 80px !important;
  }
</style>

<script is:inline define:vars={{ slug, defaultDestination }}>
  (function () {
    var nativeForm = document.getElementById("native-flight-search-form");
    var tpContainer = document.getElementById("tp-widget-container");
    var tpScript = document.getElementById("tpwdg-script");

    // Hide native form ONLY if Travelpayouts widget successfully rendered inside DOM
    function checkTpLoaded() {
      var cascoon = document.querySelector("tp-cascoon");
      var iframe = tpContainer ? tpContainer.querySelector("iframe") : null;
      if ((cascoon && cascoon.shadowRoot && cascoon.shadowRoot.children.length > 0) || (cascoon && cascoon.children.length > 0) || iframe) {
        if (nativeForm) nativeForm.style.display = "none";
      }
    }

    // Check on script load and mutation
    if (tpScript) {
      tpScript.addEventListener("load", function () {
        setTimeout(checkTpLoaded, 400);
        setTimeout(checkTpLoaded, 1200);
      });
      tpScript.addEventListener("error", function () {
        // tpwdg blocked by adblocker: keep native form visible
        if (nativeForm) nativeForm.style.display = "block";
      });
    }

    var observer = new MutationObserver(function () {
      checkTpLoaded();
    });
    if (tpContainer) {
      observer.observe(tpContainer, { childList: true, subtree: true });
    }

    // Native form submission (routes to localized Kiwi or Trip.com)
    if (nativeForm) {
      nativeForm.addEventListener("submit", function (e) {
        e.preventDefault();

        var originInput = document.getElementById("flight-origin");
        var originVal = originInput ? originInput.value.trim() : "";
        var destInput = document.getElementById("flight-dest");
        var destVal = destInput ? destInput.value.trim() : (defaultDestination || "");

        var kiwiGeoMap = {
          "us": "https://kiwi.tpk.lu/PRoNbR8A",
          "gb": "https://kiwi.tpk.lu/zdAwHpk4",
          "uk": "https://kiwi.tpk.lu/zdAwHpk4",
          "in": "https://kiwi.tpk.lu/suZfzffW",
          "cz": "https://kiwi.tpk.lu/4JJAeyYQ",
          "fi": "https://kiwi.tpk.lu/j9t7bFL8",
          "it": "https://kiwi.tpk.lu/3cbh2gXF",
          "dk": "https://kiwi.tpk.lu/k5RXUFYd",
          "da": "https://kiwi.tpk.lu/k5RXUFYd",
          "de": "https://kiwi.tpk.lu/FNBUJmy6",
          "nl": "https://kiwi.tpk.lu/U42dntOs",
          "pl": "https://kiwi.tpk.lu/bIz4CwgC",
          "br": "https://kiwi.tpk.lu/xF6eey3B",
          "es": "https://kiwi.tpk.lu/tBWe6mTP",
          "fr": "https://kiwi.tpk.lu/47KJwXAa"
        };

        var rawLang = (navigator.language || "en").toLowerCase();
        var parts = rawLang.split("-");
        var lang = parts[0];
        var country = parts[1] || "";

        var asiaLangs = ["ko", "ja", "zh", "th", "vi", "ms", "id", "tl"];
        var isEastAsia = asiaLangs.indexOf(lang) !== -1 && country !== "in";

        var region = (country === "us" || country === "ca")
          ? "NA"
          : (country === "in" || isEastAsia)
          ? "ASIA"
          : "EU";

        var subId = region + "_" + slug + "_search_widget";
        var url;

        if (isEastAsia) {
          url = "https://tp.media/r?marker=778331.BringonPlane&trs=574616&p=5543" +
                "&u=https%3A%2F%2Fwww.trip.com%2Fflight%2F" +
                "&sub_id=" + encodeURIComponent(subId);
        } else {
          var kiwiBase = kiwiGeoMap[country] || kiwiGeoMap[lang];
          if (!kiwiBase) {
            kiwiBase = (destVal || originVal) ? "https://kiwi.tpk.lu/7m9bs2Ap" : "https://kiwi.tpk.lu/PRoNbR8A";
          }
          url = kiwiBase + "?sub_id=" + encodeURIComponent(subId);
          if (originVal && destVal) {
            url += "&search=" + encodeURIComponent(originVal + " to " + destVal);
          } else if (destVal) {
            url += "&search=" + encodeURIComponent(destVal);
          } else if (originVal) {
            url += "&search=" + encodeURIComponent(originVal);
          }
        }

        window.open(url, "_blank", "noopener,noreferrer");
      });
    }
  })();
</script>
