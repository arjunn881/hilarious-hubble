---
/**
 * FlightSearchWidget.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Lightweight zero-dependency flight-search form card.
 * Affiliate links are built client-side (region-aware) via an inline script.
 * No server rendering — fully static.
 * ─────────────────────────────────────────────────────────────────────────────
 */

interface Props {
  defaultDestination?: string;
  airlineName?: string;
  slug?: string; // page slug for sub_id tracking
}

const { defaultDestination = "", airlineName = "", slug = "page" } = Astro.props;
---

<aside
  class="no-print my-5 rounded-lg border border-hairline bg-canvas p-4 shadow-sm"
  aria-label="Flight search"
>
  {/* ── Header row ── */}
  <div class="mb-3 flex items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-ink leading-tight">
      ✈️ Search Flights{airlineName ? ` on ${airlineName}` : ""}
    </h2>
    <span class="font-mono text-xs text-mute">Sponsored</span>
  </div>

  {/* ── Form ── */}
  <form id="flight-search-form" novalidate>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
      {/* Origin */}
      <input
        id="flight-origin"
        type="text"
        placeholder="From: city or airport code"
        autocomplete="off"
        class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
      />

      {/* Destination */}
      <input
        id="flight-dest"
        type="text"
        placeholder="To: city or airport code"
        autocomplete="off"
        value={defaultDestination}
        class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
      />

      {/* Depart date */}
      <input
        id="flight-date"
        type="date"
        class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
      />
    </div>

    <div class="mt-3">
      <button
        type="submit"
        class="rounded-md bg-link px-4 py-2 text-sm font-semibold text-white hover:bg-link-deep focus:outline-none focus:ring-2 focus:ring-link focus:ring-offset-2 active:opacity-90 transition-colors"
      >
        Search Flights →
      </button>
    </div>
  </form>
</aside>

<script define:vars={{ slug }}>
  (function () {
    var form = document.getElementById("flight-search-form");
    if (!form) return;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      // ── Region detection ──────────────────────────────────────────────────
      var lang = (navigator.language || "en").split("-")[0].toLowerCase();
      var asiaLangs = ["ko", "ja", "zh", "th", "vi", "ms", "id", "tl"];
      var euLangs   = ["de", "fr", "it", "es", "nl", "pt", "pl", "sv", "fi", "da", "no"];
      var region = asiaLangs.indexOf(lang) !== -1
        ? "ASIA"
        : euLangs.indexOf(lang) !== -1
        ? "EU"
        : "GLOBAL";

      // ── Destination param ─────────────────────────────────────────────────
      var destInput = /** @type {HTMLInputElement|null} */ (document.getElementById("flight-dest"));
      var destVal = destInput ? destInput.value.trim() : "";
      var destination = encodeURIComponent(destVal);

      // ── sub_id ────────────────────────────────────────────────────────────
      var subId = region + "_" + slug + "_search_widget";

      // ── Build affiliate URL ───────────────────────────────────────────────
      var url;
      if (region === "ASIA") {
        url =
          "https://tp.media/r?marker=PLACEHOLDER_ID&trs=PLACEHOLDER_ID&p=5543" +
          "&u=https%3A%2F%2Fwww.trip.com%2Fflight%2F" +
          "&sub_id=" + encodeURIComponent(subId);
      } else {
        url = "https://kiwi.tp.st/PLACEHOLDER_ID?sub_id=" + encodeURIComponent(subId);
        if (destVal) {
          url += "&search=" + destination;
        }
      }

      // ── GA4 event ─────────────────────────────────────────────────────────
      try {
        if (typeof window !== "undefined" && window.gtag) {
          window.gtag("event", "flight_search_submit", {
            region: region,
            destination: destVal,
            page_slug: slug,
          });
        }
      } catch (_) {}

      // ── Open in new tab ───────────────────────────────────────────────────
      window.open(url, "_blank", "noopener,noreferrer");
    });
  })();
</script>
