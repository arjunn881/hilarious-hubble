---
interface Props {
  slotId?: string;
  clientId?: string;
}

const {
  slotId = "5153849161",
  clientId = "ca-pub-8894580285912422",
} = Astro.props;
---

<!-- ── Responsive Mobile Banner (< 1000px, placed above footer) ───── -->
<div
  class="ad-mobile-unit"
  id="ad-mobile-container"
  data-client-id={clientId}
  data-slot-id={slotId}
  aria-label="Advertisement"
></div>

<script is:inline>
  function mountMobileAd() {
    if (typeof window === "undefined") return;

    var container = document.getElementById("ad-mobile-container");

    // On desktop viewports (>= 1000px), ensure container has NO ins tag
    if (window.innerWidth >= 1000) {
      if (container && container.querySelector("ins.adsbygoogle")) {
        container.innerHTML = "";
      }
      return;
    }

    // On mobile viewports (< 1000px), mount and initialize mobile ad
    if (!container || container.querySelector("ins.adsbygoogle")) return;

    var clientId = container.getAttribute("data-client-id") || "ca-pub-8894580285912422";
    var slotId = container.getAttribute("data-slot-id") || "5153849161";

    var ins = document.createElement("ins");
    ins.className = "adsbygoogle";
    ins.id = "ad-mobile-ins";
    ins.style.display = "block";
    ins.setAttribute("data-ad-client", clientId);
    ins.setAttribute("data-ad-slot", slotId);
    ins.setAttribute("data-ad-format", "auto");
    ins.setAttribute("data-full-width-responsive", "true");

    container.appendChild(ins);

    try {
      (adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {}
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountMobileAd);
  } else {
    mountMobileAd();
  }

  document.addEventListener("astro:page-load", mountMobileAd);
  window.addEventListener("resize", mountMobileAd, { passive: true });
</script>
