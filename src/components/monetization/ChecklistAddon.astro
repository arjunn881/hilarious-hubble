---
/**
 * ChecklistAddon.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Module C — Packing Checklist Monetization Section
 *
 * Renders two static recommendation blocks inside the below-fold static SEO
 * section of checklist.astro:
 *   1. eSIM / data connectivity (Airalo · Holafly)
 *   2. Travel insurance (World Nomads · Allianz)
 *
 * INVARIANT:
 *   • Zero script tags — 100% static server-rendered HTML.
 *   • No props — standalone, self-contained block.
 *   • Must NOT be placed inside any JS-controlled workspace container.
 *   • Injected once only, at the top of the static SEO section.
 *   • Uses rel="noopener noreferrer nofollow" (not sponsored — no Amazon link).
 *
 * Usage:
 *   <ChecklistAddon />
 */

import { ESIM_PARTNERS, INSURANCE_PARTNERS } from "./AffiliateConfig";

const esimCards = [
  {
    partner: ESIM_PARTNERS.airalo,
    label: "✈️ Need an eSIM?",
    detail: "Buy a local data SIM before you land — works in 200+ countries.",
    cta: "Get an eSIM on Airalo →",
  },
  {
    partner: ESIM_PARTNERS.holafly,
    label: "📶 Unlimited data abroad?",
    detail: "Holafly's unlimited eSIMs keep you connected without roaming charges.",
    cta: "Browse Holafly plans →",
  },
];

const insuranceCards = [
  {
    partner: INSURANCE_PARTNERS.worldNomads,
    label: "🛡️ Travel insurance sorted?",
    detail: "Medical cover + trip cancellation for adventurous travellers in 150+ countries.",
    cta: "Quote from World Nomads →",
  },
  {
    partner: INSURANCE_PARTNERS.allianz,
    label: "🏥 Need health coverage?",
    detail: "Allianz covers cancellations, emergencies, and lost baggage globally.",
    cta: "Get an Allianz quote →",
  },
];
---

<section
  class="monetization-checklist-addon no-print mb-12"
  aria-label="Travel essentials: eSIM and insurance recommendations"
>
  {/* ── eSIM Block ─────────────────────────────────────────────────────────── */}
  <div class="mb-8">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-1 h-5 rounded-full bg-gradient-to-b from-link to-link/40"></div>
      <h3 class="text-sm font-semibold tracking-[-0.3px] text-ink">
        Stay Connected Abroad — eSIM Data Plans
      </h3>
      <span class="ml-auto text-[10px] font-mono text-mute bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs">
        SPONSORED
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {esimCards.map(({ partner, label, detail, cta }) => (
        <a
          href={partner.url}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="group flex items-start gap-3 p-4 rounded-md border border-hairline bg-canvas hover:border-link/40 hover:shadow-sm transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          aria-label={`${label} — ${partner.name}`}
        >
          {/* Signal icon */}
          <div class="flex-shrink-0 w-8 h-8 rounded-sm bg-link-bg-soft border border-link/20 flex items-center justify-center group-hover:bg-link/10 transition-colors mt-0.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="text-link" aria-hidden="true">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
              <circle cx="12" cy="20" r="1" fill="currentColor"/>
            </svg>
          </div>

          {/* Text */}
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-ink mb-0.5 group-hover:text-link transition-colors">
              {label}
            </p>
            <p class="text-[11px] text-body leading-snug mb-1.5 line-clamp-2">
              {detail}
            </p>
            <span class="inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-link group-hover:underline">
              {cta}
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  {/* ── Insurance Block ─────────────────────────────────────────────────────── */}
  <div>
    <div class="flex items-center gap-2 mb-4">
      <div class="w-1 h-5 rounded-full bg-gradient-to-b from-warning-deep to-warning-deep/40"></div>
      <h3 class="text-sm font-semibold tracking-[-0.3px] text-ink">
        Travel Insurance — Don't Fly Unprotected
      </h3>
      <span class="ml-auto text-[10px] font-mono text-mute bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs">
        SPONSORED
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {insuranceCards.map(({ partner, label, detail, cta }) => (
        <a
          href={partner.url}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="group flex items-start gap-3 p-4 rounded-md border border-hairline bg-canvas hover:border-warning/40 hover:shadow-sm transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warning focus-visible:ring-offset-2"
          aria-label={`${label} — ${partner.name}`}
        >
          {/* Shield icon */}
          <div class="flex-shrink-0 w-8 h-8 rounded-sm bg-warning-soft border border-warning/20 flex items-center justify-center group-hover:bg-warning/10 transition-colors mt-0.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-warning-deep" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>

          {/* Text */}
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-ink mb-0.5 group-hover:text-warning-deep transition-colors">
              {label}
            </p>
            <p class="text-[11px] text-body leading-snug mb-1.5 line-clamp-2">
              {detail}
            </p>
            <span class="inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-warning-deep group-hover:underline">
              {cta}
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  {/* FTC disclosure */}
  <p class="mt-4 text-[10px] text-mute font-mono leading-relaxed">
    <svg class="inline w-3 h-3 mr-0.5 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
    </svg>
    Partner links above are affiliate referrals. BringOnPlane may earn a commission at no extra cost to you.
  </p>
</section>
