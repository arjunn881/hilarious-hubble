---
/**
 * BagPromoBanner.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Module B — Airline Policy Page Luggage Recommendation Banner
 *
 * Renders a visually distinct carry-on bag recommendation card directly below
 * an airline's policy/dimensions block. Brand is matched to the airline slug
 * via AIRLINE_LUGGAGE_MAP; falls back to LUGGAGE_FALLBACK for unknown slugs.
 *
 * INVARIANT:
 *   • Zero script tags — 100% static server-rendered HTML.
 *   • Does NOT read or modify any airline data collections.
 *   • Reads only from AffiliateConfig.ts.
 *
 * Usage:
 *   <BagPromoBanner airlineName="Ryanair" airlineSlug="ryanair" />
 */

import {
  AIRLINE_LUGGAGE_MAP,
  LUGGAGE_FALLBACK,
  AMAZON_TAG,
  AMAZON_DOMAIN,
} from "./AffiliateConfig";

interface Props {
  /** Human-readable airline name, e.g. "Ryanair" */
  airlineName: string;
  /**
   * URL-safe airline slug matching the key in AIRLINE_LUGGAGE_MAP,
   * e.g. "ryanair", "delta-air-lines"
   */
  airlineSlug: string;
}

const { airlineName, airlineSlug } = Astro.props;

const brand = AIRLINE_LUGGAGE_MAP[airlineSlug] ?? LUGGAGE_FALLBACK;

function buildAmazonUrl(search: string): string {
  const params = new URLSearchParams({ k: search, tag: AMAZON_TAG });
  return `https://www.${AMAZON_DOMAIN}/s?${params.toString()}`;
}

const href = buildAmazonUrl(brand.amazonSearch);
---

<aside
  class="monetization-bag-promo-banner mt-8 no-print"
  aria-label={`Carry-on bag recommendation for ${airlineName}`}
>
  <a
    href={href}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class="group flex items-start gap-4 p-5 rounded-lg border border-[#FF9900]/30 bg-gradient-to-r from-[#FF9900]/6 to-[#FF9900]/3 hover:from-[#FF9900]/12 hover:to-[#FF9900]/6 hover:border-[#FF9900]/55 hover:shadow-md transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF9900] focus-visible:ring-offset-2"
    aria-label={`Shop ${brand.name} carry-on bags for ${airlineName} — opens Amazon`}
  >
    {/* Luggage icon badge */}
    <div class="flex-shrink-0 w-10 h-10 rounded-md bg-[#FF9900]/10 border border-[#FF9900]/25 flex items-center justify-center group-hover:bg-[#FF9900]/20 transition-colors mt-0.5">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c47800" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="6" width="14" height="16" rx="2"/>
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        <line x1="12" y1="11" x2="12" y2="17"/>
        <line x1="9" y1="14" x2="15" y2="14"/>
      </svg>
    </div>

    {/* Text block */}
    <div class="flex-1 min-w-0">
      <p class="text-[10px] font-mono font-semibold text-[#a06400] uppercase tracking-wider mb-1">
        🎒 Carry-On Recommendation
      </p>
      <p class="text-sm font-semibold text-ink leading-snug mb-1 group-hover:text-[#c47800] transition-colors">
        Need a guaranteed carry-on for {airlineName}?&nbsp;
        <span class="text-[#c47800]">Check out {brand.name} bags →</span>
      </p>
      <p class="text-xs text-body leading-relaxed line-clamp-2">
        {brand.pitch}
      </p>
    </div>

    {/* External link icon */}
    <div class="flex-shrink-0 self-center opacity-50 group-hover:opacity-100 transition-opacity">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c47800" stroke-width="2.5" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </div>
  </a>

  {/* FTC disclosure */}
  <p class="mt-2 text-[10px] text-mute font-mono leading-relaxed">
    <svg class="inline w-3 h-3 mr-0.5 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
    </svg>
    As an Amazon Associate, BringOnPlane earns from qualifying purchases. Prices may vary.
  </p>
</aside>
