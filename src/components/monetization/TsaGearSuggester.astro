---
/**
 * TsaGearSuggester.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Module A — Search Results / Item Detail CTA Injector
 *
 * Renders 0–2 contextual Amazon micro-CTAs adjacent to the item's status cards,
 * matched against the item's name, category, and keywords.
 *
 * INVARIANT:
 *   • Zero script tags — 100% static server-rendered HTML.
 *   • Does NOT import or modify any existing item/TSA data files.
 *   • Must be placed as a sibling AFTER the status cards, BEFORE AmazonAffiliateBox.
 *
 * Usage:
 *   <TsaGearSuggester
 *     category={item.category}
 *     itemName={itemName}
 *     carryOnStatus={item.carryOn.status}
 *     keywords={item.keywords}
 *   />
 */

import {
  KEYWORD_CTAs,
  AMAZON_TAG,
  AMAZON_DOMAIN,
  AMAZON_TAG_IN,
  AMAZON_DOMAIN_IN,
  type KeywordCta,
} from "./AffiliateConfig";

interface Props {
  /** Item category string, e.g. "Liquids", "Electronics", "Medicine" */
  category: string;
  /** Localized or canonical item name, e.g. "Shampoo" */
  itemName: string;
  /** TSA carry-on rule status: "ALLOWED" | "NOT_ALLOWED" | "RESTRICTED" | "UNKNOWN" */
  carryOnStatus: string;
  /** Raw keywords array from the item data */
  keywords?: string[];
}

const { category, itemName, carryOnStatus, keywords = [] } = Astro.props;

/**
 * Builds a normalised signal string from all item context fields.
 * Checked case-insensitively against each CTA's matchTerms array.
 */
const signalText = [
  itemName,
  category,
  ...keywords,
].join(" ").toLowerCase();

/** Return the first N matching CTAs (max 2 to keep UI minimal). */
function matchCtAs(signal: string, max = 2): KeywordCta[] {
  const matched: KeywordCta[] = [];
  for (const cta of KEYWORD_CTAs) {
    if (cta.matchTerms.some((term) => signal.includes(term))) {
      matched.push(cta);
      if (matched.length >= max) break;
    }
  }
  return matched;
}

const matchedCtas = matchCtAs(signalText);

/** Build an Amazon search URL from a query string. */
function buildAmazonUrl(search: string): string {
  const params = new URLSearchParams({ k: search, tag: AMAZON_TAG });
  return `https://www.${AMAZON_DOMAIN}/s?${params.toString()}`;
}

function buildAmazonUrlIN(search: string): string {
  const params = new URLSearchParams({ k: search, tag: AMAZON_TAG_IN });
  return `https://www.${AMAZON_DOMAIN_IN}/s?${params.toString()}`;
}
---

{matchedCtas.length > 0 && (
  <>
    {/* ── Global block: amazon.com (bringonplane-20) — visible everywhere ── */}
    <section class="monetization-gear-suggester mb-4 no-print" aria-label="Recommended travel gear" data-global-amazon="true">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {matchedCtas.map((cta) => {
          const href = buildAmazonUrl(cta.amazonSearch);
          return (
            <a href={href} target="_blank" rel="nofollow sponsored noopener noreferrer"
              class="group flex items-start gap-2.5 p-3 rounded-lg border border-[#FF9900]/25 bg-[#FF9900]/5 hover:bg-[#FF9900]/10 hover:border-[#FF9900]/50 hover:shadow-xs transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF9900] focus-visible:ring-offset-2"
              aria-label={`${cta.label} — opens Amazon`}>
              <span class="flex-shrink-0 w-7 h-7 rounded-md bg-[#FF9900]/10 border border-[#FF9900]/20 flex items-center justify-center group-hover:bg-[#FF9900]/20 transition-colors mt-0.5">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <text x="4" y="16" font-family="Arial,sans-serif" font-size="13" font-weight="700" fill="#c47800">a</text>
                  <path d="M5 19 Q12 22 19 19" stroke="#c47800" stroke-width="1.8" stroke-linecap="round" fill="none"/>
                  <path d="M17.5 17.5 L19 19 L17.5 20.5" stroke="#c47800" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </span>
              <span class="flex-1 min-w-0">
                <span class="flex items-center justify-between gap-1.5 mb-0.5">
                  <span class="block text-xs font-semibold text-ink group-hover:text-[#c47800] transition-colors leading-snug line-clamp-1">{cta.label}</span>
                  {cta.badge && (<span class="flex-shrink-0 text-[9px] font-mono font-semibold px-1.5 py-0.2 rounded-xs bg-[#FF9900]/12 border border-[#FF9900]/30 text-[#a06400] uppercase tracking-wide whitespace-nowrap">{cta.badge}</span>)}
                </span>
                <span class="block text-[11px] text-body leading-snug line-clamp-1">{cta.why}</span>
              </span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#c47800" stroke-width="2.5" aria-hidden="true" class="opacity-50 group-hover:opacity-100 transition-opacity flex-shrink-0 mt-1">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          );
        })}
      </div>
    </section>

    {/* ── India-only block: amazon.in (arjunanayak-21) — hidden until geo confirms India ── */}
    <section class="monetization-gear-suggester mb-4 no-print" aria-label="Recommended travel gear" data-india-only="true" style="display:none">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {matchedCtas.map((cta) => {
          const href = buildAmazonUrlIN(cta.amazonSearch);
          return (
            <a href={href} target="_blank" rel="nofollow sponsored noopener noreferrer"
              class="group flex items-start gap-2.5 p-3 rounded-lg border border-[#FF9900]/25 bg-[#FF9900]/5 hover:bg-[#FF9900]/10 hover:border-[#FF9900]/50 hover:shadow-xs transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF9900] focus-visible:ring-offset-2"
              aria-label={`${cta.label} — opens Amazon`}>
              <span class="flex-shrink-0 w-7 h-7 rounded-md bg-[#FF9900]/10 border border-[#FF9900]/20 flex items-center justify-center group-hover:bg-[#FF9900]/20 transition-colors mt-0.5">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <text x="4" y="16" font-family="Arial,sans-serif" font-size="13" font-weight="700" fill="#c47800">a</text>
                  <path d="M5 19 Q12 22 19 19" stroke="#c47800" stroke-width="1.8" stroke-linecap="round" fill="none"/>
                  <path d="M17.5 17.5 L19 19 L17.5 20.5" stroke="#c47800" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </span>
              <span class="flex-1 min-w-0">
                <span class="flex items-center justify-between gap-1.5 mb-0.5">
                  <span class="block text-xs font-semibold text-ink group-hover:text-[#c47800] transition-colors leading-snug line-clamp-1">{cta.label}</span>
                  {cta.badge && (<span class="flex-shrink-0 text-[9px] font-mono font-semibold px-1.5 py-0.2 rounded-xs bg-[#FF9900]/12 border border-[#FF9900]/30 text-[#a06400] uppercase tracking-wide whitespace-nowrap">{cta.badge}</span>)}
                </span>
                <span class="block text-[11px] text-body leading-snug line-clamp-1">{cta.why}</span>
              </span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#c47800" stroke-width="2.5" aria-hidden="true" class="opacity-50 group-hover:opacity-100 transition-opacity flex-shrink-0 mt-1">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          );
        })}
      </div>
    </section>
  </>
)}
