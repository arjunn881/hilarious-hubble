---
/**
 * TravelServicesBar.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Compact above-the-fold affiliate strip.
 *
 * Placement: right after the page verdict/answer banner, before article body.
 * Designed to be visible at-a-glance without disrupting the main content or SEO.
 *
 * Layout:
 *   - One row of horizontally-scrollable pill-shaped service links
 *   - AirHelp given emphasis (free for users, highest CTR)
 *   - All services clearly labeled via icon + short name
 *
 * INVARIANT:
 *   • Zero client JavaScript — 100% static HTML.
 *   • No props needed — self-contained.
 *   • Clearly labelled "Sponsored" per AdSense policy.
 *   • rel="noopener noreferrer nofollow sponsored" on all links.
 * ─────────────────────────────────────────────────────────────────────────────
 */

import {
  ESIM_PARTNERS,
  INSURANCE_PARTNERS,
  AIRPORT_PARTNERS,
} from "./AffiliateConfig";
---

<aside
  class="no-print my-5 rounded-lg border border-hairline bg-canvas-soft px-4 py-3"
  aria-label="Travel tools and services"
>
  {/* Scrollable pill row */}
  <div class="flex flex-wrap gap-2">

    {/* AirHelp — primary, green pill */}
    <a
      href={AIRPORT_PARTNERS.airhelp.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500 hover:bg-emerald-600 transition-colors text-white text-[11px] font-semibold shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Check flight compensation eligibility with AirHelp — free"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 8v4l3 3"/>
      </svg>
      Claim flight compensation
    </a>

    {/* Yesim eSIM */}
    <a
      href={ESIM_PARTNERS.yesim.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-link/40 hover:bg-link-bg-soft transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Travel eSIM plans from Yesim"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-link" aria-hidden="true">
        <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
        <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
        <circle cx="12" cy="20" r="1" fill="currentColor"/>
      </svg>
      Travel eSIM
    </a>

    {/* EKTA Insurance */}
    <a
      href={INSURANCE_PARTNERS.ekta.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-warning/40 hover:bg-warning-soft transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warning focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Travel insurance from EKTA"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-warning-deep" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      Travel insurance
    </a>

    {/* Radical Storage */}
    <a
      href={AIRPORT_PARTNERS.radicalStorage.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-amber-500/40 hover:bg-amber-500/[0.06] transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Luggage storage from Radical Storage"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 dark:text-amber-400" aria-hidden="true">
        <rect x="3" y="7" width="18" height="14" rx="2"/>
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
      </svg>
      Luggage storage
    </a>

    {/* Kiwitaxi */}
    <a
      href={AIRPORT_PARTNERS.kiwitaxi.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-purple-500/40 hover:bg-purple-500/[0.06] transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Airport taxi and transfers from Kiwitaxi"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-600 dark:text-purple-400" aria-hidden="true">
        <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v9a2 2 0 0 1-2 2h-2"/>
        <circle cx="8" cy="17" r="2"/>
        <circle cx="16" cy="17" r="2"/>
      </svg>
      Airport transfer
    </a>

    {/* Klook */}
    <a
      href={AIRPORT_PARTNERS.klook.url}
      target="_blank"
      rel="noopener noreferrer nofollow sponsored"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-sky-500/40 hover:bg-sky-500/[0.06] transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 whitespace-nowrap"
      aria-label="Airport trains and city passes from Klook"
    >
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-600 dark:text-sky-400" aria-hidden="true">
        <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
        <line x1="12" y1="5" x2="12" y2="19" stroke-dasharray="2 2"/>
      </svg>
      Train passes
    </a>

  </div>
</aside>
