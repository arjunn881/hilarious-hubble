---
/**
 * TravelServicesBar.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Intent-driven above-the-fold affiliate strip.
 * Capped at 4 high-intent utility pills:
 *   1. ✈️ Compare flights (geo-routed)
 *   2. 📱 Travel eSIM
 *   3. 🚆 Airport trains & passes
 *   4. 🧳 Luggage storage
 *
 * All links use sub_id tracking via buildAffiliateUrl and are marked rel="nofollow sponsored noopener".
 * ─────────────────────────────────────────────────────────────────────────────
 */

import { AFFILIATE_MATRIX } from "./AffiliateConfig";
import { buildAffiliateUrl } from "../../utils/getContextualAffiliates";

interface Props {
  slug?: string;
}

const { slug = "travel" } = Astro.props;

const kiwiOffer = AFFILIATE_MATRIX.find((o) => o.id === "kiwi_flights")!;
const yesimOffer = AFFILIATE_MATRIX.find((o) => o.id === "yesim")!;
const klookOffer = AFFILIATE_MATRIX.find((o) => o.id === "klook")!;
const storageOffer = AFFILIATE_MATRIX.find((o) => o.id === "radical_storage")!;

const flightsUrl = buildAffiliateUrl(kiwiOffer.baseUrl, { slug, slot: "pill", region: "GLOBAL" });
const esimUrl = buildAffiliateUrl(yesimOffer.baseUrl, { slug, slot: "pill", region: "GLOBAL" });
const trainsUrl = buildAffiliateUrl(klookOffer.baseUrl, { slug, slot: "pill", region: "GLOBAL" });
const storageUrl = buildAffiliateUrl(storageOffer.baseUrl, { slug, slot: "pill", region: "GLOBAL" });
---

<aside
  class="no-print my-4 rounded-lg border border-hairline bg-canvas-soft px-3.5 py-2.5"
  aria-label="Travel tools and services"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    {/* 4 intentional pills */}
    <div class="flex flex-wrap items-center gap-2">
      {/* 1. Compare flights (primary blue pill, client-side geo-routed) */}
      <a
        id="flights-pill"
        href={flightsUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-link hover:bg-link-deep transition-colors text-white text-[11px] font-semibold shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 whitespace-nowrap"
        aria-label="Compare live flight deals"
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
        </svg>
        Compare flights
      </a>

      {/* 2. Travel eSIM */}
      <a
        href={esimUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-link/40 hover:bg-link-bg-soft transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 whitespace-nowrap"
        aria-label="Travel eSIM plans from Yesim"
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-link" aria-hidden="true">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
          <circle cx="12" cy="20" r="1" fill="currentColor"/>
        </svg>
        Travel eSIM
      </a>

      {/* 3. Airport trains & passes */}
      <a
        href={trainsUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-sky-500/40 hover:bg-sky-500/[0.06] transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 whitespace-nowrap"
        aria-label="Airport express trains and rail passes from Klook"
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-600 dark:text-sky-400" aria-hidden="true">
          <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
          <line x1="12" y1="5" x2="12" y2="19" stroke-dasharray="2 2"/>
        </svg>
        Airport trains &amp; passes
      </a>

      {/* 4. Luggage storage */}
      <a
        href={storageUrl}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
        class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline bg-canvas hover:border-amber-500/40 hover:bg-amber-500/[0.06] transition-colors text-ink text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 whitespace-nowrap"
        aria-label="Luggage storage from Radical Storage"
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 dark:text-amber-400" aria-hidden="true">
          <rect x="3" y="7" width="18" height="14" rx="2"/>
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
        Luggage storage
      </a>
    </div>

    {/* Discreet Sponsored badge */}
    <span class="text-[10px] font-mono text-mute ml-auto">Sponsored</span>
  </div>
</aside>

<script is:inline define:vars={{ slug }}>
  (function () {
    try {
      var pill = document.getElementById("flights-pill");
      if (!pill) return;
      var lang = (navigator.language || "en").split("-")[0].toLowerCase();
      var asiaLangs = ["ko", "ja", "zh", "th", "vi", "ms", "id", "tl"];
      if (asiaLangs.indexOf(lang) !== -1) {
        var subId = "ASIA_" + slug + "_pill";
        pill.href = "https://tp.media/r?marker=PLACEHOLDER_ID&trs=PLACEHOLDER_ID&p=5543&u=https%3A%2F%2Fwww.trip.com%2F&sub_id=" + encodeURIComponent(subId);
      }
    } catch (_) {}
  })();
</script>
