---
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getAllItems, getItemBySlug } from "../../../../lib/items";
import { ArrowLeft, Landmark, BadgeCheck, HelpCircle, ChevronDown } from "@lucide/astro";

export async function getStaticPaths() {
  const items = getAllItems();
  
  const countries = [
    { slug: "canada", name: "Canada", agency: "CATSA", declarationLimit: "Requires declaration for foods, plants, and select medicines." },
    { slug: "japan", name: "Japan", agency: "JCAB", declarationLimit: "Strict limits on certain prescription medications and stimulants." },
    { slug: "united-kingdom", name: "United Kingdom", agency: "DFT", declarationLimit: "Liquids must travel in a single transparent resealable bag." },
    { slug: "germany", name: "Germany", agency: "Federal Police", declarationLimit: "Medicines must comply with German Pharmacy regulations." },
    { slug: "france", name: "France", agency: "DGAC", declarationLimit: "Duty-free liquid purchase declarations require original sales receipts." },
    { slug: "usa", name: "United States", agency: "TSA", declarationLimit: "Agricultural imports and cash amounts exceeding $10,000 must be declared." },
    { slug: "australia", name: "Australia", agency: "ABF", declarationLimit: "Strict biosecurity screening. Declare all food items, seeds, and wood." },
    { slug: "singapore", name: "Singapore", agency: "CAAS", declarationLimit: "Chewing gum and select prescription drugs require import permits." }
  ];

  const paths = [];
  for (const item of items) {
    for (const country of countries) {
      paths.push({
        params: { slug: item.slug, country: country.slug },
        props: { itemSummary: item, country }
      });
    }
  }
  return paths;
}

const { itemSummary, country } = Astro.props;
const item = getItemBySlug(itemSummary.slug);
if (!item) {
  return Astro.redirect("/404");
}

const currentUrl = new URL(Astro.url.pathname, "https://bringonplane.com").toString();

// SEO Parameters
const seoTitle = `Can You Bring ${item.name} to ${country.name}? Customs & Baggage Rules (2026)`;
const seoDescription = `Read customs rules and aviation security policies for carrying ${item.name.toLowerCase()} to ${country.name}. Learn about declaration limits and prohibited items.`;

// 8 Unique FAQs generation
const faqs = [
  {
    q: `Can I bring ${item.name.toLowerCase()} to ${country.name}?`,
    a: `Yes, you can carry it, subject to local customs regulations. At airport security checks, ${country.name} (${country.agency}) rules apply: carry-on status is ${item.carryOn.status.replace("_", " ")} and checked baggage is ${item.checkedBag.status.replace("_", " ")}.`
  },
  {
    q: `Do I need to declare ${item.name.toLowerCase()} at ${country.name} customs?`,
    a: `For most consumer goods, declaration isn't required. However, ${country.declarationLimit}`
  },
  {
    q: `Is ${item.name.toLowerCase()} prohibited in Checked bags when flying to ${country.name}?`,
    a: `${item.checkedBag.status === 'ALLOWED' ? `No, ${country.name} allows packing it in your checked holds.` : `Yes, aviation rules prohibit packing ${item.name.toLowerCase()} in checked holds.`}`
  },
  {
    q: `What happens if I fail to declare restricted ${item.name.toLowerCase()} in ${country.name}?`,
    a: `Customs agents will confiscate the item, and you could face significant delays, fines, or loss of duty-free entry privileges.`
  },
  {
    q: `Can I travel with medical ${item.name.toLowerCase()} to ${country.name}?`,
    a: `Yes, but ensure you carry a doctor's prescription or original packaging to clear security checks smoothly.`
  },
  {
    q: `Does ${country.name} allow carrying lithium batteries like ${item.name.toLowerCase()}?`,
    a: `Yes, but batteries must be under 100Wh (or 160Wh with airline approval) and carried in the cabin only.`
  },
  {
    q: `How does ${country.name} airport security screen my ${item.name.toLowerCase()}?`,
    a: `Security checkpoints utilize X-ray screening and manual baggage checks. Be prepared to remove it from your bag if requested.`
  },
  {
    q: `Are liquid rules for ${item.name.toLowerCase()} different in ${country.name}?`,
    a: `No. Most airports globally enforce the standard 3-1-1 limit (under 100ml / 3.4 oz per container in carry-on bags).`
  }
];

// Schema JSON-LD blocks
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bringonplane.com/" },
    { "@type": "ListItem", "position": 2, "name": "Items", "item": "https://bringonplane.com/items" },
    { "@type": "ListItem", "position": 3, "name": item.name, "item": `https://bringonplane.com/items/${item.slug}` },
    { "@type": "ListItem", "position": 4, "name": country.name, "item": currentUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <link rel="canonical" href={currentUrl} slot="head" />

  <Header slot="header" />

  <div class="max-w-[800px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <!-- Navigation back link -->
    <div class="mb-8 select-none">
      <a href={`/items/${item.slug}`} class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Back to {item.name}
      </a>
    </div>

    <!-- Header Block -->
    <header class="mb-10">
      <span class="font-mono text-[10px] font-semibold text-link bg-link-bg-soft border border-link/15 px-2.5 py-0.5 rounded-xs uppercase tracking-wider block w-max mb-3">
        Customs & Border Control (2026)
      </span>
      <h1 class="text-3xl font-semibold tracking-[-1.2px] text-ink leading-[1.25]">
        Can You Bring {item.name} to {country.name}?
      </h1>
      <p class="text-sm text-body mt-2 leading-[1.6]">
        A comprehensive guide on customs declaration and security rules for carrying {item.name.toLowerCase()} to {country.name} via international flight routes.
      </p>
    </header>

    <!-- Allowance Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
      
      <!-- Carry-on Cabin Card -->
      <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-[9px] font-mono font-semibold uppercase text-mute tracking-wider block mb-1">Carry-on Cabin Bag</span>
          <div class="flex items-center gap-2 mb-3">
            <span class={`w-2.5 h-2.5 rounded-full ${item.carryOn.status === 'ALLOWED' ? 'bg-success' : item.carryOn.status === 'NOT_ALLOWED' ? 'bg-error' : 'bg-warning'}`}></span>
            <span class="text-lg font-bold text-ink tracking-tight uppercase">{item.carryOn.status.replace("_", " ")}</span>
          </div>
          <p class="text-xs text-body leading-[1.5]">
            {item.carryOn.reason}
          </p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline/60 flex items-center justify-between text-[10px] font-mono text-mute">
          <span>Security Agency</span>
          <strong class="text-ink">{country.agency} Guidelines</strong>
        </div>
      </div>

      <!-- Checked Bag Hold Card -->
      <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-[9px] font-mono font-semibold uppercase text-mute tracking-wider block mb-1">Checked Hold Baggage</span>
          <div class="flex items-center gap-2 mb-3">
            <span class={`w-2.5 h-2.5 rounded-full ${item.checkedBag.status === 'ALLOWED' ? 'bg-success' : item.checkedBag.status === 'NOT_ALLOWED' ? 'bg-error' : 'bg-warning'}`}></span>
            <span class="text-lg font-bold text-ink tracking-tight uppercase">{item.checkedBag.status.replace("_", " ")}</span>
          </div>
          <p class="text-xs text-body leading-[1.5]">
            {item.checkedBag.reason}
          </p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline/60 flex items-center justify-between text-[10px] font-mono text-mute">
          <span>Customs Authority</span>
          <strong class="text-ink">{country.name} Boarder Entry</strong>
        </div>
      </div>

    </div>

    <!-- Customs Declaration Warning Panel -->
    <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm mb-10 select-none">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-sm bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
          <Landmark class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-sm font-semibold text-ink">{country.name} Border Control Policy</h3>
          <p class="text-xs text-body leading-[1.6] mt-1">
            {country.declarationLimit} Check with official consulate sources if carrying large commercial quantities or specialized equipment.
          </p>
          <div class="flex items-center gap-4 mt-3 text-[10px] font-mono text-mute">
            <span>Last reviewed: June 2026</span>
            <span>&bull;</span>
            <span>Reviewed by BringOnPlane Editorial Team</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Accompanying accordion FAQs -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-5 border-b border-hairline pb-3">
        <HelpCircle class="w-4 h-4 text-mute" />
        <h2 class="text-lg font-semibold tracking-[-0.4px] text-ink">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <div class="border border-hairline rounded-md bg-canvas shadow-sm">
            <button 
              type="button" 
              class="faq-header-btn w-full text-left px-5 py-4 flex items-center justify-between text-sm font-semibold text-ink hover:bg-canvas-soft transition-colors cursor-pointer outline-none select-none"
              data-target={`faq-body-${idx}`}
            >
              <span>{faq.q}</span>
              <ChevronDown class="w-4 h-4 text-mute transition-transform duration-200" />
            </button>
            <div id={`faq-body-${idx}`} class="hidden px-5 pb-4 text-xs text-body leading-[1.6] border-t border-hairline/40 pt-3">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Regulatory Disclaimer -->
    <footer class="text-[10px] font-mono text-mute leading-[1.6] border-t border-hairline pt-6 select-none">
      <p>
        <strong>Disclaimer:</strong> International customs guidelines are subject to change. While BringOnPlane updates logs frequently, travelers must confirm limits with consulate offices prior to departure.
      </p>
    </footer>

  </div>

  <Footer slot="footer" />
</Layout>

<script>
  // Setup accordion toggle listeners
  document.querySelectorAll(".faq-header-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const targetId = (e.currentTarget as HTMLElement).getAttribute("data-target") || "";
      const body = document.getElementById(targetId);
      const icon = (e.currentTarget as HTMLElement).querySelector("svg");
      
      if (body) {
        const isHidden = body.classList.contains("hidden");
        if (isHidden) {
          body.classList.remove("hidden");
          if (icon) icon.classList.add("rotate-180");
        } else {
          body.classList.add("hidden");
          if (icon) icon.classList.remove("rotate-180");
        }
      }
    });
  });
</script>
