---
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getAllItems, getItemBySlug } from "../../../../lib/items";
import { ArrowLeft, ShieldAlert, BadgeCheck, HelpCircle, ChevronDown } from "@lucide/astro";

export async function getStaticPaths() {
  const items = getAllItems();
  
  const airlines = [
    { slug: "delta", name: "Delta Air Lines", cabinLimit: "10 kg (22 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "united", name: "United Airlines", cabinLimit: "8 kg (17 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "american", name: "American Airlines", cabinLimit: "10 kg (22 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "lufthansa", name: "Lufthansa", cabinLimit: "8 kg (17 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "air-france", name: "Air France", cabinLimit: "12 kg (26 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "british-airways", name: "British Airways", cabinLimit: "23 kg (50 lbs)", checkedLimit: "23 kg (50 lbs)" },
    { slug: "ryanair", name: "Ryanair", cabinLimit: "10 kg (22 lbs)", checkedLimit: "20 kg (44 lbs)" },
    { slug: "emirates", name: "Emirates", cabinLimit: "7 kg (15 lbs)", checkedLimit: "30 kg (66 lbs)" },
    { slug: "singapore-airlines", name: "Singapore Airlines", cabinLimit: "7 kg (15 lbs)", checkedLimit: "30 kg (66 lbs)" }
  ];

  const paths = [];
  for (const item of items) {
    for (const airline of airlines) {
      paths.push({
        params: { slug: item.slug, airline: airline.slug },
        props: { itemSummary: item, airline }
      });
    }
  }
  return paths;
}

const { itemSummary, airline } = Astro.props;
const item = getItemBySlug(itemSummary.slug);
if (!item) {
  return Astro.redirect("/404");
}

const currentUrl = new URL(Astro.url.pathname, "https://bringonplane.com").toString();

// SEO Parameters
const seoTitle = `Can You Bring ${item.name} on ${airline.name}? Carry-on & Checked Rules (2026)`;
const seoDescription = `Learn whether you can bring ${item.name.toLowerCase()} on ${airline.name} flights. Read official TSA regulations, cabin limits, and checked bag rules.`;

// 8 Unique FAQs generation
const faqs = [
  {
    q: `Can I bring ${item.name.toLowerCase()} on ${airline.name} flights?`,
    a: `Yes, carriage depends on bag type. Under TSA and ${airline.name} rules, ${item.name.toLowerCase()} has carry-on status: ${item.carryOn.status.replace("_", " ")} and checked bag status: ${item.checkedBag.status.replace("_", " ")}.`
  },
  {
    q: `Can I pack ${item.name.toLowerCase()} in checked luggage on ${airline.name}?`,
    a: `${item.checkedBag.status === 'ALLOWED' ? `Yes, ${airline.name} allows packing ${item.name.toLowerCase()} in checked baggage holds.` : item.checkedBag.status === 'RESTRICTED' ? `Checked bag carriage is restricted. ${item.checkedBag.reason}` : `No, ${airline.name} prohibits packing ${item.name.toLowerCase()} in checked luggage holds due to aviation safety rules.`}`
  },
  {
    q: `Can I carry ${item.name.toLowerCase()} in my cabin bag on ${airline.name}?`,
    a: `${item.carryOn.status === 'ALLOWED' ? `Yes, you can carry it in your carry-on bag. Just ensure it conforms to cabin size limits.` : item.carryOn.status === 'RESTRICTED' ? `Cabin carriage is restricted: ${item.carryOn.reason}` : `No, TSA and ${airline.name} prohibit carrying ${item.name.toLowerCase()} in cabin luggage.`}`
  },
  {
    q: `What is the ${airline.name} weight limit for baggage containing ${item.name.toLowerCase()}?`,
    a: `For cabin bags, ${airline.name} enforces a limit of ${airline.cabinLimit}. For checked luggage, the standard weight limit is ${airline.checkedLimit} per bag.`
  },
  {
    q: `Will TSA inspect my ${item.name.toLowerCase()} at the checkpoint?`,
    a: `Yes, security officers inspect all items. If ${item.name.toLowerCase()} is flagged, they will perform manual baggage audits or physical screening.`
  },
  {
    q: `Can airlines like ${airline.name} ban ${item.name.toLowerCase()} even if TSA allows it?`,
    a: `Yes. Under IATA rules, airline operators can impose stricter regulations than TSA or FAA guidelines for hazardous, lithium, or liquid carriage.`
  },
  {
    q: `Are there restrictions for carrying ${item.name.toLowerCase()} internationally on ${airline.name}?`,
    a: `Yes. For international routes, destination customs agencies (e.g. EU security, Japan Customs) may enforce different guidelines than domestic TSA rules.`
  },
  {
    q: `What happens if I pack a prohibited ${item.name.toLowerCase()} in my checked bag?`,
    a: `Security inspectors will confiscate the item, and the baggage will be delayed. If it violates FAA hazardous material protocols, airlines may impose fines.`
  }
];

// Schema JSON-LD blocks
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bringonplane.com/" },
    { "@type": "ListItem", "position": 2, "name": "Items", "item": "https://bringonplane.com/items" },
    { "@type": "ListItem", "position": 3, "name": item.name, "item": `https://bringonplane.com/items/${item.slug}` },
    { "@type": "ListItem", "position": 4, "name": airline.name, "item": currentUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <link rel="canonical" href={currentUrl} slot="head" />

  <Header slot="header" />

  <div class="max-w-[800px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <!-- Navigation back link -->
    <div class="mb-8 select-none">
      <a href={`/items/${item.slug}`} class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Back to {item.name}
      </a>
    </div>

    <!-- Header Block -->
    <header class="mb-10">
      <span class="font-mono text-[10px] font-semibold text-link bg-link-bg-soft border border-link/15 px-2.5 py-0.5 rounded-xs uppercase tracking-wider block w-max mb-3">
        Airline Regulations (2026)
      </span>
      <h1 class="text-3xl font-semibold tracking-[-1.2px] text-ink leading-[1.25]">
        Can You Bring {item.name} on {airline.name}?
      </h1>
      <p class="text-sm text-body mt-2 leading-[1.6]">
        A detailed guide on flying with {item.name.toLowerCase()} on {airline.name} flights, including FAA battery safety regulations and airport security guidelines.
      </p>
    </header>

    <!-- Allowance Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
      
      <!-- Carry-on Cabin Card -->
      <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-[9px] font-mono font-semibold uppercase text-mute tracking-wider block mb-1">Carry-on Cabin Bag</span>
          <div class="flex items-center gap-2 mb-3">
            <span class={`w-2.5 h-2.5 rounded-full ${item.carryOn.status === 'ALLOWED' ? 'bg-success' : item.carryOn.status === 'NOT_ALLOWED' ? 'bg-error' : 'bg-warning'}`}></span>
            <span class="text-lg font-bold text-ink tracking-tight uppercase">{item.carryOn.status.replace("_", " ")}</span>
          </div>
          <p class="text-xs text-body leading-[1.5]">
            {item.carryOn.reason}
          </p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline/60 flex items-center justify-between text-[10px] font-mono text-mute">
          <span>{airline.name} Cabin Limit</span>
          <strong class="text-ink">{airline.cabinLimit}</strong>
        </div>
      </div>

      <!-- Checked Bag Hold Card -->
      <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-[9px] font-mono font-semibold uppercase text-mute tracking-wider block mb-1">Checked Hold Baggage</span>
          <div class="flex items-center gap-2 mb-3">
            <span class={`w-2.5 h-2.5 rounded-full ${item.checkedBag.status === 'ALLOWED' ? 'bg-success' : item.checkedBag.status === 'NOT_ALLOWED' ? 'bg-error' : 'bg-warning'}`}></span>
            <span class="text-lg font-bold text-ink tracking-tight uppercase">{item.checkedBag.status.replace("_", " ")}</span>
          </div>
          <p class="text-xs text-body leading-[1.5]">
            {item.checkedBag.reason}
          </p>
        </div>
        <div class="mt-4 pt-4 border-t border-hairline/60 flex items-center justify-between text-[10px] font-mono text-mute">
          <span>{airline.name} Checked Limit</span>
          <strong class="text-ink">{airline.checkedLimit}</strong>
        </div>
      </div>

    </div>

    <!-- Official TSA Reference Panel -->
    <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm mb-10 select-none">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-sm bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
          <BadgeCheck class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-sm font-semibold text-ink">Baggage Safety Clearance Details</h3>
          <p class="text-xs text-body leading-[1.6] mt-1">
            We confirm that {item.name.toLowerCase()} checks out under the TSA core database guidelines. The regulatory authority hierarchy enforces TSA rules first, followed by Airline-specific baggage size and weight allowances.
          </p>
          <div class="flex items-center gap-4 mt-3 text-[10px] font-mono text-mute">
            <span>Last reviewed: June 2026</span>
            <span>&bull;</span>
            <span>Reviewed by BringOnPlane Editorial Team</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Accompanying accordion FAQs -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-5 border-b border-hairline pb-3">
        <HelpCircle class="w-4 h-4 text-mute" />
        <h2 class="text-lg font-semibold tracking-[-0.4px] text-ink">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <div class="border border-hairline rounded-md bg-canvas shadow-sm">
            <button 
              type="button" 
              class="faq-header-btn w-full text-left px-5 py-4 flex items-center justify-between text-sm font-semibold text-ink hover:bg-canvas-soft transition-colors cursor-pointer outline-none select-none"
              data-target={`faq-body-${idx}`}
            >
              <span>{faq.q}</span>
              <ChevronDown class="w-4 h-4 text-mute transition-transform duration-200" />
            </button>
            <div id={`faq-body-${idx}`} class="hidden px-5 pb-4 text-xs text-body leading-[1.6] border-t border-hairline/40 pt-3">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Regulatory Disclaimer -->
    <footer class="text-[10px] font-mono text-mute leading-[1.6] border-t border-hairline pt-6 select-none">
      <p>
        <strong>Disclaimer:</strong> Point rules apply universally. Final carriage approval remains at the discretion of the checkpoint inspector. Airlines like {airline.name} reserve the right to prohibit items on specific flights for safety reasons.
      </p>
    </footer>

  </div>

  <Footer slot="footer" />
</Layout>

<script>
  // Setup accordion toggle listeners
  document.querySelectorAll(".faq-header-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const targetId = (e.currentTarget as HTMLElement).getAttribute("data-target") || "";
      const body = document.getElementById(targetId);
      const icon = (e.currentTarget as HTMLElement).querySelector("svg");
      
      if (body) {
        const isHidden = body.classList.contains("hidden");
        if (isHidden) {
          body.classList.remove("hidden");
          if (icon) icon.classList.add("rotate-180");
        } else {
          body.classList.add("hidden");
          if (icon) icon.classList.remove("rotate-180");
        }
      }
    });
  });
</script>
