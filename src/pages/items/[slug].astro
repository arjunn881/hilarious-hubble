    <!-- Step-by-Step Packing Guide -->
    <section class="bg-canvas border border-hairline rounded-md p-6 shadow-level-2 mb-10">
      <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1"/><path d="M18 8h4a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-4"/><path d="M10 12h.01"/></svg>
        Step-by-Step Packing Instructions for {item.name}
      </h3>
      <ol class="space-y-3" role="list">
        {stepByStepPacking.map((step, idx) => (
