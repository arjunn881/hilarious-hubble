        </h3>
        <p class="text-xs text-body leading-[1.75]">
          {screeningProcedure}
        </p>
      </section>

      <section class="bg-canvas border border-hairline rounded-md p-6 shadow-sm">
        <h3 class="text-sm font-semibold tracking-[-0.3px] text-ink mb-3 flex items-center gap-2">
          <FileText class="w-4 h-4 text-link" />
          Federal Aviation & HazMat Regulations
        </h3>
        <p class="text-xs text-body leading-[1.75]">
          {regulatoryDetails}
        </p>
      </section>
    </div>

    <!-- Deep SEO Semantic Sections -->
    <div class="grid grid-cols-1 gap-8 mb-10">
      <section>
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-3 flex items-center gap-2">
          <Globe class="w-4 h-4 text-mute" />
          Airline & International Rule Variations
        </h3>
        <p class="text-sm text-body leading-[1.7] mb-6">
          {airlineDifferences}
        </p>
        <AirlineCountrySelector 
          itemName={item.name} 
          carryOnStatus={item.carryOn.status} 
          checkedStatus={item.checkedBag.status} 
          carryOnReason={item.carryOn.reason} 
          checkedReason={item.checkedBag.reason} 
          category={item.category} 
        />
      </section>

      <section>
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-3 flex items-center gap-2">
          <AlertTriangle class="w-4 h-4 text-mute" />
          Exceptions & Special Cases
        </h3>
        <p class="text-sm text-body leading-[1.7]">
          {exceptions}
        </p>
      </section>

      <section>
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-3 flex items-center gap-2">
          <Globe class="w-4 h-4 text-mute" />
          International Considerations
        </h3>
        <p class="text-sm text-body leading-[1.7]">
          {internationalConsiderations}
        </p>
      </section>

      <section>
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-3">
          Alternative Options
        </h3>
        <p class="text-sm text-body leading-[1.7]">
          {alternativeItems}
        </p>
      </section>
    </div>

    <!-- Expanded FAQ Accordions -->
    <section class="mb-10">
      <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-6">
        Frequently Asked Questions About {item.name}
      </h3>
      <div class="space-y-4">
        {itemFaqs.map((faq, idx) => (
          <details class="group bg-canvas border border-hairline rounded-md p-4 transition-all" open={idx === 0}>
            <summary class="flex justify-between items-center font-medium text-sm text-ink cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-1 rounded-sm">
              <span>{faq.question}</span>
              <span class="transition-transform group-open:rotate-180 text-mute text-xs">▼</span>
            </summary>
            <p class="text-sm text-body mt-3 leading-[1.6]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Officer Discretion Warning (Required by TSA guidelines) -->
    <div class="bg-canvas-soft-2 border border-hairline rounded-md p-6 flex items-start gap-4 mb-10 no-print">
      <div class="w-8 h-8 rounded-sm bg-warning-soft border border-warning/25 text-warning-deep flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-semibold tracking-[-0.2px] text-ink mb-1">
          TSA Officer Discretion
        </h4>
        <p class="text-xs text-body leading-[1.5]">
          The final decision rests with the TSA officer on whether an item is allowed through the security checkpoint. Rules and regulations can vary depending on international travel destinations or dynamic airport security alert levels.
        </p>
      </div>
    </div>

    <!-- Editorial Team Seal Card replaced with EEAT Banner -->
    <div class="mb-10">
      <EEATBanner lastUpdated={item.metadata.lastReviewed} />
    </div>

    <!-- Regulatory Citations Card -->
    <section class="bg-canvas border border-hairline rounded-md p-6 mb-10 select-none">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-mute mb-4">
        Official Regulation Citations
      </h3>
      <div class="flex items-start gap-3.5">
        <div class="font-mono text-xs text-mute flex-shrink-0 w-8 h-8 rounded-sm bg-canvas-soft border border-hairline flex items-center justify-center font-bold">
          §
        </div>
        <div>
          <p class="text-sm font-mono font-semibold text-ink mb-1">
            {cfr.code}
          </p>
          <p class="text-xs font-mono text-mute mb-2">
            {cfr.title} — {cfr.source}
          </p>
          <p class="text-xs text-body leading-[1.6]">
            This regulation mandates baggage safety constraints, hazardous materials classifications, or general prohibited carriage parameters for airline passengers flying within or into the United States.
          </p>
        </div>
      </div>
    </section>

    <!-- Version History Timeline -->
    <section class="mb-12 select-none no-print">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-mute mb-6">
        Rule Change & Review History
      </h3>
      <div class="relative pl-6 border-l border-hairline space-y-6">
        {item.ruleHistory && item.ruleHistory.map((step) => (
          <div class="relative">
            <!-- Timeline dot -->
            <span class="absolute -left-[31px] top-1 w-2.5 h-2.5 rounded-full bg-canvas-soft-2 border-2 border-hairline shadow-sm" />
            <div>
              <span class="font-mono text-[10px] text-mute block mb-1">
                {step.effectiveDate}
              </span>
              <p class="text-sm text-ink mb-2 leading-[1.5]">
                {step.change}
              </p>
              {step.source && (
                <a 
                  href={step.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[10px] font-mono text-link hover:text-link-deep transition-colors focus-visible:underline"
                >
                  Regulation Source
                  <ExternalLink class="w-2.5 h-2.5" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Guides section -->
    <section class="pt-8 border-t border-hairline mb-10">
      <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-6">
        Related Travel Guides
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {itemRelatedGuides.map((guide) => (
          <a
            href={guide.url}
            class="flex items-center gap-3 bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-4 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute flex-shrink-0">
              <FileText class="w-4 h-4" />
            </div>
            <h4 class="text-sm font-medium tracking-[-0.2px] text-ink line-clamp-2">
              {guide.title}
            </h4>
          </a>
        ))}
      </div>
    </section>

    <!-- Related Items section -->
    {relatedItems.length > 0 && (
      <section class="pt-8 border-t border-hairline">
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-6">
          Related Travel Items
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedItems.map((relatedItem) => (
            <a
              href={`/items/${relatedItem.slug}`}
              class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-4 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="font-mono text-[9px] font-semibold text-mute uppercase tracking-wider block mb-0.5">
                    {relatedItem.category}
                  </span>
                  <h4 class="text-sm font-medium tracking-[-0.2px] text-ink mb-1">
                    {relatedItem.name}
                  </h4>
                </div>
                <div class="flex flex-col gap-1.5 flex-shrink-0 items-end">
                  <span class:list={["text-[8px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider text-center w-20", getSmallBadgeClass(relatedItem.carryOn)]}>
                    H: {relatedItem.carryOn.toLowerCase()}
                  </span>
                  <span class:list={["text-[8px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider text-center w-20", getSmallBadgeClass(relatedItem.checked)]}>
                    C: {relatedItem.checked.toLowerCase()}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Advanced SEO Interlinking Clusters -->
    <RelatedLinksWidget groups={relatedWidgetGroups} />
  </div>

  <Footer slot="footer" />
</Layout>

<script is:inline>
  // Simple Client-side Favorite & Checklist integrations
  const btnFavorite = document.getElementById("btn-favorite");
  const starIcon = document.getElementById("star-icon");
  const favoriteLabel = document.getElementById("favorite-label");
  const btnChecklistAdd = document.getElementById("btn-checklist-add");
  const checklistAddLabel = document.getElementById("checklist-add-label");
  const btnShareLink = document.getElementById("btn-share-link");
  const shareToast = document.getElementById("share-toast");

  const currentSlug = window.location.pathname.split("/").pop();
  const currentName = document.querySelector("h1")?.textContent?.trim() || "";
  const currentCategory = document.querySelector("a[href^='/category/']")?.textContent?.trim() || "";

  // Resolve favorites state
  let favorites = JSON.parse(localStorage.getItem("traveler_favorites") || "[]");
  let isFavorite = favorites.includes(currentSlug);

  function updateFavoriteUI() {
    if (isFavorite) {
      starIcon?.setAttribute("fill", "currentColor");
      starIcon?.classList.remove("text-mute");
      starIcon?.classList.add("text-warning-deep");
      if (favoriteLabel) favoriteLabel.textContent = "Favorited";
    } else {
      starIcon?.setAttribute("fill", "none");
      starIcon?.classList.remove("text-warning-deep");
      starIcon?.classList.add("text-mute");
      if (favoriteLabel) favoriteLabel.textContent = "Favorite";
    }
  }
  updateFavoriteUI();

  btnFavorite?.addEventListener("click", () => {
    isFavorite = !isFavorite;
    if (isFavorite) {
      favorites.push(currentSlug);
    } else {
      favorites = favorites.filter(slug => slug !== currentSlug);
    }
    localStorage.setItem("traveler_favorites", JSON.stringify(favorites));
    updateFavoriteUI();
  });

  // Resolve packing checklist integration
  let checklist = JSON.parse(localStorage.getItem("traveler_checklist") || "[]");
  let inChecklist = checklist.some(item => item.id === currentSlug);

  function updateChecklistUI() {
    if (inChecklist) {
      if (checklistAddLabel) checklistAddLabel.textContent = "In Checklist";
      btnChecklistAdd?.classList.add("opacity-50");
    } else {
      if (checklistAddLabel) checklistAddLabel.textContent = "Add to Checklist";
      btnChecklistAdd?.classList.remove("opacity-50");
    }
  }
  updateChecklistUI();

  btnChecklistAdd?.addEventListener("click", () => {
    if (inChecklist) return;
    
    // Query baggage allowance status
    const carryOnText = document.querySelector(".bg-canvas p")?.textContent?.trim() || "allowed";
    const checkedText = document.querySelectorAll(".bg-canvas p")[1]?.textContent?.trim() || "allowed";

    const mapTextStatus = (text) => {
      const t = text.toLowerCase();
      if (t.includes("prohibited")) return "prohibited";
      if (t.includes("restricted")) return "restricted";
      return "allowed";
    };

    checklist.push({
      id: currentSlug,
      name: currentName,
      category: currentCategory,
      carryOn: mapTextStatus(carryOnText),
      checked: mapTextStatus(checkedText),
      checkedOff: false
    });

    localStorage.setItem("traveler_checklist", JSON.stringify(checklist));
    inChecklist = true;
    updateChecklistUI();
  });

  // Share Link Action
  btnShareLink?.addEventListener("click", () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      shareToast?.classList.remove("opacity-0");
      shareToast?.classList.add("opacity-100");
      setTimeout(() => {
        shareToast?.classList.remove("opacity-100");
        shareToast?.classList.add("opacity-0");
      }, 2000);
    });
  });

  // Push recents history
  let recents = JSON.parse(localStorage.getItem("traveler_recents") || "[]");
  recents = recents.filter(slug => slug !== currentSlug);
  recents.unshift(currentSlug);
  localStorage.setItem("traveler_recents", JSON.stringify(recents.slice(0, 10)));
</script>
