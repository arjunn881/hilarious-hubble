---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getAllItems, getRelatedItems, getItemBySlug } from "../../lib/items";
import { CheckCircle2, XCircle, AlertCircle, Calendar, ShieldAlert, ExternalLink, FileText, Globe, AlertTriangle, Check } from "@lucide/astro";
import { 
  getWhatIsThisItem, 
  getExceptions, 
  getInternationalConsiderations, 
  getAlternativeItems, 
  getRelatedGuides,
  getScreeningProcedure,
  getRegulatoryDetails,
  getAirlineDifferences,
  getStepByStepPackingGuide,
  getExpandedItemFAQs
} from "../../lib/contentGenerator";
import EEATBanner from "../../components/seo/EEATBanner.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import RelatedLinksWidget from "../../components/seo/RelatedLinksWidget.astro";
import AirlineCountrySelector from "../../components/AirlineCountrySelector.astro";
import { getAirlineCombinationsForItem, getPopularGuides, getRelatedCategories } from "../../lib/relatedEngine";
export async function getStaticPaths() {
  const items = getAllItems();
  return items.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getItemBySlug(slug as string);
if (!item) {
  return Astro.redirect("/404");
}

const relatedItems = getRelatedItems(item);

const whatIsThisItem = getWhatIsThisItem(item);
const exceptions = getExceptions(item);
const internationalConsiderations = getInternationalConsiderations(item);
const alternativeItems = getAlternativeItems(item);
const itemRelatedGuides = getRelatedGuides(item);

const screeningProcedure = getScreeningProcedure(item);
const regulatoryDetails = getRegulatoryDetails(item);
const airlineDifferences = getAirlineDifferences(item);
const stepByStepPacking = getStepByStepPackingGuide(item);
const itemFaqs = getExpandedItemFAQs(item);

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Categories", href: "/#categories" },
  { label: item.category, href: `/category/${item.category.toLowerCase().trim().replace(/\s+/g, "-")}` },
  { label: item.name }
];

const relatedWidgetGroups = [
  { title: "Relevant Airlines", links: getAirlineCombinationsForItem(item.slug, 5) },
  { title: "Popular Guides", links: getPopularGuides(5) },
  { title: "Related Categories", links: getRelatedCategories(item.category, 5).map(c => ({ title: c.name, url: `/category/${c.slug}` })) }
];

// Strict Rule Status config mapping
const statusConfig = {
  ALLOWED: {
    label: "Allowed",
    icon: CheckCircle2,
    class: "bg-link-bg-soft text-link-deep border-link/25",
    textClass: "text-link-deep",
  },
  NOT_ALLOWED: {
    label: "Prohibited",
    icon: XCircle,
    class: "bg-error-soft text-error-deep border-error/25",
    textClass: "text-error-deep",
  },
  RESTRICTED: {
    label: "Restricted",
    icon: AlertCircle,
    class: "bg-warning-soft text-warning-deep border-warning/25",
    textClass: "text-warning-deep",
  },
  UNKNOWN: {
    label: "Unknown",
    icon: AlertCircle,
    class: "bg-canvas-soft-2 text-mute border-hairline",
    textClass: "text-mute",
  },
};

const carryOnStatus = statusConfig[item.carryOn.status] || statusConfig.UNKNOWN;
const checkedStatus = statusConfig[item.checkedBag.status] || statusConfig.UNKNOWN;

const CarryOnIcon = carryOnStatus.icon;
const CheckedIcon = checkedStatus.icon;

function getSmallBadgeClass(status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') {
  if (status === 'ALLOWED') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'NOT_ALLOWED') return "bg-error-soft border-error/25 text-error-deep";
  if (status === 'RESTRICTED') return "bg-warning-soft border-warning/25 text-warning-deep";
  return "bg-canvas-soft-2 border-hairline text-mute";
}

function getCfrCitation(category: string) {
  const cat = category.toLowerCase().trim();
  if (cat === 'electronics') {
    return {
      code: "49 CFR § 175.10(a)(18)",
      title: "FAA Regulation for Lithium Batteries & Electronic Devices",
      source: "Federal Aviation Administration (FAA)"
    };
  }
  if (cat === 'liquids' || cat === 'personal-care' || cat === 'beauty') {
    return {
      code: "49 CFR § 1540.111",
      title: "TSA Regulation for Liquids, Gels, and Aerosols",
      source: "Transportation Security Administration (TSA)"
    };
  }
  if (cat === 'medicine' || cat === 'health') {
    return {
      code: "49 CFR § 1544.219",
      title: "TSA Medical Device & Prescription Exemptions",
      source: "Transportation Security Administration (TSA)"
    };
  }
  if (cat === 'tools' || cat === 'camping') {
    return {
      code: "49 CFR § 1540.111(a)",
      title: "TSA Security Rules for Tools & Bladed Objects",
      source: "Transportation Security Administration (TSA)"
    };
  }
  if (cat === 'sports') {
    return {
      code: "49 CFR § 1540.111(b)",
      title: "TSA Security Rules for Blunt Objects & Sports Equipment",
      source: "Transportation Security Administration (TSA)"
    };
  }
  return {
    code: "49 CFR § 1540.111",
    title: "TSA General Security Carriage Regulations",
    source: "Transportation Security Administration (TSA)"
  };
}
const cfr = getCfrCitation(item.category);



function getTravelTip(itemData: typeof item) {
  if (itemData.carryOn.status === 'NOT_ALLOWED') {
    return `Pack ${itemData.name.toLowerCase()} securely in your checked hold baggage before you head to the airport counter to avoid confiscation at security checkpoint lines.`;
  }
  if (itemData.carryOn.status === 'RESTRICTED') {
    return `Place ${itemData.name.toLowerCase()} in a clear pouch near the top of your carry-on luggage. Security officers often request passengers to remove restricted items for standalone X-ray screening.`;
  }
  return `Keep ${itemData.name.toLowerCase()} in your carry-on bag so it stays safe, protected, and within arm's reach during your flight. Avoid checking high-value personal items.`;
}
const travelTip = getTravelTip(item);

// ── SEO: Verdict-aware High-CTR title & dynamic year injection ──────────────────
const currentYear = new Date().getFullYear();
const carryOnVerdict = item.carryOn.status === 'ALLOWED' ? 'YES'
  : item.carryOn.status === 'NOT_ALLOWED' ? 'NO'
  : 'RESTRICTED';
const checkedVerdict = item.checkedBag.status === 'ALLOWED' ? 'YES'
  : item.checkedBag.status === 'NOT_ALLOWED' ? 'NO'
  : 'RESTRICTED';

const seoTitle = `Can You Bring ${item.name} on a Plane? [${carryOnVerdict} Carry-On] (${currentYear} TSA Rules)`;

// ── SEO: High-Converting Meta Description (<155 chars) ─────────────────────────
const carryOnShort = item.carryOn.status === 'ALLOWED' ? 'Allowed in carry-on'
  : item.carryOn.status === 'NOT_ALLOWED' ? 'PROHIBITED in carry-on'
  : 'Restricted in carry-on';
const checkedShort = item.checkedBag.status === 'ALLOWED' ? 'allowed in checked bags'
  : item.checkedBag.status === 'NOT_ALLOWED' ? 'prohibited in checked'
  : 'restricted in checked';

const rawDesc = `${carryOnShort} & ${checkedShort}. Official TSA rules for ${item.name.toLowerCase()}: see exact limits & 1 critical packing catch before your flight.`;
const seoDescription = rawDesc.length > 155 ? rawDesc.slice(0, 152) + '...' : rawDesc;

// ── SEO: Featured Snippet answer (Feature 8) ─────────────────────────────────
const featuredSnippetAnswer = item.carryOn.status === 'ALLOWED'
  ? `Yes — ${item.name} is allowed in carry-on bags by TSA. ${item.carryOn.reason || ''}`
  : item.carryOn.status === 'NOT_ALLOWED'
  ? `No — ${item.name} is NOT allowed in carry-on bags. ${item.carryOn.reason || ''} Pack it in your checked bag instead.`
  : `${item.name} is allowed in carry-on with restrictions. ${item.carryOn.reason || ''}`;

// ── Extra FAQ questions for JSON-LD (Feature 7) ───────────────────────────────
const faq4Question = `What happens if I bring ${item.name.toLowerCase()} through TSA security?`;
const faq4Answer = item.carryOn.status === 'ALLOWED'
  ? `If you bring ${item.name.toLowerCase()} through TSA security in your carry-on, it should pass through the X-ray screening without issue. ${item.carryOn.reason || ''}`
  : item.carryOn.status === 'NOT_ALLOWED'
  ? `If you attempt to bring ${item.name.toLowerCase()} through TSA in a carry-on bag, the TSA officer will confiscate it at the security checkpoint. You must place it in your checked bag or surrender it before security.`
  : `TSA officers may pull your ${item.name.toLowerCase()} for secondary screening. You may be asked to declare it or meet specific conditions. ${item.carryOn.reason || ''}`;

const faq5Question = `Can I bring ${item.name.toLowerCase()} on an international flight?`;
const faq5Answer = `TSA rules govern US departure security checkpoints. ${item.name} is ${carryOnShort} at US airports. For international destinations, each country has its own customs and aviation security rules. Check your destination country's customs authority rules in addition to the TSA.`;

const faq6Question = `Is there a size or quantity limit for ${item.name.toLowerCase()} in carry-on?`;
const faq6Answer = item.carryOn.conditions && item.carryOn.conditions.length > 0
  ? `Yes, there are specific conditions: ${item.carryOn.conditions.join('. ')}`
  : `Standard TSA rules apply to ${item.name.toLowerCase()}. Always check with your specific airline for additional restrictions as airline policies may vary.`;

// Dynamically generate FAQs for SEO schemas
const faq1Question = `Is ${item.name.toLowerCase()} allowed on a plane?`;
const faq1Answer = `According to the TSA, ${item.name.toLowerCase()} is ${item.carryOn.status.replace('_', ' ').toLowerCase()} in carry-on bags and ${item.checkedBag.status.replace('_', ' ').toLowerCase()} in checked baggage. ${item.carryOn.reason}`;

const faq2Question = `Can I bring ${item.name.toLowerCase()} in carry-on luggage?`;
const faq2Answer = `Yes, ${item.name.toLowerCase()} is ${item.carryOn.status === 'ALLOWED' ? 'fully allowed' : item.carryOn.status === 'RESTRICTED' ? 'restricted (subject to conditions)' : 'prohibited'} in carry-on bags. ${item.carryOn.conditions[0] || 'Make sure to consult airport guidelines.'}`;

const faq3Question = `Are there any special rules for packing ${item.name.toLowerCase()} in checked baggage?`;
const faq3Answer = `In checked bags, ${item.name.toLowerCase()} is ${item.checkedBag.status === 'ALLOWED' ? 'allowed without restrictions' : item.checkedBag.status === 'RESTRICTED' ? 'restricted (subject to conditions)' : 'prohibited'}. ${item.checkedBag.conditions[0] || 'Ensure it is packed securely.'}`;

---

<Layout 
  title={seoTitle}
  description={seoDescription}
  canonicalURL={`https://bringonplane.com/items/${item.slug}`}
>
  <!-- Inject JSON-LD structured data in the page body -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Thing",
        "name": item.name,
        "description": item.description,
        "url": `https://bringonplane.com/items/${item.slug}`,
        "alternateName": item.aliases,
        "category": item.category,
        "keywords": item.keywords.join(", "),
        "author": {
          "@type": "Organization",
          "name": "BringOnPlane Editorial Team"
        },
        "publisher": {
          "@type": "Organization",
          "name": "BringOnPlane",
          "logo": {
            "@type": "ImageObject",
            "url": "https://bringonplane.com/logo.png"
          }
        },
        "subjectOf": item.tsa && item.tsa.officialUrl ? {
          "@type": "WebPage",
          "name": "Official TSA Rules Source",
          "url": item.tsa.officialUrl
        } : undefined
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          ...itemFaqs.map(faq => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.answer
            }
          })),
          {
            "@type": "Question",
            "name": faq4Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq4Answer }
          },
          {
            "@type": "Question",
            "name": faq5Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq5Answer }
          },
          {
            "@type": "Question",
            "name": faq6Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq6Answer }
          }
        ]
      }
    ]
  })} />

  <Header slot="header" />

  <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 py-12 flex-1">
    <!-- Breadcrumbs complying with Web Interface Guidelines -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Item Metadata Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <a 
          href={`/category/${item.category.toLowerCase().trim().replace(/\s+/g, "-")}`}
          class="font-mono text-[10px] font-semibold text-mute hover:text-link uppercase tracking-wider bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs hover:border-link transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
        >
          {item.category}
        </a>

        <!-- Trust Confidence Badge -->
        <span class="inline-flex items-center gap-1 font-mono text-[10px] font-semibold text-link bg-link-bg-soft border border-link/25 px-2 py-0.5 rounded-xs select-none">
          <svg width="12" height="12" class="w-3 h-3 text-link" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          TSA Verified • High Confidence
        </span>

        <span class="flex items-center gap-1.5 text-xs text-mute font-mono">
          <Calendar class="w-3.5 h-3.5" aria-hidden="true" />
          Reviewed {item.metadata.lastReviewed}
        </span>
      </div>
      <!-- Feature 10: Verdict Color Banner at top of item page -->
      {item.carryOn.status === 'ALLOWED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-emerald-50 border border-emerald-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-emerald-100 border border-emerald-300 flex-shrink-0">
            <CheckCircle2 class="w-5 h-5 text-emerald-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-emerald-800">YES — Allowed in Carry-on Bags</p>
            <p class="text-xs text-emerald-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}
      {item.carryOn.status === 'NOT_ALLOWED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-red-50 border border-red-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-red-100 border border-red-300 flex-shrink-0">
            <XCircle class="w-5 h-5 text-red-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-red-800">NO — Not Allowed in Carry-on Bags</p>
            <p class="text-xs text-red-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}
      {item.carryOn.status === 'RESTRICTED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-amber-50 border border-amber-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-amber-100 border border-amber-300 flex-shrink-0">
            <AlertCircle class="w-5 h-5 text-amber-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-amber-800">RESTRICTED — Allowed with Conditions</p>
            <p class="text-xs text-amber-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}

      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.28px] text-ink text-pretty">
        Can you bring {item.name.toLowerCase()} on a plane?
      </h1>

      <!-- Feature 8: Featured Snippet Quick Answer box -->
      <div class="mt-5 mb-2 p-4 rounded-md bg-canvas-soft border-l-4 border-link">
        <p class="text-xs font-mono text-link uppercase tracking-wider mb-1.5 font-semibold">Quick Answer</p>
        <p class="text-sm text-body leading-[1.7] text-pretty">
          {featuredSnippetAnswer}
        </p>
      </div>

      {item.aliases.length > 0 && (
        <p class="text-sm text-body mt-2">
          <span class="text-mute">Also known as:</span> {item.aliases.join(", ")}
        </p>
      )}

      <!-- Action buttons for Traveler utilities -->
      <div class="flex flex-wrap items-center gap-3 mt-6 select-none">
        <button 
          type="button" 
          id="btn-favorite" 
          class="inline-flex items-center gap-2 px-3 h-8 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-1"
          aria-label="Add to Favorites"
        >
          <svg width="14" height="14" id="star-icon" class="w-3.5 h-3.5 text-mute transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span id="favorite-label">Favorite</span>
        </button>

        <button 
          type="button" 
          id="btn-checklist-add" 
          class="inline-flex items-center gap-2 px-3 h-8 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-1"
          aria-label="Add to packing checklist"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
            <path d="M12 6v12M6 12h12"/>
          </svg>
          <span id="checklist-add-label">Add to Checklist</span>
        </button>

        <button 
          type="button" 
          id="btn-share-link" 
          class="inline-flex items-center gap-2 px-3 h-8 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-1 relative"
          aria-label="Copy share link to clipboard"
        >
          <svg width="14" height="14" class="w-3.5 h-3.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
            <path d="M8.59 13.51l6.83 3.98M15.41 6.51L8.59 10.49"/>
          </svg>
          <span>Share Link</span>
          <!-- Clipboard toast notification tooltip -->
          <span id="share-toast" class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-mono font-medium text-on-primary bg-ink rounded shadow-level-3 opacity-0 transition-opacity pointer-events-none whitespace-nowrap">
            Copied link!
          </span>
        </button>
      </div>
    </header>

    <!-- Semantic Introduction -->
    <section class="mb-10">
      <h2 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-3">
        What is {item.name.toLowerCase()}?
      </h2>
      <p class="text-base text-body leading-[1.75] text-pretty">
        {whatIsThisItem}
      </p>
    </section>

    <!-- Side-by-Side Status Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
      <!-- Carry-On Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-6 shadow-md relative overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-mute">CABIN BAGGAGE (CARRY-ON)</span>
          <div class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-md border text-xs font-mono font-bold tracking-wide uppercase ${carryOnStatus.class}`}>
            <CarryOnIcon class="w-3.5 h-3.5" aria-hidden="true" />
            {carryOnStatus.label}
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-ink capitalize mb-2">
          {item.carryOn.status === "ALLOWED" && "Allowed in Cabin"}
          {item.carryOn.status === "NOT_ALLOWED" && "Strictly Prohibited"}
          {item.carryOn.status === "RESTRICTED" && "Restricted in Cabin"}
          {item.carryOn.status === "UNKNOWN" && "Status Unknown"}
        </p>
        <p class="text-xs text-body leading-relaxed">
          {item.carryOn.reason}
        </p>
      </div>

      <!-- Checked Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-6 shadow-md relative overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-mute">HOLD BAGGAGE (CHECKED)</span>
          <div class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-md border text-xs font-mono font-bold tracking-wide uppercase ${checkedStatus.class}`}>
            <CheckedIcon class="w-3.5 h-3.5" aria-hidden="true" />
            {checkedStatus.label}
          </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-ink capitalize mb-2">
          {item.checkedBag.status === "ALLOWED" && "Allowed in Hold"}
          {item.checkedBag.status === "NOT_ALLOWED" && "Strictly Prohibited"}
          {item.checkedBag.status === "RESTRICTED" && "Restricted in Hold"}
          {item.checkedBag.status === "UNKNOWN" && "Status Unknown"}
        </p>
        <p class="text-xs text-body leading-relaxed">
          {item.checkedBag.reason}
        </p>
      </div>
    </div>

    <!-- Official TSA Guidance -->
    <section class="bg-canvas border border-hairline rounded-md p-8 shadow-level-3 mb-10">
      <h2 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-4">
        Official TSA Rules & Reason
      </h2>
      <p class="text-body leading-[1.6] text-pretty mb-6">
        {item.carryOn.reason}
      </p>
      {item.tsa && item.tsa.officialUrl && (
        <a 
          href={item.tsa.officialUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center gap-2 px-4 h-9 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          Official TSA Source
          <ExternalLink class="w-3.5 h-3.5" aria-hidden="true" />
        </a>
      )}
    </section>

    <!-- Practical Traveler Packing Tip Card -->
    <section class="bg-canvas border border-link/15 rounded-md p-6 shadow-level-2 mb-10 select-none no-print">
      <div class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-sm bg-link-bg-soft text-link-deep border border-link/15 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="16" height="16" class="w-4 h-4 text-link" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="m12 3-1.912 5.886H3.886L8.7 12.518 6.788 18.4 12 14.782 17.212 18.4l-1.912-5.882 4.814-3.632h-6.202L12 3z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold tracking-[-0.2px] text-ink mb-1">
            Traveler Packing Tip
          </h4>
          <p class="text-xs text-body leading-[1.6]">
            {travelTip}
          </p>
        </div>
      </div>
    </section>

    <!-- Important Notes -->
    {item.carryOn.conditions && item.carryOn.conditions.length > 0 && (
      <section class="mb-10">
        <h3 class="text-base font-semibold tracking-[-0.4px] text-ink mb-4">
