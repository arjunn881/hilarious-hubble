            </span>
            <span class="leading-relaxed mt-0.5">{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Deep Security & Regulatory Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <section class="bg-canvas border border-hairline rounded-md p-6 shadow-sm">
        <h3 class="text-sm font-semibold tracking-[-0.3px] text-ink mb-3 flex items-center gap-2">
          <ShieldAlert class="w-4 h-4 text-link" />
