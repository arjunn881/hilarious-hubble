---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ArrowLeft, Compass } from "@lucide/astro";

const airlines = [
  { slug: "delta", name: "Delta Air Lines" },
  { slug: "united", name: "United Airlines" },
  { slug: "american", name: "American Airlines" },
  { slug: "lufthansa", name: "Lufthansa" },
  { slug: "air-france", name: "Air France" },
  { slug: "british-airways", name: "British Airways" },
  { slug: "ryanair", name: "Ryanair" },
  { slug: "emirates", name: "Emirates" },
  { slug: "singapore-airlines", name: "Singapore Airlines" }
];

const popularItems = [
  { slug: "power-bank", name: "Power Bank" },
  { slug: "sunscreen", name: "Sunscreen Lotion" },
  { slug: "laptop", name: "Laptop Computer" },
  { slug: "baby-formula", name: "Baby Formula" },
  { slug: "shampoo", name: "Shampoo" }
];
---

<Layout 
  title="Airline Baggage Allowance Regulations | Bring On Plane"
  description="Compare baggage rules, carry-on weight limits, and checked luggage allowances across major airline carriers."
>
  <Header slot="header" />

  <div class="max-w-[800px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <div class="mb-8 select-none">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Back to Home
      </a>
    </div>

    <header class="mb-10">
      <div class="flex items-center gap-2.5 mb-2">
        <Compass class="w-5 h-5 text-mute" />
        <h1 class="text-3xl font-semibold tracking-[-1px] text-ink">Airlines Index</h1>
      </div>
      <p class="text-sm text-body leading-[1.6]">
        Select an airline to check specific carry-on limits and checked luggage restrictions for travel items.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {airlines.map(airline => (
        <div class="bg-canvas border border-hairline rounded-md p-6 shadow-sm">
          <h2 class="text-base font-semibold text-ink mb-3">{airline.name}</h2>
          <ul class="space-y-1.5 text-xs font-mono">
            {popularItems.map(item => (
              <li>
                <a 
                  href={`/items/${item.slug}/airline/${airline.slug}`} 
                  class="text-link hover:text-link-deep hover:underline block"
                >
                  Can I bring {item.name.toLowerCase()} on {airline.name}?
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>

  <Footer slot="footer" />
</Layout>
