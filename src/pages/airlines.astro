---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ArrowLeft, Plane, ShieldCheck, Info, Scale, Box, BatteryCharging } from "@lucide/astro";

const airlines = [
  { 
    slug: "delta", 
    name: "Delta Air Lines", 
    carryOnDim: "22 x 14 x 9 in (56 x 35 x 23 cm)", 
    carryOnWeight: "No weight limit (except specific Asian airports)", 
    checkedWeight: "50 lbs (23 kg)", 
    personalItem: "1 personal item (purse, laptop bag)", 
    batteryPolicy: "Lithium power banks prohibited in checked hold; must be under 100Wh in cabin."
  },
  { 
    slug: "united", 
    name: "United Airlines", 
    carryOnDim: "22 x 14 x 9 in (56 x 35 x 23 cm)", 
    carryOnWeight: "No weight limit for standard tickets", 
    checkedWeight: "50 lbs (23 kg)", 
    personalItem: "17 x 10 x 9 in (43 x 25 x 22 cm)", 
    batteryPolicy: "Basic Economy permits 1 personal item only on domestic flights. Battery packs cabin-only."
  },
  { 
    slug: "american", 
    name: "American Airlines", 
    carryOnDim: "22 x 14 x 9 in (56 x 35 x 23 cm)", 
    carryOnWeight: "No weight limit", 
    checkedWeight: "50 lbs (23 kg)", 
    personalItem: "18 x 14 x 8 in (45 x 35 x 20 cm)", 
    batteryPolicy: "Power banks and e-cigarettes allowed in carry-on only."
  },
  { 
    slug: "lufthansa", 
    name: "Lufthansa", 
    carryOnDim: "55 x 40 x 23 cm (21.6 x 15.7 x 9 in)", 
    carryOnWeight: "8 kg (17.6 lbs)", 
    checkedWeight: "23 kg (50 lbs)", 
    personalItem: "40 x 30 x 10 cm", 
    batteryPolicy: "Strict 8 kg limit strictly enforced at European hubs. Max 2 spare power banks in cabin."
  },
  { 
    slug: "air-france", 
    name: "Air France", 
    carryOnDim: "55 x 35 x 25 cm (21.6 x 13.7 x 9.8 in)", 
    carryOnWeight: "12 kg (26.4 lbs) combined", 
    checkedWeight: "23 kg (50 lbs)", 
    personalItem: "40 x 30 x 15 cm", 
    batteryPolicy: "Total weight of cabin bag + personal item must remain under 12 kg."
  },
  { 
    slug: "british-airways", 
    name: "British Airways", 
    carryOnDim: "56 x 45 x 25 cm (22 x 18 x 10 in)", 
    carryOnWeight: "23 kg (50 lbs)", 
    checkedWeight: "23 kg (50 lbs)", 
    personalItem: "40 x 30 x 15 cm", 
    batteryPolicy: "Offers generous 23 kg cabin allowance. Smart bags with non-removable batteries prohibited."
  },
  { 
    slug: "ryanair", 
    name: "Ryanair", 
    carryOnDim: "40 x 20 x 25 cm (small personal bag free)", 
    carryOnWeight: "10 kg (Priority boarding only)", 
    checkedWeight: "10 kg or 20 kg (Paid fee)", 
    personalItem: "40 x 20 x 25 cm (must fit under seat)", 
    batteryPolicy: "Strict gate sizing boxes. Smart bags must have battery removed prior to carriage."
  },
  { 
    slug: "emirates", 
    name: "Emirates", 
    carryOnDim: "55 x 38 x 20 cm (22 x 15 x 8 in)", 
    carryOnWeight: "7 kg (15 lbs)", 
    checkedWeight: "30 kg (66 lbs) total concept", 
    personalItem: "Laptops must be carried within cabin bag allowance", 
    batteryPolicy: "Power banks strictly prohibited in checked luggage. Maximum 100Wh capacity per unit."
  },
  { 
    slug: "singapore-airlines", 
    name: "Singapore Airlines", 
    carryOnDim: "Sum of dimensions 115 cm", 
    carryOnWeight: "7 kg (15 lbs)", 
    checkedWeight: "30 kg (66 lbs)", 
    personalItem: "40 x 30 x 10 cm", 
    batteryPolicy: "Lithium battery approval required above 100Wh to 160Wh limit. Prohibited in holds."
  }
];

const essentialItems = [
  { slug: "power-bank", name: "Power Bank & Battery Packs" },
  { slug: "prescription-pills", name: "Prescription Medications" },
  { slug: "sunscreen", name: "Liquids & Gels (3-1-1)" },
  { slug: "laptop", name: "Laptops & Tablets" },
  { slug: "razor", name: "Safety Razors & Blades" }
];
---

<Layout 
  title="Major Airlines Baggage Policy Guide (2026 Limits & Rules)"
  description="Compare carry-on size limits, checked bag weight allowances, and lithium battery rules for Delta, United, Lufthansa, Ryanair, Emirates, and top global airlines."
  canonicalURL="https://bringonplane.com/airlines/"
>
  <Header slot="header" />

  <div class="max-w-[1000px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <div class="mb-8 select-none">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Back to TSA Checker
      </a>
    </div>

    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-link-bg-soft text-link-deep border border-link/25 rounded-xs text-xs font-mono mb-3">
        <Plane class="w-3.5 h-3.5" />
        Carrier Baggage Matrix 2026
      </div>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.2px] text-ink mb-3 leading-tight">
        Major Airline Baggage Allowances & Safety Rules
      </h1>
      <p class="text-sm text-body leading-[1.7] max-w-[760px]">
        Comprehensive breakdown of carry-on dimensions, cabin weight limits, checked hold limits, and battery safety policies across leading commercial airlines.
      </p>
    </header>

    <!-- Quick Item Shortcut Links -->
    <div class="mb-10 p-5 bg-canvas border border-hairline rounded-md shadow-xs">
      <h2 class="text-xs font-mono uppercase tracking-wider font-semibold text-mute mb-3">
        Check Popular Items Across All Carriers:
      </h2>
      <div class="flex flex-wrap gap-2">
        {essentialItems.map(item => (
          <a 
            href={`/items/${item.slug}`} 
            class="px-3 py-1.5 bg-canvas-soft hover:bg-canvas-soft-2 text-xs font-medium text-ink border border-hairline rounded-sm transition-colors"
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Airlines Grid -->
    <div class="space-y-6">
      {airlines.map(airline => (
        <div id={airline.slug} class="bg-canvas border border-hairline rounded-md p-6 shadow-xs scroll-mt-20">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-hairline gap-2">
            <h2 class="text-xl font-semibold text-ink flex items-center gap-2">
              <Plane class="w-4 h-4 text-link" />
              {airline.name}
            </h2>
            <span class="text-xs font-mono text-mute">IATA Compliant • 2026 Rules</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-5">
            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <span class="text-[10px] font-mono text-mute uppercase flex items-center gap-1 mb-1">
                <Box class="w-3 h-3 text-link" />
                Carry-on Dimensions
              </span>
              <p class="text-xs font-semibold text-ink">{airline.carryOnDim}</p>
            </div>

            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <span class="text-[10px] font-mono text-mute uppercase flex items-center gap-1 mb-1">
                <Scale class="w-3 h-3 text-link" />
                Cabin Weight Limit
              </span>
              <p class="text-xs font-semibold text-ink">{airline.carryOnWeight}</p>
            </div>

            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <span class="text-[10px] font-mono text-mute uppercase flex items-center gap-1 mb-1">
                <ShieldCheck class="w-3 h-3 text-link" />
                Checked Bag Limit
              </span>
              <p class="text-xs font-semibold text-ink">{airline.checkedWeight}</p>
            </div>
          </div>

          <div class="p-3 bg-canvas-soft rounded border border-hairline text-xs text-body space-y-1">
            <p><strong class="text-ink">Personal Item Allowance:</strong> {airline.personalItem}</p>
            <p><strong class="text-ink">Hazardous Goods & Battery Note:</strong> {airline.batteryPolicy}</p>
          </div>
        </div>
      ))}
    </div>

  </div>

  <Footer slot="footer" />
</Layout>
