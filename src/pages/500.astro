---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AlertTriangle, ArrowLeft, RefreshCcw } from "@lucide/astro";
---

<Layout
  title="Server Error (500) — BringOnPlane"
  description="BringOnPlane encountered a temporary server error. Please try refreshing the page."
  noIndex={true}
>
  <Header slot="header" />

  <main class="flex-1 flex items-center justify-center py-24 px-4">
    <div class="max-w-[520px] w-full text-center">

      <!-- Error graphic -->
      <div class="relative mb-10 select-none">
        <div class="text-[120px] md:text-[160px] font-black font-mono leading-none tracking-tight text-hairline-strong">
          500
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 rounded-full bg-error-soft border-2 border-error/30 flex items-center justify-center">
            <AlertTriangle class="w-9 h-9 text-error" />
          </div>
        </div>
      </div>

      <h1 class="text-2xl md:text-3xl font-semibold tracking-[-1px] text-ink mb-3">
        Turbulence on our end.
      </h1>
      <p class="text-sm text-body leading-[1.7] mb-10 max-w-[400px] mx-auto">
        Our server hit an unexpected error. This is temporary — please reload the page or return home. If the problem persists, <a href="/contact" class="text-link hover:underline">let us know</a>.
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
        <button
          type="button"
          onclick="window.location.reload();"
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 h-10 text-sm font-medium text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all cursor-pointer"
        >
          <RefreshCcw class="w-4 h-4" />
          Reload Page
        </button>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 h-10 text-sm font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all"
        >
          <ArrowLeft class="w-4 h-4" />
          Back to Home
        </a>
      </div>

      <!-- Status hint -->
      <div class="border border-hairline rounded-md bg-canvas-soft px-6 py-4">
        <div class="flex items-center justify-center gap-2 text-xs text-body">
          <span class="w-2 h-2 rounded-full bg-warning animate-pulse"></span>
          Investigating issue — most users are unaffected.
        </div>
        <p class="text-xs text-mute mt-2">
          If you keep seeing this, email <a href="mailto:hello@bringonplane.com" class="text-link hover:underline">hello@bringonplane.com</a>
        </p>
      </div>

    </div>
  </main>

  <Footer slot="footer" />
</Layout>
