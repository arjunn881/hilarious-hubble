          <a href="/items/page/1/" class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">View All 196+ Items &rarr;</a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          {[
            { label: "Liquids (3-1-1)", slug: "liquids", bg: "bg-blue-50 dark:bg-blue-950/40", border: "border-blue-200 dark:border-blue-800/60", text: "text-blue-700 dark:text-blue-300", iconBg: "bg-blue-600 text-white", icon: Droplet },
            { label: "Electronics", slug: "electronics", bg: "bg-purple-50 dark:bg-purple-950/40", border: "border-purple-200 dark:border-purple-800/60", text: "text-purple-700 dark:text-purple-300", iconBg: "bg-purple-600 text-white", icon: Laptop },
            { label: "Food & Snacks", slug: "food", bg: "bg-emerald-50 dark:bg-emerald-950/40", border: "border-emerald-200 dark:border-emerald-800/60", text: "text-emerald-700 dark:text-emerald-300", iconBg: "bg-emerald-600 text-white", icon: Apple },
            { label: "Medicine", slug: "medicine", bg: "bg-rose-50 dark:bg-rose-950/40", border: "border-rose-200 dark:border-rose-800/60", text: "text-rose-700 dark:text-rose-300", iconBg: "bg-rose-600 text-white", icon: Activity },
            { label: "Tools & Knives", slug: "tools", bg: "bg-amber-50 dark:bg-amber-950/40", border: "border-amber-200 dark:border-amber-800/60", text: "text-amber-800 dark:text-amber-300", iconBg: "bg-amber-600 text-white", icon: Wrench },
            { label: "Personal Care", slug: "personal-care", bg: "bg-pink-50 dark:bg-pink-950/40", border: "border-pink-200 dark:border-pink-800/60", text: "text-pink-700 dark:text-pink-300", iconBg: "bg-pink-600 text-white", icon: Sparkles },
          ].map(cat => {
