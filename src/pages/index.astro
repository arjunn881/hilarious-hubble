---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getAllItems, getItemBySlug } from "../lib/items";
import { 
  Search, 
  Laptop, 
  Droplet, 
  Apple, 
  Activity, 
  Baby, 
  Wrench, 
  Trophy, 
  Sparkles, 
  Gem, 
  FileText,
  ArrowRight,
  ShieldCheck,
  PlaneTakeoff,
  Luggage,
  ChevronDown,
  HelpCircle,
  CheckCircle2,
  XCircle,
  AlertCircle,
  ExternalLink,
  X,
  Info,
  Mail,
  Lock,
  ShieldAlert
} from "@lucide/astro";

const items = getAllItems();

// 10 categories requested by the user
const categoriesList = [
  { name: "Electronics", icon: Laptop },
  { name: "Liquids", icon: Droplet },
  { name: "Food", icon: Apple },
  { name: "Medicine", icon: Activity },
  { name: "Baby", icon: Baby },
  { name: "Tools", icon: Wrench },
  { name: "Sports", icon: Trophy },
  { name: "Personal Care", icon: Sparkles },
  { name: "Jewelry", icon: Gem },
  { name: "Documents", icon: FileText },
];

// Dynamically count items in each category
const categories = categoriesList.map(cat => {
  const count = items.filter(item => item.category === cat.name).length;
  return { ...cat, count };
});

// ── Popular Searches (10 chips shown in hero) ────────────────────────────────
// Maps label → slug.
const popularSearchChips = [
  { label: "Power Bank",     slug: "power-bank" },
  { label: "Perfume",        slug: "perfume" },
  { label: "Toothpaste",     slug: "toothpaste" },
  { label: "Scissors",       slug: "scissors" },
  { label: "Laptop",         slug: "laptop" },
  { label: "Drone",          slug: "drone" },
  { label: "Protein Powder", slug: "protein-powder" },
  { label: "Vape",           slug: "vape" },
  { label: "Razor",          slug: "razor" },
  { label: "Camera",         slug: "camera" },
];

// Pre-load full item data for each popular chip (build-time)
const popularItems = popularSearchChips.map(chip => ({
  ...chip,
  item: getItemBySlug(chip.slug),
}));

// Most searched queries (TSA heavy queries — used in the section below the hero)
const mostSearchedSlugs = ["power-bank", "sunscreen", "laptop", "aerosol-insect-repellent"];
const mostSearched = mostSearchedSlugs.map(slug => items.find(i => i.slug === slug)).filter((x): x is NonNullable<typeof x> => !!x);

// Latest reviewed items (sorted by lastReviewed date descending)
const latestReviewed = [...items]
  .sort((a, b) => b.lastReviewed.localeCompare(a.lastReviewed))
  .slice(0, 4);

// Fetch latest travel guides for the freshness system
const posts = import.meta.glob("../data/articles/*.md", { eager: true });
const latestGuides = Object.entries(posts)
  .map(([filePath, module]: [string, any]) => {
    const parts = filePath.split(/[/\\]/);
    return {
      slug: parts[parts.length - 1].replace(".md", ""),
      title: module.frontmatter.title,
      category: module.frontmatter.category,
      lastUpdated: module.frontmatter.lastUpdated
    };
  })
  .sort((a, b) => b.lastUpdated.localeCompare(a.lastUpdated))
  .slice(0, 2);

function getStatusClass(status: 'allowed' | 'prohibited' | 'restricted') {
  if (status === 'allowed') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'prohibited') return "bg-error-soft border-error/25 text-error-deep";
  return "bg-warning-soft border-warning/25 text-warning-deep";
}

function getCarryOnLabel(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'Allowed';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'Not Allowed';
  return 'Restricted';
}

function getCheckedLabel(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'Allowed';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'Not Allowed';
  return 'Restricted';
}

function getStatusBadgeClass(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'text-emerald-700 bg-emerald-50 border border-emerald-200';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'text-error-deep bg-error-soft border border-error/25';
  return 'text-warning-deep bg-warning-soft border border-warning/30';
}
---

<Layout 
  title="TSA Carry-On Checker: Is It Allowed on a Plane?"
  description="Type any item to instantly see if it goes in your carry-on or checked bag. Free TSA tool — razors, liquids, power banks, food & more. Try it now."
  image="/og-image.png"
  imageAlt="BringOnPlane — Search TSA Rules for Any Item You Want to Pack"
  canonicalURL="https://bringonplane.com/"
  keywords="can i bring food through tsa, can i bring food on a plane, can i bring a vape on a plane, what can i bring on a plane, can i bring snacks on a plane, can i bring a portable charger on a plane, can i bring toothpaste on a plane, can i bring scissors on a plane, can i bring a razor on a plane, can i bring deodorant on a plane, can i bring a lighter on a plane, can i bring batteries on a plane, can i bring cologne on a plane, can i bring hairspray on a plane, can i bring a power bank on a plane, tsa liquid rules, tsa 3-1-1 rule, carry on packing list, packing list generator, can i bring a beard trimmer on a plane, beard trimmer carry on, is beard trimmer allowed in cabin baggage, beard trimmer tsa, trimmer allowed in carry on, can i take a beard trimmer in my carry on, can you take a beard trimmer on a plane, electric razor on plane, electric shaver carry on, electric razor carry on, can i bring tent stakes on a plane, tsa tent stakes, tent stakes carry on, can i bring tent stakes in checked luggage, can you bring dumbbells on a plane, can you take dumbbells on a plane, can i bring dumbbells on a plane, can you bring weights on a plane, can i bring matches on a plane, can you bring matches on a plane, safety matches tsa, matchbook on plane, can i bring dog food on a plane, can you bring dog treats on a plane, dog treats tsa, can i take dog treats in my carry on, can you bring honey to canada, can i bring honey to canada, bringing honey into canada, can i bring protein bars on a plane, protein bars carry on, tsa protein bars, are protein bars allowed in carry on, can i bring bananas on a plane, banana tsa, can bananas go through tsa, can i bring a banana on a plane, can you bring a screwdriver on a plane, screwdriver tsa, can i take a screwdriver on a plane, can i take a screwdriver in my carry on, box cutter in checked luggage, can you put a box cutter in checked luggage, can i bring a box cutter in checked luggage, are box cutters allowed in checked luggage, can i bring contact solution on a plane, tsa contact solution, contact lens solution plane, can i bring candles on a plane, can you bring candles on a plane, candles on plane, are candles allowed on planes, can i bring a hookah on a plane, can you bring a hookah on the plane, can you bring carbonated drinks on a plane, can you fly with carbonated beverages, are chips allowed in carry on luggage, can you take potato chips on a plane, can you take dog food on a plane, can i bring coffee beans on a plane, coffee beans carry on, can i put smart watch in checked luggage, smart watch in checked luggage, can i bring high heels in my carry on, can you bring heels on a plane, can you take a beard trimmer on an airplane, is trimmer allowed in checked baggage, electric shaver airplane, are electric shavers allowed on planes, can you bring an electric shaver on a plane, ryanair electric toothbrush, ryanair electric shaver, can you bring propane on a plane, can you fly with propane canisters, can you fly with butane canisters, can someone pack scissors and a vape in a checked bag, vape pen in checked luggage, can i bring raw cones on a plane, raw cones tsa, baby milk stansted, taking baby milk through airport security uk, is there a way to bring my full hair routine on a plane, hair routine carry on, electronics in checked luggage, can i put electronics in checked luggage, which phone is banned from planes, samsung galaxy note 7 banned flight, united airlines camera policy, can i bring camera on united airlines, lufthansa alcohol checked baggage, can i bring alcohol in checked luggage lufthansa, can i bring a camping knife on a plane, camping knife checked luggage, can i bring a kettlebell on a plane, kettlebell checked luggage, can i bring a bicycle on a plane, bicycle on plane checked baggage, duty free perfume allowance uk, how much perfume can i bring into uk, can i bring milk powder to canada, baby formula powder canada customs, can i bring snow globes on a plane, snow globe tsa, can i bring a snow globe in carry on"
>
  <!-- WebSite + SearchAction JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Bring On Plane",
    "alternateName": "BringOnPlane",
    "url": "https://bringonplane.com",
    "description": "Search TSA carry-on and checked bag rules for any item you want to bring on a plane.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://bringonplane.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I bring food or snacks through TSA security?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bring solid food and snacks (like sandwiches, fresh fruits, bananas, beef jerky, bread, chips, candy, and granola bars) through TSA checkpoints and on the plane in carry-on and checked bags. However, liquid or spreadable foods (such as peanut butter, honey, jam, jelly, yogurt, and baby food puree) are subject to the 3-1-1 liquids rule (under 3.4 oz / 100ml) in carry-on luggage."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bring a vape, e-cigarette, or electronic cigarette on a plane?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bring a vape, e-cigarette, and disposable vapes on a plane, but they are strictly restricted to carry-on baggage only. FAA safety regulations prohibit carrying lithium battery-powered vapes, vape pens, and spare vape juice in checked hold luggage due to fire hazards."
        }
      },
      {
        "@type": "Question",
        "name": "Can I pack portable chargers, power banks, and batteries in my luggage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Portable chargers, lithium-ion power banks, and spare battery packs must be packed in carry-on baggage only. They are prohibited in checked baggage holds. Standard dry cell batteries (AA, AAA, double a batteries) can travel in either carry-on or checked luggage, but must be protected from short circuits."
        }
      },
      {
        "@type": "Question",
        "name": "Are lighters, matches, and scissors allowed on a plane?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can bring one common lighter (like a Bic or Zippo lighter) or one book of safety matches in your pocket or carry-on. Scissors with blades under 4 inches from the pivot point (like kids scissors or eyebrow scissors) are permitted in carry-on bags. Larger tools, utility knives, and box cutters must go in checked baggage."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bring razors (disposable, electric, or safety razors) in my carry-on?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Disposable razors (cartridge razors) and electric razors/shavers are 100% allowed in carry-on bags. However, safety razors and straight razors are only allowed in carry-ons if the blades are removed. Spare safety razor blades must be packed in checked bags."
        }
      },
      {
        "@type": "Question",
        "name": "How do toiletries, deodorant, cologne, and toothpaste fit TSA rules?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Toiletries in carry-on bags must comply with the 3-1-1 liquids limit. Liquid, gel, or aerosol deodorants, cologne, perfume, and toothpaste must be in containers of 3.4 oz (100ml) or less and fit inside a single quart-sized clear plastic bag. Solid stick deodorants, bar soaps, and dry powders are exempt from this limit."
        }
      }
    ]
  })} />

  <!-- Header Slot -->
  <Header slot="header" />

  <!-- ════════════════════════════════════════════════════════════════
       HERO — redesigned per mockup: focused search + popular chips
       + inline search result preview card
  ════════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-slate-950 text-white border-b border-slate-800/80 max-w-full" id="hero">
    <!-- Mesh Gradient & Ambient Glow Background -->
    <div class="absolute inset-0 pointer-events-none opacity-30 select-none" aria-hidden="true" style="background: radial-gradient(circle at 50% 10%, #1e40af 0%, #0f172a 60%, #020617 100%); filter: blur(60px);"></div>

    <!-- Animated Radar Scanner & Contrail Line -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] sm:w-[750px] h-[600px] sm:h-[750px] rounded-full border border-blue-500/15 opacity-30 flex items-center justify-center">
        <div class="w-[400px] sm:w-[550px] h-[400px] sm:h-[550px] rounded-full border border-blue-500/15 flex items-center justify-center">
          <div class="w-[250px] sm:w-[350px] h-[250px] sm:h-[350px] rounded-full border border-blue-500/15"></div>
        </div>
        <div class="absolute inset-0 animate-radar-sweep opacity-20 bg-[conic-gradient(from_0deg_at_50%_50%,rgba(37,99,235,0.5)_0deg,transparent_60deg)] rounded-full"></div>
      </div>
    </div>

    <div class="relative z-10 max-w-[1200px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-center flex flex-col items-center">

      <!-- Eyebrow Badge -->
      <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 mb-5 select-none shadow-sm animate-float-plane max-w-full">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0"></span>
        <span class="font-mono text-[10px] sm:text-xs font-semibold uppercase tracking-wider truncate">Official TSA · FAA · IATA Baggage Directory</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12] text-white mb-4 max-w-[900px] text-balance">
        Can I Bring This On A Plane?
      </h1>

      <!-- Featured Snippet Quick Answer Box -->
      <div class="w-full max-w-[680px] bg-slate-900/80 border border-slate-800 backdrop-blur-md rounded-2xl p-4 sm:p-5 text-slate-300 text-xs sm:text-sm leading-relaxed mb-8 shadow-xl text-left">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-400">Quick Answer & Rules Checker</span>
        </div>
        <p class="text-slate-300 leading-normal mb-3">
          Type any item name into the tool below to see instant official TSA verdicts:
        </p>
        <div class="flex flex-wrap gap-2 text-xs font-medium">
          <span class="px-2.5 py-1 rounded-md bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ✓ Allowed in Carry-on
          </span>
          <span class="px-2.5 py-1 rounded-md bg-amber-950/80 border border-amber-500/40 text-amber-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> ⚠ Restricted / Conditions
          </span>
          <span class="px-2.5 py-1 rounded-md bg-red-950/80 border border-red-500/40 text-red-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> ✗ Prohibited in Carry-on
          </span>
        </div>
      </div>

      <!-- Large Search Bar -->
      <div class="w-full max-w-[580px] relative mb-6 group" id="homepage-search-container">
        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-400 transition-colors z-10">
          <Search class="w-5 h-5" aria-hidden="true" />
        </div>
        <input 
          type="text" 
          id="homepage-search-input"
          placeholder="Type any item (e.g. Razor, Power Bank, Shampoo)..." 
          autocomplete="off" 
          spellcheck="false"
          class="w-full h-14 pl-12 pr-20 sm:pr-24 bg-slate-900/90 border border-slate-700 hover:border-slate-600 focus:border-blue-500 rounded-2xl text-sm sm:text-base text-white placeholder:text-slate-500 shadow-xl focus:shadow-2xl focus:shadow-blue-500/10 outline-none transition-all"
        />
        
        <!-- Clear Button -->
        <button 
          type="button" 
          id="homepage-search-clear" 
          class="absolute inset-y-0 right-12 sm:right-16 flex items-center text-slate-400 hover:text-white hidden cursor-pointer px-2 transition-colors z-10" 
          aria-label="Clear search"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" x2="6" y1="6" y2="18"></line>
            <line x1="6" x2="18" y1="6" y2="18"></line>
          </svg>
        </button>

        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none gap-1 z-10">
          <kbd class="hidden sm:inline-flex items-center justify-center h-6 px-1.5 text-[10px] font-mono font-medium border border-slate-700 bg-slate-800 text-slate-300 rounded shadow-xs">⌘K</kbd>
        </div>
        
        <!-- Suggestions Dropdown -->
        <div 
          id="homepage-suggestions" 
          class="absolute top-[calc(100%+8px)] left-0 right-0 z-30 hidden bg-slate-900/95 backdrop-blur-xl border border-slate-700 rounded-2xl shadow-2xl overflow-hidden max-h-[320px] overflow-y-auto text-left transition-all"
        >
          <!-- Suggestions populated dynamically -->
        </div>
      </div>

      <!-- Popular Searches chips -->
      <div class="w-full max-w-[580px] mb-8">
        <p class="text-[11px] text-slate-400 font-mono mb-2.5 text-center sm:text-left uppercase tracking-wider font-semibold">Popular Searches</p>
        <div class="flex flex-wrap justify-center sm:justify-start gap-2" id="popular-chips" role="list">
          {popularItems.map((chip, i) => (
            <button
              type="button"
              role="listitem"
              data-chip-index={i}
              data-chip-slug={chip.slug}
              class="popular-chip px-3 py-1.5 rounded-xl border border-slate-700/80 bg-slate-900/80 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 hover:border-blue-500/50 cursor-pointer transition-all select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              aria-pressed="false"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Quick-Click Category Grid -->
      <div class="w-full max-w-[760px] pt-6 border-t border-slate-800/80">
        <p class="text-[11px] text-slate-400 font-mono mb-3 text-center sm:text-left uppercase tracking-wider font-semibold">Browse by Category</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5">
          {[
            { label: "Liquids", slug: "liquids", color: "bg-blue-500/10 border-blue-500/25 text-blue-300 hover:bg-blue-500/20 hover:border-blue-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-11-7-11S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>` },
            { label: "Electronics", slug: "electronics", color: "bg-purple-500/10 border-purple-500/25 text-purple-300 hover:bg-purple-500/20 hover:border-purple-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>` },
            { label: "Food", slug: "food", color: "bg-emerald-500/10 border-emerald-500/25 text-emerald-300 hover:bg-emerald-500/20 hover:border-emerald-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" x2="6" y1="1" y2="4"/><line x1="10" x2="10" y1="1" y2="4"/><line x1="14" x2="14" y1="1" y2="4"/></svg>` },
            { label: "Medicine", slug: "medicine", color: "bg-rose-500/10 border-rose-500/25 text-rose-300 hover:bg-rose-500/20 hover:border-rose-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/></svg>` },
            { label: "Tools", slug: "tools", color: "bg-amber-500/10 border-amber-500/25 text-amber-300 hover:bg-amber-500/20 hover:border-amber-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>` },
            { label: "Personal Care", slug: "personal-care", color: "bg-pink-500/10 border-pink-500/25 text-pink-300 hover:bg-pink-500/20 hover:border-pink-400", icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>` },
          ].map(cat => (
            <a
              href={`/category/${cat.slug}`}
              class={`flex flex-col items-center gap-1.5 px-3 py-3 rounded-xl border text-center cursor-pointer transition-all duration-200 hover:-translate-y-0.5 select-none ${cat.color}`}
            >
              <span set:html={cat.icon} />
              <span class="text-xs font-semibold leading-tight">{cat.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

      <!-- ── Inline Search Result Panel (hidden until a chip/search clicked) ── -->
      <div
        id="hero-result-panel"
        class="hidden"
        aria-live="polite"
        aria-label="Search result"
      >
        <div class="max-w-[720px] mx-auto px-4 pb-14 animate-fade-in">
          <!-- Result Card -->
          <div class="bg-canvas border border-hairline rounded-xl shadow-level-4 overflow-hidden">

            <!-- ── BIG BINARY YES/NO VERDICT BANNER (Feature 2) ── -->
            <div id="result-verdict-banner" class="px-6 py-4 border-b border-hairline flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span id="result-verdict-icon" class="flex-shrink-0"></span>
                <div>
                  <p class="text-[10px] font-mono text-mute uppercase tracking-wider mb-0.5">Carry-On Answer</p>
                  <p id="result-verdict-text" class="text-2xl font-extrabold tracking-tight">Loading…</p>
                </div>
              </div>
              <button
                type="button"
                id="result-close-btn"
                aria-label="Close result"
                class="p-1.5 rounded-md hover:bg-canvas-soft text-mute hover:text-ink transition-colors flex-shrink-0"
              >
                <X class="w-4 h-4" aria-hidden="true" />
              </button>
            </div>

            <!-- Card Header -->
            <div class="px-6 pt-4 pb-3 border-b border-hairline flex items-center gap-3">
              <span id="result-title-icon-container" class="text-mute flex-shrink-0"></span>
              <div>
