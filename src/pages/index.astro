  interface SearchItem {
    slug: string;
    name: string;
    category: string;
    aliases: string[];
    keywords: string[];
    carryOn: string;
    checked: string;
  }

  interface FullItem {
    slug: string;
    name: string;
    category: string;
    carryOn: { status: string; reason: string; };
    checkedBag: { status: string; reason: string; };
  }

  // Premium SVG Icons for Categories (replacing raw emojis)
  const categoryIcons: Record<string, string> = {
