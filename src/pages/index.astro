h butane canisters, can someone pack scissors and a vape in a checked bag, vape pen in checked luggage, can i bring raw cones on a plane, raw cones tsa, baby milk stansted, taking baby milk through airport security uk, is there a way to bring my full hair routine on a plane, hair routine carry on, electronics in checked luggage, can i put electronics in checked luggage, which phone is banned from planes, samsung galaxy note 7 banned flight, united airlines camera policy, can i bring camera on united airlines, lufthansa alcohol checked baggage, can i bring alcohol in checked luggage lufthansa, can i bring a camping knife on a plane, camping knife checked luggage, can i bring a kettlebell on a plane, kettlebell checked luggage, can i bring a bicycle on a plane, bicycle on plane checked baggage, duty free perfume allowance uk, how much perfume can i bring into uk, can i bring milk powder to canada, baby formula powder canada customs, can i bring snow globes on a plane, snow globe tsa, can i bring a snow globe in carry on"
>
  <!-- WebSite + SearchAction JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Bring On Plane",
    "alternateName": "BringOnPlane",
    "url": "https://bringonplane.com/",
    "description": "Search TSA carry-on and checked bag rules for any item you want to bring on a plane.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://bringonplane.com/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I bring food or snacks through TSA security?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bring solid food and snacks (like sandwiches, fresh fruits, bananas, beef jerky, bread, chips, candy, and granola bars) through TSA checkpoints and on the plane in carry-on and checked bags. However, liquid or spreadable foods (such as peanut butter, honey, jam, jelly, yogurt, and baby food puree) are subject to the 3-1-1 liquids rule (under 3.4 oz / 100ml) in carry-on luggage."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bring a vape, e-cigarette, or electronic cigarette on a plane?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can bring a vape, e-cigarette, and disposable vapes on a plane, but they are strictly restricted to carry-on baggage only. FAA safety regulations prohibit carrying lithium battery-powered vapes, vape pens, and spare vape juice in checked hold luggage due to fire hazards."
        }
      },
      {
        "@type": "Question",
        "name": "Can I pack portable chargers, power banks, and batteries in my luggage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Portable chargers, lithium-ion power banks, and spare battery packs must be packed in carry-on baggage only. They are prohibited in checked baggage holds. Standard dry cell batteries (AA, AAA, double a batteries) can travel in either carry-on or checked luggage, but must be protected from short circuits."
        }
      },
      {
        "@type": "Question",
        "name": "Are lighters, matches, and scissors allowed on a plane?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can bring one common lighter (like a Bic or Zippo lighter) or one book of safety matches in your pocket or carry-on. Scissors with blades under 4 inches from the pivot point (like kids scissors or eyebrow scissors) are permitted in carry-on bags. Larger tools, utility knives, and box cutters must go in checked baggage."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bring razors (disposable, electric, or safety razors) in my carry-on?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Disposable razors (cartridge razors) and electric razors/shavers are 100% allowed in carry-on bags. However, safety razors and straight razors are only allowed in carry-ons if the blades are removed. Spare safety razor blades must be packed in checked bags."
        }
      },
      {
        "@type": "Question",
        "name": "How do toiletries, deodorant, cologne, and toothpaste fit TSA rules?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Toiletries in carry-on bags must comply with the 3-1-1 liquids limit. Liquid, gel, or aerosol deodorants, cologne, perfume, and toothpaste must be in containers of 3.4 oz (100ml) or less and fit inside a single quart-sized clear plastic bag. Solid stick deodorants, bar soaps, and dry powders are exempt from this limit."
        }
      }
    ]
  })} />

