---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getAllItems, getItemBySlug } from "../lib/items";
import { 
  Search, 
  Laptop, 
  Droplet, 
  Apple, 
  Activity, 
  Baby, 
  Wrench, 
  Trophy, 
  Sparkles, 
  Gem, 
  FileText,
  ArrowRight,
  ShieldCheck,
  PlaneTakeoff,
  Luggage,
  ChevronDown,
  HelpCircle,
  CheckCircle2,
  XCircle,
  AlertCircle,
  ExternalLink,
  X,
  Info,
  Mail,
  Lock,
  ShieldAlert
} from "@lucide/astro";

const items = getAllItems();

// 10 categories requested by the user
const categoriesList = [
  { name: "Electronics", icon: Laptop },
  { name: "Liquids", icon: Droplet },
  { name: "Food", icon: Apple },
  { name: "Medicine", icon: Activity },
  { name: "Baby", icon: Baby },
  { name: "Tools", icon: Wrench },
  { name: "Sports", icon: Trophy },
  { name: "Personal Care", icon: Sparkles },
  { name: "Jewelry", icon: Gem },
  { name: "Documents", icon: FileText },
];

// Dynamically count items in each category
const categories = categoriesList.map(cat => {
  const count = items.filter(item => item.category === cat.name).length;
  return { ...cat, count };
});

// ── Popular Searches (10 chips shown in hero) ────────────────────────────────
// Maps label → slug.
const popularSearchChips = [
  { label: "Power Bank",     slug: "power-bank" },
  { label: "Perfume",        slug: "perfume" },
  { label: "Toothpaste",     slug: "toothpaste" },
  { label: "Scissors",       slug: "scissors" },
  { label: "Laptop",         slug: "laptop" },
  { label: "Drone",          slug: "drone" },
  { label: "Protein Powder", slug: "protein-powder" },
  { label: "Vape",           slug: "vape" },
  { label: "Razor",          slug: "razor" },
  { label: "Camera",         slug: "camera" },
];

// Pre-load full item data for each popular chip (build-time)
const popularItems = popularSearchChips.map(chip => ({
  ...chip,
  item: getItemBySlug(chip.slug),
}));

// Most searched queries (TSA heavy queries — used in the section below the hero)
const mostSearchedSlugs = ["power-bank", "sunscreen", "laptop", "aerosol-insect-repellent"];
const mostSearched = mostSearchedSlugs.map(slug => items.find(i => i.slug === slug)).filter((x): x is NonNullable<typeof x> => !!x);

// Latest reviewed items (sorted by lastReviewed date descending)
const latestReviewed = [...items]
  .sort((a, b) => b.lastReviewed.localeCompare(a.lastReviewed))
  .slice(0, 4);

// Fetch latest travel guides for the freshness system
const posts = import.meta.glob("../data/articles/*.md", { eager: true });
const latestGuides = Object.entries(posts)
  .map(([filePath, module]: [string, any]) => {
    const parts = filePath.split(/[/\\]/);
    return {
      slug: parts[parts.length - 1].replace(".md", ""),
      title: module.frontmatter.title,
      category: module.frontmatter.category,
      lastUpdated: module.frontmatter.lastUpdated
    };
  })
  .sort((a, b) => b.lastUpdated.localeCompare(a.lastUpdated))
  .slice(0, 2);

function getStatusClass(status: 'allowed' | 'prohibited' | 'restricted') {
  if (status === 'allowed') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'prohibited') return "bg-error-soft border-error/25 text-error-deep";
  return "bg-warning-soft border-warning/25 text-warning-deep";
}

function getCarryOnLabel(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'Allowed';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'Not Allowed';
  return 'Restricted';
}

function getCheckedLabel(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'Allowed';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'Not Allowed';
  return 'Restricted';
}

function getStatusBadgeClass(status: string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return 'text-emerald-700 bg-emerald-50 border border-emerald-200';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'text-error-deep bg-error-soft border border-error/25';
  return 'text-warning-deep bg-warning-soft border border-warning/30';
}
---

