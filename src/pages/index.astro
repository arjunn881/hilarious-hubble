    'Restricted Items': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`,
    'Restricted': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`,
    'Liquids': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-11-7-11S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>`,
    'Outdoor': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>`,
    'Camping': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>`,
    'Sports': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M6 12A6 6 0 0 1 18 12"/><path d="M12 6A6 6 0 0 0 12 18"/></svg>`,
    'Gifts & Shopping': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="14" x="3" y="8" rx="2"/><path d="M12 5V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2"/><path d="M12 5v3"/><path d="M12 8H3M21 8h-9"/></svg>`,
    'Baby': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>`,
    'Pets': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5a5.5 5.5 0 0 0-9.8-3.32 5.5 5.5 0 0 0-9.8 3.32C2.4 10.79 3.9 12.54 5.4 14l6.6 6Z"/></svg>`,
    'Beauty': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m12 3-1.912 5.886H3.886L8.7 12.518 6.788 18.4 12 14.782 17.212 18.4l-1.912-5.882 4.814-3.632h-6.202L12 3z"/></svg>`,
    'Clothing': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.38 3.46 16 7.83V17c0 1.1-.9 2-2 2H10c-1.1 0-2-.9-2-2V7.83L3.62 3.46c-.6-.6-.18-1.46.68-1.46h15.4c.86 0 1.28.86.68 1.46z"/></svg>`,
    'Documents': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>`,
    'Jewelry': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>`,
    'Batteries': `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="16" height="10" x="2" y="7" rx="2" ry="2"/><line x1="22" x2="22" y1="11" y2="13"/><line x1="6" x2="6" y1="11" y2="13"/><line x1="10" x2="10" y1="10" y2="14"/><line x1="14" x2="14" y1="11" y2="13"/></svg>`
  };

  const defaultIcon = `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="16"/><line x1="8" x2="16" y1="12" y2="12"/></svg>`;

  function getCategoryIconSvg(category: string): string {
    return categoryIcons[category] || defaultIcon;
  }

  // Premium Status Badges utilizing SVG icons instead of emojis
  function getStatusBadgeHtml(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/20 dark:text-emerald-400 dark:border-emerald-900/30">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Allowed
        </span>
      `;
    }
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200 dark:bg-red-950/20 dark:text-red-400 dark:border-red-900/30">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
          Not Allowed
        </span>
      `;
    }
    return `
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/20 dark:text-amber-400 dark:border-amber-900/30">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" x2="12" y1="9" y2="13"></line><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>
        Restricted
      </span>
    `;
  }

  // Quick Summary indicators
  function getSummaryIndicatorSvg(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') {
      return `<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
    }
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') {
      return `<svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>`;
    }
    return `<svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`;
  }

  function getSummaryLabel(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') return 'Yes';
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'No';
    return 'Conditional';
  }

  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let highlightedIndex = -1;
  let matchingSuggestions: SearchItem[] = [];

  // Embedded popular items cache
  function getPopularItemsCache(): Record<string, any> {
    try {
      const el = document.getElementById('popular-items-data');
      if (!el) return {};
      const data = JSON.parse(el.textContent || '[]');
      const map: Record<string, any> = {};
      data.forEach((d: any) => { if (d.slug) map[d.slug] = d; });
      return map;
    } catch {
      return {};
    }
  }

  async function loadSearchIndex() {
    if (isIndexLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error('Search index response not ok');
      searchIndex = await res.json();
      isIndexLoaded = true;
    } catch (e) {
      console.warn('Could not load search index from static endpoint', e);
    }
  }

  // Preload search index immediately
  loadSearchIndex();

  // Fetch full item details and render
  async function handleItemSelected(slug: string, sourceChip: HTMLButtonElement | null = null) {
    const panel = document.getElementById('hero-result-panel');
    if (!panel) return;

    // Highlight active chip if it was selected from a chip or matches slug
    const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
    chips.forEach(c => {
      const isMatch = (sourceChip && c === sourceChip) || c.dataset.chipSlug === slug;
      if (isMatch) {
        c.classList.add('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
        c.setAttribute('aria-pressed', 'true');
      } else {
        c.classList.remove('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
        c.setAttribute('aria-pressed', 'false');
      }
    });

    const popularCache = getPopularItemsCache();
    const cachedItem = popularCache[slug];
    const indexItem = searchIndex.find(i => i.slug === slug);

    let item: FullItem = {
      slug,
      name: cachedItem?.name || indexItem?.name || slug.replace(/-/g, ' '),
      category: cachedItem?.category || indexItem?.category || 'Travel Item',
      carryOn: {
        status: cachedItem?.carryOn || indexItem?.carryOn || 'ALLOWED',
        reason: cachedItem?.carryOnReason || 'Must comply with standard airline baggage security regulations.'
      },
      checkedBag: {
        status: cachedItem?.checked || indexItem?.checked || 'ALLOWED',
        reason: cachedItem?.checkedReason || 'Permitted in checked baggage according to TSA guidelines.'
      }
    };

    // Render immediately with cached/index data
    renderItemVerdict(item, panel);

    // Try fetching full item JSON for richer descriptions
    try {
      const res = await fetch(`/api/items/${slug}.json`);
      if (res.ok) {
        const fullItem: FullItem = await res.json();
        renderItemVerdict(fullItem, panel);
      }
    } catch {
      // Keep rendered cached version
    }
  }

  function renderItemVerdict(item: FullItem, panel: HTMLElement) {
    const nameText = document.getElementById('result-title-text');
    const iconContainer = document.getElementById('result-title-icon-container');
    const catEl = document.getElementById('result-category');
    
    const carryonBadgeContainer = document.getElementById('result-carryon-badge-container');
    const checkedBadgeContainer = document.getElementById('result-checked-badge-container');
    
    const reasonEl = document.getElementById('result-reason');
    const statusIconEl = document.getElementById('result-status-icon-container');
    
    const summaryCoIcon = document.getElementById('result-summary-carryon-icon-container');
    const summaryCoText = document.getElementById('result-summary-carryon-text');
    const summaryCkIcon = document.getElementById('result-summary-checked-icon-container');
    const summaryCkText = document.getElementById('result-summary-checked-text');
    const summaryPiIcon = document.getElementById('result-summary-personal-icon-container');
    const summaryPiText = document.getElementById('result-summary-personal-text');
    
    const fullLink = document.getElementById('result-full-link') as HTMLAnchorElement | null;

    if (nameText) nameText.textContent = item.name;
    if (iconContainer) iconContainer.innerHTML = getCategoryIconSvg(item.category);
    if (catEl) catEl.textContent = item.category;
    
    const coStatus = (item.carryOn?.status || 'ALLOWED').toUpperCase();
    const ckStatus = (item.checkedBag?.status || 'ALLOWED').toUpperCase();

    if (carryonBadgeContainer) carryonBadgeContainer.innerHTML = getStatusBadgeHtml(coStatus);
    if (checkedBadgeContainer) checkedBadgeContainer.innerHTML = getStatusBadgeHtml(ckStatus);

    // Big YES/NO verdict banner
    const verdictBanner = document.getElementById('result-verdict-banner');
    const verdictText = document.getElementById('result-verdict-text');
    const verdictIcon = document.getElementById('result-verdict-icon');

    if (verdictText && verdictIcon && verdictBanner) {
      if (coStatus === 'ALLOWED') {
        verdictText.textContent = 'YES — Allowed in Carry-on';
        verdictText.className = 'text-2xl font-extrabold tracking-tight text-emerald-600 dark:text-emerald-400';
        verdictBanner.className = 'px-6 py-4 border-b border-emerald-200 dark:border-emerald-800/80 flex items-center justify-between gap-4 bg-emerald-50/90 dark:bg-emerald-950/60 transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/60 border border-emerald-300 dark:border-emerald-700 text-emerald-600 dark:text-emerald-400"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>`;
      } else if (coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED') {
        verdictText.textContent = 'NO — Not Allowed in Carry-on';
        verdictText.className = 'text-2xl font-extrabold tracking-tight text-rose-600 dark:text-rose-400';
        verdictBanner.className = 'px-6 py-4 border-b border-rose-200 dark:border-rose-800/80 flex items-center justify-between gap-4 bg-rose-50/90 dark:bg-rose-950/60 transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-900/60 border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg></span>`;
      } else {
        verdictText.textContent = 'RESTRICTED — Conditions Apply';
        verdictText.className = 'text-2xl font-extrabold tracking-tight text-amber-600 dark:text-amber-400';
        verdictBanner.className = 'px-6 py-4 border-b border-amber-200 dark:border-amber-800/80 flex items-center justify-between gap-4 bg-amber-50/90 dark:bg-amber-950/60 transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/60 border border-amber-300 dark:border-amber-700 text-amber-600 dark:text-amber-400"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg></span>`;
      }
    }

    // Status/Reason message
    const reason = item.carryOn?.reason || item.checkedBag?.reason || 'Must comply with standard TSA airport screening rules.';
    if (reasonEl) reasonEl.textContent = reason;
    
    // Status icon based on restriction
    if (statusIconEl) {
      const carriesRestricted = coStatus === 'RESTRICTED' || coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED';
      statusIconEl.innerHTML = carriesRestricted 
        ? `<svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" x2="12" y1="9" y2="13"></line><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>`
        : `<svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
    }

    // Quick Summary
    if (summaryCoIcon && summaryCoText) {
      summaryCoIcon.innerHTML = getSummaryIndicatorSvg(coStatus);
      summaryCoText.textContent = getSummaryLabel(coStatus);
    }
    if (summaryCkIcon && summaryCkText) {
      summaryCkIcon.innerHTML = getSummaryIndicatorSvg(ckStatus);
      summaryCkText.textContent = getSummaryLabel(ckStatus);
    }
    if (summaryPiIcon && summaryPiText) {
      summaryPiIcon.innerHTML = getSummaryIndicatorSvg(coStatus);
      summaryPiText.textContent = getSummaryLabel(coStatus);
    }

    if (fullLink) {
      fullLink.href = `/items/${item.slug}/`;
      fullLink.innerHTML = `Read Full TSA Rules →`;
    }

    // Smooth reveal
    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function findBestMatch(rawQuery: string): SearchItem | undefined {
    const q = rawQuery.toLowerCase().trim();
    if (!q || searchIndex.length === 0) return undefined;

    // 1. Direct exact or substring match on name
    const exactName = searchIndex.find(i => i.name.toLowerCase() === q || i.slug === q);
    if (exactName) return exactName;

    // 2. Query contains item name (e.g. "Perfume / Cologne" contains "perfume")
    const containedName = searchIndex.find(i => q.includes(i.name.toLowerCase()) || i.name.toLowerCase().includes(q));
    if (containedName) return containedName;

    // 3. Token-based word match
    const tokens = q.split(/[\s,/\-_]+/).filter(t => t.length >= 2);
    for (const token of tokens) {
      const match = searchIndex.find(i => 
        i.name.toLowerCase().includes(token) || 
        i.aliases.some(a => a.toLowerCase().includes(token)) ||
        i.keywords.some(k => k.toLowerCase().includes(token))
      );
      if (match) return match;
    }

    return undefined;
  }

  function setupInteractiveSearch() {
    const input = document.getElementById('homepage-search-input') as HTMLInputElement | null;
    const submitBtn = document.getElementById('homepage-search-submit');
    const suggestions = document.getElementById('homepage-suggestions');
    const clearBtn = document.getElementById('homepage-search-clear');
    const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
    const closeBtn = document.getElementById('result-close-btn');
    const panel = document.getElementById('hero-result-panel');

    if (!input || !suggestions) return;

    // Ensure index is loaded
    loadSearchIndex();
    input.addEventListener('focus', () => {
      loadSearchIndex();
    });

    function updateClearButtonVisibility() {
      if (clearBtn) {
        if (input.value) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    async function renderSuggestions() {
      await loadSearchIndex();
      const q = input.value.toLowerCase().trim();
      if (!q) {
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        return;
      }

      const tokens = q.split(/[\s,/\-_]+/).filter(t => t.length >= 2);

      matchingSuggestions = searchIndex.filter(item => {
        const itemName = item.name.toLowerCase();
        const itemCat = item.category.toLowerCase();
        
        // Exact substring
        if (itemName.includes(q) || itemCat.includes(q) || q.includes(itemName)) return true;
        if (item.aliases.some(alias => alias.toLowerCase().includes(q) || q.includes(alias.toLowerCase()))) return true;
        if (item.keywords.some(kw => kw.toLowerCase().includes(q))) return true;

        // Token match
        if (tokens.length > 0) {
          return tokens.some(t => itemName.includes(t) || item.aliases.some(a => a.toLowerCase().includes(t)));
        }

        return false;
      }).slice(0, 6);

      highlightedIndex = -1;

      if (matchingSuggestions.length === 0) {
        suggestions.innerHTML = `
          <div class="p-4 text-sm text-slate-500 dark:text-slate-400">
            No exact match for "<span class="font-medium text-slate-800 dark:text-slate-200">${input.value}</span>". Try <button type="button" class="text-blue-600 dark:text-blue-400 font-medium hover:underline cursor-pointer" id="suggest-powerbank">Power Bank</button> or browse <a href="/items/page/1/" class="text-blue-600 dark:text-blue-400 font-medium hover:underline">All 196+ Items</a>.
          </div>
        `;
        suggestions.classList.remove('hidden');
        
        const fallbackBtn = document.getElementById('suggest-powerbank');
        if (fallbackBtn) {
          fallbackBtn.addEventListener('click', () => {
            input.value = 'Power Bank';
            input.focus();
            renderSuggestions();
            updateClearButtonVisibility();
          });
        }
        return;
      }

      // Render suggestions
      suggestions.innerHTML = matchingSuggestions.map((item, idx) => {
        const iconSvg = getCategoryIconSvg(item.category);
        const coStatus = (item.carryOn || '').toUpperCase();
        const badgeColor = coStatus === 'ALLOWED'
          ? 'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-700/60'
          : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED'
          ? 'bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-300 border-red-200 dark:border-red-700/60'
          : 'bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-700/60';
        const badgeLabel = coStatus === 'ALLOWED' ? 'Allowed' : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED' ? 'Not Allowed' : 'Restricted';
        return `
          <button 
            type="button" 
            class="suggestion-item w-full flex items-center justify-between px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm text-slate-800 dark:text-slate-100 cursor-pointer text-left border-l-2 border-transparent transition-all"
            data-slug="${item.slug}"
            data-index="${idx}"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-slate-400 flex-shrink-0">${iconSvg}</span>
              <div class="min-w-0">
                <span class="font-medium block truncate">${item.name}</span>
                <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase">${item.category}</span>
              </div>
            </div>
            <span class="inline-flex items-center text-[9px] font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider flex-shrink-0 ml-2 ${badgeColor}">${badgeLabel}</span>
          </button>
        `;
      }).join('');

      suggestions.classList.remove('hidden');

      // Bind mouseenter & click handlers to suggestion items
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => {
        el.addEventListener('click', (e) => {
          const slug = (e.currentTarget as HTMLElement).dataset.slug || '';
          const name = (e.currentTarget as HTMLElement).querySelector('.font-medium')?.textContent || '';
          input.value = name;
          suggestions.classList.add('hidden');
          updateClearButtonVisibility();
          handleItemSelected(slug);
        });

        el.addEventListener('mouseenter', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).dataset.index || '-1', 10);
          highlightedIndex = idx;
          updateHighlight();
        });
      });
    }

    function updateHighlight() {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach((item, idx) => {
        if (idx === highlightedIndex) {
          item.classList.add('bg-slate-100', 'dark:bg-slate-800', 'border-blue-600', 'dark:border-blue-400');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'border-blue-600', 'dark:border-blue-400');
        }
      });
    }

    function executeSearchAction() {
      const val = input.value.trim();
      if (!val) return;

      suggestions.classList.add('hidden');

      if (highlightedIndex >= 0 && highlightedIndex < matchingSuggestions.length) {
        const selected = matchingSuggestions[highlightedIndex];
        input.value = selected.name;
        updateClearButtonVisibility();
        handleItemSelected(selected.slug);
        return;
      }

      if (matchingSuggestions.length > 0) {
        const first = matchingSuggestions[0];
        input.value = first.name;
        updateClearButtonVisibility();
        handleItemSelected(first.slug);
        return;
      }

      const match = findBestMatch(val);
      if (match) {
        input.value = match.name;
        updateClearButtonVisibility();
        handleItemSelected(match.slug);
      } else {
        window.location.href = `/items/page/1/?q=${encodeURIComponent(val)}`;
      }
    }

    // Handle typing / matching suggestions
    input.addEventListener('input', () => {
      renderSuggestions();
      updateClearButtonVisibility();
    });

    // Search button click
    if (submitBtn) {
      submitBtn.addEventListener('click', (e) => {
        e.preventDefault();
        executeSearchAction();
      });
    }

    // Clear Search Input Action
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        updateClearButtonVisibility();
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        input.focus();
      });
    }

    // Keyboard navigation (ArrowDown, ArrowUp, Enter, Escape)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeSearchAction();
        return;
      }

      if (suggestions.classList.contains('hidden') || matchingSuggestions.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex + 1) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex - 1 + matchingSuggestions.length) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'Escape') {
        suggestions.classList.add('hidden');
      }
    });

    // Close suggestions on click outside
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !suggestions.contains(e.target as Node) && !clearBtn?.contains(e.target as Node) && !submitBtn?.contains(e.target as Node)) {
        suggestions.classList.add('hidden');
      }
    });

    // Chips clicks
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const slug = chip.dataset.chipSlug || '';
        const label = chip.textContent?.trim() || '';
        input.value = label;
        updateClearButtonVisibility();
        suggestions.classList.add('hidden');
        handleItemSelected(slug, chip);
      });
    });

    // Close result panel
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        if (panel) panel.classList.add('hidden');
        chips.forEach(c => {
          c.classList.remove('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
          c.setAttribute('aria-pressed', 'false');
        });
      });
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInteractiveSearch);
  } else {
    setupInteractiveSearch();
  }

  // Support View Transitions
  document.addEventListener('astro:after-swap', () => {
    setupInteractiveSearch();
  });
</script>
