  function getSummaryIndicatorSvg(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') {
      return `<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
    }
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') {
      return `<svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>`;
    }
    return `<svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`;
  }

  function getSummaryLabel(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') return 'Yes';
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'No';
    return 'Conditional';
  }

  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let highlightedIndex = -1;
  let matchingSuggestions: SearchItem[] = [];

  async function loadSearchIndex() {
    if (isIndexLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error();
      searchIndex = await res.json();
      isIndexLoaded = true;
    } catch (e) {
      console.error('Failed to load search index for suggestions', e);
    }
  }

  // Fetch full item details and render
  async function handleItemSelected(slug: string, sourceChip: HTMLButtonElement | null = null) {
    const panel = document.getElementById('hero-result-panel');
    if (!panel) return;

    try {
      const res = await fetch(`/api/items/${slug}.json`);
      if (!res.ok) throw new Error();
      const item: FullItem = await res.json();

      // Highlight active chip if it was selected from a chip
      const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
      chips.forEach(c => {
        c.classList.remove('border-ink', 'text-ink', 'bg-canvas-soft-2', 'font-semibold');
        c.setAttribute('aria-pressed', 'false');
      });
      if (sourceChip) {
        sourceChip.classList.add('border-ink', 'text-ink', 'bg-canvas-soft-2', 'font-semibold');
        sourceChip.setAttribute('aria-pressed', 'true');
      }

      // Populate elements
      const nameText = document.getElementById('result-title-text');
      const iconContainer = document.getElementById('result-title-icon-container');
      const catEl = document.getElementById('result-category');
      
      const carryonBadgeContainer = document.getElementById('result-carryon-badge-container');
      const checkedBadgeContainer = document.getElementById('result-checked-badge-container');
      
      const reasonEl = document.getElementById('result-reason');
      const statusIconEl = document.getElementById('result-status-icon-container');
      
      const summaryCoIcon = document.getElementById('result-summary-carryon-icon-container');
      const summaryCoText = document.getElementById('result-summary-carryon-text');
      const summaryCkIcon = document.getElementById('result-summary-checked-icon-container');
      const summaryCkText = document.getElementById('result-summary-checked-text');
      const summaryPiIcon = document.getElementById('result-summary-personal-icon-container');
      const summaryPiText = document.getElementById('result-summary-personal-text');
      
      const fullLink = document.getElementById('result-full-link') as HTMLAnchorElement | null;

      if (nameText) nameText.textContent = item.name;
      if (iconContainer) iconContainer.innerHTML = getCategoryIconSvg(item.category);
      if (catEl) catEl.textContent = item.category;
      
      if (carryonBadgeContainer) carryonBadgeContainer.innerHTML = getStatusBadgeHtml(item.carryOn.status);
      if (checkedBadgeContainer) checkedBadgeContainer.innerHTML = getStatusBadgeHtml(item.checkedBag.status);

      // Feature 2: Big YES/NO verdict banner
      const verdictBanner = document.getElementById('result-verdict-banner');
      const verdictText = document.getElementById('result-verdict-text');
      const verdictIcon = document.getElementById('result-verdict-icon');
      const coS = item.carryOn.status.toUpperCase();
      if (verdictText && verdictIcon && verdictBanner) {
        if (coS === 'ALLOWED') {
          verdictText.textContent = 'YES — Allowed in Carry-on';
          verdictText.className = 'text-2xl font-extrabold tracking-tight text-emerald-600';
          verdictBanner.className = verdictBanner.className.replace(/bg-\S+/, '') + ' bg-emerald-50/80';
          verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-emerald-100 border border-emerald-300"><svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>`;
        } else if (coS === 'NOT_ALLOWED' || coS === 'PROHIBITED') {
          verdictText.textContent = 'NO — Not Allowed in Carry-on';
          verdictText.className = 'text-2xl font-extrabold tracking-tight text-red-600';
          verdictBanner.className = verdictBanner.className.replace(/bg-\S+/, '') + ' bg-red-50/80';
          verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-red-100 border border-red-300"><svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg></span>`;
        } else {
          verdictText.textContent = 'RESTRICTED — Conditions Apply';
          verdictText.className = 'text-2xl font-extrabold tracking-tight text-amber-600';
          verdictBanner.className = verdictBanner.className.replace(/bg-\S+/, '') + ' bg-amber-50/80';
          verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-amber-100 border border-amber-300"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg></span>`;
        }
      }

      // Status/Reason message
      const reason = item.carryOn.reason || item.checkedBag.reason || 'Must comply with standard airline limits.';
      if (reasonEl) reasonEl.textContent = reason;
      
      // Status icon based on restriction
      if (statusIconEl) {
        const carriesRestricted = item.carryOn.status.toUpperCase() === 'RESTRICTED' || item.carryOn.status.toUpperCase() === 'NOT_ALLOWED';
        statusIconEl.innerHTML = carriesRestricted 
          ? `<svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" x2="12" y1="9" y2="13"></line><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>`
          : `<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="16" y2="12"/><line x1="12" x2="12.01" y1="8" y2="8"/></svg>`;
      }

      // Quick Summary
      if (summaryCoIcon && summaryCoText) {
        summaryCoIcon.innerHTML = getSummaryIndicatorSvg(item.carryOn.status);
        summaryCoText.textContent = getSummaryLabel(item.carryOn.status);
      }
      if (summaryCkIcon && summaryCkText) {
        summaryCkIcon.innerHTML = getSummaryIndicatorSvg(item.checkedBag.status);
        summaryCkText.textContent = getSummaryLabel(item.checkedBag.status);
      }
      if (summaryPiIcon && summaryPiText) {
        // Personal Item is typically same status as Carry-on
        summaryPiIcon.innerHTML = getSummaryIndicatorSvg(item.carryOn.status);
        summaryPiText.textContent = getSummaryLabel(item.carryOn.status);
      }

      if (fullLink) {
        fullLink.href = `/items/${item.slug}`;
        fullLink.innerHTML = `Read Full TSA Rules →`;
      }

      // Smooth reveal
      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } catch (e) {
      console.error('Error fetching details for selected item', e);
    }
  }

  function setupInteractiveSearch() {
    const input = document.getElementById('homepage-search-input') as HTMLInputElement | null;
    const suggestions = document.getElementById('homepage-suggestions');
    const clearBtn = document.getElementById('homepage-search-clear');
    const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
    const closeBtn = document.getElementById('result-close-btn');
    const panel = document.getElementById('hero-result-panel');

    if (!input || !suggestions) return;

    // Load search index on focus
    input.addEventListener('focus', () => {
      loadSearchIndex();
    });

    function updateClearButtonVisibility() {
      if (clearBtn) {
        if (input.value) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    function renderSuggestions() {
      const q = input.value.toLowerCase().trim();
      if (!q) {
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        return;
      }

      matchingSuggestions = searchIndex.filter(item => {
        return item.name.toLowerCase().includes(q) ||
               item.category.toLowerCase().includes(q) ||
               item.aliases.some(alias => alias.toLowerCase().includes(q)) ||
               item.keywords.some(keyword => keyword.toLowerCase().includes(q));
      }).slice(0, 6);

      highlightedIndex = -1;

      if (matchingSuggestions.length === 0) {
        suggestions.innerHTML = `
          <div class="p-4 text-sm text-mute">
            No matches found. Try searching for <button type="button" class="text-link font-medium hover:underline cursor-pointer" id="suggest-powerbank">Power Bank</button> or <a href="/items" class="text-link font-medium hover:underline">All Items</a>.
          </div>
        `;
        suggestions.classList.remove('hidden');
        
        const fallbackBtn = document.getElementById('suggest-powerbank');
        if (fallbackBtn) {
          fallbackBtn.addEventListener('click', () => {
            input.value = 'Power Bank';
            input.focus();
            renderSuggestions();
            updateClearButtonVisibility();
          });
        }
        return;
      }

      // Feature 1: Color-coded status in suggestion dropdown
      suggestions.innerHTML = matchingSuggestions.map((item, idx) => {
        const iconSvg = getCategoryIconSvg(item.category);
        const coStatus = (item.carryOn || '').toUpperCase();
        const badgeColor = coStatus === 'ALLOWED'
          ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
          : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED'
          ? 'bg-red-50 text-red-700 border-red-200'
          : 'bg-amber-50 text-amber-700 border-amber-200';
        const badgeLabel = coStatus === 'ALLOWED' ? 'Allowed' : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED' ? 'Not Allowed' : 'Restricted';
        return `
          <button 
            type="button" 
            class="suggestion-item w-full flex items-center justify-between px-4 py-3 hover:bg-canvas-soft-2 text-sm text-ink cursor-pointer text-left border-l-2 border-transparent transition-all"
            data-slug="${item.slug}"
            data-index="${idx}"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-mute flex-shrink-0">${iconSvg}</span>
              <div class="min-w-0">
                <span class="font-medium block">${item.name}</span>
                <span class="text-[10px] font-mono text-mute uppercase">${item.category}</span>
              </div>
            </div>
            <span class="inline-flex items-center text-[9px] font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider flex-shrink-0 ml-2 ${badgeColor}">${badgeLabel}</span>
          </button>
        `;
      }).join('');

      suggestions.classList.remove('hidden');

      // Bind mouseenter & click handlers to suggestion items
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => {
        el.addEventListener('click', (e) => {
          const slug = (e.currentTarget as HTMLElement).dataset.slug || '';
          const name = (e.currentTarget as HTMLElement).querySelector('.font-medium')?.textContent || '';
          input.value = name;
          suggestions.classList.add('hidden');
          updateClearButtonVisibility();
          handleItemSelected(slug);
        });

        el.addEventListener('mouseenter', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).dataset.index || '-1', 10);
          highlightedIndex = idx;
          updateHighlight();
        });
      });
    }

    function updateHighlight() {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach((item, idx) => {
        if (idx === highlightedIndex) {
          item.classList.add('bg-canvas-soft-2', 'border-link');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-canvas-soft-2', 'border-link');
        }
      });
    }

    // Handle typing / matching suggestions
    input.addEventListener('input', () => {
      renderSuggestions();
      updateClearButtonVisibility();
    });

    // Clear Search Input Action
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        updateClearButtonVisibility();
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        input.focus();
      });
    }

    // Keyboard navigation (ArrowDown, ArrowUp, Enter, Escape)
    input.addEventListener('keydown', (e) => {
      if (suggestions.classList.contains('hidden') || matchingSuggestions.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex + 1) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex - 1 + matchingSuggestions.length) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'Enter') {
        if (highlightedIndex >= 0 && highlightedIndex < matchingSuggestions.length) {
          e.preventDefault();
          const selected = matchingSuggestions[highlightedIndex];
          input.value = selected.name;
          suggestions.classList.add('hidden');
          updateClearButtonVisibility();
          handleItemSelected(selected.slug);
        }
      } else if (e.key === 'Escape') {
        suggestions.classList.add('hidden');
      }
    });

    // Close suggestions on click outside
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !suggestions.contains(e.target as Node) && !clearBtn?.contains(e.target as Node)) {
        suggestions.classList.add('hidden');
      }
    });

    // Chips clicks
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const slug = chip.dataset.chipSlug || '';
        handleItemSelected(slug, chip);
      });
    });

    // Close result panel
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        if (panel) panel.classList.add('hidden');
        chips.forEach(c => {
          c.classList.remove('border-ink', 'text-ink', 'bg-canvas-soft-2', 'font-semibold');
          c.setAttribute('aria-pressed', 'false');
        });
      });
    }
  }

  // Run on page load
  setupInteractiveSearch();

  // Support View Transitions
  document.addEventListener('astro:after-swap', () => {
    setupInteractiveSearch();
  });
</script>
