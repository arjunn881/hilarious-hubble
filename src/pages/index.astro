            <kbd class="hidden sm:inline-block text-[9px] bg-blue-700/80 px-1 py-0.2 rounded border border-blue-400/40 font-mono">⌘K</kbd>
          </button>
        </div>
        
        <!-- Suggestions Dropdown -->
        <div 
          id="homepage-suggestions" 
