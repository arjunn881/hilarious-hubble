---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getAllItems } from "../../lib/items";
import { CheckCircle2, XCircle, AlertCircle, ArrowLeft } from "@lucide/astro";
import CategoryContent from "../../components/category/CategoryContent.astro";
import EEATBanner from "../../components/seo/EEATBanner.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import RelatedLinksWidget from "../../components/seo/RelatedLinksWidget.astro";
import { getRelatedCategories, POPULAR_AIRLINES, getPopularGuides } from "../../lib/relatedEngine";

export async function getStaticPaths() {
  const items = getAllItems();
  
  // Extract all unique categories and form slugs
  const categoryMap = new Map<string, string>();
  items.forEach(item => {
    const canonicalSlug = item.category.toLowerCase().trim().replace(/\s+/g, "-");
    categoryMap.set(canonicalSlug, item.category);

    // Support raw and space-encoded category variants so URLs like /category/personal%20care do not 404
    const rawSlug = item.category.toLowerCase().trim();
    if (rawSlug !== canonicalSlug) {
      categoryMap.set(rawSlug, item.category);
      categoryMap.set(encodeURIComponent(rawSlug), item.category);
    }
  });

  return Array.from(categoryMap.entries()).map(([slug, name]) => {
    const categoryItems = items.filter(item => item.category === name).sort((a, b) => a.name.localeCompare(b.name));
    return {
      params: { slug },
      props: { categoryName: name, categoryItems },
    };
  });
}

const { categoryName, categoryItems } = Astro.props;
const canonicalSlug = categoryName.toLowerCase().trim().replace(/\s+/g, "-");
const canonicalUrl = `https://bringonplane.com/category/${canonicalSlug}/`;

// Load all markdown travel guide articles for Pillar Page matching
const posts = import.meta.glob("../../data/articles/*.md", { eager: true });
const relatedGuides = Object.entries(posts)
  .map(([filePath, module]: [string, any]) => {
    const parts = filePath.split(/[/\\]/);
    const filename = parts[parts.length - 1];
    const slug = filename.replace(".md", "");
    return {
      slug,
      frontmatter: module.frontmatter,
    };
  })
  .filter(post => post.frontmatter.category.toLowerCase().trim() === categoryName.toLowerCase().trim())
  .sort((a, b) => b.frontmatter.lastUpdated.localeCompare(a.frontmatter.lastUpdated));

// Calculate stats for items in this category
const total = categoryItems.length;
const allowedCarryOn = categoryItems.filter(i => i.carryOn === 'ALLOWED').length;
const restrictedCarryOn = categoryItems.filter(i => i.carryOn === 'RESTRICTED').length;
const prohibitedCarryOn = categoryItems.filter(i => i.carryOn === 'NOT_ALLOWED').length;

function getStatusClass(status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') {
  if (status === 'ALLOWED') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'NOT_ALLOWED') return "bg-error-soft border-error/25 text-error-deep";
  if (status === 'RESTRICTED') return "bg-warning-soft border-warning/25 text-warning-deep";
  return "bg-canvas-soft-2 border-hairline text-mute";
}

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Categories", href: "/#categories" },
  { label: categoryName }
];

const relatedWidgetGroups = [
  { title: "Related Categories", links: getRelatedCategories(categoryName.toLowerCase().trim().replace(/\s+/g, "-"), 4).map(c => ({ title: c.name, url: `/category/${c.slug}` })) },
  { title: "Popular Airlines", links: POPULAR_AIRLINES.slice(0, 4).map(a => ({ title: `${a.name} Rules`, url: `/airlines` })) },
  { title: "Travel Guides", links: getPopularGuides(4) }
];
---

<Layout 
  title={`${categoryName} TSA Baggage Allowance & Rules | Bring On Plane`}
  description={`Find official TSA carry-on and checked luggage rules for ${categoryName.toLowerCase()} travel items. Detailed baggage allowance rules.`}
  canonicalURL={canonicalUrl}
>
  <!-- Inject JSON-LD structured data in the page body -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${categoryName} TSA Baggage Rules`,
    "description": `Find official TSA carry-on and checked luggage rules for ${categoryName.toLowerCase()} travel items.`,
    "author": {
      "@type": "Organization",
      "name": "BringOnPlane Editorial Team"
    },
    "publisher": {
      "@type": "Organization",
      "name": "BringOnPlane",
      "logo": {
        "@type": "ImageObject",
        "url": "https://bringonplane.com/logo.png"
      }
    }
  })} />

  <Header slot="header" />

  <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 py-12 flex-1">
    
    <!-- Breadcrumbs complying with Web Interface Guidelines -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Header Block -->
    <header class="mb-10">
      <span class="font-mono text-[10px] font-semibold text-mute uppercase tracking-wider bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs select-none">
        TSA Category
      </span>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.28px] text-ink mt-2 mb-3">
        {categoryName} TSA Rules
      </h1>
      <p class="text-sm text-body leading-relaxed max-w-[620px]">
        Rules and packing guidelines for carrying {categoryName.toLowerCase()} in your cabin baggage or hold luggage according to official regulations.
      </p>
    </header>

    <!-- Statistics Grid -->
    <div class="grid grid-cols-3 gap-4 mb-10 select-none">
      <!-- Allowed Card -->
      <div class="bg-canvas border border-hairline rounded-md p-4 text-center shadow-sm">
        <span class="text-[10px] font-mono text-mute uppercase block mb-1">Carry Allowed</span>
        <span class="text-2xl font-bold tracking-tight text-link-deep">{allowedCarryOn}</span>
      </div>
      <!-- Restricted Card -->
      <div class="bg-canvas border border-hairline rounded-md p-4 text-center shadow-sm">
        <span class="text-[10px] font-mono text-mute uppercase block mb-1">Carry Restricted</span>
        <span class="text-2xl font-bold tracking-tight text-warning-deep">{restrictedCarryOn}</span>
      </div>
      <!-- Prohibited Card -->
      <div class="bg-canvas border border-hairline rounded-md p-4 text-center shadow-sm">
        <span class="text-[10px] font-mono text-mute uppercase block mb-1">Carry Banned</span>
        <span class="text-2xl font-bold tracking-tight text-error-deep">{prohibitedCarryOn}</span>
      </div>
    </div>

    <!-- Deep Category Content injected here -->
    <div class="mb-12">
      <CategoryContent categoryName={categoryName} itemsCount={total} />
    </div>

    <!-- Related Guides (Pillar Page Enhancement) -->
    {relatedGuides.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-semibold tracking-[-0.4px] text-ink mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-link" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Essential {categoryName} Guides
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedGuides.map(guide => (
            <a href={`/guide/${guide.slug}`} class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-5 transition-all">
              <h3 class="text-base font-medium tracking-[-0.2px] text-ink mb-2">{guide.frontmatter.title}</h3>
              <p class="text-xs text-body leading-relaxed line-clamp-2">{guide.frontmatter.description}</p>
              <div class="mt-3 flex items-center gap-2 text-[10px] font-mono text-mute">
                <span>Updated {guide.frontmatter.lastUpdated}</span>
                <span class="text-link ml-auto">Read Guide &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- EEAT Banner -->
    <div class="mb-10">
      <EEATBanner lastUpdated="Aug 14, 2024" />
    </div>

    <!-- Items Listing -->
    <section>
      <h2 class="text-base font-semibold tracking-[-0.4px] text-ink mb-6">
        Items in this Category ({total})
      </h2>
      <div class="space-y-4">
        {categoryItems.map((item) => (
          <a
            href={`/items/${item.slug}`}
            class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-sm font-medium tracking-[-0.2px] text-ink mb-1">
                  {item.name}
                </h3>
                {item.aliases.length > 0 && (
                  <p class="text-xs text-mute line-clamp-1">
                    Also: {item.aliases.join(", ")}
                  </p>
                )}
              </div>
              <div class="flex flex-col sm:flex-row gap-2 flex-shrink-0 items-end sm:items-center">
                <span class:list={["text-[9px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider text-center w-24 sm:w-auto", getStatusClass(item.carryOn)]}>
                  Carry-on: {item.carryOn.toLowerCase()}
                </span>
                <span class:list={["text-[9px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider text-center w-24 sm:w-auto", getStatusClass(item.checked)]}>
                  Checked: {item.checked.toLowerCase()}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Advanced SEO Interlinking Clusters -->
    <RelatedLinksWidget groups={relatedWidgetGroups} />
  </div>

  <Footer slot="footer" />
</Layout>
