---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Search, ArrowLeft, HelpCircle, PlaneTakeoff, List } from "@lucide/astro";
---

<Layout
  title="Page Not Found (404) — BringOnPlane"
  description="Sorry, this page doesn't exist. Search our TSA item database or return to the BringOnPlane homepage."
  noIndex={true}
>
  <Header slot="header" />

  <main class="flex-1 flex items-center justify-center py-24 px-4">
    <div class="max-w-[560px] w-full text-center">

      <!-- Animated 404 graphic -->
      <div class="relative mb-10 select-none">
        <div class="text-[120px] md:text-[160px] font-black font-mono leading-none tracking-tight text-hairline-strong">
          404
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 rounded-full bg-canvas-soft border-2 border-dashed border-hairline-strong flex items-center justify-center animate-spin-slow">
            <PlaneTakeoff class="w-8 h-8 text-mute" />
          </div>
        </div>
      </div>

      <h1 class="text-2xl md:text-3xl font-semibold tracking-[-1px] text-ink mb-3">
        This page didn't make it through security.
      </h1>
      <p class="text-sm text-body leading-[1.7] mb-10 max-w-[420px] mx-auto">
        The page you're looking for was moved, renamed, or never existed. Don't worry — we can help you find what you need.
      </p>

      <!-- Primary actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <button
          type="button"
          data-open-search
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 h-10 text-sm font-medium text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all cursor-pointer"
        >
          <Search class="w-4 h-4" />
          Search TSA Items
        </button>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 h-10 text-sm font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all"
        >
          <ArrowLeft class="w-4 h-4" />
          Back to Home
        </a>
      </div>

      <!-- Quick links -->
      <div class="border border-hairline rounded-md bg-canvas-soft p-6">
        <p class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Popular Destinations</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {[
            { label: "Browse All Items", href: "/items", icon: List },
            { label: "FAQ Guide", href: "/faq", icon: HelpCircle },
            { label: "Packing Assistant", href: "/checklist", icon: PlaneTakeoff },
            { label: "About Us", href: "/about", icon: PlaneTakeoff },
            { label: "Travel Guides", href: "/guides", icon: PlaneTakeoff },
            { label: "Contact Us", href: "/contact", icon: PlaneTakeoff },
          ].map(l => (
            <a
              href={l.href}
              class="flex items-center gap-2 px-3 py-2.5 text-xs text-body hover:text-ink hover:bg-canvas border border-transparent hover:border-hairline rounded-md transition-all"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-link/50 flex-shrink-0"></span>
              {l.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>
