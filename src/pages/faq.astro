      {
        q: "Can I bring ice packs, hand warmers, and distilled water on a plane?",
        a: "Gel ice packs must be completely frozen solid when presented at the security checkpoint to be allowed in carry-on bags — if they are partially melted or liquid, they are subject to the 3-1-1 rule. Hard-sided ice packs and plastic-wrapped dry ice (under 5.5 lbs) are permitted in checked bags. Hand warmers are allowed in carry-on and checked bags. Distilled water for CPAP machines is allowed in carry-on over 3.4 oz when declared as medically necessary."
      }
    ]
  }
];

// Build the flat FAQ list for JSON-LD (all questions across all categories)
const allFaqs = categories.flatMap(cat => cat.faqs);

const currentUrl = "https://bringonplane.com/faq";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bringonplane.com/" },
    { "@type": "ListItem", "position": 2, "name": "FAQ", "item": currentUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout
  title="TSA FAQ: What Can I Bring on a Plane? Full Baggage Rules Guide (2026)"
  description="Complete FAQ guide answering: can I bring food, vape, razors, power banks, scissors, deodorant, toothpaste, wine, medications, and more through TSA security. Updated 2026 TSA rules."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <link rel="canonical" href={currentUrl} slot="head" />

  <Header slot="header" />

  <main class="flex-1">

    <!-- Hero -->
    <div class="border-b border-hairline bg-canvas-soft">
      <div class="max-w-[860px] mx-auto px-4 md:px-6 py-12">
        <div class="mb-6">
          <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
            <ArrowLeft class="w-3.5 h-3.5" />
            Back to Home
          </a>
        </div>
        <div class="flex items-start gap-3 mb-4">
          <div class="w-10 h-10 rounded-md bg-link-bg-soft text-link border border-link/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <HelpCircle class="w-5 h-5" />
          </div>
          <div>
            <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.5px] text-ink leading-tight">
              What Can I Bring on a Plane?
            </h1>
            <p class="text-sm text-body leading-[1.7] mt-2 max-w-[600px]">
              Official TSA rules for food, liquids, electronics, medications, vapes, razors, toiletries, and more. Updated for 2026 travel season.
            </p>
          </div>
        </div>

        <!-- Quick stat strip -->
        <div class="flex flex-wrap gap-3 mt-6">
          {categories.map(cat => (
            <a
              href={`#cat-${cat.id}`}
              class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-wider px-3 py-1.5 rounded-full border border-hairline hover:border-hairline-strong bg-canvas hover:bg-canvas-soft text-mute hover:text-ink transition-all"
            >
              {cat.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Main content -->
    <div class="max-w-[860px] mx-auto px-4 md:px-6 py-14 space-y-16">

      {categories.map((cat, catIdx) => (
        <section id={`cat-${cat.id}`} class="scroll-mt-20">
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-sm bg-canvas-soft border border-hairline flex items-center justify-center flex-shrink-0">
              <Package class="w-4 h-4 text-mute" />
            </div>
            <h2 class="text-xl font-semibold tracking-[-0.5px] text-ink">{cat.label}</h2>
            <span class="text-[10px] font-mono text-mute border border-hairline px-1.5 py-0.5 rounded ml-auto flex-shrink-0">
              {cat.faqs.length} questions
            </span>
          </div>

          <!-- Accordion items -->
          <div class="space-y-3">
            {cat.faqs.map((faq, idx) => {
              const faqId = `faq-${cat.id}-${idx}`;
              return (
                <div class="border border-hairline rounded-md bg-canvas shadow-sm overflow-hidden">
                  <button
                    type="button"
                    class="faq-toggle-btn w-full text-left px-5 py-4 flex items-start justify-between gap-4 text-sm font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer outline-none select-none"
                    data-faq-target={faqId}
                    aria-expanded="false"
                    aria-controls={faqId}
                  >
                    <span class="leading-snug pt-0.5">{faq.q}</span>
                    <ChevronDown class="w-4 h-4 text-mute transition-transform duration-200 flex-shrink-0 mt-0.5" />
                  </button>
                  <div
                    id={faqId}
                    class="faq-body hidden border-t border-hairline/50 px-5 py-4 text-xs text-body leading-[1.8] bg-canvas-soft/40"
                    role="region"
                  >
                    {faq.a}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Bottom CTA -->
      <div class="border border-hairline rounded-md p-8 text-center bg-canvas-soft">
        <h3 class="text-lg font-semibold tracking-[-0.5px] text-ink mb-2">Check Any Item Instantly</h3>
        <p class="text-xs text-body mb-5 max-w-[400px] mx-auto leading-[1.6]">
          Search our full database of 100+ items to get TSA carry-on and checked bag verdicts instantly.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/" class="inline-flex items-center gap-1.5 text-xs font-medium text-link hover:text-link-deep transition-colors border border-link/30 hover:border-link px-4 py-2.5 rounded-md bg-link-bg-soft">
            Search Items →
          </a>
          <a href="/packing-assistant" class="inline-flex items-center gap-1.5 text-xs font-medium text-ink hover:text-link transition-colors border border-hairline hover:border-hairline-strong px-4 py-2.5 rounded-md">
            Use Packing Assistant →
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  function setupFaqToggles() {
    document.querySelectorAll<HTMLButtonElement>(".faq-toggle-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-faq-target") ?? "";
        const body = document.getElementById(targetId);
        const icon = btn.querySelector("svg");
        const isExpanded = btn.getAttribute("aria-expanded") === "true";

        if (body) {
          if (isExpanded) {
            body.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
            icon?.classList.remove("rotate-180");
          } else {
            body.classList.remove("hidden");
            btn.setAttribute("aria-expanded", "true");
            icon?.classList.add("rotate-180");
          }
        }
      });
    });
  }

  setupFaqToggles();
  document.addEventListener("astro:after-swap", setupFaqToggles);
</script>
