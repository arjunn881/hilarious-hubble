---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import EEATBanner from "../../components/seo/EEATBanner.astro";
import RelatedLinksWidget from "../../components/seo/RelatedLinksWidget.astro";
import { 
  ArrowLeft, Trash2, Plus, Printer, Download, Share2, 
  Calendar, ClipboardList, AlertTriangle, ShieldCheck, 
  CheckCircle2, Sparkles, Edit3, Save, X, AlertCircle, FileText,
  ChevronDown, Plane, BadgeCheck, HelpCircle, Check, Luggage, Globe, Scale
} from "@lucide/astro";
import { langParams, resolveLang } from "../../i18n/config";
import { getCanonicalUrl, localeMeta, useTranslations, useTranslatedPath, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang: Lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentYear = new Date().getFullYear();
/** Locale-aware absolute URLs so every translation gets its own canonical + graph. */
const currentUrl = getCanonicalUrl("/checklist/", lang);

const breadcrumbItems = [
  { label: t("crumb.home"), href: translatePath("/") },
  { label: t("chk.h1") }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": item.label,
    "item": item.href
      ? `https://bringonplane.com${item.href.endsWith('/') ? item.href : item.href + '/'}`
      : currentUrl
  }))
};

// Long-form Q&A and the HowTo steps stay English on every locale until the
// translation overlay lands, matching the boundary drawn on /faq/.
const checklistFaqs = [
  { q: "How does the Smart Packing Assistant verify TSA baggage compliance?", a: "The Smart Packing Assistant queries our comprehensive database of over 196+ categorized travel items mapped directly against Transportation Security Administration (TSA), Federal Aviation Administration (FAA), and International Air Transport Association (IATA) regulations. Every item you add is evaluated for status (Allowed, Restricted, or Prohibited) in both carry-on cabin bags and checked hold baggage." },
  { q: "Are my travel packing lists stored on external servers or private?", a: "Your packing lists and itinerary data are stored 100% locally inside your browser's private localStorage memory. No personal travel data is ever sent to external cloud servers, guaranteeing absolute privacy and full offline availability even without internet connectivity." },
  { q: "How does the 3-1-1 liquids rule work when building a packing list?", a: "Under TSA's 3-1-1 liquids rule, any liquid, aerosol, gel, cream, or paste carried in hand luggage must be in containers of 3.4 ounces (100 milliliters) or smaller. All containers must fit comfortably inside one clear, quart-sized, resealable plastic bag. The assistant automatically flags liquid items and reminds you of 3-1-1 container restrictions." },
  { q: "Where must portable power banks and lithium batteries be packed?", a: "Standalone lithium-ion battery power banks, cell phone battery cases, and spare laptop batteries MUST be carried in cabin hand luggage ONLY. FAA and aviation authorities strictly prohibit loose lithium batteries in checked hold baggage due to thermal runaway fire hazards." },
  { q: "What items are strictly prohibited in carry-on cabin luggage?", a: "Strictly prohibited carry-on items include pocket knives, safety razor blades, scissors with blades over 4 inches, metal tent stakes, hiking poles, baseball bats, strike-anywhere matches, and liquid containers larger than 3.4 oz. These items must be packed in checked hold baggage or left at home." },
  { q: "Can I print my packing list or export it as a PDF?", a: "Yes. The assistant includes built-in one-click 'Print' and 'Download PDF' features. The print layout formats your active trip into a clean, printer-friendly paper checklist grouped by bag type with physical checkboxes." },
  { q: "What items are exempt from the 3.4 oz liquid rule?", a: "Medically necessary liquids (prescription cough syrups, eye drops, saline solutions), baby formula, breast milk, and toddler juice are fully exempt from the 3.4 oz container limit. However, you must declare these liquids to security officers for standalone X-ray screening." },
  { q: "How do I pack liquid prescription medications for flights?", a: "Keep liquid medications in their original pharmacy-labeled containers inside carry-on baggage. Inform TSA officers before screening begins. A doctor's letter is recommended for international travel." },
  { q: "Can I bring baby formula and breast milk on a plane without a baby present?", a: "Yes. TSA regulations permit parents to carry breast milk, baby formula, cooling gel ice packs, and breast pumps in hand luggage even when traveling without an infant." },
  { q: "How do airline carry-on weight limits differ across carriers?", a: "While US domestic carriers (Delta, United, American) generally do not enforce weight limits on carry-on bags, major international and European budget airlines (Ryanair, Lufthansa, Emirates, Singapore Airlines) enforce strict cabin bag weight limits between 7 kg (15 lbs) and 12 kg (26 lbs)." },
  { q: "What happens if airport security officers flag an item in my bag?", a: "If security screeners detect a prohibited or un-declared restricted item, they will pull your bag for secondary manual inspection. Prohibited carry-on items must be surrendered to screeners or placed into checked luggage." },
  { q: "How do preset packing templates work in the assistant?", a: "Preset templates (Weekend Trip, Business Suit, International, Beach Vacation, Camping, Family Trip) pre-load expert-curated lists of essential gear, TSA status warnings, and category placements into your workspace with a single click." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": checklistFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Use the Smart Packing Assistant",
  "description": "Create a customized, TSA-compliant travel packing checklist in 5 easy steps.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Enter Trip Details", "text": "Input your trip name, destination, travel dates, airline carrier, and trip profile." },
    { "@type": "HowToStep", "position": 2, "name": "Choose a Preset Template", "text": "Select a pre-configured template like Weekend Trip, Business Suit, International, or Beach Vacation." },
    { "@type": "HowToStep", "position": 3, "name": "Review TSA Compliance Alerts", "text": "Check automatic warnings for liquids, lithium power banks, sharp tools, and restricted items." },
    { "@type": "HowToStep", "position": 4, "name": "Add Custom Items", "text": "Use the real-time search bar to add specific gear and see instant cabin vs hold placement rules." },
    { "@type": "HowToStep", "position": 5, "name": "Print or Export Your Checklist", "text": "Check off items as you pack, or export your list as a clean printable PDF." }
  ]
};

const airlineLimits = [
  { name: "Delta Air Lines", carryOn: "22 x 14 x 9 in (No weight limit)", checked: "50 lbs (23 kg)" },
  { name: "United Airlines", carryOn: "22 x 14 x 9 in (17 lbs / 8 kg)", checked: "50 lbs (23 kg)" },
  { name: "American Airlines", carryOn: "22 x 14 x 9 in (22 lbs / 10 kg)", checked: "50 lbs (23 kg)" },
  { name: "Lufthansa", carryOn: "21.6 x 15.7 x 9 in (17 lbs / 8 kg)", checked: "50 lbs (23 kg)" },
  { name: "Air France", carryOn: "21.7 x 13.8 x 9.9 in (26 lbs / 12 kg)", checked: "50 lbs (23 kg)" },
  { name: "British Airways", carryOn: "22 x 18 x 10 in (50 lbs / 23 kg)", checked: "50 lbs (23 kg)" },
  { name: "Ryanair", carryOn: "21.6 x 15.7 x 7.8 in (22 lbs / 10 kg)", checked: "44 lbs (20 kg)" },
  { name: "Emirates", carryOn: "22 x 15 x 8 in (15 lbs / 7 kg)", checked: "66 lbs (30 kg)" },
  { name: "Singapore Airlines", carryOn: "22 x 15 x 8 in (15 lbs / 7 kg)", checked: "66 lbs (30 kg)" }
];

const relatedWidgetGroups = [
  { title: t("chk.groupPresets"), links: [
    { title: t("packingList.crumb", { trip: t("trip.weekend-trip") }), url: translatePath("/packing-list/weekend-trip/") },
    { title: t("packingList.crumb", { trip: t("trip.business-trip") }), url: translatePath("/packing-list/business-trip/") },
    { title: t("packingList.crumb", { trip: t("trip.international-trip") }), url: translatePath("/packing-list/international-trip/") },
    { title: t("packingList.crumb", { trip: t("trip.beach-vacation") }), url: translatePath("/packing-list/beach-vacation/") },
    { title: t("packingList.crumb", { trip: t("trip.camping-trip") }), url: translatePath("/packing-list/camping-trip/") },
    { title: t("packingList.crumb", { trip: t("trip.family-vacation") }), url: translatePath("/packing-list/family-vacation/") }
  ]},
  { title: t("chk.groupDirectories"), links: [
    { title: t("nav.viewAllItems", { count: 196 }), url: `${translatePath("/")}#categories` },
    { title: t("rel.airlineRules"), url: translatePath("/airlines/") },
    { title: t("rel.countryRules"), url: translatePath("/countries/") },
    { title: t("nav.faq"), url: translatePath("/faq/") }
  ]}
];

/**
 * Quick-add pills. The localized label is also what the client looks up in the
 * search index, so `chk.qa.passport` carries the exact localized item name.
 */
const quickAddKeys = [
  "chk.qa.passport",
  "chk.qa.wallet",
  "chk.qa.laptop",
  "chk.qa.phone",
  "chk.qa.charger",
  "chk.qa.medicine",
  "chk.qa.powerBank",
  "chk.qa.toothbrush"
] as const;

/**
 * Strings the client-side workspace renders at runtime. The script below is
 * TypeScript, so it cannot take `define:vars` (that would force `is:inline`
 * and skip transformation) — the payload travels as a JSON script tag instead.
 * Templates keep their `{placeholder}` slots and are filled in the browser.
 */
const i18n = {
  indexUrl: lang === "en" ? "/search-index.json" : `/search-index-${lang}.json`,
  moveTo: t("chk.moveTo"),
  packItem: t("chk.packItem"),
  essentials: t("chk.list.essentials"),
  defaultReason: t("chk.defaultReason"),
  reasonIndexed: t("chk.reasonIndexed"),
  reasonCustom: t("chk.reasonCustom"),
  tipIndexed: t("chk.tipIndexed"),
  tipCustom: t("chk.tipCustom"),
  packedStats: t("chk.packedStats"),
  allPacked: t("chk.allPacked"),
  remaining: t("chk.remaining"),
  /** Only shown for hand-typed items; database entries carry their own date. */
  reviewedFallback: new Date().toLocaleDateString(localeMeta[lang].dateLocale, {
    year: "numeric",
    month: "long",
    timeZone: "UTC"
  }),
  metaCarrier: t("chk.metaCarrier"),
  metaProfile: t("chk.metaProfile"),
  metaDestination: t("chk.metaDestination"),
  metaDates: t("chk.metaDates"),
  importedReason: t("chk.importedReason"),
  importedTip: t("chk.importedTip"),
  cabinAllowance: t("item.cabinBaggage"),
  holdAllowance: t("item.holdBaggage"),
  regulatoryReason: t("chk.regulatoryReason"),
  checklistTip: t("chk.checklistTip"),
  reviewed: t("item.reviewed"),
  officialSource: t("item.officialSource"),
  editorialVerified: t("chk.editorialVerified"),
  suggestionDueTo: t("chk.suggestionDueTo"),
  noRecentTrips: t("chk.noRecentTrips"),
  showDetails: t("chk.showDetails"),
  hideDetails: t("chk.hideDetails"),
  deleteItem: t("chk.deleteItem"),
  deleteTrip: t("chk.deleteTrip"),
  promptNewList: t("chk.promptNewList"),
  coreNoRename: t("chk.coreNoRename"),
  promptRename: t("chk.promptRename"),
  coreNoDelete: t("chk.coreNoDelete"),
  confirmDeleteList: t("chk.confirmDeleteList"),
  confirmDeleteTrip: t("chk.confirmDeleteTrip"),
  sharedTrip: t("chk.sharedTrip"),
  unknown: t("status.unknown"),
  lists: {
    "carry-on": t("chk.list.carry-on"),
    "checked-bag": t("chk.list.checked-bag"),
    "personal-item": t("chk.list.personal-item"),
    "documents": t("chk.list.documents"),
    "essentials": t("chk.list.essentials")
  } as Record<string, string>,
  types: {
    vacation: t("chk.type.vacation"),
    business: t("chk.type.business"),
    international: t("chk.type.international"),
    domestic: t("chk.type.domestic"),
    weekend: t("chk.type.weekend")
  } as Record<string, string>,
  statuses: {
    ALLOWED: t("status.allowed"),
    PROHIBITED: t("status.prohibited"),
    RESTRICTED: t("status.restricted"),
    UNKNOWN: t("status.unknown")
  } as Record<string, string>
};
---

<Layout
  title={t("chk.title", { year: currentYear })}
  description={t("chk.description")}
  lang={lang}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
  <script type="application/json" id="chk-i18n" is:inline set:html={JSON.stringify(i18n).replace(/</g, "\\u003c")} />

  <Header slot="header" lang={lang} />

  <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 py-12 flex-1 flex flex-col lg:flex-row gap-8">
    
    <!-- Left Sidebar: Recent Trips (no-print) -->
    <aside class="w-full lg:w-64 flex-shrink-0 no-print select-none">
      <div class="bg-canvas border border-hairline rounded-md p-5 shadow-sm sticky top-24">
        <div class="flex items-center justify-between mb-4 border-b border-hairline pb-2.5">
          <h3 class="text-xs font-mono font-semibold tracking-wider text-mute">{t("chk.recentTrips")}</h3>
          <button
            type="button"
            id="btn-sidebar-new-trip"
            class="text-[10px] font-mono text-link hover:text-link-deep transition-colors cursor-pointer"
          >
            + {t("chk.new")}
          </button>
        </div>

        <div id="recent-trips-list" class="flex flex-col gap-1 max-h-60 overflow-y-auto">
          <!-- Populated by JS -->
          <span class="text-xs text-mute font-mono py-2 text-center">{t("chk.noRecentTrips")}</span>
        </div>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 flex flex-col min-w-0">
      
      <!-- SECTION 1: TRIPSETUP WIZARD -->
      <section id="trip-wizard-section" class="bg-canvas border border-hairline rounded-md p-8 shadow-level-3 select-none no-print">
        <header class="mb-6 border-b border-hairline pb-4">
          <div class="flex items-center gap-2.5 mb-1.5">
            <div class="w-7 h-7 rounded-sm bg-primary text-on-primary flex items-center justify-center">
              <ClipboardList class="w-4 h-4" />
            </div>
            <h1 class="text-2xl font-semibold tracking-[-0.8px] text-ink">{t("chk.h1")}</h1>
          </div>
          <p class="text-xs text-body leading-[1.6]">
            {t("chk.intro")}
          </p>
        </header>

        <form id="wizard-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="w-name" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldTripName")}</label>
              <input type="text" id="w-name" placeholder={t("chk.phTripName")} required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-sm text-ink outline-none focus:border-link transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="w-dest" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldDestination")}</label>
              <input type="text" id="w-dest" placeholder={t("chk.phDestination")} required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-sm text-ink outline-none focus:border-link transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="w-dep" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldDeparture")}</label>
              <input type="date" id="w-dep" required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-xs text-ink outline-none focus:border-link transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="w-ret" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldReturn")}</label>
              <input type="date" id="w-ret" required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-xs text-ink outline-none focus:border-link transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="w-airline" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldAirline")}</label>
              <select id="w-airline" required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-xs text-ink outline-none cursor-pointer focus:border-link notranslate">
                <option value="Delta Air Lines">Delta Air Lines</option>
                <option value="United Airlines">United Airlines</option>
                <option value="American Airlines">American Airlines</option>
                <option value="Lufthansa">Lufthansa</option>
                <option value="Air France">Air France</option>
                <option value="British Airways">British Airways</option>
                <option value="Ryanair">Ryanair</option>
                <option value="Emirates">Emirates</option>
              </select>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="w-type" class="text-[10px] font-mono font-semibold tracking-wider text-mute">{t("chk.fieldTripType")}</label>
              <select id="w-type" required class="h-10 px-3 bg-canvas border border-hairline rounded-sm text-xs text-ink outline-none cursor-pointer focus:border-link">
                <option value="vacation">{t("chk.type.vacation")}</option>
                <option value="business">{t("chk.type.business")}</option>
                <option value="international">{t("chk.type.international")}</option>
                <option value="domestic">{t("chk.type.domestic")}</option>
                <option value="weekend">{t("chk.type.weekend")}</option>
              </select>
            </div>
          </div>

          <!-- Templates selection -->
          <div>
            <span class="text-[10px] font-mono font-semibold tracking-wider text-mute block mb-3">{t("chk.presets")}</span>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="weekend" class="mt-1" checked />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.weekend-trip")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.weekend")}</span>
                </div>
              </label>
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="business" class="mt-1" />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.business-trip")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.business")}</span>
                </div>
              </label>
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="international" class="mt-1" />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.international-trip")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.international")}</span>
                </div>
              </label>
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="beach" class="mt-1" />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.beach-vacation")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.beach")}</span>
                </div>
              </label>
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="camping" class="mt-1" />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.camping-trip")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.camping")}</span>
                </div>
              </label>
              <label class="border border-hairline hover:border-hairline-strong rounded-sm p-3 flex items-start gap-2.5 cursor-pointer bg-canvas hover:bg-canvas-soft transition-all select-none">
                <input type="radio" name="w-template" value="family" class="mt-1" />
                <div>
                  <span class="text-xs font-semibold text-ink block">{t("trip.family-vacation")}</span>
                  <span class="text-[9px] text-mute font-mono block mt-0.5">{t("chk.hint.family")}</span>
                </div>
              </label>
            </div>
          </div>

          <button type="submit" class="w-full h-11 bg-primary hover:bg-ink text-on-primary font-medium text-sm rounded-sm transition-all cursor-pointer shadow-sm">
            {t("chk.launch")}
          </button>
        </form>
      </section>

      <!-- SECTION 2: ACTIVE WORKSPACE -->
      <section id="trip-workspace-section" class="hidden flex flex-col gap-6">
        
        <!-- Print Header -->
        <div id="checklist-print-header" class="hidden mb-6 border-b-2 border-black pb-4">
          <h1 class="text-3xl font-bold tracking-tight" id="print-workspace-name">{t("chk.printTitle")}</h1>
          <p class="text-sm font-mono text-mute mt-1" id="print-workspace-summary"></p>
        </div>

        <!-- 2A. Trip Summary bar (no-print) -->
        <div class="bg-canvas border border-hairline rounded-md p-6 shadow-level-2 select-none no-print flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="min-w-0">
            <span class="font-mono text-[9px] font-semibold text-link bg-link-bg-soft border border-link/15 px-2 py-0.5 rounded-xs tracking-wider block w-max mb-1.5">
              {t("chk.dashboard")}
            </span>
            <h2 class="text-xl font-semibold tracking-[-0.8px] text-ink" id="ws-trip-name"></h2>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs font-mono text-mute">
              <span id="ws-trip-meta"></span>
              <span>&bull;</span>
              <span id="ws-trip-dates"></span>
            </div>
          </div>
          
          <!-- Actions -->
          <div class="flex items-center gap-2 self-start sm:self-center">
            <button type="button" id="btn-print-list" class="h-8 px-3 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer flex items-center gap-1.5">
              <Printer class="w-3.5 h-3.5" /> {t("chk.print")}
            </button>
            <button type="button" id="btn-pdf-list" class="h-8 px-3 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer flex items-center gap-1.5">
              <Download class="w-3.5 h-3.5" /> <span class="notranslate">PDF</span>
            </button>
            <button type="button" id="btn-share-list" class="h-8 px-3 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer flex items-center gap-1.5 relative">
              <Share2 class="w-3.5 h-3.5" /> {t("chk.share")}
              <span id="ws-share-toast" class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 py-1 text-[10px] font-mono font-medium text-on-primary bg-ink rounded shadow-level-3 opacity-0 transition-opacity pointer-events-none whitespace-nowrap">
                {t("btn.copiedLink")}
              </span>
            </button>
            <button type="button" id="btn-close-trip" class="h-8 px-3 text-xs font-medium text-error-deep bg-error-soft hover:bg-error-soft-2 border border-error/25 rounded-sm transition-colors cursor-pointer">
