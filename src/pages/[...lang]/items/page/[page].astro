---
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getAllItems } from "../../../../lib/items";
import type { GetStaticPathsOptions } from "astro";
import { langParams, resolveLang } from "../../../../i18n/config";
import { useTranslations, useTranslatedPath, type Lang } from "../../../../i18n/utils";
import { getItemName } from "../../../../i18n/items";
import { getCategoryName } from "../../../../i18n/categories";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  /**
   * One paginated set per locale. Names are localized *before* sorting so each
   * language reads alphabetically in its own collation, which means page N
   * holds different items per locale — harmless, these pages are noindex.
   */
  return langParams.flatMap((params) => {
    const lang = resolveLang(params.lang);
    const items = getAllItems()
      .map((item) => ({ ...item, name: getItemName(item.slug, item.name, lang) }))
      .sort((a, b) => a.name.localeCompare(b.name, lang));
    return paginate(items, { pageSize: 12, params });
  });
}

const lang: Lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { page } = Astro.props;

/** `page.url.*` already carries the locale prefix, so these need no rewriting. */
const prevURL = page.url.prev ? `https://bringonplane.com${page.url.prev.endsWith('/') ? page.url.prev : page.url.prev + '/'}` : undefined;
const nextURL = page.url.next ? `https://bringonplane.com${page.url.next.endsWith('/') ? page.url.next : page.url.next + '/'}` : undefined;

function getStatusClass(status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') {
  if (status === 'ALLOWED') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'NOT_ALLOWED') return "bg-error-soft border-error/25 text-error-deep";
  if (status === 'RESTRICTED') return "bg-warning-soft border-warning/25 text-warning-deep";
  return "bg-canvas-soft-2 border-hairline text-mute";
}

/** Enum → native label. */
function statusLabel(status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') {
  if (status === 'ALLOWED') return t("status.allowed");
  if (status === 'NOT_ALLOWED') return t("status.prohibited");
  if (status === 'RESTRICTED') return t("status.restricted");
  return t("status.unknown");
}
---

<Layout
  title={t("items.title", { page: page.currentPage })}
  description={t("items.description", { page: page.currentPage })}
  prevURL={prevURL}
  nextURL={nextURL}
  noIndex="noindex, follow"
  lang={lang}
>
  <Header slot="header" lang={lang} />

  <div class="max-w-[1000px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <!-- Title block -->
    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono font-medium rounded-full bg-canvas-soft border border-hairline text-body mb-4 select-none">
        {t("page.pageOf", { current: page.currentPage, total: page.lastPage })}
      </div>
      <h1 class="text-3xl font-semibold tracking-[-1.2px] text-ink mb-2">
        {t("items.h1")}
      </h1>
      <p class="text-sm text-body">
        {t("items.intro")}
      </p>
    </header>

    <!-- Paginated Items Listing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {page.data.map((item) => (
        <a
          href={translatePath(`/items/${item.slug}/`)}
          class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="font-mono text-[9px] font-semibold text-mute uppercase tracking-wider block mb-0.5">
                {getCategoryName(item.category, lang)}
              </span>
              <h2 class="text-base font-medium tracking-[-0.2px] text-ink mb-1">
                {item.name}
              </h2>
              {item.aliases.length > 0 && (
                <p class="text-xs text-mute line-clamp-1">
                  {t("items.also")} {item.aliases.slice(0, 2).join(", ")}
                </p>
              )}
            </div>
            <div class="flex flex-col gap-1.5 flex-shrink-0 items-end">
              <span class:list={["text-[9px] font-mono px-2 py-0.2 rounded-full border uppercase tracking-wider text-center min-w-24", getStatusClass(item.carryOn)]}>
                {t("item.carryAbbr")}: {statusLabel(item.carryOn)}
              </span>
              <span class:list={["text-[9px] font-mono px-2 py-0.2 rounded-full border uppercase tracking-wider text-center min-w-24", getStatusClass(item.checked)]}>
                {t("item.checkedAbbr")}: {statusLabel(item.checked)}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Monospaced Pagination Links -->
    <nav aria-label={t("nav.pagination")} class="flex items-center justify-between border-t border-hairline pt-6 font-mono text-xs text-mute select-none no-print">
      <!-- Previous Button -->
      <div>
        {page.url.prev ? (
          <a href={page.url.prev.endsWith('/') ? page.url.prev : `${page.url.prev}/`} class="inline-flex items-center gap-1 hover:text-ink transition-colors focus-visible:underline">
            &larr; {t("btn.previous")}
          </a>
        ) : (
          <span class="text-mute/40 select-none">&larr; {t("btn.previous")}</span>
        )}
      </div>

      <!-- Page Numbers List -->
      <div class="hidden sm:flex items-center gap-3">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((p) => (
          <a
            href={translatePath(`/items/page/${p}/`)}
            aria-current={p === page.currentPage ? "page" : undefined}
            class:list={[
              "px-2 py-1 rounded-sm transition-all focus-visible:ring-2 focus-visible:ring-link",
              p === page.currentPage
                ? "bg-primary text-on-primary font-bold shadow-sm"
                : "hover:text-ink hover:bg-canvas-soft-2"
            ]}
          >
            {p}
          </a>
        ))}
      </div>

      <!-- Next Button -->
      <div>
        {page.url.next ? (
          <a href={page.url.next.endsWith('/') ? page.url.next : `${page.url.next}/`} class="inline-flex items-center gap-1 hover:text-ink transition-colors focus-visible:underline">
            {t("btn.next")} &rarr;
          </a>
        ) : (
          <span class="text-mute/40 select-none">{t("btn.next")} &rarr;</span>
        )}
      </div>
    </nav>

  </div>

  <Footer slot="footer" lang={lang} />
</Layout>
