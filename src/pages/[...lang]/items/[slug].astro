---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getAllItems, getRelatedItems, getItemBySlug } from "../../../lib/items";
import { CheckCircle2, XCircle, AlertCircle, Calendar, ShieldAlert, ExternalLink, FileText, Globe, AlertTriangle, Check } from "@lucide/astro";
import { 
  getWhatIsThisItem,
  getExceptions, 
  getInternationalConsiderations, 
  getAlternativeItems, 
  getRelatedGuides,
  getScreeningProcedure,
  getRegulatoryDetails,
  getAirlineDifferences,
  getStepByStepPackingGuide,
  getExpandedItemFAQs
} from "../../../lib/contentGenerator";

import EEATBanner from "../../../components/seo/EEATBanner.astro";
import Breadcrumbs from "../../../components/seo/Breadcrumbs.astro";
import RelatedLinksWidget from "../../../components/seo/RelatedLinksWidget.astro";
import AirlineCountrySelector from "../../../components/AirlineCountrySelector.astro";
import AmazonAffiliateBox from "../../../components/AmazonAffiliateBox.astro";
import TsaGearSuggester from "../../../components/monetization/TsaGearSuggester.astro";
import ChecklistAddon from "../../../components/monetization/ChecklistAddon.astro";
import TravelServicesBar from "../../../components/monetization/TravelServicesBar.astro";
import AdInArticle from "../../../components/AdInArticle.astro";
import { getPopularGuides, getRelatedCategories, POPULAR_AIRLINES, POPULAR_COUNTRIES } from "../../../lib/relatedEngine";
import { getCountryName } from "../../../i18n/places";
import { langParams, localeMeta, resolveLang } from "../../../i18n/config";
import { getCanonicalUrl, useTranslations, useTranslatedPath, type Lang } from "../../../i18n/utils";
import { getItemName } from "../../../i18n/items";
import { getItemProse, localizeItemProse } from "../../../i18n/prose";
import { categorySlug, getCategoryName } from "../../../i18n/categories";

export async function getStaticPaths() {
  const items = getAllItems();
  /** Every item crossed with every locale. */
  return langParams.flatMap((params) =>
    items.map((item) => ({
      params: { ...params, slug: item.slug },
    })),
  );
}

const lang: Lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { slug } = Astro.params;
const source = getItemBySlug(slug as string);
if (!source) {
  return Astro.redirect(translatePath("/404"));
}
/** Regulatory prose swapped for its translation where one exists (else English). */
const item = localizeItemProse(source, lang);
/** Overrides for the generated long-form blocks; `undefined` until translated. */
const prose = getItemProse(item.slug, lang);

/** Native item name — the primary non-English keyword surface on this page. */
const itemName = getItemName(item.slug, item.name, lang);
const catSlug = categorySlug(item.category);
const categoryLabel = getCategoryName(item.category, lang);
/** Locale-aware absolute URL for the canonical tag and the structured-data graph. */
const pageUrl = getCanonicalUrl(`/items/${item.slug}/`, lang);

const relatedItems = getRelatedItems(item);

// ── Grammar: plural/singular verb utility ────────────────────────────────────
function getVerb(name: string): "is" | "are" {
  const lower = name.trim().toLowerCase();
  const pluralIrregular = ["feet", "teeth", "mice", "geese", "oxen", "children"];
  if (pluralIrregular.includes(lower)) return "are";
  if (
    lower.endsWith("ies") ||
    (lower.endsWith("s") &&
      !lower.endsWith("ss") &&
      !lower.endsWith("us") &&
      !lower.endsWith("is"))
  )
    return "are";
  return "is";
}
const verb = getVerb(item.name);

const exceptions = prose?.exceptions ?? getExceptions(item);
const internationalConsiderations = prose?.international ?? getInternationalConsiderations(item);
const alternativeItems = prose?.alternatives ?? getAlternativeItems(item);
const itemRelatedGuides = getRelatedGuides(item);

const screeningProcedure = prose?.screening ?? getScreeningProcedure(item);
const regulatoryDetails = prose?.regulatory ?? getRegulatoryDetails(item);
const airlineDifferences = prose?.airlineDifferences ?? getAirlineDifferences(item);
const stepByStepPacking = prose?.packingGuide ?? getStepByStepPackingGuide(item);
const itemFaqs = prose?.faq ?? getExpandedItemFAQs(item);

// ── YMYL flag — triggers medical disclaimer block ────────────────────────────
const isMedicine = item.category === "Medicine";


const breadcrumbItems = [
  { label: t("crumb.home"), href: translatePath("/") },
  { label: t("crumb.categories"), href: `${translatePath("/")}#categories` },
  { label: categoryLabel, href: translatePath(`/category/${catSlug}/`) },
  { label: itemName }
];

/**
 * The item×airline and item×country combination pages are English-only, so their
 * links keep the un-prefixed URL. The labels are still localised — the reader has
 * to know what the link is about, and the group headings beside them are native.
 * Airline names stay in their registered brand form; country names are translated
 * because they are the ranking term in queries like "aduanas Japón".
 */
const relatedWidgetGroups = [
  {
    title: t("rel.airlineRules"),
    links: POPULAR_AIRLINES.slice(0, 5).map(a => ({
      title: t("rel.airlineBaggage", { airline: a.name }),
      url: `/items/${item.slug}/airline/${a.slug}/`,
    })),
  },
  {
    title: t("rel.countryRules"),
    links: POPULAR_COUNTRIES.slice(0, 5).map(c => ({
      title: t("rel.countryCustoms", { country: getCountryName(c.slug, c.name, lang) }),
      url: `/items/${item.slug}/country/${c.slug}/`,
    })),
  },
  { title: t("rel.popularGuides"), links: getPopularGuides(4).map(g => ({ ...g, url: translatePath(g.url) })) },
  { title: t("rel.relatedCategories"), links: getRelatedCategories(catSlug, 4).map(c => ({ title: getCategoryName(c.name, lang), url: translatePath(`/category/${c.slug}/`) })) }
];

// Strict Rule Status config mapping
const statusConfig = {
  ALLOWED: {
    label: t("status.allowed"),
    icon: CheckCircle2,
    class: "bg-link-bg-soft text-link-deep border-link/25",
    textClass: "text-link-deep",
  },
  NOT_ALLOWED: {
    label: t("status.prohibited"),
    icon: XCircle,
    class: "bg-error-soft text-error-deep border-error/25",
    textClass: "text-error-deep",
  },
  RESTRICTED: {
    label: t("status.restricted"),
    icon: AlertCircle,
    class: "bg-warning-soft text-warning-deep border-warning/25",
    textClass: "text-warning-deep",
  },
  UNKNOWN: {
    label: t("status.unknown"),
    icon: AlertCircle,
    class: "bg-canvas-soft-2 text-mute border-hairline",
    textClass: "text-mute",
  },
};

const carryOnStatus = statusConfig[item.carryOn.status] || statusConfig.UNKNOWN;
const checkedStatus = statusConfig[item.checkedBag.status] || statusConfig.UNKNOWN;

const CarryOnIcon = carryOnStatus.icon;
const CheckedIcon = checkedStatus.icon;

function getSmallBadgeClass(status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') {
  if (status === 'ALLOWED') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (status === 'NOT_ALLOWED') return "bg-error-soft border-error/25 text-error-deep";
  if (status === 'RESTRICTED') return "bg-warning-soft border-warning/25 text-warning-deep";
  return "bg-canvas-soft-2 border-hairline text-mute";
}

/** Localized one-word status for the compact related-item badges. */
const smallStatusLabel = (status: 'ALLOWED' | 'NOT_ALLOWED' | 'RESTRICTED' | 'UNKNOWN') =>
  (statusConfig[status] || statusConfig.UNKNOWN).label;

/** CFR code stays verbatim; the human-readable title and issuing agency localize. */
function getCfrCitation(category: string) {
  const cat = category.toLowerCase().trim();
  if (cat === 'electronics') {
    return { code: "49 CFR § 175.10(a)(18)", title: t("cfr.electronics"), source: t("cfr.sourceFAA") };
  }
  if (cat === 'liquids' || cat === 'personal-care' || cat === 'beauty') {
    return { code: "49 CFR § 1540.111", title: t("cfr.liquids"), source: t("cfr.sourceTSA") };
  }
  if (cat === 'medicine' || cat === 'health') {
    return { code: "49 CFR § 1544.219", title: t("cfr.medicine"), source: t("cfr.sourceTSA") };
  }
  if (cat === 'tools' || cat === 'camping') {
    return { code: "49 CFR § 1540.111(a)", title: t("cfr.tools"), source: t("cfr.sourceTSA") };
  }
  if (cat === 'sports') {
    return { code: "49 CFR § 1540.111(b)", title: t("cfr.sports"), source: t("cfr.sourceTSA") };
  }
  return { code: "49 CFR § 1540.111", title: t("cfr.general"), source: t("cfr.sourceTSA") };
}
const cfr = getCfrCitation(item.category);



function getTravelTip(itemData: typeof item) {
  if (itemData.carryOn.status === 'NOT_ALLOWED') return t("tip.prohibited", { item: itemName });
  if (itemData.carryOn.status === 'RESTRICTED') return t("tip.restricted", { item: itemName });
  return t("tip.allowed", { item: itemName });
}
const travelTip = getTravelTip(item);

// ── SEO: Verdict-aware High-CTR title & dynamic year injection ──────────────────
const currentYear = new Date().getFullYear();
const carryOnVerdict = item.carryOn.status === 'ALLOWED' ? t("verdict.yes")
  : item.carryOn.status === 'NOT_ALLOWED' ? t("verdict.no")
  : t("verdict.restricted");
const checkedVerdict = item.checkedBag.status === 'ALLOWED' ? t("verdict.yes")
  : item.checkedBag.status === 'NOT_ALLOWED' ? t("verdict.no")
  : t("verdict.restricted");

const seoTitle = t("item.title", { item: itemName, verdict: carryOnVerdict, year: currentYear });

// ── SEO: High-Converting Meta Description (<155 chars) ─────────────────────────
const carryOnShort = item.carryOn.status === 'ALLOWED' ? t("short.carryAllowed")
  : item.carryOn.status === 'NOT_ALLOWED' ? t("short.carryProhibited")
  : t("short.carryRestricted");
const checkedShort = item.checkedBag.status === 'ALLOWED' ? t("short.checkedAllowed")
  : item.checkedBag.status === 'NOT_ALLOWED' ? t("short.checkedProhibited")
  : t("short.checkedRestricted");

const rawDesc = t("item.description", { carryOn: carryOnShort, checked: checkedShort, item: itemName });
const seoDescription = rawDesc.length > 155 ? rawDesc.slice(0, 152) + '...' : rawDesc;



// ── SEO: Featured Snippet / Quick Answer ─────────────────────────────────────
// Compiler engine is self-contained: verb, hold status, and dedup are
// resolved internally. No arguments beyond the item object are required.
const featuredSnippetAnswer = prose?.whatIsThis ?? getWhatIsThisItem(item);


// ── Extra FAQ questions for JSON-LD (Feature 7) ───────────────────────────────
const faq4Question = `What happens if I bring ${item.name.toLowerCase()} through TSA security?`;
const faq4Answer = item.carryOn.status === 'ALLOWED'
  ? `If you bring ${item.name.toLowerCase()} through TSA security in your carry-on, it should pass through the X-ray screening without issue. ${item.carryOn.reason || ''}`
  : item.carryOn.status === 'NOT_ALLOWED'
  ? `If you attempt to bring ${item.name.toLowerCase()} through TSA in a carry-on bag, the TSA officer will confiscate it at the security checkpoint. You must place it in your checked bag or surrender it before security.`
  : `TSA officers may pull your ${item.name.toLowerCase()} for secondary screening. You may be asked to declare it or meet specific conditions. ${item.carryOn.reason || ''}`;

const faq5Question = `Can I bring ${item.name.toLowerCase()} on an international flight?`;
const faq5Answer = `TSA rules govern US departure security checkpoints. ${item.name} is ${carryOnShort} at US airports. For international destinations, each country has its own customs and aviation security rules. Check your destination country's customs authority rules in addition to the TSA.`;

const faq6Question = `Is there a size or quantity limit for ${item.name.toLowerCase()} in carry-on?`;
const faq6Answer = item.carryOn.conditions && item.carryOn.conditions.length > 0
  ? `Yes, there are specific conditions: ${item.carryOn.conditions.join('. ')}`
  : `Standard TSA rules apply to ${item.name.toLowerCase()}. Always check with your specific airline for additional restrictions as airline policies may vary.`;

// Dynamically generate FAQs for SEO schemas
const faq1Question = `Is ${item.name.toLowerCase()} allowed on a plane?`;
const faq1Answer = `According to the TSA, ${item.name.toLowerCase()} is ${item.carryOn.status.replace('_', ' ').toLowerCase()} in carry-on bags and ${item.checkedBag.status.replace('_', ' ').toLowerCase()} in checked baggage. ${item.carryOn.reason}`;

const faq2Question = `Can I bring ${item.name.toLowerCase()} in carry-on luggage?`;
const faq2Answer = item.carryOn.status === 'ALLOWED'
  ? `Yes, ${item.name.toLowerCase()} is fully allowed in carry-on bags. ${item.carryOn.conditions[0] || 'Check with your airline for any additional restrictions.'}`
  : item.carryOn.status === 'NOT_ALLOWED'
  ? `No, ${item.name.toLowerCase()} is prohibited in carry-on bags by TSA. ${item.carryOn.conditions[0] || 'You must place it in checked baggage or leave it at home before the checkpoint.'}`
  : `${item.name} is restricted in carry-on bags and subject to conditions. ${item.carryOn.conditions[0] || 'Check with your airline and airport security for specific requirements.'}`;

const faq3Question = `Are there any special rules for packing ${item.name.toLowerCase()} in checked baggage?`;
const faq3Answer = `In checked bags, ${item.name.toLowerCase()} is ${item.checkedBag.status === 'ALLOWED' ? 'allowed without restrictions' : item.checkedBag.status === 'RESTRICTED' ? 'restricted (subject to conditions)' : 'prohibited'}. ${item.checkedBag.conditions[0] || 'Ensure it is packed securely.'}`;

// ── Item-specific keywords (passed to Layout for <meta name="keywords">) ────
const itemKeywords = [
  `can i bring ${item.name.toLowerCase()} on a plane`,
  `can you bring ${item.name.toLowerCase()} on a plane`,
  `${item.name.toLowerCase()} tsa rules`,
  `${item.name.toLowerCase()} carry on`,
  `${item.name.toLowerCase()} checked bag`,
  `${item.name.toLowerCase()} airplane`,
  `${item.name.toLowerCase()} flight rules`,
  `is ${item.name.toLowerCase()} allowed on a plane`,
  `tsa ${item.name.toLowerCase()}`,
  `${item.name.toLowerCase()} on a plane`,
  ...(item.aliases || []).map((a: string) => `can i bring ${a.toLowerCase()} on a plane`),
  `${item.name.toLowerCase()} air france`,
  `${item.name.toLowerCase()} emirates`,
  `${item.name.toLowerCase()} ryanair`,
  `${item.name.toLowerCase()} british airways`,
  `${item.name.toLowerCase()} united airlines`,
  `${item.name.toLowerCase()} delta`,
  `${item.name.toLowerCase()} singapore airlines`,
  `${item.name.toLowerCase()} lufthansa`,
  ...(item.keywords || [])
].join(', ');

/**
 * Everything the inline utilities script needs, resolved on the server. It used
 * to scrape the slug, name, category and both statuses out of the rendered DOM,
 * which broke on trailing-slash URLs and on every locale-prefixed page.
 */
const clientItem = {
  slug: item.slug,
  name: itemName,
  category: categoryLabel,
  carryOn: item.carryOn.status,
  checked: item.checkedBag.status,
};

const i18n = {
  favorite: t("btn.favorite"),
  favorited: t("btn.favorited"),
  addToChecklist: t("btn.addToChecklist"),
  inChecklist: t("btn.inChecklist"),
};

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={itemKeywords}
  speakableSummary={featuredSnippetAnswer}
  breadcrumbItems={breadcrumbItems}
  lang={lang}
>
  <!-- Inject JSON-LD structured data in the page body -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": seoTitle,
        "description": seoDescription,
        "url": pageUrl,
        "inLanguage": localeMeta[lang].hreflang,
        "datePublished": item.metadata?.lastReviewed || item.lastReviewed || new Date().toISOString().split('T')[0],
        "dateModified": item.metadata?.lastReviewed || item.lastReviewed || new Date().toISOString().split('T')[0],
        "author": {
          "@type": "Organization",
          "name": "BringOnPlane Editorial Team",
          "url": "https://bringonplane.com/about/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "BringOnPlane",
          "url": "https://bringonplane.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://bringonplane.com/logo.png"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": pageUrl
        },
        "about": {
          "@type": "Thing",
          "name": itemName,
          "description": item.description
        },
        "mentions": item.tsa?.officialUrl ? [
          {
            "@type": "WebPage",
            "name": `Official TSA Rules for ${item.name}`,
            "url": item.tsa.officialUrl
          }
        ] : undefined,
        "isPartOf": {
          "@type": "WebSite",
          "name": "BringOnPlane",
          "url": "https://bringonplane.com"
        }
      },
      {
        "@type": "Thing",
        "name": itemName,
        "description": item.description,
        "url": pageUrl,
        "alternateName": item.aliases,
        "category": item.category,
        "keywords": item.keywords.join(", "),
        "author": {
          "@type": "Organization",
          "name": "BringOnPlane Editorial Team"
        },
        "publisher": {
          "@type": "Organization",
          "name": "BringOnPlane",
          "logo": {
            "@type": "ImageObject",
            "url": "https://bringonplane.com/logo.png"
          }
        },
        "subjectOf": item.tsa && item.tsa.officialUrl ? {
          "@type": "WebPage",
          "name": "Official TSA Rules Source",
          "url": item.tsa.officialUrl
        } : undefined
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          ...itemFaqs.map(faq => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.answer
            }
          })),
          {
            "@type": "Question",
            "name": faq4Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq4Answer }
          },
          {
            "@type": "Question",
            "name": faq5Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq5Answer }
          },
          {
            "@type": "Question",
            "name": faq6Question,
            "acceptedAnswer": { "@type": "Answer", "text": faq6Answer }
          }
        ]
      }
    ]
  })} />

  <Header slot="header" lang={lang} />

  <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 py-12 flex-1">
    <!-- Breadcrumbs complying with Web Interface Guidelines -->
    <Breadcrumbs items={breadcrumbItems} lang={lang} />

    <!-- Item Metadata Header — H1 is first for crawler priority (SEO B3) -->
    <header class="mb-10">
      <!-- Primary H1: must be read by crawlers before badges or visual layout blocks -->
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.28px] text-ink text-pretty mb-4">
        {t("item.h1", { item: itemName })}
      </h1>

      <div class="flex flex-wrap items-center gap-3 mb-3">
        <a
          href={translatePath(`/category/${catSlug}/`)}
          class="font-mono text-[10px] font-semibold text-mute hover:text-link uppercase tracking-wider bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs hover:border-link transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
        >
          {categoryLabel}
        </a>

        <!-- Trust Confidence Badge -->
        <span class="inline-flex items-center gap-1 font-mono text-[10px] font-semibold text-link bg-link-bg-soft border border-link/25 px-2 py-0.5 rounded-xs select-none">
          <svg width="12" height="12" class="w-3 h-3 text-link" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          {t("item.tsaVerified")}
        </span>

        <span class="flex items-center gap-1.5 text-xs text-mute font-mono">
          <Calendar class="w-3.5 h-3.5" aria-hidden="true" />
          {t("item.reviewed", { date: item.metadata.lastReviewed })}
        </span>
      </div>

      <!-- Feature 10: Verdict Color Banner — appears after H1 -->
      {item.carryOn.status === 'ALLOWED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-emerald-50 border border-emerald-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-emerald-100 border border-emerald-300 flex-shrink-0">
            <CheckCircle2 class="w-5 h-5 text-emerald-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-emerald-800">{t("banner.allowed")}</p>
            <p class="text-xs text-emerald-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}
      {item.carryOn.status === 'NOT_ALLOWED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-red-50 border border-red-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-red-100 border border-red-300 flex-shrink-0">
            <XCircle class="w-5 h-5 text-red-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-red-800">{t("banner.notAllowed")}</p>
            <p class="text-xs text-red-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}
      {item.carryOn.status === 'RESTRICTED' && (
        <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-amber-50 border border-amber-200 select-none">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-amber-100 border border-amber-300 flex-shrink-0">
            <AlertCircle class="w-5 h-5 text-amber-600" />
          </span>
          <div>
            <p class="text-sm font-bold text-amber-800">{t("banner.restricted")}</p>
            <p class="text-xs text-amber-700 leading-snug mt-0.5">{item.carryOn.reason}</p>
          </div>
        </div>
      )}

      <!-- Feature 8: Featured Snippet Quick Answer box (speakable-answer targets this for voice/AI) -->
      <div class="mt-5 mb-2 p-4 rounded-md bg-canvas-soft border-l-4 border-link">
        <p class="text-xs font-mono text-link uppercase tracking-wider mb-1.5 font-semibold">{t("item.quickAnswer")}</p>
        <p class="speakable-answer text-sm text-body leading-[1.7] text-pretty">
          {featuredSnippetAnswer}
        </p>
      </div>

      {item.aliases.length > 0 && (
        <p class="text-sm text-body mt-2">
          <span class="text-mute">{t("item.alsoKnownAs")}</span> {item.aliases.join(", ")}
        </p>
      )}

      <!-- Above-the-fold sponsored travel services bar -->
      <TravelServicesBar />

      <!-- Action buttons for Traveler utilities -->
      <div class="flex flex-wrap items-center gap-3 mt-6 select-none">
        <button
          type="button"
          id="btn-favorite"
          class="inline-flex items-center gap-2 px-3 h-8 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-1"
          aria-label={t("a11y.addFavorite")}
        >
          <svg width="14" height="14" id="star-icon" class="w-3.5 h-3.5 text-mute transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span id="favorite-label">{t("btn.favorite")}</span>
        </button>

        <button
          type="button"
          id="btn-checklist-add"
