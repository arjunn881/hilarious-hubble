---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import InstagramIcon from "../../components/InstagramIcon.astro";
import { Mail, MapPin, Clock, MessageSquare, Send, HelpCircle, ExternalLink, CheckCircle2, XCircle } from "@lucide/astro";
import { langParams, resolveLang } from "../../i18n/config";
import { useTranslations, useTranslatedPath, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang: Lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

/** Published turnaround targets, shown as a label/value pair each. */
const responseTimes = [
  { type: t("contact.rtGeneral"), time: t("contact.rtGeneralTime") },
  { type: t("contact.rtErrors"), time: t("contact.rtErrorsTime") },
  { type: t("contact.labelPartnerships"), time: t("contact.rtPartnersTime") },
];

/** Self-serve answers offered before the form. Paths follow the active locale. */
const selfServeLinks = [
  { label: t("footer.faqGuide"), href: translatePath("/faq/") },
  { label: t("footer.allItemsAZ"), href: translatePath("/items/page/1/") },
  { label: t("nav.packingAssistant"), href: translatePath("/checklist/") },
];

/** Subject options for the form. The empty value is the placeholder row. */
const subjects = [
  { value: "", label: t("contact.subjectPlaceholder") },
  { value: "tsa-rule-error", label: t("contact.subjRuleError") },
  { value: "suggest-item", label: t("contact.subjSuggest") },
  { value: "packing-help", label: t("contact.subjPacking") },
  { value: "partnership", label: t("contact.subjPartnership") },
  { value: "press", label: t("contact.subjPress") },
  { value: "other", label: t("contact.subjOther") },
];

/** Strings the submit handler needs at runtime, passed as a JSON island. */
const formStrings = {
  sending: t("contact.sending"),
  sent: t("contact.sent"),
  submit: t("contact.submit"),
};
---

<Layout
  title={t("contact.title")}
  description={t("contact.description")}
  keywords="contact bringonplane, report tsa rule error, travel packing help, baggage rules question"
  lang={lang}
>
  <Header slot="header" lang={lang} />

  <main class="flex-1">

    <!-- Hero -->
    <section class="py-16 md:py-20 border-b border-hairline bg-canvas-soft">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-link-bg-soft text-link border border-link/20 mb-5 mx-auto">
          <Mail class="w-6 h-6" />
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.5px] text-ink mb-4">{t("contact.h1")}</h1>
        <p class="text-sm text-body leading-[1.8] max-w-[540px] mx-auto">
          {t("contact.heroSub")}
        </p>
      </div>
    </section>

    <!-- Contact grid -->
    <section class="py-16 border-b border-hairline bg-canvas">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 grid md:grid-cols-2 gap-12">

        <!-- Left: Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-lg font-semibold tracking-[-0.5px] text-ink mb-5">{t("contact.h2Info")}</h2>
            <div class="space-y-4">
              <a href="mailto:hello@bringonplane.com" class="flex items-start gap-4 p-4 border border-hairline rounded-md hover:border-link hover:shadow-sm transition-all group bg-canvas">
                <div class="w-9 h-9 rounded-md bg-link-bg-soft text-link border border-link/15 flex items-center justify-center flex-shrink-0">
                  <Mail class="w-4.5 h-4.5" />
                </div>
                <div>
                  <p class="text-[11px] font-mono text-mute uppercase tracking-wider mb-0.5">{t("contact.labelEmail")}</p>
                  <p class="text-sm font-medium text-ink group-hover:text-link transition-colors">hello@bringonplane.com</p>
                </div>
              </a>

              <a href="https://www.instagram.com/bringonplane/" target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 p-4 border border-hairline rounded-md hover:border-pink-500/50 hover:shadow-sm transition-all group bg-canvas">
                <div class="w-9 h-9 rounded-md bg-pink-500/10 text-pink-500 border border-pink-500/20 flex items-center justify-center flex-shrink-0">
                  <InstagramIcon class="w-4.5 h-4.5 text-pink-500" />
                </div>
                <div>
                  <p class="text-[11px] font-mono text-mute uppercase tracking-wider mb-0.5">{t("contact.labelInstagram")}</p>
                  <p class="text-sm font-medium text-ink group-hover:text-pink-500 transition-colors inline-flex items-center gap-1">@bringonplane ↗</p>
                </div>
              </a>

              <a href="mailto:errors@bringonplane.com" class="flex items-start gap-4 p-4 border border-hairline rounded-md hover:border-link hover:shadow-sm transition-all group bg-canvas">
                <div class="w-9 h-9 rounded-md bg-link-bg-soft text-link border border-link/15 flex items-center justify-center flex-shrink-0">
                  <MessageSquare class="w-4.5 h-4.5" />
                </div>
                <div>
                  <p class="text-[11px] font-mono text-mute uppercase tracking-wider mb-0.5">{t("contact.labelErrors")}</p>
                  <p class="text-sm font-medium text-ink group-hover:text-link transition-colors">errors@bringonplane.com</p>
                </div>
              </a>

              <a href="mailto:partners@bringonplane.com" class="flex items-start gap-4 p-4 border border-hairline rounded-md hover:border-link hover:shadow-sm transition-all group bg-canvas">
                <div class="w-9 h-9 rounded-md bg-link-bg-soft text-link border border-link/15 flex items-center justify-center flex-shrink-0">
                  <ExternalLink class="w-4.5 h-4.5" />
                </div>
                <div>
                  <p class="text-[11px] font-mono text-mute uppercase tracking-wider mb-0.5">{t("contact.labelPartnerships")}</p>
                  <p class="text-sm font-medium text-ink group-hover:text-link transition-colors">partners@bringonplane.com</p>
                </div>
              </a>
            </div>
          </div>

          <div class="border border-hairline rounded-md p-5 bg-canvas-soft space-y-3">
            <div class="flex items-center gap-2 mb-3">
              <Clock class="w-4 h-4 text-mute" />
              <span class="text-xs font-mono text-mute uppercase tracking-wider">{t("contact.h3Response")}</span>
            </div>
            {responseTimes.map(r => (
              <div class="flex items-center justify-between text-xs text-body border-b border-hairline/50 pb-2 last:border-0 last:pb-0">
                <span>{r.type}</span>
                <span class="text-ink font-medium font-mono">{r.time}</span>
              </div>
            ))}
          </div>

          <div class="border border-hairline rounded-md p-5 bg-canvas">
            <div class="flex items-center gap-2 mb-3">
              <HelpCircle class="w-4 h-4 text-mute" />
              <span class="text-xs font-mono text-mute uppercase tracking-wider">{t("contact.h3Before")}</span>
            </div>
            <p class="text-xs text-body leading-[1.7] mb-3">{t("contact.beforeIntro")}</p>
            <div class="space-y-2">
              {selfServeLinks.map(l => (
                <a href={l.href} class="flex items-center justify-between text-xs text-link hover:text-link-deep transition-colors">
                  <span>{l.label}</span>
                  <ExternalLink class="w-3 h-3" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Contact form -->
        <div>
          <h2 class="text-lg font-semibold tracking-[-0.5px] text-ink mb-5">{t("contact.h2Form")}</h2>
          <form
            id="contact-form"
            class="space-y-4"
            novalidate
          >
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="cf-name" class="block text-xs font-medium text-body mb-1.5">{t("contact.fieldName")} <span class="text-error">*</span></label>
                <input
                  type="text"
                  id="cf-name"
                  name="name"
                  required
                  placeholder={t("contact.phName")}
                  class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
                />
              </div>
              <div>
                <label for="cf-email" class="block text-xs font-medium text-body mb-1.5">{t("contact.fieldEmail")} <span class="text-error">*</span></label>
                <input
                  type="email"
                  id="cf-email"
                  name="email"
                  required
                  placeholder={t("contact.phEmail")}
                  class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="cf-subject" class="block text-xs font-medium text-body mb-1.5">{t("contact.fieldSubject")} <span class="text-error">*</span></label>
              <select
                id="cf-subject"
                name="subject"
                required
                class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
              >
                {subjects.map(s => <option value={s.value}>{s.label}</option>)}
              </select>
            </div>

            <div>
              <label for="cf-message" class="block text-xs font-medium text-body mb-1.5">{t("contact.fieldMessage")} <span class="text-error">*</span></label>
              <textarea
                id="cf-message"
                name="message"
                required
                rows={6}
                placeholder={t("contact.phMessage")}
                class="w-full px-3 py-2.5 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors resize-y min-h-[140px]"
              ></textarea>
            </div>

            <!-- Honeypot (spam trap) -->
            <div class="hidden" aria-hidden="true">
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <button
              type="submit"
              id="cf-submit"
              class="inline-flex items-center gap-2 px-5 h-10 text-sm font-medium text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all w-full justify-center cursor-pointer"
            >
              <span id="cf-icon-send" class="inline-flex"><Send class="w-4 h-4" /></span>
              <span id="cf-icon-sent" class="hidden"><CheckCircle2 class="w-4 h-4" /></span>
              <span id="cf-submit-label">{t("contact.submit")}</span>
            </button>

            <!-- Status messages -->
            <div id="cf-success" class="hidden text-xs text-success bg-success-soft border border-success/25 rounded-md px-4 py-3 items-center gap-2">
              <CheckCircle2 class="w-4 h-4 flex-shrink-0" />
              <span>{t("contact.success")}</span>
            </div>
            <div id="cf-error" class="hidden text-xs text-error bg-error-soft border border-error/25 rounded-md px-4 py-3 items-center gap-2">
              <XCircle class="w-4 h-4 flex-shrink-0" />
              <span>{t("contact.failure")} <a href="mailto:hello@bringonplane.com" class="underline">hello@bringonplane.com</a></span>
            </div>
          </form>

          <script type="application/json" id="cf-i18n" set:html={JSON.stringify(formStrings)}></script>
        </div>

      </div>
    </section>

  </main>

  <Footer slot="footer" lang={lang} />
</Layout>

<script>
  /** Button/status labels for the active locale, injected as a JSON island. */
  function readStrings() {
    const fallback = { sending: "Sending…", sent: "Sent!", submit: "Send Message" };
    try {
      const el = document.getElementById("cf-i18n");
      return el?.textContent ? { ...fallback, ...JSON.parse(el.textContent) } : fallback;
    } catch {
      return fallback;
    }
  }

  function setupContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form) return;

    const s = readStrings();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("cf-submit") as HTMLButtonElement | null;
      const label = document.getElementById("cf-submit-label");
      const iconSend = document.getElementById("cf-icon-send");
      const iconSent = document.getElementById("cf-icon-sent");
      const success = document.getElementById("cf-success");

      if (btn) btn.disabled = true;
      if (label) label.textContent = s.sending;

      // Simulate form submission (replace with Formspree/Resend endpoint)
      await new Promise(r => setTimeout(r, 800));

      // Show success (in production hook to real API)
      success?.classList.remove("hidden");
      success?.classList.add("flex");
      form.reset();
      if (btn) btn.disabled = false;
      if (label) label.textContent = s.sent;
      iconSend?.classList.add("hidden");
      iconSent?.classList.remove("hidden");
      iconSent?.classList.add("inline-flex");

      setTimeout(() => {
        success?.classList.add("hidden");
        success?.classList.remove("flex");
        if (label) label.textContent = s.submit;
        iconSent?.classList.add("hidden");
        iconSent?.classList.remove("inline-flex");
        iconSend?.classList.remove("hidden");
      }, 4000);
    });
  }

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
