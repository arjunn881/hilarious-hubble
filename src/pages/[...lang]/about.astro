---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Plane, Users, ShieldCheck, Zap, Globe, Star, ArrowRight, Mail, HelpCircle } from "@lucide/astro";
import { langParams, resolveLang } from "../../i18n/config";
import { useTranslations, useTranslatedPath, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang: Lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

/** The three sample searches quoted in the mission paragraph, joined inline. */
const missionQuestions = [t("about.mission2Q1"), t("about.mission2Q2"), t("about.mission2Q3")];

/** Feature grid — icons are language-neutral, labels come from the dictionary. */
const features = [
  { icon: Zap, title: t("about.f1Title"), desc: t("about.f1Desc") },
  { icon: ShieldCheck, title: t("about.f2Title"), desc: t("about.f2Desc") },
  { icon: Globe, title: t("about.f3Title"), desc: t("about.f3Desc") },
  { icon: Users, title: t("about.f4Title"), desc: t("about.f4Desc") },
  { icon: Star, title: t("about.f5Title"), desc: t("about.f5Desc") },
  { icon: HelpCircle, title: t("about.f6Title"), desc: t("about.f6Desc") },
];

/** Primary sources, in the order they are cited on the page. */
const sources = [
  t("about.src1"),
  t("about.src2"),
  t("about.src3"),
  t("about.src4"),
  t("about.src5"),
  t("about.src6"),
];

/** Editorial-policy cards. The number prefix is rendered outside the string. */
const editorialPolicies = [
  { title: t("about.e1Title"), desc: t("about.e1Desc") },
  { title: t("about.e2Title"), desc: t("about.e2Desc") },
  { title: t("about.e3Title"), desc: t("about.e3Desc") },
  { title: t("about.e4Title"), desc: t("about.e4Desc") },
];
---

<Layout
  title={t("about.title")}
  description={t("about.description")}
  keywords="about bringonplane, tsa rules checker, free packing list generator, travel tool, airport baggage rules"
  lang={lang}
>
  <Header slot="header" lang={lang} />


  <main class="flex-1">

    <!-- Hero -->
    <section class="py-20 md:py-28 border-b border-hairline bg-canvas-soft">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-primary text-on-primary mb-6 mx-auto">
          <Plane class="w-7 h-7 rotate-45" />
        </div>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-[-2px] text-ink mb-5 leading-tight">
          {t("about.h1")}
        </h1>
        <p class="text-base text-body leading-[1.8] max-w-[640px] mx-auto">
          {t("about.heroSub")}
        </p>
      </div>
    </section>

    <!-- Mission -->
    <section class="py-20 border-b border-hairline bg-canvas">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8">
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink mb-6">{t("about.h2Mission")}</h2>
        <div class="space-y-5 text-sm text-body leading-[1.9]">
          <p>{t("about.mission1")}</p>
          <p>
            <strong class="text-ink">{t("about.mission2Lead")}</strong> {t("about.mission2Body")}
            {missionQuestions.map((q, i) => (
              <Fragment>{i > 0 ? t("about.mission2Sep") : ""}<em>{q}</em></Fragment>
            ))}
            — {t("about.mission2Tail")}
          </p>
          <p>{t("about.mission3")}</p>
        </div>
      </div>
    </section>

    <!-- Values / Features Grid -->
    <section class="py-20 border-b border-hairline bg-canvas-soft">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8">
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink mb-10 text-center">{t("about.h2WhyUs")}</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {features.map(f => (
            <div class="border border-hairline rounded-md bg-canvas p-6">
              <div class="w-9 h-9 rounded-md bg-link-bg-soft text-link border border-link/20 flex items-center justify-center mb-4">
                <f.icon class="w-4.5 h-4.5" />
              </div>
              <h3 class="text-sm font-semibold text-ink mb-2">{f.title}</h3>
              <p class="text-xs text-body leading-[1.7]">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Data sourcing -->
    <section class="py-20 border-b border-hairline bg-canvas">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8">
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink mb-6">{t("about.h2Sources")}</h2>
        <div class="space-y-4 text-sm text-body leading-[1.9]">
          <p>{t("about.sourcesIntro")}</p>
          <ul class="list-none space-y-2 ml-0">
            {sources.map(s => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-link mt-2 flex-shrink-0"></span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4">{t("about.sourcesReview")}</p>
          <p class="text-xs text-mute border border-hairline rounded-md p-4 bg-canvas-soft mt-4">
            <strong>{t("about.disclaimerLabel")}</strong> {t("about.disclaimerBody")}
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial Policy & E-E-A-T Standards -->
    <section id="editorial-policy" class="py-20 border-b border-hairline bg-canvas-soft scroll-mt-12">
      <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8">
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink mb-6">{t("about.h2Editorial")}</h2>
        <div class="space-y-4 text-sm text-body leading-[1.9]">
          <p>{t("about.editorialIntro")}</p>
          <div class="grid sm:grid-cols-2 gap-4 mt-4">
            {editorialPolicies.map((p, i) => (
              <div class="p-4 bg-canvas border border-hairline rounded-md">
                <h3 class="font-semibold text-ink text-sm mb-1">{i + 1}. {p.title}</h3>
                <p class="text-xs text-body leading-relaxed">
                  {p.desc}
                  {i === editorialPolicies.length - 1 && (
                    <a href="mailto:errors@bringonplane.com" class="text-link hover:underline">errors@bringonplane.com</a>
                  )}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-canvas-soft">
      <div class="max-w-[560px] mx-auto px-4 md:px-6 text-center">
        <h2 class="text-2xl font-semibold tracking-[-0.8px] text-ink mb-3">{t("about.h2Cta")}</h2>
        <p class="text-sm text-body mb-8">{t("about.ctaSub")}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={translatePath("/")} class="inline-flex items-center gap-2 px-5 h-10 text-sm font-medium text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all">
            <Plane class="w-4 h-4 rotate-45" /> {t("about.searchCta")}
          </a>
          <a href={translatePath("/checklist/")} class="inline-flex items-center gap-2 px-5 h-10 text-sm font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm transition-all">
            {t("about.listCta")} <ArrowRight class="w-4 h-4" />
          </a>
        </div>
        <div class="text-xs text-mute mt-6 flex flex-wrap items-center justify-center gap-3">
          <span>{t("about.questions")} <a href="mailto:hello@bringonplane.com" class="text-link hover:underline">hello@bringonplane.com</a></span>
          <span>&bull;</span>
          <a href="https://www.instagram.com/bringonplane/" target="_blank" rel="noopener noreferrer" class="text-pink-600 dark:text-pink-400 hover:underline inline-flex items-center gap-1 font-medium">{t("about.instagram", { handle: "@bringonplane" })} ↗</a>
        </div>
      </div>
    </section>

  </main>

  <Footer slot="footer" lang={lang} />
</Layout>
