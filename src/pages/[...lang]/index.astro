  function getCategoryIconSvg(category: string): string {
    const slug = toCategorySlug(category);
    return categoryIcons[slug] || defaultIcon;
  }

  // Premium Status Badges utilizing SVG icons instead of emojis (High Contrast)
  function getStatusBadgeHtml(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') {
      return `
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700 shadow-xs">
