<script>
  /**
   * Locale payload emitted by this page's frontmatter. `statuses` is the lookup
   * table for the canonical `RuleStatus` values the item islands carry.
   */
  const dash: Record<string, any> = (() => {
    try {
      return JSON.parse(document.getElementById("home-i18n")?.textContent || "{}");
    } catch {
      return {};
    }
  })();
  const DASH_STATUS: Record<string, string> = dash.statuses || {};

  const statusColors: Record<string, string> = {
    ALLOWED: "bg-link-bg-soft text-link-deep border-link/25",
    NOT_ALLOWED: "bg-error-soft text-error-deep border-error/25",
    PROHIBITED: "bg-error-soft text-error-deep border-error/25",
    RESTRICTED: "bg-warning-soft border-warning/25 text-warning-deep"
  };

  /** Fills `{name}`-style slots left in the dictionary templates. */
  function fillDash(template: string, vars: Record<string, string | number>) {
    return String(template ?? "").replace(/\{(\w+)\}/g, (whole, key) =>
      key in vars ? String(vars[key]) : whole
    );
  }

  /** The page's own item summaries, keyed by slug — already in this locale. */
  function itemsBySlug(): Record<string, any> {
    try {
      const data = JSON.parse(document.getElementById("all-items-data")?.textContent || "[]");
      const map: Record<string, any> = {};
      data.forEach((d: any) => { if (d.slug) map[d.slug] = d; });
      return map;
    } catch {
      return {};
    }
  }

  /**
   * The item pages persist plain slugs, so the display name, category and
   * statuses are resolved here rather than stored — that keeps a list starred
   * in one language rendering natively in every other one.
   */
  function storedItems(storageKey: string) {
    const stored = JSON.parse(localStorage.getItem(storageKey) || "[]");
    const db = itemsBySlug();
    return (Array.isArray(stored) ? stored : [])
      .map((entry: any) => db[typeof entry === "string" ? entry : entry?.slug])
      .filter(Boolean)
      .slice(0, 10);
  }

  function emptyState(message: string) {
    return `<p class="text-xs text-body italic bg-canvas-soft border border-hairline rounded-md p-4">${message}</p>`;
  }

  function statusPill(status: string, label: string) {
    const s = String(status || "").toUpperCase();
    const tone = statusColors[s] || statusColors.RESTRICTED;
    return `<span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full border tracking-wider ${tone}">${label}: ${DASH_STATUS[s] || s}</span>`;
  }

  function reviewedLabel(iso: string) {
    if (!iso) return "";
    const parsed = new Date(`${iso}T00:00:00Z`);
    if (Number.isNaN(parsed.getTime())) return "";
    const date = parsed.toLocaleDateString(dash.dateLocale || "en-US", {
      year: "numeric", month: "long", day: "numeric", timeZone: "UTC"
    });
    return fillDash(dash.reviewed || "{date}", { date });
  }

  function renderFavorites() {
    const listContainer = document.getElementById("favorites-dashboard-list");
    if (!listContainer) return;

    try {
      const favorites = storedItems("traveler_favorites");
      if (favorites.length === 0) {
        listContainer.innerHTML = emptyState(dash.noStarred || "");
        return;
      }

      listContainer.innerHTML = favorites.map(item => `
        <a href="${dash.itemBase}${item.slug}/" class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-3.5 transition-all">
          <div class="flex items-center justify-between gap-3">
            <div>
              <span class="text-sm font-medium text-ink">${item.name}</span>
              <span class="text-[10px] text-mute font-mono tracking-wider ml-2">${item.category}</span>
            </div>
            <div class="flex gap-1.5 flex-shrink-0">
              ${statusPill(item.carryOn, dash.carryAbbr)}
              ${statusPill(item.checked, dash.holdAbbr)}
            </div>
          </div>
        </a>
      `).join("");
    } catch {
      listContainer.innerHTML = `<p class="text-xs text-error font-mono">${dash.favoritesError || ""}</p>`;
    }
  }

  function renderRecents() {
    const listContainer = document.getElementById("recents-dashboard-list");
    if (!listContainer) return;

    try {
      const recents = storedItems("traveler_recents");
      if (recents.length === 0) {
        listContainer.innerHTML = emptyState(dash.noRecents || "");
        return;
      }

      listContainer.innerHTML = recents.map(item => `
        <a href="${dash.itemBase}${item.slug}/" class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-3.5 transition-all">
          <div class="flex items-center justify-between gap-3">
            <div>
              <span class="text-sm font-medium text-ink">${item.name}</span>
              <span class="text-[10px] text-mute font-mono tracking-wider ml-2">${item.category}</span>
            </div>
            <span class="text-[10px] text-mute font-mono">${reviewedLabel(item.lastReviewed)}</span>
          </div>
        </a>
      `).join("");
    } catch {
      listContainer.innerHTML = `<p class="text-xs text-error font-mono">${dash.recentsError || ""}</p>`;
    }
  }

  function setupFaq() {
    document.querySelectorAll(".home-faq-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const targetId = (e.currentTarget as HTMLElement).getAttribute("data-target") || "";
        const body = document.getElementById(targetId);
        const icon = (e.currentTarget as HTMLElement).querySelector("svg");
        
        if (body) {
          const isHidden = body.classList.contains("hidden");
          if (isHidden) {
            body.classList.remove("hidden");
            if (icon) icon.classList.add("rotate-180");
          } else {
            body.classList.add("hidden");
            if (icon) icon.classList.remove("rotate-180");
          }
        }
      });
    });
  }

  // Load dashboards and FAQs on window load
  renderFavorites();
  renderRecents();
  setupFaq();

  // Support View Transitions swapping
  document.addEventListener("astro:after-swap", () => {
    renderFavorites();
    renderRecents();
    setupFaq();
  });
</script>

<script>
  // ── Client-side Interactive Search & Popular Chips Redesign ─────────────────
  interface SearchItem {
    slug: string;
    name: string;
    category: string;
    /** Present on the translated indexes only; derived from `category` otherwise. */
    categorySlug?: string;
    aliases: string[];
    keywords: string[];
    carryOn: string;
    checked: string;
  }

  interface FullItem {
    slug: string;
    name: string;
    category: string;
    categorySlug: string;
    carryOn: { status: string; reason: string; };
    checkedBag: { status: string; reason: string; };
  }

  /** Locale payload emitted by this page's frontmatter (`#home-i18n`). */
  const S: Record<string, any> = (() => {
    try {
      return JSON.parse(document.getElementById("home-i18n")?.textContent || "{}");
    } catch {
      return {};
    }
  })();
  const STATUS_LABELS: Record<string, string> = S.statuses || {};

  /** Fills `{name}`-style slots left in the dictionary templates. */
  function fill(template: string, vars: Record<string, string>) {
    return String(template ?? '').replace(/\{(\w+)\}/g, (whole, key) =>
      key in vars ? vars[key] : whole
    );
  }

  /** Escapes text destined for an `innerHTML` template (queries, names, labels). */
  function escapeHtml(value: string) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function statusLabel(status: string) {
    const s = (status || '').toUpperCase();
    return STATUS_LABELS[s] || s;
  }

  /** Mirrors `categorySlug()` for the English index, which ships display names. */
  function toCategorySlug(value: string) {
    return (value || '')
      .toLowerCase()
      .trim()
      .replace(/&/g, 'and')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

