          ${statusLabel(s)}
        </span>
      `;
    }
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') {
      return `
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-rose-100 dark:bg-rose-950 text-rose-900 dark:text-rose-200 border border-rose-300 dark:border-rose-700 shadow-xs">
