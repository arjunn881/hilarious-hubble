// Most searched queries (TSA heavy queries — used in the section below the hero)
const mostSearchedSlugs = ["power-bank", "laptop-charger", "airtag", "melatonin", "sunscreen", "laptop", "aerosol-insect-repellent"];
const mostSearched = mostSearchedSlugs
  .map(slug => items.find(i => i.slug === slug))
  .filter((x): x is NonNullable<typeof x> => !!x)
  .map(item => ({
    ...item,
    name: getItemName(item.slug, item.name, lang),
    categoryLabel: getCategoryName(item.category, lang),
  }));

// Latest reviewed items (sorted by lastReviewed date descending)
const latestReviewed = [...items]
  .sort((a, b) => b.lastReviewed.localeCompare(a.lastReviewed))
  .slice(0, 4)
  .map(item => ({
    ...item,
    name: getItemName(item.slug, item.name, lang),
    categoryLabel: getCategoryName(item.category, lang),
    reviewedLabel: formatDate(item.lastReviewed, lang),
  }));

// Fetch latest travel guides for the freshness system. Guide titles come from
// the article frontmatter — translated when a localized guide exists, English
// otherwise; the category label and date are always localized.
const posts = import.meta.glob("../../data/articles/*.md", { eager: true });
const guideOverlay = indexArticleOverlay(
  import.meta.glob("../../data/articles/*/*.md", { eager: true }),
);
const latestGuides = Object.entries(posts)
  .map(([filePath, module]: [string, any]) => {
    const parts = filePath.split(/[/\\]/);
    const slug = parts[parts.length - 1].replace(".md", "");
    const fm = pickArticle(guideOverlay, slug, lang, module).frontmatter;
    return {
      slug,
      title: fm.title,
      category: fm.category,
      categoryLabel: getCategoryName(fm.category, lang),
      lastUpdated: fm.lastUpdated,
      updatedLabel: formatDate(fm.lastUpdated, lang),
    };
  })
  .sort((a, b) => b.lastUpdated.localeCompare(a.lastUpdated))
  .slice(0, 2);

function getStatusClass(status: RuleStatus | string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return "bg-link-bg-soft border-link/25 text-link-deep";
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return "bg-error-soft border-error/25 text-error-deep";
  return "bg-warning-soft border-warning/25 text-warning-deep";
}

/** Native status label for either baggage column. */
function getStatusLabel(status: RuleStatus | string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return t('status.allowed');
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return t('status.prohibited');
  if (s === 'RESTRICTED') return t('status.restricted');
  return t('status.unknown');
}

/** Marker glyph paired with a status label — language-neutral. */
function getStatusGlyph(status: RuleStatus | string) {
  const s = status?.toUpperCase();
  if (s === 'ALLOWED') return '✓';
  if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return '✗';
  return '!';
}

