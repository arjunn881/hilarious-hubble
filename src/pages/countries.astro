const countryFaqs = [
  {
    q: "Can I bring melatonin on a plane into the UK?",
    a: "Yes. Even though melatonin requires a prescription to buy in UK pharmacies, UK Border Force and MHRA guidelines legally allow international visitors to bring up to a 3-month personal supply in their carry-on or checked baggage."
  },
  {
    q: "Can you bring nicotine pouches (ZYN) into Singapore through Changi Airport?",
    a: "No. Nicotine pouches, snus, and e-cigarettes are strictly banned under Singapore tobacco analogue laws. Possession or importation at Singapore Changi Airport carries heavy fines up to SGD $2,000."
  },
  {
    q: "Can I bring cup noodles and cashew nuts into Australia?",
    a: "Yes, but you MUST declare all food items on the Australian Incoming Passenger Card. Commercially roasted nuts without shells and vegetarian/seafood instant noodles will clear biosecurity, while noodles containing pork or poultry broths may be seized."
  },
  {
    q: "Can I bring an EpiPen to Japan?",
    a: "Yes! Japan Customs permits travelers to bring 1 personal EpiPen auto-injector for emergency allergy management without requiring advance Yakkan Shoumei paperwork. Keep it with your doctor prescription."
  },
  {
    q: "Is melatonin legal in France?",
    a: "Yes! Melatonin supplements up to 1.9mg are sold over-the-counter in French pharmacies, and travelers can bring up to a 3-month personal supply through customs."
  },
  {
    q: "Can I bring cooking oil from Malaysia to Singapore?",
    a: "Yes. Under Singapore Food Agency (SFA) rules, individuals entering Singapore from Malaysia may bring up to 5 kg / 5 L of cooking oil for personal consumption without a commercial import permit."
  }
];
---

<Layout 
  title="International Customs & Airport Security Regulations (2026)"
  description="Guide to customs declarations, biosecurity limits, melatonin laws, nicotine pouch bans, and liquid rules for Singapore, UK, France, Australia, Japan, USA, and Canada."
  canonicalURL="https://bringonplane.com/countries/"
  keywords="can i bring melatonin on a plane uk, can you bring melatonin into the uk, is melatonin legal in france, can i take my vape to france, nicotine pouches singapore airport, can i bring cup noodles into australia, can i bring cashew nuts to australia, bringing epipen to japan, can i bring cooking oil from malaysia to singapore, bring cigarettes to sg, uk customs baby formula, engagement ring airport security uk"
>
  <Header slot="header" />

  <!-- FAQ Schema JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": countryFaqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  })} />

  <div class="max-w-[1000px] w-full mx-auto px-4 md:px-6 py-12 flex-1">
    
    <div class="mb-8 select-none">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-mute hover:text-ink transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        Back to TSA Checker
      </a>
    </div>

    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-link-bg-soft text-link-deep border border-link/25 rounded-xs text-xs font-mono mb-3">
        <Globe class="w-3.5 h-3.5" />
        Border Control & Customs 2026
      </div>
      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.2px] text-ink mb-3 leading-tight">
        International Airport Security & Customs Regulations
      </h1>
      <p class="text-sm text-body leading-[1.7] max-w-[760px]">
        Official airport screening protocols, biosecurity declaration requirements, melatonin status, nicotine bans, and medication rules across Singapore, UK, France, Australia, Japan, USA, Canada, and Germany.
      </p>
    </header>

    <!-- Country Cards -->
    <div class="space-y-6 mb-12">
      {countries.map(country => (
        <div id={country.slug} class="bg-canvas border border-hairline rounded-md p-6 shadow-xs scroll-mt-20">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-hairline gap-2">
            <h2 class="text-xl font-semibold text-ink flex items-center gap-2">
              <Landmark class="w-4.5 h-4.5 text-link" />
              {country.name}
            </h2>
            <span class="text-xs font-mono text-mute">{country.agency}</span>
          </div>

          <div class="space-y-3 my-5 text-xs text-body">
            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <strong class="text-ink block mb-0.5 font-semibold">Liquid & Security Screening Protocol:</strong>
              <span>{country.liquidRule}</span>
            </div>

            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <strong class="text-ink block mb-0.5 font-semibold">Biosecurity & Agriculture Rules:</strong>
              <span>{country.biosecurity}</span>
            </div>

            <div class="p-3 bg-canvas-soft rounded border border-hairline">
              <strong class="text-ink block mb-0.5 font-semibold">Medication & Prescription Protocol:</strong>
              <span>{country.medicineRule}</span>
            </div>
          </div>

          <div class="p-3 bg-canvas-soft rounded border border-hairline/80 text-xs text-body flex items-start gap-2.5 mb-4">
            <AlertCircle class="w-4 h-4 text-warning-deep flex-shrink-0 mt-0.5" />
            <div>
              <strong class="text-ink block mb-0.5">Duty-Free Exemption & Customs Limit:</strong>
              <span>{country.dutyFreeLimit}</span>
            </div>
          </div>

          {country.specialRegulations && country.specialRegulations.length > 0 && (
            <div class="mt-4 pt-4 border-t border-hairline">
              <h3 class="text-xs font-mono uppercase tracking-wider font-semibold text-mute mb-2.5">
                Key Item Regulations for {country.name}:
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {country.specialRegulations.map(reg => (
                  <div class="p-2.5 bg-canvas-soft-2 rounded border border-hairline text-xs">
                    <span class="font-semibold text-ink block mb-0.5">{reg.item}</span>
                    <span class="text-body leading-relaxed">{reg.rule}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Country Customs FAQ Section -->
    <section class="mt-12 bg-canvas border border-hairline rounded-md p-6 shadow-xs">
      <h2 class="text-2xl font-semibold text-ink tracking-tight mb-4">
        Frequently Asked International Customs Questions
      </h2>
      <div class="divide-y divide-hairline">
        {countryFaqs.map((faq) => (
          <div class="py-4 first:pt-0 last:pb-0">
            <h3 class="text-sm font-semibold text-ink mb-1.5">
              {faq.q}
            </h3>
            <p class="text-xs text-body leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</Layout>
