---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Mail, MapPin, Clock, MessageSquare, Send, HelpCircle, ExternalLink } from "@lucide/astro";
---

<Layout
  title="Contact BringOnPlane — Get Help, Report an Error, or Partner With Us"
  description="Contact the BringOnPlane team to report incorrect TSA rules, suggest new items, ask about partnerships, or get travel packing help."
  canonicalURL="https://bringonplane.com/contact"
  keywords="contact bringonplane, report tsa rule error, travel packing help, baggage rules question"
>
  <Header slot="header" />

  <main class="flex-1">

    <!-- Hero -->
    <section class="py-16 md:py-20 border-b border-hairline bg-canvas-soft">
      <div class="max-w-[680px] mx-auto px-4 md:px-6 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-link-bg-soft text-link border border-link/20 mb-5 mx-auto">
          <Mail class="w-6 h-6" />
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.5px] text-ink mb-4">Get in Touch</h1>
        <p class="text-sm text-body leading-[1.8] max-w-[480px] mx-auto">
          Found an outdated TSA rule? Have a suggestion? Need help with your packing list? We read every message.
        </p>
      </div>
    </section>

    <!-- Contact grid -->
    <section class="py-16 border-b border-hairline bg-canvas">
      <div class="max-w-[900px] mx-auto px-4 md:px-6 grid md:grid-cols-2 gap-12">

        <!-- Left: Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-lg font-semibold tracking-[-0.5px] text-ink mb-5">Contact Information</h2>
            <div class="space-y-4">
              {[
                { icon: Mail, label: "Email", value: "hello@bringonplane.com", href: "mailto:hello@bringonplane.com" },
                { icon: MessageSquare, label: "Report an Error", value: "errors@bringonplane.com", href: "mailto:errors@bringonplane.com" },
                { icon: ExternalLink, label: "Partnerships", value: "partners@bringonplane.com", href: "mailto:partners@bringonplane.com" },
              ].map(c => (
                <a href={c.href} class="flex items-start gap-4 p-4 border border-hairline rounded-md hover:border-link hover:shadow-sm transition-all group bg-canvas">
                  <div class="w-9 h-9 rounded-md bg-link-bg-soft text-link border border-link/15 flex items-center justify-center flex-shrink-0">
                    <c.icon class="w-4.5 h-4.5" />
                  </div>
                  <div>
                    <p class="text-[11px] font-mono text-mute uppercase tracking-wider mb-0.5">{c.label}</p>
                    <p class="text-sm font-medium text-ink group-hover:text-link transition-colors">{c.value}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <div class="border border-hairline rounded-md p-5 bg-canvas-soft space-y-3">
            <div class="flex items-center gap-2 mb-3">
              <Clock class="w-4 h-4 text-mute" />
              <span class="text-xs font-mono text-mute uppercase tracking-wider">Response Times</span>
            </div>
            {[
              { type: "General inquiries", time: "Within 48 hours" },
              { type: "TSA rule errors", time: "Within 24 hours" },
              { type: "Partnerships", time: "Within 72 hours" },
            ].map(r => (
              <div class="flex items-center justify-between text-xs text-body border-b border-hairline/50 pb-2 last:border-0 last:pb-0">
                <span>{r.type}</span>
                <span class="text-ink font-medium font-mono">{r.time}</span>
              </div>
            ))}
          </div>

          <div class="border border-hairline rounded-md p-5 bg-canvas">
            <div class="flex items-center gap-2 mb-3">
              <HelpCircle class="w-4 h-4 text-mute" />
              <span class="text-xs font-mono text-mute uppercase tracking-wider">Before You Write</span>
            </div>
            <p class="text-xs text-body leading-[1.7] mb-3">Check if your question is already answered in our resources:</p>
            <div class="space-y-2">
              {[
                { label: "Full FAQ Guide", href: "/faq" },
                { label: "All TSA Items A–Z", href: "/items" },
                { label: "Packing List Generator", href: "/checklist" },
              ].map(l => (
                <a href={l.href} class="flex items-center justify-between text-xs text-link hover:text-link-deep transition-colors">
                  <span>{l.label}</span>
                  <ExternalLink class="w-3 h-3" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Contact form -->
        <div>
          <h2 class="text-lg font-semibold tracking-[-0.5px] text-ink mb-5">Send a Message</h2>
          <form
            id="contact-form"
            class="space-y-4"
            novalidate
          >
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="cf-name" class="block text-xs font-medium text-body mb-1.5">Full Name <span class="text-error">*</span></label>
                <input
                  type="text"
                  id="cf-name"
                  name="name"
                  required
                  placeholder="Jane Smith"
                  class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
                />
              </div>
              <div>
                <label for="cf-email" class="block text-xs font-medium text-body mb-1.5">Email Address <span class="text-error">*</span></label>
                <input
                  type="email"
                  id="cf-email"
                  name="email"
                  required
                  placeholder="jane@example.com"
                  class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="cf-subject" class="block text-xs font-medium text-body mb-1.5">Subject <span class="text-error">*</span></label>
              <select
                id="cf-subject"
                name="subject"
                required
                class="w-full h-10 px-3 text-sm text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors"
              >
                <option value="">Select a topic…</option>
                <option value="tsa-rule-error">Report an incorrect TSA rule</option>
                <option value="suggest-item">Suggest a new item</option>
                <option value="packing-help">Packing list help</option>
                <option value="partnership">Partnership inquiry</option>
                <option value="press">Press & media</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="cf-message" class="block text-xs font-medium text-body mb-1.5">Message <span class="text-error">*</span></label>
              <textarea
                id="cf-message"
                name="message"
                required
                rows={6}
                placeholder="Describe your question, error report, or feedback…"
                class="w-full px-3 py-2.5 text-sm text-ink bg-canvas border border-hairline rounded-md placeholder:text-mute/50 focus:outline-none focus:ring-2 focus:ring-link focus:border-link transition-colors resize-y min-h-[140px]"
              ></textarea>
            </div>

            <!-- Honeypot (spam trap) -->
            <div class="hidden" aria-hidden="true">
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <button
              type="submit"
              id="cf-submit"
              class="inline-flex items-center gap-2 px-5 h-10 text-sm font-medium text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all w-full justify-center cursor-pointer"
            >
              <Send class="w-4 h-4" />
              Send Message
            </button>

            <!-- Status messages -->
            <div id="cf-success" class="hidden text-xs text-success bg-success-soft border border-success/25 rounded-md px-4 py-3">
              ✅ Message sent! We'll get back to you within 48 hours.
            </div>
            <div id="cf-error" class="hidden text-xs text-error bg-error-soft border border-error/25 rounded-md px-4 py-3">
              ❌ Something went wrong. Please email us directly at hello@bringonplane.com
            </div>
          </form>
        </div>

      </div>
    </section>

  </main>

  <Footer slot="footer" />
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("cf-submit") as HTMLButtonElement;
      const success = document.getElementById("cf-success");
      const error = document.getElementById("cf-error");

      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }

      // Simulate form submission (replace with Formspree/Resend endpoint)
      await new Promise(r => setTimeout(r, 800));

      // Show success (in production hook to real API)
      if (success) success.classList.remove("hidden");
      form.reset();
      if (btn) { btn.disabled = false; btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' class='w-4 h-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><polyline points='20 6 9 17 4 12'/></svg> Sent!`; }

      setTimeout(() => {
        if (success) success.classList.add("hidden");
        if (btn) btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' class='w-4 h-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><line x1='22' y1='2' x2='11' y2='13'/><polygon points='22 2 15 22 11 13 2 9 22 2'/></svg> Send Message`;
      }, 4000);
    });
  }

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
