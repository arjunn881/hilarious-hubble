        { title: "Audit Lighting & Batteries", desc: "Remove lithium-ion batteries from headlamps and pack them inside protective plastic battery cases in carry-on." },
        { title: "Check Match & Lighter Limits", desc: "Keep 1 ordinary book of safety matches or 1 common disposable lighter on your person." },
        { title: "Pack Sleeping Gear Compressively", desc: "Use compression dry-sacks to shrink sleeping bag and tent volume." }
      ],
      faqs: [
        { q: "Can I bring tent stakes in carry-on luggage?", a: "No. Metal or plastic tent stakes, pegs, and spikes are classified as sharp objects and are strictly prohibited in carry-on bags. They MUST be packed in checked hold baggage." },
        { q: "Are camping gas fuel canisters allowed on planes?", a: "No. Fuel canisters containing propane, butane, isobutane, or white gas are STRICTLY BANNED from all passenger aircraft in both carry-on and checked baggage." },
        { q: "Can I bring a camp stove on a plane?", a: "Yes, but ONLY if the stove is completely empty and thoroughly cleaned of all fuel residues and vapors. If any fuel smell remains, screeners will confiscate it." },
        { q: "Are trekking poles allowed in carry-on bags?", a: "No. TSA rules require hiking poles, trekking poles, and ski poles to be packed in checked hold luggage." },
        { q: "Can I bring a pocket knife in my checked bag?", a: "Yes. Pocket knives, hunting knives, multi-tools, and axes are allowed in checked luggage. Ensure blades are securely wrapped to prevent injury to baggage handlers." },
        { q: "How many matches can I take on a flight?", a: "You are allowed 1 single book of safety matches or 1 common lighter carried on your person. Strike-anywhere matches and torch lighters are strictly prohibited." },
        { q: "Is bear spray allowed on airplanes?", a: "Bear spray is banned in carry-on bags. A single 4 oz (118ml) container of bear spray with a 14% OC capsaicin concentration and safety latch is allowed in checked luggage on select airlines." },
        { q: "Can I pack a sleeping bag as a carry-on item?", a: "Yes. Sleeping bags, sleeping pads, and bivvy sacks are fully permitted in carry-on luggage provided they meet your airline's size limits." }
      ]
    },
    {
      slug: "family-vacation",
      name: "Family Vacation",
      tagline: "Parent Travel, Kids' Gear & Exempt Liquid Rules",
      desc: "Ultimate family travel checklist for parents flying with infants, toddlers, or kids. Details TSA exemptions for baby formula, breast milk, juice, stroller gate-checking, and child travel gear.",
      quickAnswer: "For a family trip, pack baby formula, breast milk, or juice (EXEMPT from 3.4 oz limits), baby wipes, diapers, snacks, travel games, change of clothes, and collapsible stroller (gate-check allowed). Always declare baby liquids at TSA security.",
      items: [
        { name: "Baby Formula & Prepared Bottles", cat: "Baby", status: "ALLOWED", placement: "Declare at TSA", note: "EXEMPT from 3-1-1 3.4 oz rules in reasonable quantities." },
        { name: "Breast Milk & Cooling Ice Packs", cat: "Baby", status: "ALLOWED", placement: "Declare at TSA", note: "Allowed in carry-on even if flying without the infant present." },
        { name: "Baby Wipes & Diapers (1-2 Days Extra)", cat: "Baby", status: "ALLOWED", placement: "Carry-on Bag", note: "Pack extra to handle flight delays or cancellations." },
        { name: "Juice & Toddler Snack Pouches", cat: "Baby", status: "ALLOWED", placement: "Declare at TSA", note: "Medically necessary child liquids are exempt from 3.4 oz limits." },
        { name: "Collapsible Stroller / Car Seat", cat: "Baby", status: "ALLOWED", placement: "Gate-Checked Free", note: "Most airlines permit free gate-checking of strollers and car seats." },
        { name: "Spare Clothing Sets for Kids & Parents", cat: "Clothing", status: "ALLOWED", placement: "Carry-on Bag", note: "Keep an extra outfit handy for accidental spills." },
        { name: "Child Prescription & Fever Meds", cat: "Medicine", status: "ALLOWED", placement: "Carry-on Bag", note: "Liquid infant Tylenol/Motrin exempt from 3-1-1 rules upon declaration." },
        { name: "Compact Toys, Coloring Books & Crayons", cat: "Baby", status: "ALLOWED", placement: "Personal Item", note: "Keeps children entertained during long boarding waits." },
        { name: "Kid-Friendly Headphones (Volume-Limited)", cat: "Electronics", status: "ALLOWED", placement: "Personal Item", note: "Protects young ears while watching inflight movies." },
        { name: "Sanitizing Surface Wipes", cat: "Personal Care", status: "ALLOWED", placement: "Carry-on Bag", note: "Wipe down seat tray tables, armrests, and window shades." },
        { name: "Pacifiers & Teething Toys", cat: "Baby", status: "ALLOWED", placement: "Carry-on Bag", note: "Sucking on pacifiers reduces ear pressure pain during takeoff." },
        { name: "Ziploc Bags for Soiled Items", cat: "Personal Care", status: "ALLOWED", placement: "Carry-on Bag", note: "Essential for storing dirty clothes or trash in flight." }
      ],
      mistakes: [
        "Assuming baby formula, breast milk, or toddler juice fall under the 3.4 oz limit (they are medically exempt but MUST be declared).",
        "Not removing frozen gel ice packs for baby milk before passing X-ray screening.",
        "Packing essential diapers, formula, or children's daily medications inside checked baggage.",
        "Forgetting to check your airline's specific car seat and stroller gate-check weight limits.",
        "Packing toy weapons, plastic guns, or metal cutlery in children's carry-on backpacks."
      ],
      steps: [
        { title: "Separate Baby Formula & Liquids", desc: "Place all baby formula, breast milk, toddler juice, and ice packs into a separate pouch for TSA declaration." },
        { title: "Inform TSA Officers at Security", desc: "Notify the security officer before screening that you are carrying baby liquids exceeding 3.4 oz." },
        { title: "Prepare Stroller for Screening", desc: "Collapse your stroller at the TSA security line so it can pass through the X-ray scanner or be manually inspected." },
        { title: "Pack Emergency Diaper Bag Supplies", desc: "Include at least 24 hours worth of extra diapers, wipes, formula, and change of clothes for unexpected travel delays." },
        { title: "Organize Entertainment & Electronics", desc: "Pre-load tablets with offline movies and games, and pack volume-limited child headphones." },
        { title: "Utilize Gate-Checking for Heavy Gear", desc: "Check car seats and strollers at the boarding gate right before stepping onto the aircraft jetbridge." }
      ],
      faqs: [
        { q: "Is baby formula exempt from the TSA 3.4 oz liquid rule?", a: "YES! Baby formula, breast milk, toddler juice, and baby food in reasonable quantities are fully exempt from the 3.4 oz (100ml) liquid limit. You must declare these items to TSA officers at the checkpoint." },
        { q: "Can I bring breast milk on a plane if my baby is not traveling with me?", a: "YES. TSA regulations allow parents to carry breast milk, cooling ice packs, and breast pumps in carry-on baggage regardless of whether the child is present." },
        { q: "Do airlines charge extra for checking strollers and car seats?", a: "No. Almost all major airlines allow parents to check 1 stroller and 1 car seat free of charge, either at the ticket counter or right at the boarding gate." },
        { q: "How are baby liquids screened at TSA security?", a: "TSA officers may test formula or breast milk using advanced liquid bottle scanners (which do not open or contaminate the liquid) or request a small sample for testing." },
        { q: "Can I bring gel ice packs to keep baby milk cold?", a: "Yes. Ice packs, gel packs, and freezer packs are allowed to keep baby milk cold. If ice packs are partially melted, officers may perform additional screening." },
        { q: "Are baby wipes allowed in carry-on bags?", a: "Yes. Baby wipes, moist towelettes, and diaper cream (in containers under 3.4 oz unless declared as medically necessary) are allowed in carry-on luggage." },
        { q: "Can I bring a FAA-approved car seat to use on an airplane seat?", a: "Yes. If you purchased a ticketed seat for your child, you can install a FAA-approved car seat (bearing a label stating 'Certified for Use in Motor Vehicles and Aircraft')." },
        { q: "What snacks can I pack for kids on a flight?", a: "Solid snacks like crackers, cereal, dried fruit, cheese sticks, and sandwiches are fully allowed through TSA checkpoints." }
      ]
    }
  ];

  return templates.map(tpl => ({
    params: { slug: tpl.slug },
    props: { template: tpl, allTemplates: templates }
  }));
}

const { template, allTemplates } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, "https://bringonplane.com").toString();
const currentYear = new Date().getFullYear();

// High-CTR SEO Metadata
const seoTitle = `${template.name} Packing List & TSA Baggage Rules (${currentYear})`;
const seoDescription = `Complete ${template.name.toLowerCase()} packing checklist with TSA rules, prohibited items, airline weight limits & common packing mistakes. Updated ${currentYear}.`;

// Schema JSON-LD blocks
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Packing Assistant", href: "/checklist/" },
  { label: `${template.name} Checklist` }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": item.label,
    "item": item.href ? `https://bringonplane.com${item.href.endsWith('/') ? item.href : item.href + '/'}` : currentUrl
  }))
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": template.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Pack for a ${template.name}`,
  "description": template.desc,
  "step": template.steps.map((step, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": step.title,
    "text": step.desc
  }))
};

// Airline Comparison Table Data
const airlineLimits = [
  { name: "Delta Air Lines", carryOn: "22 x 14 x 9 in (No weight limit)", checked: "50 lbs (23 kg)" },
  { name: "United Airlines", carryOn: "22 x 14 x 9 in (17 lbs / 8 kg)", checked: "50 lbs (23 kg)" },
  { name: "American Airlines", carryOn: "22 x 14 x 9 in (22 lbs / 10 kg)", checked: "50 lbs (23 kg)" },
  { name: "Lufthansa", carryOn: "21.6 x 15.7 x 9 in (17 lbs / 8 kg)", checked: "50 lbs (23 kg)" },
  { name: "Air France", carryOn: "21.7 x 13.8 x 9.9 in (26 lbs / 12 kg)", checked: "50 lbs (23 kg)" },
  { name: "British Airways", carryOn: "22 x 18 x 10 in (50 lbs / 23 kg)", checked: "50 lbs (23 kg)" },
  { name: "Ryanair", carryOn: "21.6 x 15.7 x 7.8 in (22 lbs / 10 kg)", checked: "44 lbs (20 kg)" },
  { name: "Emirates", carryOn: "22 x 15 x 8 in (15 lbs / 7 kg)", checked: "66 lbs (30 kg)" },
  { name: "Singapore Airlines", carryOn: "22 x 15 x 8 in (15 lbs / 7 kg)", checked: "66 lbs (30 kg)" }
];

const relatedWidgetGroups = [
  { title: "Packing Lists", links: allTemplates.map(t => ({ title: `${t.name} Checklist`, url: `/packing-list/${t.slug}` })) },
  { title: "Travel Tools", links: [
    { title: "Smart Packing Assistant", url: "/checklist" },
    { title: "Item Baggage Directory", url: "/#categories" },
    { title: "Airline Baggage Rules", url: "/airlines" },
    { title: "Country Customs Rules", url: "/countries" }
  ]}
];
---

<Layout title={seoTitle} description={seoDescription} canonicalURL={currentUrl}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />

  <Header slot="header" />

  <div class="max-w-[1200px] w-full mx-auto px-4 md:px-6 lg:px-8 py-12 flex-1">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Page Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="font-mono text-[10px] font-semibold text-mute uppercase tracking-wider bg-canvas-soft-2 border border-hairline px-2 py-0.5 rounded-xs">
          TSA Baggage Rules
        </span>

        <span class="inline-flex items-center gap-1 font-mono text-[10px] font-semibold text-link bg-link-bg-soft border border-link/25 px-2 py-0.5 rounded-xs select-none">
          <BadgeCheck class="w-3 h-3 text-link" />
          TSA Verified • High Confidence
        </span>

        <span class="flex items-center gap-1.5 text-xs text-mute font-mono">
          <Calendar class="w-3.5 h-3.5" />
          Updated {currentYear}
        </span>
      </div>

      <!-- Verdict Banner -->
      <div class="mb-6 flex items-center gap-4 px-5 py-4 rounded-lg bg-emerald-50 border border-emerald-200 select-none">
        <span class="flex items-center justify-center w-9 h-9 rounded-full bg-emerald-100 border border-emerald-300 flex-shrink-0">
          <CheckCircle2 class="w-5 h-5 text-emerald-600" />
        </span>
        <div>
          <p class="text-sm font-bold text-emerald-800">COMPLETE PACKING CHECKLIST — {template.name.toUpperCase()}</p>
          <p class="text-xs text-emerald-700 leading-snug mt-0.5">{template.tagline}</p>
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-semibold tracking-[-1.28px] text-ink text-pretty">
        {template.name} Packing List & Baggage Rules
      </h1>

      <!-- Featured Snippet Quick Answer Box -->
      <div class="mt-5 mb-4 p-4 rounded-md bg-canvas-soft border-l-4 border-link">
        <p class="text-xs font-mono text-link uppercase tracking-wider mb-1.5 font-semibold">Quick Answer & Summary</p>
        <p class="text-sm text-body leading-[1.7] text-pretty">
          {template.quickAnswer}
        </p>
      </div>

      <!-- CTA to Launch Interactive Assistant -->
      <div class="flex flex-wrap items-center gap-4 mt-6">
        <button 
          type="button" 
          id="btn-import-checklist"
          class="inline-flex items-center gap-2 h-10 px-5 text-xs font-semibold text-on-primary bg-primary hover:bg-ink rounded-sm shadow-sm transition-all cursor-pointer"
        >
          <ClipboardCheck class="w-4 h-4" />
          Import to Smart Packing Assistant
        </button>

        <a 
          href="/checklist" 
          class="inline-flex items-center gap-2 h-10 px-5 text-xs font-medium text-ink bg-canvas border border-hairline hover:border-hairline-strong rounded-sm shadow-sm transition-all"
        >
          <Luggage class="w-4 h-4 text-mute" />
          Build Custom Trip List
        </a>
      </div>
    </header>

    <!-- Overview Section -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold text-ink mb-3 tracking-tight">Overview & TSA Compliance</h2>
      <p class="text-sm text-body leading-[1.7] text-pretty">{template.desc}</p>
    </section>

    <!-- Essential Packing Items Table Grid -->
    <section class="my-10">
      <h2 class="text-xl font-semibold text-ink mb-4 tracking-tight">Recommended {template.name} Packing Checklist</h2>
      <div class="overflow-x-auto border border-hairline rounded-lg bg-canvas shadow-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-canvas-soft border-b border-hairline text-[10px] font-mono font-semibold text-mute uppercase tracking-wider">
              <th class="py-3 px-4">Item Name</th>
              <th class="py-3 px-4">Category</th>
              <th class="py-3 px-4">TSA Status</th>
              <th class="py-3 px-4">Placement</th>
              <th class="py-3 px-4">Packing Note</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/60 text-xs">
            {template.items.map(item => (
              <tr class="hover:bg-canvas-soft/50 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-ink">{item.name}</td>
                <td class="py-3.5 px-4 font-mono text-[10px] text-mute uppercase">{item.cat}</td>
                <td class="py-3.5 px-4">
                  {item.status === 'ALLOWED' && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-xs">
                      <CheckCircle2 class="w-3 h-3" /> ALLOWED
                    </span>
                  )}
                  {item.status === 'RESTRICTED' && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-xs">
                      <AlertCircle class="w-3 h-3" /> RESTRICTED
                    </span>
                  )}
                  {item.status === 'NOT_ALLOWED' && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-red-700 bg-red-50 border border-red-200 px-2 py-0.5 rounded-xs">
                      <XCircle class="w-3 h-3" /> CHECKED ONLY / BANNED
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-4 font-mono text-[10px] text-body">{item.placement}</td>
                <td class="py-3.5 px-4 text-mute text-pretty">{item.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Common Packing Mistakes Grid -->
    <section class="my-10">
      <h2 class="text-xl font-semibold text-ink mb-4 tracking-tight flex items-center gap-2">
        <AlertTriangle class="w-5 h-5 text-amber-600" />
        5 Critical {template.name} Packing Mistakes to Avoid
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {template.mistakes.map((mistake, idx) => (
          <div class="p-4 rounded-md bg-amber-50/60 border border-amber-200/80 flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-amber-100 border border-amber-300 text-amber-800 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
              {idx + 1}
            </span>
            <p class="text-xs text-amber-900 leading-relaxed font-medium">{mistake}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Step-by-Step Packing Guide -->
    <section class="my-10">
      <h2 class="text-xl font-semibold text-ink mb-4 tracking-tight">Step-by-Step Packing Guide for {template.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {template.steps.map((step, idx) => (
          <div class="p-5 rounded-md border border-hairline bg-canvas shadow-xs flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs text-link font-semibold block mb-1">Step {idx + 1}</span>
              <h3 class="text-sm font-semibold text-ink mb-2">{step.title}</h3>
              <p class="text-xs text-body leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Airline Baggage Weight Limits Reference Table -->
    <section class="my-10">
      <h2 class="text-xl font-semibold text-ink mb-4 tracking-tight flex items-center gap-2">
        <Plane class="w-5 h-5 text-link" />
        Major Airline Baggage Allowance Reference Table
      </h2>
      <div class="overflow-x-auto border border-hairline rounded-lg bg-canvas shadow-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-canvas-soft border-b border-hairline text-[10px] font-mono font-semibold text-mute uppercase tracking-wider">
              <th class="py-3 px-4">Airline Carrier</th>
              <th class="py-3 px-4">Cabin Baggage Allowance</th>
              <th class="py-3 px-4">Checked Hold Allowance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline/60 text-xs">
            {airlineLimits.map(al => (
              <tr class="hover:bg-canvas-soft/50 transition-colors">
                <td class="py-3 px-4 font-semibold text-ink">{al.name}</td>
                <td class="py-3 px-4 font-mono text-body">{al.carryOn}</td>
                <td class="py-3 px-4 font-mono text-body">{al.checked}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Frequently Asked Questions Accordion -->
    <section class="my-10">
      <h2 class="text-xl font-semibold text-ink mb-5 tracking-tight">Frequently Asked Questions ({template.name})</h2>
      <div class="space-y-3">
        {template.faqs.map((faq, idx) => (
          <div class="border border-hairline rounded-md bg-canvas shadow-xs">
            <button 
              type="button" 
              class="faq-header-btn w-full text-left px-5 py-4 flex items-center justify-between text-sm font-semibold text-ink hover:bg-canvas-soft transition-colors cursor-pointer outline-none select-none"
              data-target={`faq-body-tpl-${idx}`}
            >
              <span>{faq.q}</span>
              <ChevronDown class="w-4 h-4 text-mute transition-transform duration-200" />
            </button>
            <div id={`faq-body-tpl-${idx}`} class="hidden px-5 pb-4 text-xs text-body leading-[1.6] border-t border-hairline/40 pt-3">
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- E-E-A-T Editorial Banner -->
    <EEATBanner />

    <!-- Related Packing Lists Widget -->
    <RelatedLinksWidget groups={relatedWidgetGroups} />
  </div>

  <Footer slot="footer" />
</Layout>

<script define:vars={{ template }}>
  // FAQ accordion toggles
  document.querySelectorAll(".faq-header-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      const targetId = e.currentTarget.getAttribute("data-target") || "";
      const body = document.getElementById(targetId);
      const icon = e.currentTarget.querySelector("svg");
      
      if (body) {
        const isHidden = body.classList.contains("hidden");
        if (isHidden) {
          body.classList.remove("hidden");
          if (icon) icon.classList.add("rotate-180");
        } else {
          body.classList.add("hidden");
          if (icon) icon.classList.remove("rotate-180");
        }
      }
    });
  });

  // Import checklist values directly to localStorage active trip
  document.getElementById("btn-import-checklist")?.addEventListener("click", () => {
    const activeTrip = {
      id: `trip-${Date.now()}`,
      name: `${template.name} Itinerary`,
      destination: "Imported Route",
      departureDate: new Date().toISOString().split('T')[0],
      returnDate: new Date(Date.now() + 259200000).toISOString().split('T')[0],
      airline: "Delta Air Lines",
      tripType: template.slug.split("-")[0] || "vacation",
      lists: [
        { id: "carry-on", name: "Carry-on Bag", isCustom: false, items: [] },
        { id: "checked-bag", name: "Checked Bag", isCustom: false, items: [] },
        { id: "personal-item", name: "Personal Item", isCustom: false, items: [] },
        { id: "documents", name: "Documents", isCustom: false, items: [] },
        { id: "essentials", name: "Essentials", isCustom: false, items: [] }
      ],
      notes: ""
    };

    // Populate items
    template.items.forEach((item, idx) => {
      let listId = "carry-on";
      if (item.cat === 'Documents') listId = "documents";
      if (item.cat === 'Liquids' || item.status === 'NOT_ALLOWED' || item.placement.includes("Checked")) listId = "checked-bag";

      const targetList = activeTrip.lists.find(l => l.id === listId);
      if (targetList) {
        targetList.items.push({
          id: `imp-${Date.now()}-${idx}`,
          name: item.name,
          category: item.cat,
          carryOnStatus: item.status,
          checkedStatus: 'ALLOWED',
          reason: item.note,
          travelTip: `Placement: ${item.placement}`,
          packed: false,
          compliance: { status: 'SAFE', message: 'Verified compliant.' }
        });
      }
    });

    localStorage.setItem("active_trip", JSON.stringify(activeTrip));
    localStorage.setItem("traveler_checklist", JSON.stringify([]));
    
    // Redirect to Packing Assistant page!
    window.location.href = "/checklist";
  });
</script>
