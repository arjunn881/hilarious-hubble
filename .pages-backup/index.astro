      return `<svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>`;
    }
    return `<svg class="w-4 h-4 text-amber-500 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`;
  }

  function getSummaryLabel(status: string): string {
    const s = (status || '').toUpperCase();
    if (s === 'ALLOWED') return 'Yes';
    if (s === 'NOT_ALLOWED' || s === 'PROHIBITED') return 'No';
    return 'Conditional';
  }

  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let highlightedIndex = -1;
  let matchingSuggestions: SearchItem[] = [];

  // Embedded all items database cache (0ms instant lookup)
  function getAllItemsDatabase(): Record<string, any> {
    try {
      const el = document.getElementById('all-items-data');
      if (!el) return {};
      const data = JSON.parse(el.textContent || '[]');
      const map: Record<string, any> = {};
      data.forEach((d: any) => { if (d.slug) map[d.slug] = d; });
      return map;
    } catch {
      return {};
    }
  }

  async function loadSearchIndex() {
    if (isIndexLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error('Search index response not ok');
      searchIndex = await res.json();
      isIndexLoaded = true;
    } catch (e) {
      console.warn('Could not load search index from static endpoint', e);
    }
  }

  // Preload search index immediately
  loadSearchIndex();

  // Fetch full item details and render in popup modal
  function handleItemSelected(slug: string, sourceChip: HTMLButtonElement | null = null) {
    const modal = document.getElementById('hero-result-modal');
    if (!modal) return;

    // Highlight active chip if it was selected from a chip or matches slug
    const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
    chips.forEach(c => {
      const isMatch = (sourceChip && c === sourceChip) || c.dataset.chipSlug === slug;
      if (isMatch) {
        c.classList.add('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
        c.setAttribute('aria-pressed', 'true');
      } else {
        c.classList.remove('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
        c.setAttribute('aria-pressed', 'false');
      }
    });

    const itemsDb = getAllItemsDatabase();
    const dbItem = itemsDb[slug];
    const indexItem = searchIndex.find(i => i.slug === slug);

    let item: FullItem = {
      slug,
      name: dbItem?.name || indexItem?.name || slug.replace(/-/g, ' '),
      category: dbItem?.category || indexItem?.category || 'Travel Item',
      carryOn: {
        status: dbItem?.carryOn || indexItem?.carryOn || 'ALLOWED',
        reason: dbItem?.carryOnReason || 'Must comply with standard airline baggage security regulations.'
      },
      checkedBag: {
        status: dbItem?.checked || indexItem?.checked || 'ALLOWED',
        reason: dbItem?.checkedReason || 'Permitted in checked baggage according to TSA guidelines.'
      }
    };

    // Render immediately with complete data (no failed network requests)
    renderItemVerdict(item, modal);
  }

  function renderItemVerdict(item: FullItem, modal: HTMLElement) {
    const nameText = document.getElementById('result-title-text');
    const iconContainer = document.getElementById('result-title-icon-container');
    const catEl = document.getElementById('result-category');
    
    const carryonBadgeContainer = document.getElementById('result-carryon-badge-container');
    const checkedBadgeContainer = document.getElementById('result-checked-badge-container');
    
    const reasonEl = document.getElementById('result-reason');
    const statusIconEl = document.getElementById('result-status-icon-container');
    
    const summaryCoIcon = document.getElementById('result-summary-carryon-icon-container');
    const summaryCoText = document.getElementById('result-summary-carryon-text');
    const summaryCkIcon = document.getElementById('result-summary-checked-icon-container');
    const summaryCkText = document.getElementById('result-summary-checked-text');
    const summaryPiIcon = document.getElementById('result-summary-personal-icon-container');
    const summaryPiText = document.getElementById('result-summary-personal-text');
    
    const fullLink = document.getElementById('result-full-link') as HTMLAnchorElement | null;

    if (nameText) nameText.textContent = item.name;
    if (iconContainer) iconContainer.innerHTML = getCategoryIconSvg(item.category);
    if (catEl) catEl.textContent = item.category;
    
    const coStatus = (item.carryOn?.status || 'ALLOWED').toUpperCase();
    const ckStatus = (item.checkedBag?.status || 'ALLOWED').toUpperCase();

    if (carryonBadgeContainer) carryonBadgeContainer.innerHTML = getStatusBadgeHtml(coStatus);
    if (checkedBadgeContainer) checkedBadgeContainer.innerHTML = getStatusBadgeHtml(ckStatus);

    // Big YES/NO verdict banner (High Contrast)
    const verdictBanner = document.getElementById('result-verdict-banner');
    const verdictText = document.getElementById('result-verdict-text');
    const verdictIcon = document.getElementById('result-verdict-icon');

    if (verdictText && verdictIcon && verdictBanner) {
      if (coStatus === 'ALLOWED') {
        verdictText.textContent = 'YES — Allowed in Carry-on';
        verdictText.className = 'text-xl sm:text-2xl font-black tracking-tight text-emerald-950 dark:text-emerald-100';
        verdictBanner.className = 'sticky top-0 z-20 px-6 py-4.5 border-b border-emerald-300 dark:border-emerald-700/80 flex items-center justify-between gap-4 bg-emerald-500/20 dark:bg-emerald-950 backdrop-blur-md transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-emerald-600 text-white shadow-sm flex-shrink-0"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>`;
      } else if (coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED') {
        verdictText.textContent = 'NO — Prohibited in Carry-on';
        verdictText.className = 'text-xl sm:text-2xl font-black tracking-tight text-rose-950 dark:text-rose-100';
        verdictBanner.className = 'sticky top-0 z-20 px-6 py-4.5 border-b border-rose-300 dark:border-rose-700/80 flex items-center justify-between gap-4 bg-rose-500/20 dark:bg-rose-950 backdrop-blur-md transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-rose-600 text-white shadow-sm flex-shrink-0"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg></span>`;
      } else {
        verdictText.textContent = 'RESTRICTED — Conditions Apply';
        verdictText.className = 'text-xl sm:text-2xl font-black tracking-tight text-amber-950 dark:text-amber-100';
        verdictBanner.className = 'sticky top-0 z-20 px-6 py-4.5 border-b border-amber-300 dark:border-amber-700/80 flex items-center justify-between gap-4 bg-amber-500/20 dark:bg-amber-950 backdrop-blur-md transition-colors';
        verdictIcon.innerHTML = `<span class="flex items-center justify-center w-10 h-10 rounded-full bg-amber-600 text-white shadow-sm flex-shrink-0"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg></span>`;
      }
    }

    // Status/Reason message
    const reason = item.carryOn?.reason || item.checkedBag?.reason || 'Must comply with standard TSA airport security rules.';
    if (reasonEl) reasonEl.textContent = reason;
    
    // Status icon based on restriction
    if (statusIconEl) {
      const carriesRestricted = coStatus === 'RESTRICTED' || coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED';
      statusIconEl.innerHTML = carriesRestricted 
        ? `<svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" x2="12" y1="9" y2="13"></line><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>`
        : `<svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
    }

    // Quick Summary
    if (summaryCoIcon && summaryCoText) {
      summaryCoIcon.innerHTML = getSummaryIndicatorSvg(coStatus);
      summaryCoText.textContent = getSummaryLabel(coStatus);
    }
    if (summaryCkIcon && summaryCkText) {
      summaryCkIcon.innerHTML = getSummaryIndicatorSvg(ckStatus);
      summaryCkText.textContent = getSummaryLabel(ckStatus);
    }
    if (summaryPiIcon && summaryPiText) {
      summaryPiIcon.innerHTML = getSummaryIndicatorSvg(coStatus);
      summaryPiText.textContent = getSummaryLabel(coStatus);
    }

    if (fullLink) {
      fullLink.href = `/items/${item.slug}/`;
      fullLink.innerHTML = `Read Full TSA Rules &amp; Guide →`;
    }

    // Open popup modal cleanly
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function findBestMatch(rawQuery: string): SearchItem | undefined {
    const q = rawQuery.toLowerCase().trim();
    if (!q || searchIndex.length === 0) return undefined;

    // 1. Direct exact or substring match on name
    const exactName = searchIndex.find(i => i.name.toLowerCase() === q || i.slug === q);
    if (exactName) return exactName;

    // 2. Query contains item name (e.g. "Perfume / Cologne" contains "perfume")
    const containedName = searchIndex.find(i => q.includes(i.name.toLowerCase()) || i.name.toLowerCase().includes(q));
    if (containedName) return containedName;

    // 3. Token-based word match
    const tokens = q.split(/[\s,/\-_]+/).filter(t => t.length >= 2);
    for (const token of tokens) {
      const match = searchIndex.find(i => 
        i.name.toLowerCase().includes(token) || 
        i.aliases.some(a => a.toLowerCase().includes(token)) ||
        i.keywords.some(k => k.toLowerCase().includes(token))
      );
      if (match) return match;
    }

    return undefined;
  }

  function setupInteractiveSearch() {
    const input = document.getElementById('homepage-search-input') as HTMLInputElement | null;
    const submitBtn = document.getElementById('homepage-search-submit');
    const suggestions = document.getElementById('homepage-suggestions');
    const clearBtn = document.getElementById('homepage-search-clear');
    const chips = document.querySelectorAll<HTMLButtonElement>('.popular-chip');
    const modal = document.getElementById('hero-result-modal');
    const closeBtn = document.getElementById('result-close-btn');
    const dismissBtn = document.getElementById('result-dismiss-btn');
    const backdrop = document.getElementById('hero-result-backdrop');

    if (!input || !suggestions) return;

    // Ensure index is loaded
    loadSearchIndex();
    input.addEventListener('focus', () => {
      loadSearchIndex();
    });

    function updateClearButtonVisibility() {
      if (clearBtn) {
        if (input.value) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
      chips.forEach(c => {
        c.classList.remove('border-blue-600', 'text-blue-600', 'dark:border-blue-400', 'dark:text-blue-400', 'bg-blue-50', 'dark:bg-blue-950/80', 'font-semibold');
        c.setAttribute('aria-pressed', 'false');
      });
    }

    async function renderSuggestions() {
      await loadSearchIndex();
      const q = input.value.toLowerCase().trim();
      if (!q) {
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        return;
      }

      const tokens = q.split(/[\s,/\-_]+/).filter(t => t.length >= 2);

      matchingSuggestions = searchIndex.filter(item => {
        const itemName = item.name.toLowerCase();
        const itemCat = item.category.toLowerCase();
        
        // Exact substring
        if (itemName.includes(q) || itemCat.includes(q) || q.includes(itemName)) return true;
        if (item.aliases.some(alias => alias.toLowerCase().includes(q) || q.includes(alias.toLowerCase()))) return true;
        if (item.keywords.some(kw => kw.toLowerCase().includes(q))) return true;

        // Token match
        if (tokens.length > 0) {
          return tokens.some(t => itemName.includes(t) || item.aliases.some(a => a.toLowerCase().includes(t)));
        }

        return false;
      }).slice(0, 6);

      highlightedIndex = -1;

      if (matchingSuggestions.length === 0) {
        suggestions.innerHTML = `
          <div class="p-4 text-sm text-slate-700 dark:text-slate-200">
            No exact match for "<span class="font-bold text-slate-950 dark:text-white">${input.value}</span>". Try <button type="button" class="text-blue-600 dark:text-blue-400 font-bold hover:underline cursor-pointer" id="suggest-powerbank">Power Bank</button> or browse <a href="/items/page/1/" class="text-blue-600 dark:text-blue-400 font-bold hover:underline">All 196+ Items</a>.
          </div>
        `;
        suggestions.classList.remove('hidden');
        
        const fallbackBtn = document.getElementById('suggest-powerbank');
        if (fallbackBtn) {
          fallbackBtn.addEventListener('click', () => {
            input.value = 'Power Bank';
            input.focus();
            renderSuggestions();
            updateClearButtonVisibility();
          });
        }
        return;
      }

      // Render suggestions with high contrast
      suggestions.innerHTML = matchingSuggestions.map((item, idx) => {
        const iconSvg = getCategoryIconSvg(item.category);
        const coStatus = (item.carryOn || '').toUpperCase();
        const badgeColor = coStatus === 'ALLOWED'
          ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-900 dark:text-emerald-200 border-emerald-300 dark:border-emerald-700'
          : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED'
          ? 'bg-rose-100 dark:bg-rose-950 text-rose-900 dark:text-rose-200 border-rose-300 dark:border-rose-700'
          : 'bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-200 border-amber-300 dark:border-amber-700';
        const badgeLabel = coStatus === 'ALLOWED' ? 'Allowed' : coStatus === 'NOT_ALLOWED' || coStatus === 'PROHIBITED' ? 'Not Allowed' : 'Restricted';
        return `
          <button 
            type="button" 
            class="suggestion-item w-full flex items-center justify-between px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm text-slate-900 dark:text-slate-100 cursor-pointer text-left border-l-4 border-transparent hover:border-blue-600 transition-all font-medium"
            data-slug="${item.slug}"
            data-index="${idx}"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-blue-600 dark:text-blue-400 flex-shrink-0">${iconSvg}</span>
              <div class="min-w-0">
                <span class="font-bold block truncate text-slate-950 dark:text-white">${item.name}</span>
                <span class="text-[10px] font-mono text-slate-600 dark:text-slate-400 uppercase font-semibold">${item.category}</span>
              </div>
            </div>
            <span class="inline-flex items-center text-[10px] font-bold px-2.5 py-0.5 rounded-full border uppercase tracking-wider flex-shrink-0 ml-2 ${badgeColor}">${badgeLabel}</span>
          </button>
        `;
      }).join('');

      suggestions.classList.remove('hidden');

      // Bind mouseenter & click handlers to suggestion items
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => {
        el.addEventListener('click', (e) => {
          const slug = (e.currentTarget as HTMLElement).dataset.slug || '';
          const name = (e.currentTarget as HTMLElement).querySelector('.font-bold')?.textContent || '';
          input.value = name;
          suggestions.classList.add('hidden');
          updateClearButtonVisibility();
          handleItemSelected(slug);
        });

        el.addEventListener('mouseenter', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).dataset.index || '-1', 10);
          highlightedIndex = idx;
          updateHighlight();
        });
      });
    }

    function updateHighlight() {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach((item, idx) => {
        if (idx === highlightedIndex) {
          item.classList.add('bg-blue-50', 'dark:bg-slate-800', 'border-blue-600', 'dark:border-blue-400');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-blue-50', 'dark:bg-slate-800', 'border-blue-600', 'dark:border-blue-400');
        }
      });
    }

    function executeSearchAction() {
      const val = input.value.trim();
      if (!val) return;

      suggestions.classList.add('hidden');

      if (highlightedIndex >= 0 && highlightedIndex < matchingSuggestions.length) {
        const selected = matchingSuggestions[highlightedIndex];
        input.value = selected.name;
        updateClearButtonVisibility();
        handleItemSelected(selected.slug);
        return;
      }

      if (matchingSuggestions.length > 0) {
        const first = matchingSuggestions[0];
        input.value = first.name;
        updateClearButtonVisibility();
        handleItemSelected(first.slug);
        return;
      }

      const match = findBestMatch(val);
      if (match) {
        input.value = match.name;
        updateClearButtonVisibility();
        handleItemSelected(match.slug);
      } else {
        window.location.href = `/items/page/1/?q=${encodeURIComponent(val)}`;
      }
    }

    // Handle typing / matching suggestions
    input.addEventListener('input', () => {
      renderSuggestions();
      updateClearButtonVisibility();
    });

    // Search button click
    if (submitBtn) {
      submitBtn.addEventListener('click', (e) => {
        e.preventDefault();
        executeSearchAction();
      });
    }

    // Clear Search Input Action
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        updateClearButtonVisibility();
        suggestions.classList.add('hidden');
        suggestions.innerHTML = '';
        matchingSuggestions = [];
        highlightedIndex = -1;
        input.focus();
      });
    }

    // Keyboard navigation (ArrowDown, ArrowUp, Enter, Escape)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeSearchAction();
        return;
      }

      if (suggestions.classList.contains('hidden') || matchingSuggestions.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex + 1) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlightedIndex = (highlightedIndex - 1 + matchingSuggestions.length) % matchingSuggestions.length;
        updateHighlight();
      } else if (e.key === 'Escape') {
        suggestions.classList.add('hidden');
      }
    });

    // Close suggestions on click outside
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !suggestions.contains(e.target as Node) && !clearBtn?.contains(e.target as Node) && !submitBtn?.contains(e.target as Node)) {
        suggestions.classList.add('hidden');
      }
    });

    // Chips clicks
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const slug = chip.dataset.chipSlug || '';
        const label = chip.textContent?.trim() || '';
        input.value = label;
        updateClearButtonVisibility();
        suggestions.classList.add('hidden');
        handleItemSelected(slug, chip);
      });
    });

    // Close result modal handlers
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    if (dismissBtn) {
      dismissBtn.addEventListener('click', closeModal);
    }
    if (backdrop) {
      backdrop.addEventListener('click', closeModal);
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInteractiveSearch);
  } else {
    setupInteractiveSearch();
  }

  // Support View Transitions
  document.addEventListener('astro:after-swap', () => {
    setupInteractiveSearch();
  });
</script>
