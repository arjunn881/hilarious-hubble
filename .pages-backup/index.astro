<script>
  const statusColors = {
    allowed: "bg-link-bg-soft text-link-deep border-link/25",
    prohibited: "bg-error-soft text-error-deep border-error/25",
    restricted: "bg-warning-soft border-warning/25 text-warning-deep"
  };

  function renderFavorites() {
    const listContainer = document.getElementById("favorites-dashboard-list");
    if (!listContainer) return;

    try {
      const favorites = JSON.parse(localStorage.getItem("favorite_items") || "[]");
      if (favorites.length === 0) {
        listContainer.innerHTML = `
          <p class="text-xs text-body italic bg-canvas-soft border border-hairline rounded-md p-4">
            No starred items. Click the "Favorite" star button on any item rules page to see it here.
          </p>
        `;
        return;
      }

      listContainer.innerHTML = favorites.map(item => `
        <a href="/items/${item.slug}/" class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-3.5 transition-all">
          <div class="flex items-center justify-between gap-3">
            <div>
              <span class="text-sm font-medium text-ink">${item.name}</span>
              <span class="text-[10px] text-mute uppercase font-mono tracking-wider ml-2">${item.category}</span>
            </div>
            <div class="flex gap-1.5 flex-shrink-0">
              <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider ${statusColors[item.carryOn]}">
                H: ${item.carryOn}
              </span>
              <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full border uppercase tracking-wider ${statusColors[item.checked]}">
                C: ${item.checked}
              </span>
            </div>
          </div>
        </a>
      `).join("");
    } catch {
      listContainer.innerHTML = `<p class="text-xs text-error font-mono">Failed to load favorites.</p>`;
    }
  }

  function renderRecents() {
    const listContainer = document.getElementById("recents-dashboard-list");
    if (!listContainer) return;

    try {
      const recents = JSON.parse(localStorage.getItem("recently_viewed") || "[]");
      if (recents.length === 0) {
        listContainer.innerHTML = `
          <p class="text-xs text-body italic bg-canvas-soft border border-hairline rounded-md p-4">
            No recently viewed items. Search for items or click links to populate this list.
          </p>
        `;
        return;
      }

      listContainer.innerHTML = recents.map(item => `
        <a href="/items/${item.slug}/" class="block bg-canvas border border-hairline hover:border-link hover:shadow-level-2 rounded-md p-3.5 transition-all">
          <div class="flex items-center justify-between gap-3">
            <div>
              <span class="text-sm font-medium text-ink">${item.name}</span>
              <span class="text-[10px] text-mute uppercase font-mono tracking-wider ml-2">${item.category}</span>
            </div>
            <span class="text-[10px] text-mute font-mono">Reviewed ${item.lastReviewed}</span>
          </div>
        </a>
      `).join("");
    } catch {
      listContainer.innerHTML = `<p class="text-xs text-error font-mono">Failed to load recents.</p>`;
    }
  }

  function setupFaq() {
    document.querySelectorAll(".home-faq-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const targetId = (e.currentTarget as HTMLElement).getAttribute("data-target") || "";
        const body = document.getElementById(targetId);
        const icon = (e.currentTarget as HTMLElement).querySelector("svg");
        
        if (body) {
          const isHidden = body.classList.contains("hidden");
          if (isHidden) {
            body.classList.remove("hidden");
            if (icon) icon.classList.add("rotate-180");
          } else {
            body.classList.add("hidden");
            if (icon) icon.classList.remove("rotate-180");
          }
        }
      });
    });
  }

  // Load dashboards and FAQs on window load
  renderFavorites();
  renderRecents();
  setupFaq();

  // Support View Transitions swapping
  document.addEventListener("astro:after-swap", () => {
    renderFavorites();
    renderRecents();
    setupFaq();
  });
</script>

