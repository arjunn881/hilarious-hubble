{
  "name": "hilarious-hubble",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-search-index.js && astro dev --port 3000",
    "build": "node scripts/build-search-index.js && node scripts/validate.js && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate.js",
    "review-report": "node scripts/review-report.js",
    "build-search-index": "node scripts/build-search-index.js",
    "generate-related": "node scripts/generate-related.js",
    "seo-report": "node scripts/seo-report.js",
    "seo:validate": "node scripts/seo-validate.js",
    "seo:report": "node scripts/seo-validate.js",
    "sitemap": "node scripts/seo-report.js",
    "schema": "node scripts/validate.js",
    "metadata": "node scripts/build-search-index.js",
    "i18n:keys": "node scripts/i18n/uicheck.mjs",
    "i18n:leaks": "node scripts/i18n/leakcheck.mjs",
    "i18n:paths": "node scripts/i18n/pathcheck.mjs",
    "i18n:overlay": "node scripts/i18n/prosecheck.mjs",
    "i18n:compile": "node scripts/i18n/astrocheck.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name bringonplane"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.22.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
